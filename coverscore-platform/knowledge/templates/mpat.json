    {
      "id": "MPAT-001",
      "section_id": "SEC-MPAT-WELCOME",
      "sequence": 0,
      "question_type": "choice",
      "text": "👋 Hello and welcome to CoverScore™.\n\nI'm your AI Risk Advisor.\n\nOver the next few minutes, I'll help you understand how well you're protected against risks that matter most to you.\n\nAt the end of our conversation, you'll receive your personalized Risk Intelligence Report™ with practical recommendations.\n\nThis usually takes about 5 minutes.\n\nShall we begin?",
