        { "text": "✅ Yes, let's begin", "value": "yes", "sort_order": 0, "next_question": "MPAT-010" },
        { "text": "ℹ️ Tell me more", "value": "tell_me_more", "sort_order": 1, "next_question": "MPAT-005" }
      ]
    },
    {
