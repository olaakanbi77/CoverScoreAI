    {
      "id": "MBAT-001",
      "section_id": "SEC-MBAT-WELCOME",
      "sequence": 0,
      "question_type": "choice",
      "text": "👋 Welcome to CoverScore™ Business Risk Intelligence.\n\nI'm your AI Risk Advisor.\n\nOver the next few minutes, I'll help identify the key operational, financial, and protection risks that could affect your business.\n\nAt the end of our conversation, you'll receive a personalized Business Risk Intelligence Report™ with practical recommendations to strengthen your resilience.\n\nThis usually takes about 5 minutes.\n\nShall we begin?",
      "options": [
        { "text": "✅ Yes, let's begin", "value": "yes", "sort_order": 0, "next_question": "MBAT-010" },
        { "text": "ℹ️ Tell me more", "value": "tell_me_more", "sort_order": 1, "next_question": "MBAT-005" }
      ]
    },
    {
      "id": "MBAT-005",
      "section_id": "SEC-MBAT-WELCOME",
      "sequence": 1,
      "question_type": "choice",
      "text": "CoverScore™ helps businesses identify hidden risks before they become costly incidents.\n\nWe'll ask a few simple questions about your business so we can prepare practical recommendations tailored to your operations.\n\nYour responses remain confidential and are used only to generate your report.\n\nReady to begin?",
      "options": [
        { "text": "✅ Start Assessment", "value": "yes", "sort_order": 0, "next_question": "MBAT-010" }
      ]
    },
