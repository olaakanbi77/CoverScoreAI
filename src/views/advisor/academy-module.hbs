<style>
  :root {
    --c-navy: #0b1120; --c-navy-light: #1e293b; --c-purple: #7c3aed;
    --c-purple-light: #f5f3ff; --c-dark: #0f172a; --c-gray: #64748b;
    --text-sec: #64748b; --c-gray-light: #f1f5f9; --c-green: #10b981;
    --c-green-dark: #047857; --c-green-light: #ecfdf5; --c-orange: #f97316;
    --c-orange-light: #fff7ed; --c-blue: #2563eb; --c-blue-light: #eff6ff;
    --bg-page: #ffffff; --gold: #fbbf24;
  }
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  body { font-family: 'Inter', sans-serif; background-color: var(--bg-page); margin: 0; }
  .app { max-width: 480px; margin: 0 auto; min-height: 100vh; background: var(--bg-page); position: relative; padding-bottom: 40px; }

  /* Topbar */
  .topbar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: white; position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #f1f5f9; }
  .back-btn { background: none; border: none; padding: 4px; cursor: pointer; color: var(--c-dark); display: flex; align-items: center; text-decoration: none; }
  .back-btn svg { width: 20px; height: 20px; stroke-width: 2; }
  .top-info { flex: 1; min-width: 0; }
  .top-label { font-size: 9px; font-weight: 700; color: var(--c-purple); text-transform: uppercase; letter-spacing: 0.5px; }
  .top-title { font-size: 11px; font-weight: 800; color: var(--c-dark); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Hero */
  .hero { padding: 16px; background: linear-gradient(135deg, #0b1120 0%, #1e293b 100%); }
  .hero-code { font-size: 9px; font-weight: 700; color: var(--c-purple); background: rgba(124,58,237,0.15); padding: 3px 8px; border-radius: 4px; display: inline-block; margin-bottom: 6px; }
  .hero-title { font-size: 15px; font-weight: 800; color: white; margin: 0 0 2px 0; line-height: 1.3; }
  .hero-course { font-size: 10px; color: #94a3b8; margin: 0 0 8px 0; font-weight: 500; }
  .hero-meta { display: flex; gap: 12px; }
  .meta-item { display: flex; align-items: center; gap: 3px; font-size: 10px; color: #94a3b8; font-weight: 600; }
  .meta-item svg { width: 13px; height: 13px; stroke-width: 2; }

  /* Course progress bar */
  .prog-section { padding: 8px 16px; background: white; border-bottom: 1px solid #f1f5f9; }
  .prog-row { display: flex; align-items: center; gap: 8px; }
  .prog-bg { flex: 1; height: 4px; background: #f1f5f9; border-radius: 2px; overflow: hidden; }
  .prog-fill { height: 100%; background: var(--c-green); border-radius: 2px; transition: width 0.3s; }
  .prog-txt { font-size: 9px; font-weight: 700; color: var(--c-green-dark); white-space: nowrap; }

  /* Actions */
  .actions { display: flex; gap: 8px; padding: 10px 16px; }
  .btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px; border-radius: 8px; font-size: 11px; font-weight: 700; border: none; cursor: pointer; text-decoration: none; }
  .btn.primary { background: var(--c-green-dark); color: white; }
  .btn.primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn.outline { background: white; color: var(--c-dark); border: 1px solid #e2e8f0; }
  .btn.outline.completed { border-color: #d1fae5; color: var(--c-green-dark); background: var(--c-green-light); }
  .btn svg { width: 14px; height: 14px; stroke-width: 2; }

  /* Tabs */
  .tabs { display: flex; gap: 0; overflow-x: auto; border-bottom: 1px solid #f1f5f9; background: white; position: sticky; top: 44px; z-index: 15; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab { display: flex; align-items: center; gap: 3px; padding: 8px 6px; font-size: 9px; font-weight: 700; color: var(--c-gray); border: none; background: none; cursor: pointer; white-space: nowrap; border-bottom: 2px solid transparent; transition: all 0.15s; flex-shrink: 0; }
  .tab:hover { color: var(--c-dark); }
  .tab.active { color: var(--c-purple); border-bottom-color: var(--c-purple); }
  .tab svg { width: 12px; height: 12px; stroke-width: 2; }
  .tab-badge { background: var(--c-purple-light); color: var(--c-purple); font-size: 7px; font-weight: 800; padding: 1px 4px; border-radius: 8px; }

  /* Tab Content */
  .tab-content { padding: 0; }
  .tab-pane { display: none; padding: 16px; }
  .tab-pane.active { display: block; }

  /* Handbook styles */
  .handbook h2 { font-size: 14px; font-weight: 800; color: var(--c-dark); margin: 20px 0 8px 0; }
  .handbook h3 { font-size: 12px; font-weight: 700; color: var(--c-dark); margin: 16px 0 6px 0; }
  .handbook p { font-size: 11px; line-height: 1.6; color: var(--c-gray); font-weight: 500; margin: 0 0 10px 0; }
  .handbook ul, .handbook ol { margin: 0 0 10px 0; padding-left: 18px; }
  .handbook li { font-size: 11px; line-height: 1.6; color: var(--c-gray); font-weight: 500; margin-bottom: 3px; }
  .handbook strong { color: var(--c-dark); font-weight: 700; }
  .handbook table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 10px; }
  .handbook th { background: var(--c-navy); color: white; padding: 6px 8px; text-align: left; font-weight: 700; font-size: 10px; }
  .handbook td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; color: var(--c-gray); font-weight: 500; font-size: 10px; }
  .handbook .callout-box p { font-size: 11px; }

  /* Quiz styles */
  .quiz-section { }
  .quiz-question { margin-bottom: 20px; padding: 14px; background: #f8fafc; border-radius: 10px; border: 1px solid #f1f5f9; }
  .q-number { font-size: 9px; font-weight: 700; color: var(--c-purple); text-transform: uppercase; margin-bottom: 4px; }
  .q-text { font-size: 12px; font-weight: 700; color: var(--c-dark); margin: 0 0 10px 0; line-height: 1.4; }
  .q-option { display: flex; align-items: center; gap: 8px; padding: 8px 12px; margin-bottom: 4px; border-radius: 6px; border: 1px solid #e2e8f0; background: white; cursor: pointer; touch-action: manipulation; transition: all 0.15s; }
  .q-option:hover { border-color: var(--c-purple); background: var(--c-purple-light); }
  .q-option.selected { border-color: var(--c-purple); background: var(--c-purple-light); }
  .q-option.correct { border-color: var(--c-green); background: var(--c-green-light); }
  .q-option.wrong { border-color: #ef4444; background: #fef2f2; }
  .q-radio { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #cbd5e1; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .q-option.selected .q-radio { border-color: var(--c-purple); }
  .q-option.selected .q-radio::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c-purple); }
  .q-option.correct .q-radio { border-color: var(--c-green); }
  .q-option.correct .q-radio::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c-green); }
  .q-option.wrong .q-radio { border-color: #ef4444; }
  .q-option.wrong .q-radio::after { content: '✕'; font-size: 10px; color: #ef4444; }
  .q-label { font-size: 11px; font-weight: 600; color: var(--c-dark); flex: 1; }
  .q-feedback { margin-top: 8px; padding: 8px 10px; border-radius: 6px; font-size: 10px; font-weight: 500; display: none; }
  .q-feedback.show { display: block; }
  .q-feedback.correct { background: var(--c-green-light); color: var(--c-green-dark); }
  .q-feedback.wrong { background: #fef2f2; color: #b91c1c; }

  .quiz-submit { width: 100%; padding: 12px; border-radius: 8px; font-size: 12px; font-weight: 700; background: var(--c-purple); color: white; border: none; cursor: pointer; margin-top: 8px; }
  .quiz-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .quiz-submit:hover:not(:disabled) { background: #6d28d9; }
  .flash-unanswered { animation: flashUnanswered 1.5s ease; }
  .flash-unanswered .q-text { color: #b91c1c; font-weight: 700; }
  @keyframes flashUnanswered { 0% { background: #fef2f2; } 50% { background: #ffedd5; } 100% { background: transparent; } }
  .quiz-result { padding: 16px; text-align: center; background: var(--c-green-light); border-radius: 10px; margin-bottom: 16px; }
  .qr-score { font-size: 32px; font-weight: 800; color: var(--c-green-dark); }
  .qr-label { font-size: 11px; font-weight: 600; color: var(--c-green-dark); }
  .qr-detail { font-size: 10px; color: var(--c-gray); margin-top: 4px; }
  .qr-pass { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 10px; font-weight: 700; margin-top: 8px; }
  .qr-pass.yes { background: var(--c-green-dark); color: white; }
  .qr-pass.no { background: #ef4444; color: white; }

  /* AI Coach styles */
  .coach-container { display: flex; flex-direction: column; gap: 12px; min-height: 300px; }
  .coach-messages { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 0; }
  .coach-msg { display: flex; gap: 8px; max-width: 85%; }
  .coach-msg.user { align-self: flex-end; flex-direction: row-reverse; }
  .cm-avatar { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
  .cm-avatar.coach { background: var(--c-purple-light); color: var(--c-purple); }
  .cm-avatar.user { background: var(--c-blue-light); color: var(--c-blue); }
  .cm-bubble { padding: 8px 12px; border-radius: 12px; font-size: 11px; line-height: 1.5; font-weight: 500; }
  .coach-msg.coach .cm-bubble { background: #f1f5f9; color: var(--c-dark); border-bottom-left-radius: 4px; }
  .coach-msg.user .cm-bubble { background: var(--c-purple); color: white; border-bottom-right-radius: 4px; }
  .coach-input-row { display: flex; gap: 8px; padding: 8px 0; border-top: 1px solid #f1f5f9; margin-top: 8px; }
  .coach-input { flex: 1; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 11px; outline: none; }
  .coach-input:focus { border-color: var(--c-purple); }
  .coach-send { width: 40px; height: 40px; border-radius: 8px; background: var(--c-purple); color: white; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .coach-send:disabled { opacity: 0.5; cursor: not-allowed; }
  .coach-send svg { width: 18px; height: 18px; }
  .coach-typing { display: flex; gap: 4px; padding: 8px 12px; background: #f1f5f9; border-radius: 12px; align-self: flex-start; max-width: 60px; }
  .coach-typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--c-gray); animation: bounce 1.4s infinite ease-in-out; }
  .coach-typing span:nth-child(2) { animation-delay: 0.2s; }
  .coach-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

  /* Video */
  .video-placeholder { width: 100%; aspect-ratio: 16/9; background: var(--c-navy); border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; gap: 8px; }
  .video-placeholder svg { width: 40px; height: 40px; opacity: 0.5; }
  .video-placeholder span { font-size: 10px; font-weight: 600; opacity: 0.7; }
  .bg-play-label { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 10px; font-weight: 600; color: var(--c-gray); cursor: pointer; user-select: none; }
  .bg-play-label input { accent-color: var(--c-orange); cursor: pointer; }

  /* Workbook */
  .workbook-content { font-size: 11px; line-height: 1.6; color: var(--c-gray); font-weight: 500; }
  .workbook-content h3 { font-size: 13px; font-weight: 800; color: var(--c-dark); margin: 16px 0 8px 0; }
  .wb-note { width: 100%; box-sizing: border-box; margin-top: 8px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 12px; line-height: 1.5; color: var(--c-dark); font-family: inherit; background: white; resize: vertical; }
  .wb-note:focus { outline: none; border-color: var(--c-purple); box-shadow: 0 0 0 3px rgba(124,58,237,0.12); }
  .wb-note::placeholder { color: #94a3b8; font-size: 11px; }
  .wb-saved { display: inline-block; margin-top: 10px; font-size: 10px; font-weight: 700; color: var(--c-green-dark); opacity: 0; transition: opacity 0.3s; }
  .wb-saved.show { opacity: 1; }
  .quiz-lock-banner { margin: 0 16px 12px; padding: 10px 12px; background: var(--c-orange-light); border: 1px solid #fed7aa; border-radius: 8px; display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 600; color: #9a3412; }
  .quiz-lock-banner svg { width: 16px; height: 16px; flex-shrink: 0; }

  /* Resources */
  .resource-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #f1f5f9; border-radius: 8px; margin-bottom: 6px; text-decoration: none; }
  .resource-item:hover { background: #f8fafc; }
  .ri-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ri-icon.pdf { background: #fef2f2; color: #dc2626; }
  .ri-icon.doc { background: var(--c-blue-light); color: var(--c-blue); }
  .ri-icon.link { background: var(--c-purple-light); color: var(--c-purple); }
  .ri-icon.video { background: var(--c-orange-light); color: var(--c-orange); }
  .ri-info { flex: 1; }
  .ri-title { font-size: 11px; font-weight: 700; color: var(--c-dark); margin: 0; }
  .ri-desc { font-size: 9px; color: var(--c-gray); font-weight: 500; margin: 2px 0 0 0; }

  /* Toast */
  .toast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); background: var(--c-dark); color: white; padding: 10px 20px; border-radius: 8px; font-size: 11px; font-weight: 600; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 200; max-width: 360px; text-align: center; }
  .toast.show { opacity: 1; }

  /* Bottom Nav */
  .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active { color: var(--c-green-dark); }
  .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }
</style>

<div class="app">

  <!-- Topbar -->
  <div class="topbar">
    {{#if course}}
    <a href="/advisor/academy/course/{{course.id}}" class="back-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    {{else}}
    <a href="/advisor/academy" class="back-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    {{/if}}
    <div class="top-info">
      <div class="top-label">{{#if course}}{{course.code}}{{else}}{{level.name}}{{/if}}</div>
      <h1 class="top-title">{{module.title}}</h1>
    </div>
  </div>

  <!-- Hero -->
  <div class="hero">
    {{#if course}}<div class="hero-code">{{course.code}} · Lesson {{module.lesson_number}}</div>{{/if}}
    <h2 class="hero-title">{{module.title}}</h2>
    {{#if course}}<p class="hero-course">{{course.title}}</p>{{/if}}
    <div class="hero-meta">
      {{#if module.duration_minutes}}
      <span class="meta-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {{module.duration_minutes}} min
      </span>
      {{/if}}
      <span class="meta-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        {{#if status}}<span style="color:{{#if (eq status 'completed')}}var(--c-green){{else if (eq status 'in_progress')}}var(--c-blue){{else}}#94a3b8{{/if}};">{{status}}</span>{{else}}pending{{/if}}
      </span>
    </div>
  </div>

  <!-- Course Progress -->
  <div class="prog-section">
    <div class="prog-row">
      <span style="font-size:9px; font-weight:700; color:var(--c-dark);">{{#if course}}Course{{else}}Level{{/if}} Progress</span>
      <div class="prog-bg">
        <div class="prog-fill" style="width: {{levelProgress}}%"></div>
      </div>
      <span class="prog-txt">{{levelCompleted}}/{{levelTotal}}</span>
    </div>
  </div>

  <!-- Actions -->
  {{#if isAdmin}}
  <div class="quiz-lock-banner" style="background:var(--c-purple-light); border-color:#ddd6fe; color:var(--c-purple);">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
    Preview mode — browsing without enrolment. Lesson access and navigation are unlocked, and progress is not tracked.
  </div>
  {{/if}}

  <div class="actions">
    {{#if (and isAdmin (eq status 'pending'))}}
    <button class="btn outline" style="cursor:default;" disabled>Previewing lesson (no enrolment needed)</button>
    {{else if (eq status 'completed')}}
    <button class="btn outline completed" disabled>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      Completed
    </button>
    {{else}}
      {{#if (and hasQuiz (not quizPassed))}}
      <button class="btn primary" id="completeBtn" onclick="goToQuiz()">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Take Quiz to Complete
      </button>
      {{else}}
      <button class="btn primary" id="completeBtn" onclick="updateProgress('completed')">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Mark Complete
      </button>
      {{/if}}
    {{/if}}
    {{#if (eq status 'in_progress')}}
    <button class="btn outline" onclick="updateProgress('pending')">Reset</button>
    {{else if (ne status 'completed')}}
    <button class="btn outline" id="saveBtn" onclick="updateProgress('in_progress')">Save Progress</button>
    {{/if}}
  </div>

  {{#if (and hasQuiz (not quizPassed))}}
  <div class="quiz-lock-banner">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
    Pass the lesson quiz to complete this lesson and unlock the next one.
  </div>
  {{/if}}

  {{#if locked}}
  <div class="quiz-lock-banner">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
    Complete the previous lesson to unlock this lesson.
  </div>
  {{/if}}

  <!-- Tabs -->
  <div class="tabs" id="tabs">
    {{#if videoUrl}}
    <button class="tab active" data-tab="video">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Video
    </button>
    {{else if videoScript}}
    <button class="tab active" data-tab="video">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Transcript
    </button>
    {{/if}}
    <button class="tab{{#unless videoUrl}}{{#unless videoScript}} active{{/unless}}{{/unless}}" data-tab="handbook">
