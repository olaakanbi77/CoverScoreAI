<script>
// ── API fetch with silent token refresh & retry ──────────────────────
async function apiFetch(url, options = {}) {
  let res = await fetch(url, options);
  if (res.status === 401) {
    // Try to refresh the expired access token, then retry once.
    await fetch('/api/auth/refresh', { method: 'POST', credentials: 'same-origin' });
    res = await fetch(url, options);
  }
  return res;
}

// ── Tab Switching ────────────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
  });
});

function goToQuiz() {
  const tab = document.querySelector('.tab[data-tab="quiz"]');
  if (tab) tab.click();
  const quizPane = document.getElementById('tab-quiz');
  if (quizPane) quizPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Background playback (keep playing when tab minimized) ────────────
(function() {
  const video = document.getElementById('lessonVideo');
  const toggle = document.getElementById('bgPlayToggle');
  if (!video || !toggle) return;

  let lastTime = 0;

  const rememberState = () => { lastTime = video.currentTime; };

  video.addEventListener('timeupdate', rememberState);

  function enterPip() {
    if (!toggle.checked) return;
    if (document.pictureInPictureElement) return;
    if (!document.pictureInPictureEnabled) return;
    // Request PiP in a user-gesture context (on play) so it works reliably,
    // then the video keeps playing in its floating window when minimized.
    video.requestPictureInPicture().catch(() => {});
  }

  function exitPip() {
    if (document.pictureInPictureElement) {
      document.exitPictureInPicture().catch(() => {});
    }
  }

  // Enter PiP as soon as playback begins — this call happens right when the
  // user clicks play (a trusted user gesture), making it dependable.
  video.addEventListener('play', enterPip);

  // Optional, per preference: pull it back when the user starts interacting
  // with the page again after it had gone to background.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      // If still playing after being hidden, make sure it is in PiP.
      if (!video.paused && !video.ended) enterPip();
    }
  });

  // Resume at the same spot after returning from PiP.
  video.addEventListener('leavepictureinpicture', () => {
    if (document.hidden) return;
    try { if (lastTime > 0) video.currentTime = lastTime; video.play().catch(() => {}); } catch (e) {}
  });
})();

// ── Workbook Notes (autosave) ────────────────────────────────────────
{{#if hasWorkbook}}
(function() {
  const moduleId = {{module.id}};
  const key = 'academy_workbook_' + moduleId;
  const saved = {};
  try { Object.assign(saved, JSON.parse(localStorage.getItem(key) || '{}')); } catch (e) {}

  document.querySelectorAll('.wb-note').forEach(note => {
    const idx = note.dataset.noteIndex;
    if (saved[idx]) note.value = saved[idx];
    let t;
    note.addEventListener('input', () => {
      saved[idx] = note.value;
      clearTimeout(t);
      t = setTimeout(() => {
        try {
          localStorage.setItem(key, JSON.stringify(saved));
          const el = document.getElementById('wbSaved');
          if (el) {
            el.classList.add('show');
            setTimeout(() => el.classList.remove('show'), 1500);
          }
        } catch (e) {}
      }, 400);
    });
  });
})();
{{/if}}

// ── Locked banner (flash on load) ────────────────────────────────────
{{#if locked}}
(function() {
  setTimeout(() => {
    const el = document.querySelector('.quiz-lock-banner');
    if (el) {
      el.style.transition = 'background 0.4s';
      el.style.background = '#ffedd5';
      setTimeout(() => { el.style.background = ''; }, 1200);
    }
  }, 400);
})();
{{/if}}

// ── Progress ─────────────────────────────────────────────────────────
async function updateProgress(status) {
  const moduleId = {{module.id}};
  try {
    const res = await apiFetch('/advisor/api/academy/progress', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ moduleId, status })
    });
    const data = await res.json();
    if (data.success) {
      showToast(data.message || 'Progress updated');
      setTimeout(() => location.reload(), 800);
    } else {
      showToast(data.error || 'Failed to update');
    }
  } catch (err) {
    showToast('Network error');
  }
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

// ── Quiz ─────────────────────────────────────────────────────────────
const userAnswers = {};

function selectOption(qid, idx) {
  userAnswers[qid] = idx;
  const qEl = document.querySelector(`.quiz-question[data-qid="${qid}"]`);
  qEl.querySelectorAll('.q-option').forEach((opt, i) => {
    opt.classList.toggle('selected', i === idx);
  });
}

async function submitQuiz() {
  const moduleId = {{module.id}};
  const allQ = document.querySelectorAll('.quiz-question');
  let answered = 0;
  const firstUnanswered = [];
  allQ.forEach(q => {
    const qid = parseInt(q.dataset.qid);
    if (userAnswers[qid] !== undefined) answered++;
    else firstUnanswered.push(q);
  });

  if (answered < allQ.length) {
    showToast(`Answer all ${allQ.length} questions first`);
    // Visibly scroll to and highlight the first unanswered question so the
    // user always sees why the button did not submit.
    const target = firstUnanswered[0];
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('flash-unanswered');
      setTimeout(() => target.classList.remove('flash-unanswered'), 2000);
    }
    return;
  }

  const btn = document.getElementById('quizSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Submitting...';

  try {
    const res = await apiFetch('/advisor/api/academy/quiz/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ moduleId, answers: userAnswers })
    });
    const data = await res.json();

    if (data.success) {
      // Show feedback for each question
      data.results.forEach(r => {
        const qEl = document.querySelector(`.quiz-question[data-qid="${r.questionId}"]`);
        qEl.querySelectorAll('.q-option').forEach((opt, i) => {
          opt.style.pointerEvents = 'none';
          if (i === r.correctIndex) opt.classList.add('correct');
          if (i === r.userAnswer && !r.correct) opt.classList.add('wrong');
        });
        const fb = document.getElementById('feedback-' + r.questionId);
        fb.textContent = r.explanation;
        fb.className = 'q-feedback show ' + (r.correct ? 'correct' : 'wrong');
      });

      // Show result summary
      const resultDiv = document.getElementById('quizResult');
      resultDiv.innerHTML = `
        <div class="quiz-result">
          <div class="qr-score">${data.percentage}%</div>
          <div class="qr-label">${data.score} of ${data.total} correct</div>
          <div class="qr-detail">${data.passed ? 'Congratulations! You passed.' : 'You need 70% to pass. Review and try again.'}</div>
          <div class="qr-pass ${data.passed ? 'yes' : 'no'}">${data.passed ? 'PASSED' : 'FAILED'}</div>
        </div>
      `;

      btn.textContent = data.passed ? '✓ Completed' : 'Retry Quiz';
      btn.disabled = data.passed;
      if (data.passed) {
        showToast('🎉 Quiz passed! Lesson completed');
        setTimeout(() => location.reload(), 1200);
      } else {
        btn.onclick = () => location.reload();
      }
    } else {
      showToast(data.error || 'Failed to submit');
      btn.disabled = false;
      btn.textContent = 'Submit Answers';
    }
  } catch (err) {
    showToast('Network error');
    btn.disabled = false;
    btn.textContent = 'Submit Answers';
  }
}

// ── AI Coach ─────────────────────────────────────────────────────────
let coachBusy = false;

async function askCoach() {
  const input = document.getElementById('coachInput');
  const msg = input.value.trim();
  if (!msg || coachBusy) return;

  const moduleId = {{module.id}};
  const messages = document.getElementById('coachMessages');
  const sendBtn = document.getElementById('coachSendBtn');

  // Lock the input while a request is in flight (prevents queue flooding).
  coachBusy = true;

  // Add user message
  messages.innerHTML += `
    <div class="coach-msg user">
      <div class="cm-avatar user">👤</div>
      <div class="cm-bubble">${escapeHtml(msg)}</div>
    </div>
  `;

  // Add typing indicator
  const typingEl = document.createElement('div');
  typingEl.className = 'coach-typing';
  typingEl.id = 'typingIndicator';
  typingEl.innerHTML = '<span></span><span></span><span></span>';
  messages.appendChild(typingEl);
  messages.scrollTop = messages.scrollHeight;

  input.value = '';
  input.disabled = true;
  sendBtn.disabled = true;

  try {
    let data;
    // Retry with exponential backoff when the AI request queue is full (503).
    for (let attempt = 0; attempt < 3; attempt++) {
      const res = await apiFetch('/advisor/api/academy/coach/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ moduleId, message: msg })
      });
      if (res.status === 503 && attempt < 2) {
        const delay = 1000 * Math.pow(2, attempt) + Math.floor(Math.random() * 300);
        await new Promise(r => setTimeout(r, delay));
        continue;
      }
      data = await res.json().catch(() => null);
      break;
    }

    typingEl.remove();

    if (data && data.success) {
      messages.innerHTML += `
        <div class="coach-msg coach">
          <div class="cm-avatar coach">💡</div>
          <div class="cm-bubble">${escapeHtml(data.message)}</div>
        </div>
      `;
    } else if (data && data.retryable) {
      messages.innerHTML += `
        <div class="coach-msg coach">
          <div class="cm-avatar coach">💡</div>
          <div class="cm-bubble">The request queue is busy right now. Please try again in a moment.</div>
        </div>
      `;
    } else {
      messages.innerHTML += `
        <div class="coach-msg coach">
          <div class="cm-avatar coach">💡</div>
          <div class="cm-bubble">I am here to help! Could you rephrase your question?</div>
        </div>
      `;
    }
    messages.scrollTop = messages.scrollHeight;
  } catch (err) {
    typingEl.remove();
    messages.innerHTML += `
      <div class="coach-msg coach">
        <div class="cm-avatar coach">💡</div>
        <div class="cm-bubble">I am having trouble connecting. Please try again.</div>
      </div>
    `;
  }

  coachBusy = false;
  input.disabled = false;
  sendBtn.disabled = false;
  input.focus();
}

function escapeHtml(text) {
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}
</script>