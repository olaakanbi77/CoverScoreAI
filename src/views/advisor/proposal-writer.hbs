<style>
  :root {
    --c-green: #10b981;
    --c-green-dark: #047857;
    --c-green-light: #ecfdf5;
    --c-dark: #0f172a;
    --c-gray: #64748b;
    --text-sec: #64748b;
    --c-gray-light: #f1f5f9;
    --bg-page: #ffffff;
  }

  /* Override Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  body { font-family: 'Inter', sans-serif; background-color: var(--bg-page); margin: 0; }

  .mobile-app-container {
    max-width: 480px;
    margin: 0 auto;
    background: #ffffff;
    min-height: 100vh;
    box-shadow: 0 0 20px rgba(0,0,0,0.05);
    position: relative;
    padding-bottom: 320px; /* Space for fixed action bar + nav */
  }

  /* Topbar */
  .qb-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    background: white;
  }
  .qb-title { font-size: 18px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .qb-actions { display: flex; align-items: center; gap: 12px; }
  .qb-save { color: var(--c-green-dark); font-size: 13px; font-weight: 700; text-decoration: none; }
  .icon-btn { background: none; border: none; padding: 4px; cursor: pointer; color: var(--c-dark); display: flex; align-items: center; justify-content: center; }
  .icon-btn svg { width: 24px; height: 24px; stroke-width: 2.5; }

  /* Header Card */
  .qb-header {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: white;
  }
  .lead-info-row { display: flex; align-items: center; gap: 12px; }
  .c-avatar {
    width: 52px;
    height: 52px;
    background: #ecfdf5;
    color: #059669;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
  }
  .lead-details h2 { font-size: 15px; font-weight: 800; color: var(--c-dark); margin: 0 0 4px 0; }
  .lead-details p { font-size: 12px; color: var(--c-gray); margin: 0 0 6px 0; }
  .badge-completed {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #ecfdf5;
    color: #059669;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
  }
  .risk-score-box { text-align: center; }
  .risk-circle {
    width: 44px;
    height: 44px;
    border: 2px solid #059669;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0 auto 4px auto;
  }
  .risk-lbl { font-size: 10px; color: var(--c-gray); font-weight: 500; }

  /* Stepper */
  .stepper-container {
    padding: 24px 20px 20px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    position: relative;
    background: white;
  }
  .stepper-line {
    position: absolute;
    top: 36px;
    left: 40px;
    right: 40px;
    height: 1px;
    background: #e2e8f0;
    z-index: 1;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 2;
  }
  .step-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4px solid white;
  }
  .step-icon svg { width: 14px; height: 14px; stroke-width: 2; }
  .step.active .step-icon { background: #059669; color: white; }
  .step-lbl { font-size: 10px; font-weight: 700; color: #94a3b8; }
  .step.active .step-lbl { color: #059669; }

  /* Section Title */
  .section-header { padding: 20px 16px 12px; background: white; }
  .sh-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .sh-title { font-size: 16px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .sh-count { font-size: 12px; font-weight: 700; color: #059669; }
  .sh-sub { font-size: 12px; color: var(--c-gray); margin: 0; }

  /* Covers List */
  .covers-list { padding: 0 16px; display: flex; flex-direction: column; gap: 12px; background: white; }
  .cover-item {
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cover-item.active { border-color: #a7f3d0; background: #f4fdf8; }
  .cb-custom {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cover-item.active .cb-custom { background: #059669; border-color: #059669; color: white; }
  .cb-custom svg { width: 14px; height: 14px; display: none; stroke-width: 3; }
  .cover-item.active .cb-custom svg { display: block; }
  
  .cover-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cover-icon svg { width: 20px; height: 20px; stroke-width: 2; }
  .bg-g { background: #ecfdf5; color: #059669; }
  .bg-o { background: #fffbeb; color: #d97706; }
  .bg-p { background: #f5f3ff; color: #7c3aed; }
  .bg-b { background: #eff6ff; color: #2563eb; }
  .bg-c { background: #e0f2fe; color: #0ea5e9; }
  .bg-y { background: #fef9c3; color: #ca8a04; }

  .cover-details { flex-grow: 1; }
  .cd-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0 0 4px 0;
  }
  .badge-rec {
    background: #ecfdf5;
    color: #059669;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 12px;
  }
  .cd-desc { font-size: 11px; color: var(--c-gray); margin: 0; line-height: 1.4; }

  .cover-price { text-align: right; display: flex; flex-direction: column; justify-content: center; }
  .cp-val { font-size: 14px; font-weight: 800; color: var(--c-dark); margin: 0 0 2px 0; }
  .cp-freq { font-size: 10px; color: var(--c-gray); }
  .chevron-down { color: #cbd5e1; width: 16px; height: 16px; margin-left: 12px; }

  /* Bottom Action Bar */
  .bottom-action-bar {
    position: fixed;
    bottom: 80px; /* Above global bottom nav */
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    border-top: 1px solid #f1f5f9;
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -10px 15px rgba(0,0,0,0.03);
    padding: 16px 20px;
    z-index: 90;
  }
  .bab-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .bab-title { font-size: 15px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .bab-link { font-size: 12px; font-weight: 700; color: #059669; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
  .bab-link svg { width: 14px; height: 14px; stroke-width: 2.5; }

  .bab-stats { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; }
  .stat-check { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--c-gray); font-weight: 600; }
  .stat-check .circle-check { width: 20px; height: 20px; border: 2px solid #059669; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .stat-check .circle-check svg { width: 12px; height: 12px; stroke-width: 3; }

  .stat-group-wrap { display: flex; gap: 20px; }
  .stat-item { text-align: right; }
  .stat-lbl { font-size: 10px; color: var(--c-gray); margin-bottom: 4px; display: flex; align-items: center; justify-content: flex-end; gap: 4px; }
  .stat-lbl svg { width: 12px; height: 12px; color: #94a3b8; }
  .stat-val { font-size: 18px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .stat-val.green { color: #059669; }

  .bundle-box {
    background: #f4fdf8;
    border: 1px solid #d1fae5;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 700;
    color: #059669;
  }
  .bundle-box svg { width: 16px; height: 16px; }

  .btn-row { display: flex; gap: 12px; }
  .btn-back {
    flex: 1;
    border: 1px solid #cbd5e1;
    background: white;
    color: var(--c-dark);
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-next {
    flex: 2;
    background: #047857;
    color: white;
    border: none;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-next svg { width: 16px; height: 16px; stroke-width: 2.5; }

  /* Standard Nav included from unify script */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 0 24px 0;
    border-top: 1px solid #e2e8f0;
    z-index: 100;
  }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active {
    color: var(--c-green);
  }
  .nav-item svg {
    width: 24px;
    height: 24px;
    stroke-width: 2;
  }
</style>

