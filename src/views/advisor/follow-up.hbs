<style>
  :root {
    --c-green: #10b981;
    --c-green-dark: #047857;
    --c-green-light: #ecfdf5;
    --c-dark: #0f172a;
    --c-gray: #64748b;
    --c-gray-light: #f1f5f9;
    --bg-page: #ffffff;
  }

  /* Override Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  body { font-family: 'Inter', sans-serif; background-color: var(--bg-page); margin: 0; }

  .mobile-app-container {
    max-width: 480px; margin: 0 auto; min-height: 100vh;
    background: #ffffff; position: relative; padding-bottom: 160px;
  }

  /* Topbar */
  .fu-topbar { display: flex; align-items: center; justify-content: space-between; padding: 16px; border-bottom: 1px solid #f1f5f9; }
  .fu-title { font-size: 18px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .icon-btn { background: none; border: none; padding: 4px; cursor: pointer; color: var(--c-dark); display: flex; align-items: center; justify-content: center; }
  .icon-btn svg { width: 24px; height: 24px; stroke-width: 2.5; }

  /* Header */
  .fu-header { padding: 16px; display: flex; align-items: center; justify-content: space-between; }
  .lead-info-row { display: flex; align-items: center; gap: 12px; }
  .c-avatar { width: 52px; height: 52px; background: #ecfdf5; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; }
  .lead-details h2 { font-size: 15px; font-weight: 800; color: var(--c-dark); margin: 0 0 4px 0; }
  .lead-details p { font-size: 12px; color: var(--c-gray); margin: 0 0 6px 0; }
  .badge-hot { display: inline-flex; align-items: center; gap: 4px; background: #ecfdf5; color: #059669; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 12px; border: 1px solid #a7f3d0; }
  .risk-score-box { text-align: center; }
  .risk-circle { width: 44px; height: 44px; border: 2px solid #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 800; color: var(--c-dark); margin: 0 auto 4px auto; }
  .risk-lbl { font-size: 10px; color: var(--c-gray); font-weight: 500; }

  /* Stepper */
  .stepper-container { padding: 8px 16px 20px; display: flex; justify-content: space-between; position: relative; }
  .stepper-line { position: absolute; top: 16px; left: 40px; right: 40px; height: 2px; background: #059669; z-index: 1; }
  .stepper-line-bg { position: absolute; top: 16px; left: 40px; right: 40px; height: 2px; background: #e2e8f0; z-index: 0; }
  .step { display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative; z-index: 2; width: 48px;}
  .step-icon { width: 20px; height: 20px; border-radius: 50%; background: white; color: #94a3b8; display: flex; align-items: center; justify-content: center; border: 2px solid #cbd5e1; }
  .step-icon.done { background: #059669; border-color: #059669; color: white; }
  .step-icon svg { width: 10px; height: 10px; stroke-width: 3; }
  .step-lbl { font-size: 9px; font-weight: 700; color: var(--c-dark); text-align: center; line-height: 1.2; }

  /* Next Best Action */
  .nba-card { margin: 0 16px 20px; border: 1px solid #f1f5f9; border-left: 4px solid #059669; border-radius: 12px; padding: 16px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); background: white;}
  .nba-content { flex: 1; }
  .nba-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .nba-time { font-size: 11px; font-weight: 700; color: var(--c-dark); }
  .badge-orange { background: #fff7ed; color: #ea580c; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 8px; }
  .nba-title { font-size: 16px; font-weight: 800; color: var(--c-dark); margin: 0 0 6px 0; }
  .nba-desc { font-size: 11px; color: var(--c-gray); margin: 0 0 12px 0; line-height: 1.4; }
  .btn-call { display: inline-flex; align-items: center; gap: 6px; background: #059669; color: white; font-size: 12px; font-weight: 700; padding: 8px 16px; border-radius: 8px; text-decoration: none; }
  .btn-call svg { width: 14px; height: 14px; }
  .nba-icon { width: 64px; height: 64px; background: #ecfdf5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #059669; margin-left: 12px; flex-shrink: 0; }
  .nba-icon svg { width: 32px; height: 32px; transform: rotate(-15deg); }

  /* Bento Grid */
  .bento-grid { padding: 0 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .bento-col { display: flex; flex-direction: column; gap: 12px; }
  .bento-card { border: 1px solid #f1f5f9; border-radius: 12px; padding: 16px; background: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .card-title { font-size: 13px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .card-link { font-size: 11px; font-weight: 700; color: #059669; text-decoration: none; }

  /* Timeline */
  .timeline { margin: 0; padding: 0; list-style: none; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: #e2e8f0; }
  .tl-item { display: flex; gap: 12px; margin-bottom: 16px; position: relative; }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-icon { width: 16px; height: 16px; border-radius: 50%; background: white; border: 2px solid #cbd5e1; flex-shrink: 0; z-index: 1; display: flex; align-items: center; justify-content: center; }
  .tl-icon.done { border-color: #059669; background: #059669; color: white; }
  .tl-icon svg { width: 10px; height: 10px; stroke-width: 3; }
  .tl-content { padding-top: 1px; }
  .tl-title { font-size: 11px; font-weight: 800; color: var(--c-dark); margin: 0 0 2px 0; }
  .tl-time { font-size: 10px; color: var(--c-gray); margin: 0; }
  .view-full { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: #059669; text-decoration: none; margin-top: 12px; }

  /* Recent Interactions */
  .ri-item { display: flex; gap: 12px; margin-bottom: 12px; }
  .ri-item:last-child { margin-bottom: 0; }
  .ri-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ri-icon.p { background: #f5f3ff; color: #7c3aed; }
  .ri-icon.b { background: #eff6ff; color: #3b82f6; }
  .ri-icon.g { background: #ecfdf5; color: #059669; }
  .ri-icon svg { width: 14px; height: 14px; stroke-width: 2.5; }
  .ri-content { flex: 1; }
  .ri-title { font-size: 11px; font-weight: 800; color: var(--c-dark); margin: 0 0 2px 0; }
  .ri-time { font-size: 10px; color: var(--c-gray); margin: 0; }

  /* Quick Actions Grid */
  .qa-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .qa-btn { border: 1px solid #f1f5f9; border-radius: 8px; padding: 12px 8px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-decoration: none; color: var(--c-dark); background: white; transition: all 0.2s; }
  .qa-btn.wa { border-color: #bbf7d0; }
  .qa-btn.wa svg { color: #16a34a; }
  .qa-btn.call { border-color: #bfdbfe; }
  .qa-btn.call svg { color: #2563eb; }
  .qa-btn.email { border-color: #ddd6fe; }
  .qa-btn.email svg { color: #7c3aed; }
  .qa-btn.sched { border-color: #fef08a; }
  .qa-btn.sched svg { color: #ca8a04; }
  .qa-btn svg { width: 20px; height: 20px; }
  .qa-lbl { font-size: 10px; font-weight: 700; text-align: center; }

  /* AI Copilot */
  .ai-card { background: #f4fdf8; border: 1px solid #d1fae5; }
  .ai-header { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; font-size: 13px; font-weight: 800; color: var(--c-dark); }
  .badge-beta { background: #059669; color: white; font-size: 8px; font-weight: 800; padding: 2px 4px; border-radius: 4px; }
  .ai-desc { font-size: 11px; color: var(--c-gray); margin: 0 0 8px 0; line-height: 1.4; }
  .ai-rec { font-size: 11px; color: var(--c-dark); font-weight: 700; margin: 0 0 12px 0; }
  .ai-rec span { color: #059669; display: block; margin-bottom: 2px; }
  .ai-close { background: white; border: 1px solid #d1fae5; border-radius: 8px; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; }
  .ai-close-lbl { font-size: 11px; font-weight: 700; color: var(--c-gray); display: flex; align-items: center; gap: 4px; }
  .ai-close-lbl svg { width: 14px; height: 14px; color: #059669; stroke-width: 2.5; }
  .ai-close-val { font-size: 14px; font-weight: 800; color: #059669; }

  /* Notes */
  .note-sect { margin-bottom: 12px; }
  .note-sect:last-child { margin-bottom: 0; }
  .note-lbl { font-size: 10px; color: var(--c-gray); margin-bottom: 4px; }
  .note-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .note-item { font-size: 11px; font-weight: 700; color: var(--c-dark); display: flex; align-items: center; gap: 6px; }
  .note-item svg { width: 12px; height: 12px; flex-shrink: 0; }
  .text-green { color: #059669; }
  .text-yellow { color: #ca8a04; }
  .note-text { font-size: 11px; font-weight: 700; color: var(--c-dark); margin: 0; line-height: 1.4; }

  /* Bottom Actions fixed */
  .fixed-bottom { position: fixed; bottom: 65px; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; padding: 16px; background: linear-gradient(to top, rgba(255,255,255,1) 80%, rgba(255,255,255,0)); z-index: 90; }
  .btn-complete { width: 100%; background: #047857; color: white; font-size: 14px; font-weight: 700; border: none; border-radius: 8px; padding: 14px; display: flex; justify-content: center; align-items: center; gap: 8px; cursor: pointer; }
  .btn-complete svg { width: 18px; height: 18px; }

  .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--c-gray); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active { color: var(--c-green); }
  .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }
</style>

