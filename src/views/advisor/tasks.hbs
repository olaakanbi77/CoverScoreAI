<style>
  :root {
    --c-purple: #7c3aed;
    --c-purple-dark: #6d28d9;
    --c-purple-light: #f5f3ff;
    --c-dark: #0f172a;
    --c-gray: #64748b;
    --text-sec: #64748b;
    --c-gray-light: #f1f5f9;
    --c-green: #10b981;
    --c-green-dark: #047857;
    --c-green-light: #ecfdf5;
    --c-orange: #f97316;
    --c-orange-light: #fff7ed;
    --c-red: #ef4444;
    --c-red-light: #fef2f2;
    --c-blue: #2563eb;
    --c-blue-light: #eff6ff;
    --bg-page: #ffffff;
  }

  /* Override Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  body { font-family: 'Inter', sans-serif; background-color: var(--bg-page); margin: 0; }

  .mobile-app-container {
    max-width: 480px; margin: 0 auto; min-height: 100vh;
    background: var(--bg-page); position: relative; padding-bottom: 140px;
  }

  /* Topbar */
  .t-topbar { display: flex; align-items: center; justify-content: space-between; padding: 16px; background: white; position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; }
  .t-title { font-size: 18px; font-weight: 800; color: var(--c-dark); margin: 0; flex: 1; text-align: center; }
  .icon-btn { background: none; border: none; padding: 4px; cursor: pointer; color: var(--c-dark); display: flex; align-items: center; justify-content: center; }
  .icon-btn svg { width: 24px; height: 24px; stroke-width: 2; }
  .filter-btn { display: flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 700; color: var(--c-dark); text-decoration: none; }
  .filter-btn svg { width: 20px; height: 20px; }

  /* Stats Scroller */
  .stats-scroller { display: flex; gap: 12px; padding: 0 16px 16px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid #f1f5f9; }
  .stats-scroller::-webkit-scrollbar { display: none; }
  
  .stat-card { width: 100px; flex-shrink: 0; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: white; }
  .stat-title { font-size: 10px; font-weight: 800; margin: 0; }
  .stat-bottom { display: flex; justify-content: space-between; align-items: flex-end; }
  .stat-num { font-size: 24px; font-weight: 800; color: var(--c-dark); line-height: 1; }
  .stat-icon { width: 20px; height: 20px; }
  
  .stat-card.overdue .stat-title { color: var(--c-red); }
  .stat-card.overdue .stat-icon { color: var(--c-red); }
  .stat-card.overdue { border-color: #fca5a5; box-shadow: 0 2px 4px rgba(239, 68, 68, 0.05); }

  .stat-card.today .stat-title { color: var(--c-orange); }
  .stat-card.today .stat-icon { color: var(--c-orange); }
  .stat-card.today { border-color: #fdba74; box-shadow: 0 2px 4px rgba(249, 115, 22, 0.05); }

  .stat-card.week .stat-title { color: var(--c-blue); }
  .stat-card.week .stat-icon { color: var(--c-blue); }
  .stat-card.week { border-color: #93c5fd; box-shadow: 0 2px 4px rgba(37, 99, 235, 0.05); }

  .stat-card.completed .stat-title { color: var(--c-green-dark); }
  .stat-card.completed .stat-icon { color: var(--c-green-dark); }
  .stat-card.completed { border-color: #6ee7b7; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.05); }

  /* Tabs */
  .tabs-scroller { display: flex; padding: 0 16px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid #e2e8f0; margin-bottom: 16px; }
  .tabs-scroller::-webkit-scrollbar { display: none; }
  .tab-item { white-space: nowrap; padding: 12px 16px; font-size: 13px; font-weight: 700; color: var(--c-gray); text-decoration: none; border-bottom: 2px solid transparent; }
  .tab-item.active { color: var(--c-green-dark); border-bottom-color: var(--c-green-dark); }

  /* Task Groups */
  .task-group { margin-bottom: 24px; }
  .group-header { display: flex; justify-content: space-between; align-items: center; padding: 0 16px; margin-bottom: 12px; }
  .gh-left { display: flex; align-items: center; gap: 8px; }
  .gh-title { font-size: 16px; font-weight: 800; color: var(--c-dark); margin: 0; }
  .gh-badge { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; font-size: 11px; font-weight: 800; color: white; }
  .gh-badge.r { background: var(--c-red); }
  .gh-badge.b { background: var(--c-blue); }
  
  .gh-view-all { font-size: 12px; font-weight: 700; color: var(--c-green-dark); text-decoration: none; }

  /* Task List */
  .task-list { display: flex; flex-direction: column; }
  .task-item { display: flex; gap: 12px; padding: 16px; border-bottom: 1px solid #f1f5f9; text-decoration: none; }
  .task-icon { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .task-icon.r { background: var(--c-red-light); color: var(--c-red); }
  .task-icon.g { background: var(--c-green-light); color: var(--c-green-dark); }
  .task-icon.p { background: var(--c-purple-light); color: var(--c-purple); }
  .task-icon.b { background: var(--c-blue-light); color: var(--c-blue); }
  .task-icon.o { background: var(--c-orange-light); color: var(--c-orange); }
  .task-icon svg { width: 22px; height: 22px; stroke-width: 2; }
  
  .task-content { flex: 1; min-width: 0; }
  .task-title { font-size: 14px; font-weight: 800; color: var(--c-dark); margin: 0 0 4px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .task-sub { font-size: 11px; color: var(--c-gray); margin: 0 0 2px 0; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .task-lead { font-size: 11px; color: var(--c-blue); margin: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  
  .task-right { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 8px; flex-shrink: 0; }
  .tr-time { font-size: 10px; font-weight: 800; }
  .tr-time.r { color: var(--c-red); }
  .tr-time.o { color: var(--c-orange); }
  .tr-time.b { color: var(--c-blue); }
  
  .tr-bottom { display: flex; align-items: center; gap: 8px; }
  .tr-badge { font-size: 9px; font-weight: 800; padding: 2px 8px; border-radius: 4px; }
  .tr-badge.r { background: var(--c-red-light); color: var(--c-red); }
  .tr-badge.o { background: var(--c-orange-light); color: var(--c-orange); }
  .tr-badge.g { background: var(--c-green-light); color: var(--c-green-dark); }
  .chevron { color: #cbd5e1; width: 16px; height: 16px; stroke-width: 2.5; }

  /* Floating Add Button */
  .fab-wrapper { position: fixed; bottom: 85px; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; padding: 0 16px; z-index: 90; }
  .fab-btn { width: 100%; background: var(--c-green-dark); color: white; border: none; border-radius: 12px; padding: 14px; font-size: 15px; font-weight: 800; display: flex; justify-content: center; align-items: center; gap: 8px; cursor: pointer; box-shadow: 0 4px 12px rgba(4, 120, 87, 0.2); }
  .fab-btn svg { width: 20px; height: 20px; }

  /* Bottom Nav */
  .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active { color: var(--c-dark); }
  .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }
  .nav-dot { position: absolute; top: 0; right: 2px; width: 8px; height: 8px; background: var(--c-red); border-radius: 50%; border: 2px solid white; }
</style>

<div class="mobile-app-container">

  <!-- Topbar -->
  <div class="t-topbar">
    <button class="icon-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1 class="t-title">Tasks</h1>
    <a href="javascript:void(0)" class="filter-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
      Filter
    </a>
  </div>

  <!-- Stats Scroller -->
  <div class="stats-scroller">
    <!-- Overdue -->
    <div class="stat-card overdue">
      <h3 class="stat-title">Overdue</h3>
      <div class="stat-bottom">
        <div class="stat-num">{{tasksData.overdue.length}}</div>
        <svg class="stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
    <!-- Due Today -->
    <div class="stat-card today">
      <h3 class="stat-title">Due Today</h3>
      <div class="stat-bottom">
        <div class="stat-num">{{tasksData.today.length}}</div>
        <svg class="stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <!-- This Week -->
    <div class="stat-card week">
      <h3 class="stat-title">This Week</h3>
      <div class="stat-bottom">
        <div class="stat-num">{{tasksData.week.length}}</div>
        <svg class="stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <!-- Completed -->
    <div class="stat-card completed">
      <h3 class="stat-title">Completed</h3>
      <div class="stat-bottom">
        <div class="stat-num">{{tasksData.completed.length}}</div>
        <svg class="stat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs-scroller">
    <a href="javascript:void(0)" class="tab-item active">All Tasks (27)</a>
    <a href="javascript:void(0)" class="tab-item">Follow Ups (15)</a>
    <a href="javascript:void(0)" class="tab-item">Meetings (6)</a>
    <a href="javascript:void(0)" class="tab-item">Other (6)</a>
  </div>

  <!-- Due Today Group -->
  <div class="task-group">
    <div class="group-header">
      <div class="gh-left">
        <h2 class="gh-title">Due Today</h2>
        <div class="gh-badge r">{{tasksData.today.length}}</div>
      </div>
      <a href="javascript:void(0)" class="gh-view-all">View All</a>
    </div>
    
    <div class="task-list">
      {{#each tasksData.today}}
      <a href="/advisor/tasks/{{this.id}}" class="task-item">
        <div class="task-icon g">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </div>
        <div class="task-content">
          <h3 class="task-title">{{this.title}}</h3>
          <p class="task-sub">{{this.description}}</p>
          <p class="task-lead">Lead: {{this.business_name}}</p>
        </div>
        <div class="task-right">
          <div class="tr-time o">Today</div>
          <div class="tr-bottom">
            <span class="tr-badge o">Medium</span>
            <svg class="chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
      {{else}}
      <div style="padding: 16px; text-align: center; color: var(--c-gray); font-size: 12px; font-weight: 600;">No tasks due today.</div>
      {{/each}}
    </div>
  </div>

  <!-- This Week Group -->
  <div class="task-group">
    <div class="group-header">
      <div class="gh-left">
        <h2 class="gh-title">This Week</h2>
        <div class="gh-badge b">{{tasksData.week.length}}</div>
      </div>
      <a href="javascript:void(0)" class="gh-view-all">View All</a>
    </div>
    
    <div class="task-list">
      {{#each tasksData.week}}
      <a href="/advisor/tasks/{{this.id}}" class="task-item">
        <div class="task-icon p">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <div class="task-content">
          <h3 class="task-title">{{this.title}}</h3>
          <p class="task-sub">{{this.description}}</p>
          <p class="task-lead" style="color:var(--c-gray);">{{this.due_date}}</p>
        </div>
        <div class="task-right">
          <div class="tr-time b">Upcoming</div>
          <div class="tr-bottom">
            <span class="tr-badge o">Medium</span>
            <svg class="chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
      {{else}}
      <div style="padding: 16px; text-align: center; color: var(--c-gray); font-size: 12px; font-weight: 600;">No tasks due later this week.</div>
      {{/each}}
    </div>
  </div>

  <!-- Overdue Group -->
  <div class="task-group" style="margin-bottom: 0;">
    <div class="group-header">
      <div class="gh-left">
        <h2 class="gh-title">Overdue</h2>
        <div class="gh-badge r">{{tasksData.overdue.length}}</div>
      </div>
      <a href="javascript:void(0)" class="gh-view-all">View All</a>
    </div>
    
    <div class="task-list">
      {{#each tasksData.overdue}}
      <a href="/advisor/tasks/{{this.id}}" class="task-item">
        <div class="task-icon r">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div class="task-content">
          <h3 class="task-title">{{this.title}}</h3>
          <p class="task-sub">{{this.description}}</p>
          <p class="task-lead" style="color:var(--c-gray);">{{this.due_date}}</p>
        </div>
        <div class="task-right">
          <div class="tr-time r">Overdue</div>
          <div class="tr-bottom">
            <span class="tr-badge r">High</span>
            <svg class="chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </a>
      {{else}}
      <div style="padding: 16px; text-align: center; color: var(--c-gray); font-size: 12px; font-weight: 600;">No overdue tasks.</div>
      {{/each}}
    </div>
  </div>

  <!-- Floating Add Button -->
  <div class="fab-wrapper">
    <button class="fab-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      Add New Task
    </button>
  </div>

</div>

<!-- Bottom Navigation -->
    <!-- BOTTOM NAV -->
    <div class="bottom-nav">
      <a href="/advisor/dashboard" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Home
      </a>
      <a href="/admin/leads" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Leads
      </a>
      <a href="/admin/assessments" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Assessments
      </a>
      <a href="/admin/opportunities" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        Opportunities
      </a>
      <a href="/advisor/profile" class="nav-item active">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        More
      </a>
    </div>