      <svg class="mic" id="copilot-send-btn" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="{{#unless leadId}}opacity:0.4;{{/unless}}cursor:pointer;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
    </div>
