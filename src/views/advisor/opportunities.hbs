<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} | CoverScore Advisor OS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800 font-sans pb-20">

  <!-- Mobile Header -->
  <header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="px-4 py-3 flex justify-between items-center">
      <h1 class="text-xl font-bold text-gray-900">My Opportunities</h1>
      <a href="/advisor/profile" class="text-gray-500 hover:text-gray-700">
        <i class="fas fa-user-circle text-2xl"></i>
      </a>
    </div>
  </header>

  <!-- Summary Strip -->
  <div class="bg-blue-600 text-white px-4 py-3 shadow-md flex justify-around text-sm font-medium">
    <div class="text-center">
      <span class="block text-xl font-bold">{{counts.due_today}}</span>
      <span class="text-blue-100">Due Today</span>
    </div>
    <div class="text-center">
      <span class="block text-xl font-bold">{{counts.high_priority}}</span>
      <span class="text-blue-100">High Priority</span>
    </div>
    <div class="text-center">
      <span class="block text-xl font-bold">{{counts.active}}</span>
      <span class="text-blue-100">Active</span>
    </div>
  </div>

  <!-- Filter Chips (Horizontally Scrollable) -->
  <div class="px-4 py-4 overflow-x-auto whitespace-nowrap flex space-x-2 scrollbar-hide">
    <a href="?filter=all" class="inline-block px-4 py-1.5 rounded-full text-sm font-medium {{#if (eq activeFilter 'all')}}bg-blue-100 text-blue-700 border border-blue-200{{else}}bg-white text-gray-600 border border-gray-200 hover:bg-gray-50{{/if}}">All</a>
    <a href="?filter=new" class="inline-block px-4 py-1.5 rounded-full text-sm font-medium {{#if (eq activeFilter 'new')}}bg-blue-100 text-blue-700 border border-blue-200{{else}}bg-white text-gray-600 border border-gray-200 hover:bg-gray-50{{/if}}">New</a>
    <a href="?filter=nurture" class="inline-block px-4 py-1.5 rounded-full text-sm font-medium {{#if (eq activeFilter 'nurture')}}bg-blue-100 text-blue-700 border border-blue-200{{else}}bg-white text-gray-600 border border-gray-200 hover:bg-gray-50{{/if}}">Nurture</a>
  </div>

  <!-- Opportunity List -->
  <main class="px-4 space-y-3 pb-6">
    {{#if opportunities.length}}
      {{#each opportunities}}
        <a href="/advisor/opportunities/{{this.id}}" class="block bg-white rounded-lg shadow-sm border border-gray-100 p-4 hover:shadow-md transition-shadow relative overflow-hidden">
          <!-- Priority Indicator Bar -->
          <div class="absolute left-0 top-0 bottom-0 w-1.5 {{this.badgeClass}}"></div>
          
          <div class="flex justify-between items-start mb-2 pl-2">
            <div>
              <h2 class="text-lg font-bold text-gray-900">{{this.lead_initial}} <span class="text-gray-400 text-sm font-normal">#{{this.id}}</span></h2>
              <p class="text-sm text-gray-600">Score: {{this.score}}/100 ({{this.score_band}})</p>
            </div>
            <span class="text-xs font-semibold px-2 py-1 rounded {{#if (eq this.opportunity_priority 'Urgent')}}bg-red-100 text-red-700{{else}}{{#if (eq this.opportunity_priority 'High')}}bg-orange-100 text-orange-700{{else}}bg-blue-100 text-blue-700{{/if}}{{/if}}">
              {{this.opportunity_priority}}
            </span>
          </div>
          
          <div class="pl-2 mt-3 space-y-1">
            <p class="text-sm font-medium text-gray-800"><i class="fas fa-exclamation-circle text-gray-400 w-5"></i> {{this.top_priority}}</p>
            <p class="text-sm text-gray-600"><i class="fab fa-whatsapp text-green-500 w-5"></i> {{this.contact_preference}}</p>
          </div>

          <div class="mt-4 pl-2 pt-3 border-t border-gray-100 flex justify-between items-center">
            <span class="text-sm font-semibold text-blue-600">{{this.nextAction}}</span>
            <i class="fas fa-chevron-right text-gray-300"></i>
          </div>
        </a>
      {{/each}}
    {{else}}
      <div class="text-center py-12 bg-white rounded-lg border border-dashed border-gray-300">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-100 mb-4">
          <i class="fas fa-check text-gray-400 text-xl"></i>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-1">You are up to date</h3>
        <p class="text-gray-500 text-sm px-6">There are no opportunities requiring action right now.</p>
        <a href="?filter=nurture" class="mt-4 inline-block text-blue-600 text-sm font-medium hover:underline">View Nurture Opportunities</a>
      </div>
    {{/if}}
  </main>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 flex justify-around pb-safe">
    <a href="/advisor/dashboard" class="flex flex-col items-center py-3 px-2 text-gray-500 hover:text-blue-600 w-1/4">
      <i class="fas fa-home text-xl mb-1"></i>
      <span class="text-[10px] font-medium uppercase tracking-wider">Home</span>
    </a>
    <a href="/advisor/opportunities" class="flex flex-col items-center py-3 px-2 text-blue-600 border-t-2 border-blue-600 -mt-[1px] w-1/4">
      <i class="fas fa-briefcase text-xl mb-1"></i>
      <span class="text-[10px] font-medium uppercase tracking-wider">Opps</span>
    </a>
    <a href="/advisor/tasks" class="flex flex-col items-center py-3 px-2 text-gray-500 hover:text-blue-600 w-1/4">
      <i class="fas fa-check-square text-xl mb-1"></i>
      <span class="text-[10px] font-medium uppercase tracking-wider">Tasks</span>
    </a>
    <a href="/advisor/team-queue" class="flex flex-col items-center py-3 px-2 text-gray-500 hover:text-blue-600 w-1/4">
      <i class="fas fa-users text-xl mb-1"></i>
      <span class="text-[10px] font-medium uppercase tracking-wider">Team</span>
    </a>
  </nav>

</body>
</html>
