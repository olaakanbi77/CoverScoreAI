<script>
async function enrollFromHome(courseId, btn) {
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = '...';
  try {
    const res = await fetch('/advisor/api/academy/enroll/' + courseId, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      window.showToast(data.message || 'Enrolled!');
      setTimeout(() => window.location.href = '/advisor/academy/course/' + courseId, 600);
    } else {
      window.showToast(data.error || 'Failed to enroll', 'error');
      btn.disabled = false;
      btn.textContent = original;
    }
  } catch (e) {
    window.showToast('Network error', 'error');
    btn.disabled = false;
    btn.textContent = original;
  }
}
</script>