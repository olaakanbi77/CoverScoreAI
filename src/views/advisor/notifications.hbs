<style>
  :root {
    --c-green: #10b981;
    --c-green-dark: #047857;
    --c-green-light: #ecfdf5;
    --c-orange: #f59e0b;
    --c-orange-light: #fffbeb;
    --c-blue: #3b82f6;
    --c-blue-light: #eff6ff;
    --c-purple: #8b5cf6;
    --c-purple-light: #f5f3ff;
    --c-red: #ef4444;
    --c-red-light: #fef2f2;
    --c-teal: #14b8a6;
    --c-teal-light: #f0fdfa;
    --c-indigo: #6366f1;
    --c-indigo-light: #e0e7ff;
    --c-dark: #0f172a;
    --c-gray: #64748b;
    --text-sec: #64748b;
    --c-gray-light: #f8fafc;
    --bg-page: #ffffff;
  }

  /* Override Admin Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  
  body {
    background-color: var(--bg-page);
    font-family: 'Inter', sans-serif;
  }

  .mobile-app-container {
    max-width: 480px;
    margin: 0 auto;
    background: #ffffff;
    min-height: 100vh;
    box-shadow: 0 0 20px rgba(0,0,0,0.05);
    position: relative;
    padding-bottom: 90px;
  }

  .notifications-page {
    padding: 24px 16px;
    color: var(--c-dark);
  }

  /* Header */
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
  }
  .header-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .btn-filter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--c-dark);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    margin-left: auto;
  }

  /* Filter Chips */
  .filter-chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 16px;
    margin-bottom: 12px;
    scrollbar-width: none;
  }
  .filter-chips::-webkit-scrollbar { display: none; }
  
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    font-size: 13px;
    font-weight: 600;
    color: var(--c-gray);
    white-space: nowrap;
    text-decoration: none;
  }
  .chip.active {
    border-color: var(--c-green);
    color: var(--c-green-dark);
    background: var(--c-green-light);
  }
  .chip-badge {
    background: #f1f5f9;
    color: var(--c-gray);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 10px;
  }
  .chip.active .chip-badge {
    background: var(--c-green);
    color: white;
  }

  /* Sections */
  .section-title {
    font-size: 15px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 24px 0 16px 0;
  }
  .section-title:first-of-type { margin-top: 8px; }

  /* Notification Item */
  .notif-card {
    background: white;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    position: relative;
    text-decoration: none;
  }
  .notif-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .notif-icon-wrap svg { width: 20px; height: 20px; }
  
  .c-green .notif-icon-wrap { background: var(--c-green-light); color: var(--c-green); }
  .c-blue .notif-icon-wrap { background: var(--c-blue-light); color: var(--c-blue); }
  .c-purple .notif-icon-wrap { background: var(--c-purple-light); color: var(--c-purple); }
  .c-orange .notif-icon-wrap { background: var(--c-orange-light); color: var(--c-orange); }
  .c-red .notif-icon-wrap { background: var(--c-red-light); color: var(--c-red); }
  .c-teal .notif-icon-wrap { background: var(--c-teal-light); color: var(--c-teal); }
  .c-indigo .notif-icon-wrap { background: var(--c-indigo-light); color: var(--c-indigo); }

  .notif-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 24px;
  }
  .notif-title {
    font-size: 14px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0 0 4px 0;
  }
  .notif-desc {
    font-size: 12px;
    color: var(--c-gray);
    line-height: 1.4;
    margin: 0;
  }
  .notif-desc strong {
    color: var(--c-dark);
    font-weight: 700;
  }
  .notif-desc .t-green { color: var(--c-green-dark); font-weight: 700; }
  
  .notif-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    font-size: 11px;
    font-weight: 600;
  }
  .notif-meta.t-green { color: var(--c-green); }

  .notif-right {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .notif-time {
    font-size: 10px;
    color: var(--c-gray);
    font-weight: 600;
  }
  .unread-dot {
    width: 8px;
    height: 8px;
    background: var(--c-green);
    border-radius: 50%;
  }

  /* Preference Card */
  .pref-card {
    background: var(--c-green-light);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }
  .pref-icon {
    width: 40px;
    height: 40px;
    background: transparent;
    color: var(--c-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pref-icon svg { width: 28px; height: 28px; }
  .pref-text { flex-grow: 1; }
  .pref-text h4 {
    font-size: 13px;
    font-weight: 800;
    color: var(--c-green-dark);
    margin: 0 0 2px 0;
  }
  .pref-text p {
    font-size: 11px;
    color: #065f46;
    margin: 0;
    line-height: 1.4;
  }
  .btn-pref {
    background: transparent;
    border: 1px solid var(--c-green);
    color: var(--c-green-dark);
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Icons */
  .icon-sm { width: 14px; height: 14px; }
  .icon-md { width: 18px; height: 18px; }
  .chevron-right { color: var(--c-gray); margin-top: 12px; }

  /* Bottom Nav */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 0 24px 0;
    border-top: 1px solid #e2e8f0;
    z-index: 100;
  }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active {
    color: var(--c-green);
  }
  .nav-item svg {
    width: 24px;
    height: 24px;
    stroke-width: 2;
  }
  .nav-badge {
    position: absolute;
    top: -2px;
    right: 6px;
    background: var(--c-red);
    color: white;
    font-size: 9px;
    font-weight: 800;
    min-width: 14px;
    height: 14px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 2px solid white;
  }
</style>

