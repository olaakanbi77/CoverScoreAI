<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Advisor Dashboard - CoverScore</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #0F172A;
      --navy-light: #1E293B;
      --green: #108A43; /* Matches the dark green card in screenshot */
      --green-light: #16A34A; /* Logo score green */
      --green-bg: #F0FDF4;
      --orange: #F97316;
      --orange-bg: #FFF7ED;
      --blue: #3B82F6;
      --blue-bg: #EFF6FF;
      --purple: #8B5CF6;
      --purple-bg: #F5F3FF;
      --bg: #F9FAFB;
      --card: #FFFFFF;
      --border: #F1F5F9;
      --text: #0F172A;
      --text-sec: #64748B;
      --font: 'Inter', system-ui, sans-serif;
    }
    
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: var(--font);
      background-color: #E2E8F0; /* Darker bg outside the app container on desktop */
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    .app-container {
      max-width: 480px;
      margin: 0 auto;
      background-color: var(--bg);
      min-height: 100vh;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* TOP BAR */
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .menu-btn {
      background: none; border: none; color: var(--navy); cursor: pointer;
    }
    .brand {
      font-size: 20px; font-weight: 800; letter-spacing: -0.5px;
    }
    .brand-cover { color: var(--navy); }
    .brand-score { color: var(--green-light); }
    .notification-btn {
      background: none; border: none; color: var(--navy); cursor: pointer; position: relative;
    }
    .notif-badge {
      position: absolute;
      top: -2px; right: -4px;
      background: #EF4444; color: white;
      font-size: 10px; font-weight: 700;
      width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      border: 2px solid var(--bg);
    }

    .main-content {
      padding: 0 20px 100px;
      flex: 1;
      overflow-y: auto;
    }

    /* PROFILE SECTION */
    .profile-section {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 8px;
      margin-bottom: 16px;
    }
    .avatar {
      width: 56px; height: 56px;
      border-radius: 50%;
      background: var(--green-light);
      display: flex; align-items: center; justify-content: center;
      color: white; font-weight: 700; font-size: 20px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
      flex-shrink: 0;
      overflow: hidden;
    }
    .avatar img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .profile-text .greeting {
      font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 2px;
    }
    .profile-text .date {
      font-size: 12px; font-weight: 500; color: var(--text-sec); margin-bottom: 2px;
    }
    .profile-text .subtitle {
      font-size: 12px; color: var(--text-sec);
    }

    /* PIPELINE CARD */
    .pipeline-card {
      background: var(--green);
      border-radius: 20px;
      padding: 16px;
      color: white;
      margin-bottom: 20px;
      box-shadow: 0 10px 25px rgba(16, 138, 67, 0.25);
    }
    .pipeline-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 16px;
    }
    .pipeline-title {
      display: flex; align-items: center; gap: 12px;
    }
    .pipeline-icon-circle {
      width: 40px; height: 40px; border-radius: 50%; background: white;
      display: flex; align-items: center; justify-content: center; color: var(--green);
    }
    .pipeline-title h2 { font-size: 16px; font-weight: 700; margin-bottom: 2px; }
    .pipeline-title p { font-size: 12px; opacity: 0.9; }
    .view-all-btn {
      background: rgba(255,255,255,0.2); border: none; color: white;
      padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
      text-decoration: none; display: inline-block;
    }

    .pipeline-stats {
      display: flex; justify-content: space-between;
    }
    .stat-col {
      display: flex; flex-direction: column; gap: 4px;
      flex: 1; padding: 0 4px;
    }
    .stat-col.divider {
      border-left: 1px solid rgba(255,255,255,0.2);
      padding-left: 12px;
    }
    .stat-top {
      display: flex; align-items: center; gap: 8px;
    }
    .stat-value {
      font-size: 24px; font-weight: 800; line-height: 1;
    }
    .stat-meta-icon {
      width: 24px; height: 24px; border-radius: 50%; background: white;
      display: flex; align-items: center; justify-content: center; color: var(--green);
      flex-shrink: 0;
    }
    .stat-label { font-size: 11px; font-weight: 600; line-height: 1.3; margin-top: 2px; }

    /* SECTIONS */
    .section-title {
      font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 12px;
    }
    .section-title.green { color: var(--green); }

    /* NEXT ACTION */
    .next-action-container { margin-bottom: 20px; }
    .action-card {
      background: var(--card); border-radius: 16px; padding: 12px 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }
    .action-header {
      display: flex; align-items: center; gap: 12px; margin-bottom: 12px;
    }
    .action-icon {
      width: 48px; height: 48px; border-radius: 50%; background: var(--green-bg);
      display: flex; align-items: center; justify-content: center; color: var(--green-light);
    }
    .action-details { flex: 1; }
    .action-details h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 2px; }
    .action-details p { font-size: 12px; color: var(--text-sec); margin-bottom: 4px; }
    .action-badge {
      display: inline-block; background: var(--orange-bg); color: var(--orange);
      font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 12px;
    }
    .action-chevron { color: var(--text-sec); }
    .btn-generate {
      width: 100%; background: var(--green); color: white; border: none;
      padding: 12px; border-radius: 12px; font-size: 13px; font-weight: 600;
      cursor: pointer;
    }

    /* QUICK ACTIONS */
    .quick-actions-container { margin-bottom: 20px; }
    .qa-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
    }
    .qa-item {
      background: var(--card); border-radius: 16px; padding: 12px 6px;
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03); cursor: pointer; text-decoration: none;
    }
    .qa-icon {
      width: 44px; height: 44px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .qa-icon.green { background: var(--green-bg); color: var(--green-light); }
    .qa-icon.blue { background: var(--blue-bg); color: var(--blue); }
    .qa-icon.purple { background: var(--purple-bg); color: var(--purple); }
    .qa-icon.orange { background: var(--orange-bg); color: var(--orange); }
    .qa-label { font-size: 12px; font-weight: 600; color: var(--navy); line-height: 1.2; }

    /* RECENT ACTIVITY */
    .recent-activity-container { margin-bottom: 20px; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .view-all-link { font-size: 13px; font-weight: 600; color: var(--green); text-decoration: none; }
    .activity-list {
      background: var(--card); border-radius: 16px; padding: 0 16px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    .activity-item {
      display: flex; align-items: center; gap: 16px; padding: 10px 0;
      border-bottom: 1px solid var(--border);
    }
    .activity-item:last-child { border-bottom: none; }
    /* CSS trick to hide items beyond 3 */
    .activity-item:nth-child(n+4) { display: none; }
    
    .act-icon {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .act-icon.green { background: var(--green-bg); color: var(--green-light); border: 1px solid #DCFCE7; }
    .act-icon.blue { background: var(--blue-bg); color: var(--blue); border: 1px solid #DBEAFE; }
    .act-icon.orange { background: var(--orange-bg); color: var(--orange); border: 1px solid #FFEDD5; }
    
    .act-details { flex: 1; }
    .act-details h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 2px; }
    .act-details p { font-size: 12px; color: var(--text-sec); }
    .act-meta { display: flex; align-items: center; gap: 12px; }
    .act-time { font-size: 11px; color: var(--text-sec); }
    .act-chevron { color: #CBD5E1; }

    /* BOTTOM NAV */
    .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
    .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
    .nav-item.active { color: var(--green); }
    .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }

  </style>
</head>
<body>

  <div class="app-container">
    
    <!-- TOP BAR -->
    <header class="top-bar">
      <button class="menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="brand">
        <span class="brand-cover">Cover</span><span class="brand-score">Score</span>
      </div>
      <a href="/advisor/notifications" class="notification-btn" style="text-decoration:none;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="notif-badge">3</span>
      </a>
    </header>

    <main class="main-content">
      
      <!-- PROFILE -->
      <div class="profile-section">
        <div class="avatar">
          <!-- Placeholder avatar if no image -->
          <img src="/img/avatar.png" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" alt="Avatar">
          <span style="display:none;">{{userInitials user.name}}</span>
        </div>
        <div class="profile-text">
          <h1 class="greeting">Good Morning, {{#if user.name}}{{user.name}}{{else}}Ayo{{/if}} 👋</h1>
          <p class="date"><script>document.write(new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric'}).format(new Date()))</script></p>
          <p class="subtitle">Let's close some deals today.</p>
        </div>
      </div>

      <!-- PIPELINE CARD -->
      <div class="pipeline-card">
        <div class="pipeline-header">
          <div class="pipeline-title">
            <div class="pipeline-icon-circle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
              <h2>Today's Pipeline</h2>
              <p>Your overview for today</p>
            </div>
          </div>
          <a href="/advisor/pipeline" class="view-all-btn">View All ></a>
        </div>
        
        <div class="pipeline-stats">
          <div class="stat-col">
            <div class="stat-top">
              <div class="stat-value">{{#if summary.newLeads}}{{summary.newLeads}}{{else}}12{{/if}}</div>
              <div class="stat-meta-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            </div>
            <div class="stat-label">New Leads</div>
          </div>
          <div class="stat-col divider">
            <div class="stat-top">
              <div class="stat-value">{{#if summary.assessmentsPending}}{{summary.assessmentsPending}}{{else}}8{{/if}}</div>
              <div class="stat-meta-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg></div>
            </div>
            <div class="stat-label">Assessments Pending</div>
          </div>
          <div class="stat-col divider">
            <div class="stat-top">
              <div class="stat-value">{{#if summary.estPremium}}{{summary.estPremium}}{{else}}₦2.5M{{/if}}</div>
              <div class="stat-meta-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
            </div>
            <div class="stat-label">Potential Premium</div>
          </div>
        </div>
      </div>

      <!-- NEXT ACTION -->
      <div class="next-action-container">
        <h3 class="section-title green">Next Action Required</h3>
        <div class="action-card">
          <div class="action-header">
            <div class="action-icon">
              <!-- Hospital Icon -->
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 21V9a2 2 0 0 0-2-2h-2V3a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v4H4a2 2 0 0 0-2 2v12"/><path d="M22 21H2"/><path d="M12 9v4"/><path d="M10 11h4"/></svg>
            </div>
            <div class="action-details">
              <h4>{{#if selectedLead}}{{selectedLead.business_name}}{{else}}Greenfield Hospital{{/if}}</h4>
              <p>Assessment Completed</p>
              <span class="action-badge">Waiting for Quote</span>
            </div>
            <div class="action-chevron">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </div>
          {{#if selectedLead}}
          <a href="/advisor/quote-builder/{{selectedLead.id}}" style="text-decoration:none;">
            <button class="btn-generate">Build Quote</button>
          </a>
          {{else}}
          <button class="btn-generate" onclick="window.location.href='/advisor/dashboard'">Build Quote</button>
          {{/if}}
        </div>
      </div>

      <!-- QUICK ACTIONS -->
      <div class="quick-actions-container">
        <h3 class="section-title">Quick Actions</h3>
        <div class="qa-grid">
          <a href="/assessment/start" class="qa-item">
            <div class="qa-icon green">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </div>
            <span class="qa-label">New Lead</span>
          </a>
          <a href="/assessment/start" class="qa-item">
            <div class="qa-icon blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="12" y1="11" x2="16" y2="11"/><line x1="14" y1="9" x2="14" y2="13"/></svg>
            </div>
            <span class="qa-label">New Assessment</span>
          </a>
          <a href="/advisor/quote-builder/{{#if selectedLead}}{{selectedLead.id}}{{else}}0{{/if}}" class="qa-item">
            <div class="qa-icon purple">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M10.42 12.61a2.1 2.1 0 1 1 2.97 2.97L7.95 21 4 22l.99-3.95 5.43-5.44Z"/></svg>
            </div>
            <span class="qa-label">Build Quote</span>
          </a>
          <a href="/admin/opportunities" class="qa-item">
            <div class="qa-icon orange">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span class="qa-label">Follow Up</span>
          </a>
          <a href="/advisor/copilot{{#if selectedLead}}?lead={{selectedLead.id}}{{/if}}" class="qa-item">
            <div class="qa-icon purple">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2zm6.5 1.5l1 3.5 3.5 1-3.5 1-1 3.5-1-3.5-3.5-1 3.5-1 1-3.5z"/></svg>
            </div>
            <span class="qa-label">Copilot</span>
          </a>
        </div>
      </div>

      <!-- RECENT ACTIVITY -->
      <div class="recent-activity-container">
        <div class="flex-between">
          <h3 class="section-title" style="margin:0;">Recent Activity</h3>
          <a href="/admin/leads" class="view-all-link">View All</a>
        </div>
        <div class="activity-list">
          {{#if leads.length}}
            {{#each leads}}
              {{#if (lte @index 2)}}
              <div class="activity-item">
                <div class="act-icon {{#if (eq this.status 'New Lead')}}orange{{else if (eq this.status 'Assessment Completed')}}green{{else}}blue{{/if}}">
                  {{#if (eq this.status 'New Lead')}}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                  {{else if (eq this.status 'Assessment Completed')}}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
                  {{else}}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                  {{/if}}
                </div>
                <div class="act-details">
                  <h4>{{this.business_name}}</h4>
                  <p>{{this.status}}</p>
                </div>
                <div class="act-meta">
                  <span class="act-time">{{#if this.last_activity}}Yesterday{{else}}Today{{/if}}</span>
                  <span class="act-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></span>
                </div>
              </div>
              {{/if}}
            {{/each}}
          {{else}}
            <div class="activity-item" style="justify-content: center; padding: 30px 0; border: none;">
              <div style="text-align: center; color: var(--text-sec);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.5;">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
                <p style="font-size: 13px;">No recent activity found.</p>
              </div>
            </div>
          {{/if}}
        </div>
      </div>

    </main>

    <!-- BOTTOM NAV -->
    <div class="bottom-nav">
      <a href="/advisor/dashboard" class="nav-item active">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Home
      </a>
      <a href="/admin/leads" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Leads
      </a>
      <a href="/admin/assessments" class="nav-item">
