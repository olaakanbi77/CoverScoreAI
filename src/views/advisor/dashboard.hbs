<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Advisor Dashboard - CoverScore AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0B1F3A;
      --navy-light: #132a4a;
      --green: #16A34A;
      --green-hover: #15803D;
      --success: #22C55E;
      --orange: #F59E0B;
      --red: #EF4444;
      --bg: #F8FAFC;
      --card: #FFFFFF;
      --border: #E5E7EB;
      --text: #111827;
      --text-secondary: #6B7280;
      --text-muted: #9CA3AF;
      --sidebar-width: 260px;
      --col1-width: 380px;
      --col3-width: 380px;
      --radius: 12px;
      --radius-sm: 8px;
      --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --font: 'Inter', system-ui, -apple-system, sans-serif;
    }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
      font-size: 14px;
    }
    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, #0B1F3A 0%, #0a1a30 100%);
      color: white;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 100;
    }
    .sidebar-brand {
      padding: 24px 20px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .brand-name { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
    .brand-name span { color: var(--green); }
    .brand-badge {
      display: inline-block;
      background: var(--green);
      color: white;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      vertical-align: super;
      margin-left: 2px;
    }
    .brand-subtitle { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 4px; letter-spacing: 0.3px; }
    .sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
    .sidebar-nav::-webkit-scrollbar { width: 3px; }
    .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.15s;
      border-left: 3px solid transparent;
      cursor: pointer;
    }
    .nav-item:hover { color: white; background: rgba(255,255,255,0.04); }
    .nav-item.active {
      color: white;
      background: rgba(22, 163, 74, 0.15);
      border-left-color: var(--green);
    }
    .nav-item svg { width: 20px; height: 20px; flex-shrink: 0; opacity: 0.7; }
    .nav-item.active svg { opacity: 1; }
    .nav-section-label {
      padding: 16px 20px 6px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.3);
    }
    .sidebar-summary {
      margin: 12px 16px;
      padding: 16px;
      background: rgba(255,255,255,0.05);
      border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .summary-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(255,255,255,0.4); margin-bottom: 12px; }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .summary-item { }
    .summary-label { font-size: 11px; color: rgba(255,255,255,0.4); }
    .summary-value { font-size: 15px; font-weight: 700; color: white; }
    .summary-premium { margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06); }
    .summary-premium .summary-label { font-size: 10px; }
    .summary-premium .summary-value { font-size: 18px; color: var(--green); }
    .sidebar-profile {
      padding: 16px 20px;
      border-top: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .profile-avatar {
      width: 40px; height: 40px; border-radius: 50%;
      background: var(--green);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 16px; color: white;
      flex-shrink: 0;
    }
    .profile-info { min-width: 0; }
    .profile-name { font-size: 13px; font-weight: 600; color: white; }
    .profile-role { font-size: 11px; color: rgba(255,255,255,0.4); }
    .main-wrapper {
      margin-left: var(--sidebar-width);
      display: flex;
      flex: 1;
      height: 100vh;
      overflow: hidden;
    }
    .col-leads {
      width: var(--col1-width);
      flex-shrink: 0;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      background: var(--card);
    }
    .col-center {
      flex: 1;
      min-width: 0;
      overflow-y: auto;
      padding: 24px;
      background: var(--bg);
    }
    .col-center::-webkit-scrollbar { width: 6px; }
    .col-center::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }
    .col-whatsapp {
      width: var(--col3-width);
      flex-shrink: 0;
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      background: var(--card);
    }
    .col-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .col-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); }
    .col-tabs { display: flex; gap: 4px; }
    .col-tab {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      transition: all 0.15s;
    }
    .col-tab:hover { background: var(--bg); }
    .col-tab.active { background: var(--green); color: white; }
    .lead-queue { flex: 1; overflow-y: auto; padding: 12px; }
    .lead-queue::-webkit-scrollbar { width: 4px; }
    .lead-queue::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }
    .lead-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 10px;
      cursor: pointer;
      transition: all 0.15s;
      position: relative;
    }
    .lead-card:hover { box-shadow: var(--shadow-md); border-color: #d1d5db; }
    .lead-card.selected { border-color: var(--red); box-shadow: 0 0 0 1px var(--red); }
    .lead-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .lead-card-company { display: flex; align-items: center; gap: 10px; }
    .lead-avatar {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 14px; color: white;
      flex-shrink: 0;
    }
    .lead-card-name { font-size: 14px; font-weight: 600; color: var(--text); }
    .lead-badge {
      display: inline-block;
      font-size: 9px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 2px 8px; border-radius: 4px;
    }
    .lead-badge.hot { background: rgba(239,68,68,0.1); color: var(--red); }
    .lead-badge.warm { background: rgba(245,158,11,0.1); color: var(--orange); }
    .lead-badge.follow-up { background: rgba(107,114,128,0.1); color: var(--text-secondary); }
    .lead-card-score {
      display: flex; align-items: center; gap: 6px; margin-bottom: 8px;
    }
    .score-ring {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700;
      flex-shrink: 0;
    }
    .score-ring.high { background: rgba(239,68,68,0.1); color: var(--red); }
    .score-ring.medium { background: rgba(245,158,11,0.1); color: var(--orange); }
    .score-ring.low { background: rgba(34,197,94,0.1); color: var(--success); }
    .risk-label { font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .risk-label.high { color: var(--red); }
    .risk-label.medium { color: var(--orange); }
    .risk-label.low { color: var(--success); }
    .lead-card-premium { font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; }
    .lead-card-footer { display: flex; justify-content: space-between; align-items: center; }
    .lead-card-action {
      font-size: 11px; font-weight: 600; color: var(--green);
      background: rgba(22,163,74,0.08);
      padding: 4px 10px; border-radius: 6px;
    }
    .lead-card-time { font-size: 11px; color: var(--text-muted); }

    .section-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 16px;
      overflow: hidden;
    }
    .section-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); }
    .section-body { padding: 18px; }

    .intel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .intel-item { }
    .intel-label { font-size: 11px; color: var(--text-muted); margin-bottom: 2px; }
    .intel-value { font-size: 14px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 6px; }
    .intel-score {
      display: flex; align-items: center; gap: 10px;
      grid-column: 1 / -1;
      background: rgba(22,163,74,0.05);
      border: 1px solid rgba(22,163,74,0.2);
      border-radius: var(--radius-sm);
      padding: 14px 16px;
    }
    .score-gauge {
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--green);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 800; color: white;
      flex-shrink: 0;
    }
    .score-gauge-info { }
    .score-gauge-label { font-size: 11px; color: var(--text-secondary); }
    .score-gauge-value { font-size: 22px; font-weight: 800; color: var(--text); }

    .profile-row { display: flex; gap: 8px; margin-bottom: 10px; }
    .profile-row:last-child { margin-bottom: 0; }
    .profile-row-label { width: 100px; font-size: 12px; color: var(--text-muted); flex-shrink: 0; }
    .profile-row-value { font-size: 13px; color: var(--text); }

    .risk-bar-item { margin-bottom: 12px; }
    .risk-bar-item:last-child { margin-bottom: 0; }
    .risk-bar-header { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .risk-bar-name { font-size: 12px; color: var(--text-secondary); }
    .risk-bar-score { font-size: 12px; font-weight: 600; color: var(--text); }
    .risk-bar-track {
      height: 6px; background: #F3F4F6; border-radius: 10px; overflow: hidden;
    }
    .risk-bar-fill { height: 100%; border-radius: 10px; transition: width 0.3s; }
    .risk-bar-fill.critical { background: var(--red); }
    .risk-bar-fill.high { background: var(--orange); }
    .risk-bar-fill.medium { background: #F59E0B; }
    .risk-bar-fill.low { background: var(--success); }

    .gap-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 0; border-bottom: 1px solid #F3F4F6;
      font-size: 13px; color: var(--red); font-weight: 500;
    }
    .gap-item:last-child { border-bottom: none; }
    .gap-icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--red); }

    .notes-textarea {
      width: 100%; min-height: 80px;
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 12px; font-family: var(--font); font-size: 13px;
      color: var(--text); resize: vertical;
      background: var(--card);
    }
    .notes-textarea:focus { outline: none; border-color: var(--green); }

    .chat-area { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
    .chat-area::-webkit-scrollbar { width: 4px; }
    .chat-area::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }
    .chat-msg { max-width: 85%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.5; }
    .chat-msg.client {
      align-self: flex-start;
      background: #F3F4F6;
      color: var(--text);
      border-bottom-left-radius: 4px;
    }
    .chat-msg.advisor {
      align-self: flex-end;
      background: var(--green);
      color: white;
      border-bottom-right-radius: 4px;
    }
    .chat-msg-time { font-size: 10px; color: rgba(0,0,0,0.35); margin-top: 4px; text-align: right; }
    .chat-msg.advisor .chat-msg-time { color: rgba(255,255,255,0.6); }
    .chat-input-area {
      padding: 12px 16px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .chat-input {
      flex: 1;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 10px 16px;
      font-family: var(--font);
      font-size: 13px;
      background: var(--bg);
    }
    .chat-input:focus { outline: none; border-color: var(--green); }
    .chat-btn {
      width: 36px; height: 36px;
      border-radius: 50%;
      border: none;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      background: var(--bg);
      color: var(--text-secondary);
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .chat-btn:hover { background: var(--green); color: white; }
    .chat-btn.send { background: var(--green); color: white; }
    .chat-btn.send:hover { background: var(--green-hover); }

    .ai-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 0; border-bottom: 1px solid #F3F4F6;
    }
    .ai-item:last-child { border-bottom: none; }
    .ai-item-name { font-size: 13px; font-weight: 500; }
    .ai-item-priority {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      padding: 2px 8px; border-radius: 4px;
    }
    .ai-item-priority.high { background: rgba(239,68,68,0.1); color: var(--red); }
    .ai-item-priority.medium { background: rgba(245,158,11,0.1); color: var(--orange); }
    .ai-item-priority.low { background: rgba(34,197,94,0.1); color: var(--success); }

    .tp-item {
      display: flex; align-items: flex-start; gap: 8px;
      padding: 8px 0; border-bottom: 1px solid #F3F4F6;
      font-size: 13px; color: var(--text-secondary);
    }
    .tp-item:last-child { border-bottom: none; }
    .tp-item svg { width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; color: var(--green); }
    .tp-view-more {
      display: block; width: 100%;
      padding: 10px; margin-top: 8px;
      text-align: center; font-size: 12px; font-weight: 600;
      color: var(--green); background: rgba(22,163,74,0.06);
      border: 1px dashed rgba(22,163,74,0.3);
      border-radius: var(--radius-sm);
      cursor: pointer; transition: all 0.15s;
    }
    .tp-view-more:hover { background: rgba(22,163,74,0.1); }

    .action-panel { display: flex; flex-direction: column; gap: 8px; }
    .action-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 12px;
      border: none; border-radius: var(--radius-sm);
      font-size: 14px; font-weight: 600;
      cursor: pointer; transition: all 0.15s;
      font-family: var(--font);
    }
    .action-btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .action-btn.green { background: var(--green); color: white; }
    .action-btn.blue { background: #2563EB; color: white; }
    .action-btn.orange { background: var(--orange); color: white; }
    .action-btn.red { background: var(--red); color: white; }

    .wa-status { display: flex; align-items: center; gap: 6px; }
    .wa-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; }

    .svg-icon { width: 20px; height: 20px; flex-shrink: 0; }
    .svg-icon-sm { width: 16px; height: 16px; }

    .lead-intel-card {
      border: 1px solid rgba(22,163,74,0.3);
      background: linear-gradient(135deg, rgba(22,163,74,0.03), rgba(22,163,74,0.06));
    }

    .flex { display: flex; }
    .items-center { align-items: center; }
    .gap-2 { gap: 8px; }
    .gap-3 { gap: 12px; }
    .gap-4 { gap: 16px; }
    .justify-between { justify-content: space-between; }
    .text-muted { color: var(--text-muted); }
    .text-secondary { color: var(--text-secondary); }
    .text-sm { font-size: 12px; }
    .text-xs { font-size: 11px; }
    .font-semibold { font-weight: 600; }
    .font-bold { font-weight: 700; }
    .mt-2 { margin-top: 8px; }
    .mt-4 { margin-top: 16px; }
    .mb-2 { margin-bottom: 8px; }
    .mb-4 { margin-bottom: 16px; }
    .w-full { width: 100%; }
  </style>
</head>
