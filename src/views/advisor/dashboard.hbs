      </a>
      <a href="/admin/settings" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </a>
    </nav>
    <div class="sidebar-summary">
      <div class="summary-title">Today's Summary</div>
      <div class="summary-grid">
        <div class="summary-item"><div class="summary-label">Hot Leads</div><div class="summary-value">5</div></div>
        <div class="summary-item"><div class="summary-label">Consultations</div><div class="summary-value">3</div></div>
        <div class="summary-item"><div class="summary-label">Proposals Sent</div><div class="summary-value">4</div></div>
        <div class="summary-item"><div class="summary-label">Policies Sold</div><div class="summary-value">2</div></div>
      </div>
      <div class="summary-premium">
        <div class="summary-label">Estimated Premium</div>
        <div class="summary-value">₦3.8M</div>
      </div>
    </div>
    <div class="sidebar-profile">
      <div class="profile-avatar">{{userInitials user.name}}</div>
      <div class="profile-info">
        <div class="profile-name">{{user.name}}</div>
        <div class="profile-role">Senior Advisor</div>
      </div>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <div class="main-wrapper">

    <!-- COLUMN 1: LEAD QUEUE -->
    <div class="col-leads">
      <div class="col-header">
        <span class="col-title">Lead Queue</span>
        <div class="col-tabs">
          <button class="col-tab active">All Leads</button>
          <button class="col-tab">Hot</button>
          <button class="col-tab">Follow-up</button>
        </div>
      </div>
      <div class="lead-queue">
        {{#each leads}}
        <div class="lead-card {{#if (eq id ../selectedLead.id)}}selected{{/if}}" onclick="selectLead({{id}})">
          <div class="lead-card-header">
            <div class="lead-card-company">
              <div class="lead-avatar" style="background: {{#if (eq risk_level 'high')}}#EF4444{{else if (eq risk_level 'medium')}}#F59E0B{{else}}#22C55E{{/if}};">
                {{#if business_name}}{{userInitials business_name}}{{else}}{{userInitials name}}{{/if}}
              </div>
              <div>
                <div class="lead-card-name">{{business_name}}</div>
                <div style="font-size:11px;color:var(--text-muted);">{{contact}}</div>
              </div>
            </div>
            <span class="lead-badge {{status}}">{{#if (eq status 'follow-up')}}Follow-up{{else}}{{status}}{{/if}}</span>
          </div>
          <div class="lead-card-score">
            <div class="score-ring {{risk_level}}">{{score}}</div>
            <span class="risk-label {{risk_level}}">{{risk_level}}</span>
            <span style="margin-left:auto;font-size:12px;color:var(--text-secondary);">{{premium_range}}</span>
          </div>
          <div class="lead-card-footer">
            <span class="lead-card-action">{{next_action}}</span>
            <span class="lead-card-time">{{last_activity}}</span>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- COLUMN 2: LEAD PROFILE -->
    <div class="col-center">
      <!-- LEAD INTELLIGENCE -->
      <div class="section-card lead-intel-card">
        <div class="section-header">
          <span class="section-title" style="color:var(--green);">Lead Intelligence</span>
        </div>
        <div class="section-body">
          <div class="intel-grid">
            <div class="intel-score">
              <div class="score-gauge">{{selectedLead.score}}</div>
              <div class="score-gauge-info">
                <div class="score-gauge-label">CoverScore / Likelihood to Buy</div>
                <div class="flex items-center gap-3">
                  <span class="score-gauge-value">{{selectedLead.score}}/100</span>
                  <span style="font-size:13px;font-weight:600;color:var(--green);">{{selectedLead.likelihood_to_buy}}</span>
                </div>
              </div>
            </div>
            <div class="intel-item">
              <div class="intel-label">Status</div>
              <div class="intel-value">
                <span class="lead-badge {{selectedLead.status}}" style="font-size:11px;">{{selectedLead.status}}</span>
              </div>
            </div>
            <div class="intel-item">
              <div class="intel-label">Potential Premium</div>
              <div class="intel-value">{{selectedLead.premium_range}}</div>
            </div>
            <div class="intel-item">
              <div class="intel-label">Primary Concern</div>
              <div class="intel-value">{{selectedLead.primary_concern}}</div>
            </div>
            <div class="intel-item">
              <div class="intel-label">Recommended First Product</div>
              <div class="intel-value">{{selectedLead.recommended_product}}</div>
            </div>
            <div class="intel-item">
              <div class="intel-label">Next Best Action</div>
              <div class="intel-value" style="color:var(--green);">{{selectedLead.next_action}}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- CLIENT PROFILE -->
      <div class="section-card">
        <div class="section-header">
          <span class="section-title">Client Profile</span>
        </div>
        <div class="section-body">
          <div class="profile-row">
            <span class="profile-row-label">Company</span>
            <span class="profile-row-value font-semibold">{{selectedLead.business_name}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Contact</span>
            <span class="profile-row-value">{{selectedLead.contact}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Phone</span>
            <span class="profile-row-value">{{selectedLead.phone}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Email</span>
            <span class="profile-row-value">{{selectedLead.email}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Industry</span>
            <span class="profile-row-value">{{selectedLead.industry}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Employees</span>
            <span class="profile-row-value">{{selectedLead.employees}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Turnover</span>
            <span class="profile-row-value">{{selectedLead.annual_turnover}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Location</span>
            <span class="profile-row-value">{{selectedLead.location}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Assessment</span>
            <span class="profile-row-value">{{selectedLead.assessment_date}}</span>
          </div>
          <div class="profile-row">
            <span class="profile-row-label">Source</span>
            <span class="profile-row-value">{{selectedLead.source}}</span>
          </div>
        </div>
      </div>

      <!-- RISK SNAPSHOT -->
      <div class="section-card">
        <div class="section-header">
          <span class="section-title">Risk Snapshot</span>
        </div>
        <div class="section-body">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="score-gauge" style="width:48px;height:48px;font-size:15px;">{{selectedLead.score}}</div>
              <div>
                <div style="font-size:12px;color:var(--text-muted);">CoverScore</div>
                <div style="font-size:16px;font-weight:700;">{{selectedLead.score}}/100</div>
              </div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:12px;color:var(--text-muted);">Financial Exposure</div>
              <div style="font-size:14px;font-weight:700;">₦{{formatNumber selectedLead.financial_exposure_min}} - ₦{{formatNumber selectedLead.financial_exposure_max}}</div>
            </div>
          </div>
          {{#if selectedLead.risks}}
          {{#each selectedLead.risks}}
          <div class="risk-bar-item">
            <div class="risk-bar-header">
              <span class="risk-bar-name">{{name}}</span>
              <span class="risk-bar-score">{{score}}</span>
            </div>
            <div class="risk-bar-track">
              <div class="risk-bar-fill {{#if (gte score 80)}}critical{{else if (gte score 60)}}high{{else if (gte score 40)}}medium{{else}}low{{/if}}" style="width:{{score}}%;"></div>
            </div>
          </div>
          {{/each}}
          {{/if}}
        </div>
      </div>

      <!-- PROTECTION GAPS -->
      {{#if selectedLead.protection_gaps}}
      <div class="section-card">
        <div class="section-header">
          <span class="section-title" style="color:var(--red);">Protection Gaps</span>
        </div>
        <div class="section-body">
          {{#each selectedLead.protection_gaps}}
          <div class="gap-item">
            <svg class="gap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            {{this}}
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- NOTES -->
      <div class="section-card">
        <div class="section-header">
          <span class="section-title">Advisor Notes</span>
        </div>
        <div class="section-body">
          <textarea class="notes-textarea" placeholder="Add notes about this lead...">{{selectedLead.notes}}</textarea>
        </div>
      </div>
    </div>

    <!-- COLUMN 3: WHATSAPP + AI -->
    <div class="col-whatsapp">
      <!-- WHATSAPP CONVERSATION -->
      <div class="col-header">
        <div>
          <span class="col-title">WhatsApp</span>
          <div class="wa-status" style="margin-top:4px;">
            <span class="wa-dot"></span>
            <span style="font-size:12px;color:var(--success);font-weight:500;">Online</span>
          </div>
        </div>
        <div>
          <div style="font-size:13px;font-weight:600;">{{selectedLead.contact}}</div>
          <div style="font-size:11px;color:var(--text-muted);">{{selectedLead.business_name}}</div>
        </div>
      </div>
      <div class="chat-area">
        {{#each selectedLead.conversations}}
        <div class="chat-msg {{sender}}">
          {{text}}
          <div class="chat-msg-time">{{time}}</div>
        </div>
        {{/each}}
      </div>
      <div class="chat-input-area">
        <button class="chat-btn" title="Attach file">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <button class="chat-btn" title="Voice note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
        </button>
        <input type="text" class="chat-input" placeholder="Type a message...">
        <button class="chat-btn send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>

      <!-- AI RECOMMENDATIONS -->
      <div style="border-top:1px solid var(--border);padding:16px;">
        <div class="section-title mb-4">AI Recommendations</div>
        {{#each aiRecommendations}}
        <div class="ai-item">
          <span class="ai-item-name">{{product}}</span>
          <span class="ai-item-priority {{priority}}">{{priority}}</span>
        </div>
        {{/each}}
      </div>

      <!-- TALKING POINTS -->
      <div style="border-top:1px solid var(--border);padding:16px;">
        <div class="section-title mb-4">Suggested Talking Points</div>
        {{#each talkingPoints}}
        <div class="tp-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          {{this}}
        </div>
        {{/each}}
        <button class="tp-view-more">View More Talking Points</button>
      </div>

      <!-- ACTION PANEL -->
      <div style="border-top:1px solid var(--border);padding:16px;">
        <div class="section-title mb-4">Actions</div>
        <div class="action-panel">
          <button class="action-btn green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Schedule Call
          </button>
          <button class="action-btn blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Send Proposal
          </button>
          <button class="action-btn green">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
            Send WhatsApp
          </button>
          <button class="action-btn orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><polyline points="20 6 9 17 4 12"/></svg>
            Mark as Won
          </button>
          <button class="action-btn red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Mark as Lost
          </button>
        </div>
      </div>
    </div>

  </div>

  <script>
    function selectLead(id) {
      window.location.href = '/advisor/dashboard?lead=' + id;
    }

    document.querySelectorAll('.col-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.col-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
      });
    });
  </script>
</body>
</html>
