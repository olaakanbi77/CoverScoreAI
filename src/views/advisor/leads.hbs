<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Leads - CoverScore</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #0F172A;
      --navy-light: #1E293B;
      --green: #108A43; /* Matches the dark green card in screenshot */
      --green-light: #16A34A; /* Logo score green */
      --green-bg: #F0FDF4;
      --orange: #F97316;
      --orange-bg: #FFF7ED;
      --blue: #3B82F6;
      --blue-bg: #EFF6FF;
      --purple: #8B5CF6;
      --purple-bg: #F5F3FF;
      --pink: #E11D48;
      --pink-bg: #FFE4E6;
      --bg: #F9FAFB;
      --card: #FFFFFF;
      --border: #F1F5F9;
      --text: #0F172A;
      --text-sec: #64748B;
      --font: 'Inter', system-ui, sans-serif;
    }
    
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: var(--font);
      background-color: #E2E8F0; /* Darker bg outside the app container on desktop */
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    .app-container {
      max-width: 480px;
      margin: 0 auto;
      background-color: var(--card); /* white bg for leads page */
      min-height: 100vh;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* TOP BAR */
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--card);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .menu-btn {
      background: none; border: none; color: var(--navy); cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .page-title {
      font-size: 18px; font-weight: 800; color: var(--navy);
    }
    .top-actions {
      display: flex; align-items: center; gap: 16px;
    }
    .action-icon {
      color: var(--navy); cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative;
    }
    /* Filter icon active dot */
    .filter-dot {
      position: absolute; top: -2px; right: -2px; width: 6px; height: 6px; border-radius: 50%; background: var(--green-light);
    }

    .main-content {
      padding: 0 0 100px;
      flex: 1;
      overflow-y: auto;
    }

    /* HEADER */
    .header-section {
      padding: 12px 20px 20px;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .header-text h1 { font-size: 18px; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .header-text p { font-size: 12px; color: var(--text-sec); }
    .btn-new-lead {
      background: var(--green); color: white; border: none; border-radius: 8px;
      padding: 10px 14px; font-size: 14px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 6px;
    }

    /* FILTER TABS */
    .filter-tabs-wrapper {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
    }
    .filter-tabs {
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
    }
    .filter-tabs::-webkit-scrollbar { display: none; }
    
    .tab-pill {
      display: flex; align-items: center; gap: 4px;
      padding: 6px 10px; border-radius: 20px;
      font-size: 11px; font-weight: 600; white-space: nowrap;
      cursor: pointer; border: 1px solid var(--border);
      background: var(--card); color: var(--text);
    }
    .tab-pill.active {
      background: var(--green); color: white; border-color: var(--green);
    }
    .tab-badge {
      display: flex; align-items: center; justify-content: center;
      min-width: 20px; height: 20px; border-radius: 10px;
      font-size: 11px; font-weight: 700; background: var(--green-bg); color: var(--green);
      padding: 0 6px;
    }
    .tab-pill.active .tab-badge {
      background: white; color: var(--green);
    }

    /* LEAD LIST */
    .leads-list {
      padding: 16px 20px;
      display: flex; flex-direction: column; gap: 16px;
    }
    .lead-card {
      background: var(--card); border-radius: 16px; padding: 16px;
      border: 1px solid var(--border);
      display: flex; align-items: center; gap: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      cursor: pointer; text-decoration: none; color: inherit;
    }
    
    .lead-avatar {
      width: 52px; height: 52px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 700; flex-shrink: 0;
    }
    /* Dynamic Avatar Colors */
    .color-green { background: var(--green-bg); color: var(--green-light); }
    .color-blue { background: var(--blue-bg); color: var(--blue); }
    .color-purple { background: var(--purple-bg); color: var(--purple); }
    .color-orange { background: var(--orange-bg); color: var(--orange); }
    .color-pink { background: var(--pink-bg); color: var(--pink); }

    .lead-info { flex: 1; min-width: 0; }
    .lead-info h3 { font-size: 15px; font-weight: 700; color: var(--navy); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lead-sub { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-sec); margin-bottom: 8px; }
    .lead-sub-icon { display: flex; align-items: center; justify-content: center; opacity: 0.7; }
    .lead-time { font-size: 11px; color: var(--text-sec); }

    .lead-stats {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    }
    .status-pill {
      font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 10px;
    }
    
    .score-gauge-wrap {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
    }
    .score-circle {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 800; color: var(--navy);
      position: relative;
    }
    .score-circle svg {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      transform: rotate(-90deg);
    }
    .score-circle circle {
      fill: none; stroke-width: 3; stroke-linecap: round;
    }
    .score-circle .bg { stroke: var(--border); }
    .score-label { font-size: 9px; color: var(--text-sec); text-align: center; }
    
    .chevron { color: var(--navy); margin-left: 8px; display: flex; align-items: center; }

    /* BOTTOM BANNER */
    .bottom-banner {
      margin: 8px 20px 24px; background: var(--green-bg); border-radius: 16px;
      padding: 20px; display: flex; align-items: center; justify-content: space-between;
      border: 1px solid #DCFCE7;
    }
    .banner-icon { width: 40px; height: 40px; border-radius: 50%; background: #DCFCE7; color: var(--green); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .banner-text { flex: 1; margin: 0 16px; }
    .banner-text h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 2px; }
    .banner-text p { font-size: 12px; color: var(--text-sec); }
    .btn-add-lead-outline {
      border: 1px solid var(--green); background: transparent; color: var(--green);
      padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;
    }

    .hidden-lead { display: none !important; }
    .view-all-wrap { text-align: center; margin: 0 20px 16px; }
    .btn-view-all { 
      background: transparent; color: var(--green); border: 1px solid var(--green);
      padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 14px;
      cursor: pointer; width: 100%;
    }

    /* BOTTOM NAV */
    .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
    .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
    .nav-item.active { color: var(--green); }
    .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }

  </style>
</head>
<body>

  <div class="app-container">
    
    <!-- TOP BAR -->
    <header class="top-bar">
      <button class="menu-btn" onclick="alert('Menu opened')">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-title">Leads</div>
      <div class="top-actions">
        <div class="action-icon" onclick="alert('Search leads...')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <div class="action-icon" onclick="alert('Open filters...')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          <div class="filter-dot"></div>
        </div>
      </div>
    </header>

    <main class="main-content">
      
      <!-- HEADER -->
      <div class="header-section">
        <div class="header-text">
          <h1>Manage your prospects</h1>
          <p>Track, follow up and convert more leads.</p>
        </div>
        <button class="btn-new-lead" onclick="openAddLeadModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Lead
        </button>
      </div>

      <!-- FILTER TABS -->
      <div class="filter-tabs-wrapper">
        <div class="filter-tabs">
          <div class="tab-pill active" data-filter="All">
            All Leads <div class="tab-badge">{{counts.all}}</div>
          </div>
          <div class="tab-pill" data-filter="New">
            New <div class="tab-badge">{{counts.new}}</div>
          </div>
          <div class="tab-pill" data-filter="Contacted">
            Contacted <div class="tab-badge">{{counts.contacted}}</div>
          </div>
          <div class="tab-pill" data-filter="Qualified">
            Qualified <div class="tab-badge">{{counts.qualified}}</div>
          </div>
        </div>
      </div>

      <!-- LEAD LIST -->
      <div class="leads-list" id="mainLeadsList">
        {{#each parsedLeads}}
        <a href="/admin/leads/{{this.id}}" class="lead-card {{#if (gte @index 4)}}hidden-lead{{/if}}" data-status="{{this.displayStatus}}">
          <div class="lead-avatar color-{{this.colorTheme}}">{{this.initials}}</div>
          
          <div class="lead-info">
            <h3>{{this.business_name}}</h3>
            <div class="lead-sub">
              <span class="lead-sub-icon">
                {{#if (eq this.entity_type 'hospital')}}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 21V9a2 2 0 0 0-2-2h-2V3a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v4H4a2 2 0 0 0-2 2v12"/><path d="M22 21H2"/><path d="M12 9v4"/><path d="M10 11h4"/></svg>
                {{else}}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M9 8h1"/><path d="M9 12h1"/><path d="M9 16h1"/><path d="M14 8h1"/><path d="M14 12h1"/><path d="M14 16h1"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/></svg>
                {{/if}}
              </span>
              <span>{{#if (eq this.entity_type 'hospital')}}Hospital{{else}}Clinic{{/if}} • {{this.location}}</span>
            </div>
            <div class="lead-time">Added {{this.timeAgo}}</div>
          </div>
          
          <div class="lead-stats">
            <div class="status-pill color-{{this.colorTheme}}">{{this.displayStatus}}</div>
            <div class="score-gauge-wrap">
              <div class="score-circle">
                <svg>
                  <circle class="bg" cx="20" cy="20" r="17"></circle>
                  <circle cx="20" cy="20" r="17" style="stroke: var(--{{this.colorTheme}}); stroke-dasharray: 106.8; stroke-dashoffset: {{this.dashOffset}};"></circle>
                </svg>
                <span>{{this.score}}</span>
              </div>
              <span class="score-label">Potential Score</span>
            </div>
          </div>

          <div class="chevron">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </div>
        </a>
        {{/each}}
      </div>

      {{#if (gte parsedLeads.length 5)}}
      <div class="view-all-wrap">
        <button id="viewAllBtn" class="btn-view-all">View All Leads</button>
      </div>
      {{/if}}

      <!-- BOTTOM BANNER -->
      <div class="bottom-banner">
        <div class="banner-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="banner-text">
          <h4>More leads, more protection.</h4>
          <p>Add new leads and grow your pipeline.</p>
        </div>
        <button class="btn-add-lead-outline" onclick="openAddLeadModal()">Add Lead</button>
      </div>

    </main>

    <!-- BOTTOM NAV -->
    <div class="bottom-nav">
      <a href="/advisor/dashboard" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Home
      </a>
      <a href="/admin/leads" class="nav-item active">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Leads
      </a>
      <a href="/admin/assessments" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Assessments
      </a>
      <a href="/admin/opportunities" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        Quotes
      </a>
      <a href="/advisor/profile" class="nav-item">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        More
      </a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('viewAllBtn');
      const tabs = document.querySelectorAll('.tab-pill');
      const cards = document.querySelectorAll('.lead-card');

      if (btn) {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.hidden-lead').forEach(el => el.classList.remove('hidden-lead'));
          btn.style.display = 'none';
        });
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          // Remove active from all tabs
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          
          const filter = tab.getAttribute('data-filter');
          let visibleCount = 0;
          
          cards.forEach(card => {
            card.classList.remove('hidden-lead');
            const status = card.getAttribute('data-status');
            
            if (filter === 'All' || status === filter) {
              card.style.display = 'flex';
              visibleCount++;
              if (filter === 'All' && visibleCount > 4) {
                card.classList.add('hidden-lead');
              }
            } else {
              card.style.display = 'none';
            }
          });

          if (btn) {
            btn.style.display = (filter === 'All' && visibleCount > 4) ? 'block' : 'none';
          }
        });
      });
    });

    // Stub for existing Add Lead Modal logic
    function openAddLeadModal() {
      alert("Open existing Add Lead Modal");
      // document.getElementById('addLeadModal').style.display = 'flex';
    }
  </script>
</body>
</html>
