<style>
  :root {
    --c-navy: #0b1120; --c-navy-light: #1e293b; --c-purple: #7c3aed;
    --c-purple-light: #f5f3ff; --c-dark: #0f172a; --c-gray: #64748b;
    --text-sec: #64748b; --c-gray-light: #f1f5f9; --c-green: #10b981;
    --c-green-dark: #047857; --c-green-light: #ecfdf5; --c-orange: #f97316;
    --c-orange-light: #fff7ed; --c-blue: #2563eb; --c-blue-light: #eff6ff;
    --bg-page: #ffffff; --gold: #fbbf24;
  }
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  body { font-family: 'Inter', sans-serif; background-color: var(--bg-page); margin: 0; }
  .app { max-width: 480px; margin: 0 auto; min-height: 100vh; background: var(--bg-page); position: relative; padding-bottom: 40px; }

  .topbar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: white; position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #f1f5f9; }
  .back-btn { background: none; border: none; padding: 4px; cursor: pointer; color: var(--c-dark); display: flex; align-items: center; }
  .back-btn svg { width: 20px; height: 20px; stroke-width: 2; }
  .top-info { flex: 1; min-width: 0; }
  .top-label { font-size: 9px; font-weight: 700; color: var(--c-purple); text-transform: uppercase; letter-spacing: 0.5px; }
  .top-title { font-size: 12px; font-weight: 800; color: var(--c-dark); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .hero { padding: 20px 16px; background: linear-gradient(135deg, #0b1120 0%, #1e293b 100%); }
  .hero-code { font-size: 10px; font-weight: 700; color: var(--c-purple); background: rgba(124,58,237,0.15); padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 8px; }
  .hero-title { font-size: 16px; font-weight: 800; color: white; margin: 0 0 4px 0; line-height: 1.3; }
  .hero-level { font-size: 10px; color: #94a3b8; margin: 0 0 8px 0; font-weight: 500; }
  .hero-desc { font-size: 11px; color: #cbd5e1; margin: 0 0 16px 0; font-weight: 500; line-height: 1.4; }
  .hero-meta { display: flex; gap: 16px; }
  .meta-item { display: flex; align-items: center; gap: 4px; font-size: 10px; color: #94a3b8; font-weight: 600; }
  .meta-item svg { width: 14px; height: 14px; stroke-width: 2; }

  .progress-section { padding: 12px 16px; background: white; border-bottom: 1px solid #f1f5f9; }
  .progress-row { display: flex; align-items: center; gap: 10px; }
  .progress-bg { flex: 1; height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--c-green); border-radius: 3px; transition: width 0.3s; }
  .progress-txt { font-size: 10px; font-weight: 700; color: var(--c-green-dark); white-space: nowrap; }

  .continue-card { margin: 12px 16px; padding: 12px; background: var(--c-green-light); border-radius: 10px; display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .continue-card:hover { background: #d1fae5; }
  .cc-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--c-green-dark); display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; }
  .cc-icon svg { width: 16px; height: 16px; }
  .cc-info { flex: 1; }
  .cc-label { font-size: 9px; font-weight: 700; color: var(--c-green-dark); text-transform: uppercase; }
  .cc-title { font-size: 12px; font-weight: 800; color: var(--c-dark); margin: 2px 0 0 0; }

  .enroll-card { margin: 12px 16px; padding: 20px 16px; background: var(--c-purple-light); border: 1px solid #ede9fe; border-radius: 12px; text-align: center; }
  .enroll-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--c-purple); color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; }
  .enroll-icon svg { width: 20px; height: 20px; }
  .enroll-title { font-size: 13px; font-weight: 800; color: var(--c-dark); margin: 0 0 4px 0; }
  .enroll-desc { font-size: 10px; color: var(--c-gray); margin: 0 0 14px 0; line-height: 1.4; }
  .enroll-btn { display: inline-flex; align-items: center; gap: 6px; background: var(--c-purple); color: white; border: none; border-radius: 8px; padding: 10px 24px; font-size: 12px; font-weight: 800; cursor: pointer; }
  .enroll-btn:hover { background: #6d28d9; }
  .enroll-btn:disabled { opacity: 0.6; cursor: default; }

  .section-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 16px 8px; }
  .sec-title { font-size: 13px; font-weight: 800; color: var(--c-dark); margin: 0; }

  .lesson-list { padding: 0 16px; display: flex; flex-direction: column; gap: 2px; }
  .lesson-item { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 8px; text-decoration: none; transition: background 0.15s; }
  .lesson-item:hover { background: #f8fafc; }
  .lesson-num { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; flex-shrink: 0; }
  .lesson-num.completed { background: var(--c-green-light); color: var(--c-green-dark); }
  .lesson-num.in_progress { background: var(--c-blue-light); color: var(--c-blue); }
  .lesson-num.pending { background: #f1f5f9; color: var(--c-gray); }
  .lesson-info { flex: 1; min-width: 0; }
  .lesson-title { font-size: 12px; font-weight: 700; color: var(--c-dark); margin: 0; }
  .lesson-desc { font-size: 10px; color: var(--c-gray); font-weight: 500; margin: 2px 0 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lesson-time { font-size: 9px; color: #94a3b8; font-weight: 600; }
  .lesson-check { width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .lesson-check.done { background: var(--c-green-light); color: var(--c-green-dark); }
  .lesson-check.pending { border: 2px solid #e2e8f0; }

  .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: white; display: flex; justify-content: space-around; align-items: center; padding: 12px 0 24px 0; border-top: 1px solid #e2e8f0; z-index: 100; }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active { color: var(--c-green-dark); }
  .nav-item svg { width: 24px; height: 24px; stroke-width: 2; }
</style>

<div class="app">

  <div class="topbar">
    <a href="/advisor/academy" class="back-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div class="top-info">
      <div class="top-label">{{course.level_name}}</div>
      <h1 class="top-title">{{course.title}}</h1>
    </div>
  </div>

  <div class="hero">
    <div class="hero-code">{{course.code}}</div>
    <h2 class="hero-title">{{course.title}}</h2>
    <p class="hero-level">{{course.level_name}}</p>
    <p class="hero-desc">{{course.description}}</p>
    <div class="hero-meta">
      <span class="meta-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {{totalMin}} min
      </span>
      <span class="meta-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
        {{total}} Lessons
      </span>
    </div>
  </div>

  {{#if enrolled}}
  <div class="progress-section">
    <div class="progress-row">
      <span style="font-size:10px; font-weight:700; color:var(--c-dark);">Course Progress</span>
      <div class="progress-bg">
        <div class="progress-fill" style="width: {{pct}}%"></div>
      </div>
      <span class="progress-txt">{{completed}}/{{total}}</span>
    </div>
  </div>

  {{#if continueLesson}}
  <a href="/advisor/academy/module/{{continueLesson.id}}" class="continue-card">
    <div class="cc-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="cc-info">
      <div class="cc-label">Continue Learning</div>
      <h3 class="cc-title">{{continueLesson.title}}</h3>
    </div>
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:16px;height:16px;color:var(--c-green-dark);flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </a>
  {{/if}}

  <div class="section-header">
    <h3 class="sec-title">Lessons</h3>
  </div>

  <div class="lesson-list">
    {{#each lessons}}
    <a href="/advisor/academy/module/{{this.id}}" class="lesson-item">
      <div class="lesson-num {{this.status}}">{{add @index 1}}</div>
      <div class="lesson-info">
        <h4 class="lesson-title">{{this.title}}</h4>
        <p class="lesson-desc">{{this.description}}</p>
      </div>
      {{#if (eq this.status 'completed')}}
      <div class="lesson-check done">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:14px;height:14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      {{else}}
      <div class="lesson-check pending"></div>
      {{/if}}
      <span class="lesson-time">{{this.duration_minutes}}m</span>
    </a>
    {{/each}}
  </div>
  {{else}}
  <div class="enroll-card">
    <div class="enroll-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
    </div>
    <h3 class="enroll-title">Enrol to start learning</h3>
    <p class="enroll-desc">{{total}} lessons · {{totalMin}} min · {{course.level_name}}</p>
    <button class="enroll-btn" onclick="enroll({{course.id}})">
      Enrol Now
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12"/></svg>
    </button>
  </div>
  {{/if}}

  <div style="padding: 16px; text-align: center;">
    <a href="/advisor/academy" class="back-btn" style="display:inline-flex; gap:4px; font-size:11px; font-weight:700; color:var(--c-gray); padding:8px 16px; border:1px solid #e2e8f0; border-radius:8px; text-decoration:none;">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:14px;height:14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back to Academy
    </a>
  </div>

</div>

<div class="bottom-nav">
  <a href="/advisor/dashboard" class="nav-item">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
    Home
  </a>
  <a href="/admin/leads" class="nav-item">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
    Leads
  </a>
  <a href="/admin/assessments" class="nav-item">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
    Assessments
  </a>
  <a href="/admin/opportunities" class="nav-item">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
    Opportunities
  </a>
  <a href="/advisor/academy" class="nav-item active">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
    Academy
  </a>
</div>

<div id="toast" style="position:fixed; bottom:80px; left:50%; transform:translateX(-50%); background:#0f172a; color:white; padding:10px 18px; border-radius:8px; font-size:11px; font-weight:600; opacity:0; transition:opacity .3s; pointer-events:none; z-index:200;"></div>

<script>
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  t.style.opacity = '1';
  setTimeout(() => { t.style.opacity = '0'; }, 2500);
}
async function enroll(courseId) {
  const btn = document.querySelector('.enroll-btn');
  btn.disabled = true; btn.textContent = 'Enrolling...';
  try {
    const res = await fetch('/advisor/api/academy/enroll/' + courseId, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      showToast(data.message || 'Enrolled!');
      setTimeout(() => location.reload(), 800);
    } else {
      showToast(data.error || 'Failed to enroll');
      btn.disabled = false; btn.textContent = 'Enrol Now';
    }
  } catch (e) {
    showToast('Network error');
    btn.disabled = false; btn.textContent = 'Enrol Now';
  }
}
</script>

