<style>
  .score-trend { display:flex; align-items:center; gap:12px; padding:20px 24px; background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.15); border-radius:var(--radius-lg); margin-bottom:20px; }
  .score-trend.declined { background:rgba(239,68,68,0.08); border-color:rgba(239,68,68,0.15); }
  .score-trend-number { font-size:32px; font-weight:800; font-family:var(--font-mono); color:var(--color-success); }
  .score-trend.declined .score-trend-number { color:var(--color-danger); }
  .policy-card { display:flex; align-items:center; gap:16px; padding:16px 20px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md); margin-bottom:10px; }
  .policy-card:last-child { margin-bottom:0; }
  .policy-icon { width:40px; height:40px; border-radius:10px; background:rgba(59,130,246,0.12); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .claim-status { display:inline-block; padding:3px 8px; border-radius:4px; font-size:11px; font-weight:600; }
  .claim-status.filed { background:rgba(59,130,246,0.15); color:#60a5fa; }
  .claim-status.settled { background:rgba(16,185,129,0.15); color:#34d399; }
  .empty-state { text-align:center; padding:48px 24px; color:var(--text-muted); }
  .reassess-banner { background:linear-gradient(135deg,rgba(59,130,246,0.1),rgba(139,92,246,0.08)); border:1px solid rgba(59,130,246,0.2); border-radius:var(--radius-xl); padding:28px 32px; margin-top:24px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .reassess-banner h3 { margin:0 0 4px; font-size:18px; color:var(--text-primary); }
  .reassess-banner p { margin:0; font-size:14px; color:var(--text-secondary); }
</style>

<div class="container py-12">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-3xl font-bold mb-2">My Dashboard</h1>
      <p class="text-muted">Welcome back, <span id="userName" class="text-white font-medium">User</span>. Here's your protection overview.</p>
    </div>
    <a href="/assessment/start" class="btn btn-primary">New Assessment</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <!-- Score Comparison -->
      <div id="comparisonSection"></div>

      <!-- Recent Assessments -->
      <div class="glass-card h-full">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-white">Assessment History</h3>
        </div>
        <div class="p-0" id="recentAssessments">
          <div class="flex items-center justify-center p-12">
            <div class="loading-spinner"></div>
          </div>
        </div>
      </div>

      <!-- Reassessment Banner -->
      <div class="reassess-banner">
        <div>
          <h3>Time for a Check-Up?</h3>
          <p>Your risks change over time. Retake your assessment to see how your score has evolved.</p>
        </div>
        <a href="/assessment/start" class="btn btn-primary">Retake Assessment →</a>
      </div>
    </div>

    <div>
      <!-- Active Policies -->
      <div class="glass-card mb-6">
        <div class="p-6 border-b border-white/10">
          <h3 class="text-lg font-semibold text-white">My Policies</h3>
        </div>
        <div class="p-6" id="policiesSection">
          {{#if policies.length}}
            {{#each policies}}
            <div class="policy-card">
              <div class="policy-icon">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div style="flex:1;">
                <div style="font-weight:600;color:var(--text-primary);font-size:14px;">{{this.product}}</div>
                <div style="font-size:12px;color:var(--text-muted);">{{this.policy_number}} · Exp: {{formatDate this.expiry_date}}</div>
              </div>
              <span style="font-size:13px;font-weight:600;color:var(--color-success);">₦{{formatNumber this.premium}}</span>
            </div>
            {{/each}}
          {{else}}
            <div class="empty-state">
              <p>No active policies yet. Complete an assessment to get started.</p>
            </div>
          {{/if}}
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="glass-card">
        <div class="p-6 border-b border-white/10">
          <h3 class="text-lg font-semibold text-white">Quick Actions</h3>
        </div>
        <div class="p-6 flex flex-col gap-3">
          <a href="/assessment/start" class="btn btn-outline" style="justify-content:center;">Take New Assessment</a>
          <a href="/consultation" class="btn btn-outline" style="justify-content:center;">Book Consultation</a>
          <a href="/profile" class="btn btn-ghost" style="justify-content:center;">My Profile</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let user = null;
  const comparisonData = {{{comparison}}};

  async function init() {
    const token = localStorage.getItem('accessToken');
    if (!token) { window.location.href = '/auth/login'; return; }

    const storedUser = localStorage.getItem('user');
    if (storedUser) { user = JSON.parse(storedUser); document.getElementById('userName').textContent = user.name; }

    renderComparison();
    await loadAssessments();
  }

  function renderComparison() {
    const section = document.getElementById('comparisonSection');
    if (!comparisonData || !comparisonData.current) {
      section.innerHTML = '';
      return;
    }

    if (comparisonData.hasPrevious) {
      const trend = comparisonData.improvement === 'improved' ? 'improved' : 'declined';
      const arrow = comparisonData.improvement === 'improved' ? '↑' : '↓';
      section.innerHTML = `
        <div class="score-trend ${trend === 'declined' ? 'declined' : ''}">
          <div style="flex:1;">
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:4px;">Score Trend</div>
            <div class="score-trend-number">${comparisonData.current.score} <span style="font-size:18px;">${arrow} ${comparisonData.scoreChange}</span></div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:12px;color:var(--text-muted);">Previous: ${comparisonData.previous.score}</div>
            <div style="font-size:12px;color:var(--text-muted);">${new Date(comparisonData.current.date).toLocaleDateString()}</div>
          </div>
        </div>`;
    } else {
      section.innerHTML = `
        <div class="score-trend">
          <div style="flex:1;">
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:4px;">Latest CoverScore</div>
            <div class="score-trend-number">${comparisonData.current.score}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:12px;color:var(--text-muted);">First assessment</div>
            <div style="font-size:12px;color:var(--text-muted);">${new Date(comparisonData.current.date).toLocaleDateString()}</div>
          </div>
        </div>`;
    }
  }

  async function loadAssessments() {
    const token = localStorage.getItem('accessToken');
    try {
      const res = await fetch('/api/assessment', { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error('Failed to load');
      const data = await res.json();

      if (!data.assessments?.length) {
        document.getElementById('recentAssessments').innerHTML = '<div class="empty-state"><p>No assessments yet</p><a href="/assessment/start" class="btn btn-primary">Start Your First Assessment</a></div>';
        return;
      }

      let html = '<div class="divide-y divide-white/10">';
      data.assessments.forEach(a => {
        const date = new Date(a.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        html += `<div class="flex justify-between items-center p-6 bg-white/5 hover:bg-white/10 transition-colors">
          <div>
            <div class="text-white font-medium mb-1">${date}</div>
            <div class="text-xs text-muted flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-${a.riskLevel === 'low' ? 'success' : a.riskLevel === 'moderate' ? 'warning' : 'danger'}"></span>
              ${a.riskLevel.charAt(0).toUpperCase() + a.riskLevel.slice(1)} Risk
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="text-right">
              <div class="text-sm font-bold text-white font-mono">${a.score}</div>
              <div class="text-[10px] text-muted uppercase tracking-wider">Score</div>
            </div>
            <a href="/assessment/result/${a.id}" class="btn btn-ghost btn-sm">View Report</a>
          </div>
        </div>`;
      });
      html += '</div>';
      document.getElementById('recentAssessments').innerHTML = html;
    } catch (err) {
      console.error(err);
      document.getElementById('recentAssessments').innerHTML = '<div class="p-6 text-center text-muted">Failed to load assessments.</div>';
    }
  }

  async function logout() {
    const token = localStorage.getItem('accessToken');
    try { await fetch('/api/auth/logout', { method: 'POST', headers: { Authorization: `Bearer ${token}` } }); } catch(e) {}
    localStorage.removeItem('accessToken');
    localStorage.removeItem('user');
    window.location.href = '/';
  }

  init();
</script>