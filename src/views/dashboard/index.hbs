  <div class="container py-12">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
      <div>
        <h1 class="text-3xl font-bold mb-2">Dashboard</h1>
        <p class="text-muted">Welcome back, <span id="userName" class="text-white font-medium">User</span>. Here's your risk overview.</p>
      </div>
      <a href="/assessment/start" class="btn btn-primary">New Assessment</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="glass-card p-6">
        <div class="text-muted text-sm font-medium mb-2">Total Assessments</div>
        <div class="text-3xl font-bold text-white font-mono" id="totalAssessments">0</div>
      </div>
      <div class="glass-card p-6">
        <div class="text-muted text-sm font-medium mb-2">Average Score</div>
        <div class="text-3xl font-bold text-white font-mono" id="avgScore">0</div>
      </div>
      <div class="glass-card p-6">
        <div class="text-muted text-sm font-medium mb-2">High Risk Cases</div>
        <div class="text-3xl font-bold text-danger font-mono" id="highRiskCount">0</div>
      </div>
      <div class="glass-card p-6">
        <div class="text-muted text-sm font-medium mb-2">Conversion Rate</div>
        <div class="text-3xl font-bold text-success font-mono" id="conversionRate">0%</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="glass-card h-full">
          <div class="p-6 border-b border-white/10 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-white">Recent Assessments</h3>
            <a href="/assessments" class="text-sm text-primary hover:underline">View All</a>
          </div>
          <div class="p-0" id="recentAssessments">
            <div class="flex items-center justify-center p-12">
              <div class="loading-spinner"></div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="glass-card h-full">
          <div class="p-6 border-b border-white/10">
            <h3 class="text-lg font-semibold text-white">Risk Distribution</h3>
          </div>
          <div class="p-6" id="riskDistribution">
            <div class="flex items-center justify-center p-12">
              <div class="loading-spinner"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let user = null;

    async function init() {
      const token = localStorage.getItem('accessToken');
      if (!token) {
        window.location.href = '/auth/login';
        return;
      }

      const storedUser = localStorage.getItem('user');
      if (storedUser) {
        user = JSON.parse(storedUser);
        document.getElementById('userName').textContent = user.name;
      }

      await loadDashboard();
    }

    async function loadDashboard() {
      const token = localStorage.getItem('accessToken');

      try {
        const [overviewRes, riskRes] = await Promise.all([
          fetch('/api/analytics/overview', { headers: { Authorization: `Bearer ${token}` } }),
          fetch('/api/analytics/risk-distribution', { headers: { Authorization: `Bearer ${token}` } })
        ]);

        if (!overviewRes.ok) throw new Error('Failed to load analytics');
        const overview = await overviewRes.json();
        const risk = riskRes.ok ? await riskRes.json() : {};

        document.getElementById('totalAssessments').textContent = overview.totalAssessments || 0;
        document.getElementById('avgScore').textContent = overview.avgScore || 0;
        document.getElementById('highRiskCount').textContent = (risk.high || 0) + (risk.critical || 0);
        document.getElementById('conversionRate').textContent = `${overview.conversionRate || 0}%`;

        const riskTotal = (risk.low || 0) + (risk.moderate || 0) + (risk.high || 0) + (risk.critical || 0);
        let riskHtml = '<div class="flex flex-col gap-3">';

        const levels = [
          { key: 'critical', label: 'Critical', color: 'var(--color-danger)' },
          { key: 'high', label: 'High', color: '#f97316' },
          { key: 'moderate', label: 'Moderate', color: 'var(--color-warning)' },
          { key: 'low', label: 'Low', color: 'var(--color-success)' }
        ];

        levels.forEach(level => {
          const count = risk[level.key] || 0;
          const pct = riskTotal > 0 ? Math.round((count / riskTotal) * 100) : 0;
          riskHtml += `
            <div>
              <div class="flex justify-between text-sm" style="margin-bottom: 4px;">
                <span>${level.label}</span>
                <span class="font-mono">${count} (${pct}%)</span>
              </div>
              <div class="progress-bar">
                <div class="progress-bar-fill" style="width: ${pct}%; background-color: ${level.color};"></div>
              </div>
            </div>
          `;
        });

        riskHtml += '</div>';
        document.getElementById('riskDistribution').innerHTML = riskHtml;

        loadAssessments();

      } catch (err) {
        console.error(err);
      }
    }

    async function loadAssessments() {
      const token = localStorage.getItem('accessToken');

      try {
        const res = await fetch('/api/assessment', {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (!res.ok) throw new Error('Failed to load assessments');
        const data = await res.json();

        if (!data.assessments?.length) {
          document.getElementById('recentAssessments').innerHTML = `
            <div class="empty-state">
              <div class="empty-state-text">No assessments yet</div>
              <a href="/assessment/start" class="btn btn-primary">Start Your First Assessment</a>
            </div>
          `;
          return;
        }

        let html = '<div class="divide-y divide-white/10">';
        data.assessments.slice(0, 5).forEach(a => {
          const date = new Date(a.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          html += `
            <div class="flex justify-between items-center p-6 bg-white/5 hover:bg-white/10 transition-colors">
              <div>
                <div class="text-white font-medium mb-1">${date}</div>
                <div class="text-xs text-muted flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-${a.riskLevel === 'low' ? 'success' : a.riskLevel === 'moderate' ? 'warning' : 'danger'}"></span>
                  ${a.riskLevel.charAt(0).toUpperCase() + a.riskLevel.slice(1)} Risk
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <div class="text-sm font-bold text-white font-mono">${a.score}</div>
                  <div class="text-[10px] text-muted uppercase tracking-wider">Score</div>
                </div>
                <a href="/assessment/result/${a.id}" class="btn btn-ghost btn-sm">View Report</a>
              </div>
            </div>
          `;
        });
        html += '</div>';
        document.getElementById('recentAssessments').innerHTML = html;

      } catch (err) {
        console.error(err);
        document.getElementById('recentAssessments').innerHTML = '<div class="p-6 text-center text-muted">Failed to load assessments.</div>';
      }
    }

    async function logout() {
      const token = localStorage.getItem('accessToken');
      try {
        await fetch('/api/auth/logout', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` }
        });
      } catch (e) {}
      localStorage.removeItem('accessToken');
      localStorage.removeItem('user');
      window.location.href = '/';
    }

    init();
  </script>
