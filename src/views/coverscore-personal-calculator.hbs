<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/coverscore-calculator.css">
  
  <meta name="theme-color" content="#ffffff">
</head>
<body>

  <!-- Header -->
  <header class="header">
    <div class="logo">
      <img src="/images/logo.png" alt="CoverScore" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'120\' height=\'30\'><text x=\'0\' y=\'20\' font-family=\'Arial\' font-size=\'20\' font-weight=\'bold\' fill=\'%230B2253\'>CoverScore</text></svg>'">
      <span class="logo-subtitle">Personal</span>
    </div>
    <a href="/personal" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back
    </a>
  </header>

  <!-- Main Calculator Area -->
  <main class="main-container">
    
    <div class="step-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
        <rect x="9" y="9" width="6" height="6"/>
        <line x1="9" y1="1" x2="9" y2="4"/>
        <line x1="15" y1="1" x2="15" y2="4"/>
        <line x1="9" y1="20" x2="9" y2="23"/>
        <line x1="15" y1="20" x2="15" y2="23"/>
        <line x1="20" y1="9" x2="23" y2="9"/>
        <line x1="20" y1="14" x2="23" y2="14"/>
        <line x1="1" y1="9" x2="4" y2="9"/>
        <line x1="1" y1="14" x2="4" y2="14"/>
      </svg>
      EXPOSURE CALCULATOR
    </div>
    
    <h1>Let's estimate your <span class="text-green">family's financial exposure</span></h1>
    <p class="subtitle">If your <strong>income stopped tomorrow</strong>, how much would your family need to stay financially secure?</p>
    
    <!-- Expenses Card -->
    <div class="calc-card">
      <div class="card-header">
        <div class="icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <div class="card-title-wrap">
          <label for="monthlyExpenses">Your estimated monthly<br>household expenses</label>
          <div class="info-icon" title="Include living expenses like food, rent, transport, school fees, utilities, loans, etc.">i</div>
        </div>
      </div>
      
      <div class="input-wrapper">
        <span class="currency-prefix">₦</span>
        <input type="text" id="monthlyExpenses" inputmode="numeric" placeholder="e.g. 500,000" autocomplete="off">
      </div>
      
      <p class="help-text">Include living expenses like food, rent, transport, school fees, utilities, loans, etc.</p>
    </div>
    
    <!-- Duration Card -->
    <div class="calc-card">
      <div class="card-header">
        <div class="icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <rect x="8" y="14" width="3" height="3" fill="currentColor"/>
          </svg>
        </div>
        <div class="card-title-wrap">
          <label>How many months would your<br>family need support?</label>
          <div class="info-icon" title="Choose how long your family would need coverage to transition or replace income.">i</div>
        </div>
      </div>
      
      <div class="segmented-control" id="durationControl">
        <button class="segment-btn" data-months="3">3 months</button>
        <button class="segment-btn active" data-months="6">6 months</button>
        <button class="segment-btn" data-months="12">12 months</button>
      </div>
    </div>
    
    <!-- Result Card -->
    <div class="result-card">
      <div class="result-header">
        <div class="result-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
        </div>
        <div class="result-title">Your Estimated Household Exposure</div>
      </div>
      
      <div class="huge-number" id="exposureResult">₦0</div>
      
      <p class="result-subhead" id="exposureSubhead">
        This is the estimated amount your household may need to maintain essential expenses for 6 months.
      </p>
      
      <div class="disclaimer-wrap">
        <svg class="disclaimer-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <div class="disclaimer-text">
          This is an estimate based on the figures you entered and is for awareness and planning purposes only.
        </div>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="cta-section">
      <button class="btn-whatsapp" id="btnContinue" disabled>
        <div class="btn-whatsapp-content">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span style="text-align: left; line-height: 1.2;">See My Full Family<br>Protection Score™</span>
        </div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
      
      <div class="trust-badges-row">
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Private & secure
        </div>
        <div class="trust-divider"></div>
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Takes under 30 seconds
        </div>
        <div class="trust-divider"></div>
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          No obligation
        </div>
      </div>
    </div>
    
  </main>
  
  <footer class="calc-footer">
    <div class="footer-inner">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
      <div>
        Your information is never shared.<br>
        We use bank-level security to protect your data.
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('monthlyExpenses');
      const durationBtns = document.querySelectorAll('.segment-btn');
      const resultEl = document.getElementById('exposureResult');
      const subheadEl = document.getElementById('exposureSubhead');
      const btnContinue = document.getElementById('btnContinue');
      
      let duration = 6; // Default to 6 months
      
      // Format number with commas
      function formatNumber(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      }
      
      // Calculate exposure
      function calculate() {
        // Get raw numeric value
        const rawValue = input.value.replace(/,/g, '').replace(/[^\d]/g, '');
        const expenses = parseInt(rawValue, 10);
        
        if (!isNaN(expenses) && expenses > 0) {
          const exposure = expenses * duration;
          resultEl.textContent = '₦' + formatNumber(exposure);
          subheadEl.innerHTML = `This is the estimated amount your household may need to maintain essential expenses for <strong>${duration} months</strong>.`;
          btnContinue.disabled = false;
          input.closest('.input-wrapper').classList.add('has-value');
        } else {
          resultEl.textContent = '₦0';
          subheadEl.innerHTML = `This is the estimated amount your household may need to maintain essential expenses for <strong>${duration} months</strong>.`;
          btnContinue.disabled = true;
          input.closest('.input-wrapper').classList.remove('has-value');
        }
      }
      
      // Handle input changes
      input.addEventListener('input', (e) => {
        // Remove non-numeric characters for processing
        let rawValue = e.target.value.replace(/,/g, '').replace(/[^\d]/g, '');
        
        // Re-format with commas and set value
        if (rawValue !== '') {
          e.target.value = formatNumber(rawValue);
        } else {
          e.target.value = '';
        }
        
        calculate();
      });
      
      // Handle segment buttons
      durationBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active class from all
          durationBtns.forEach(b => b.classList.remove('active'));
          // Add active class to clicked
          btn.classList.add('active');
          
          duration = parseInt(btn.getAttribute('data-months'), 10);
          calculate();
        });
      });
      
      // CTA Button
      btnContinue.addEventListener('click', () => {
        const rawValue = input.value.replace(/,/g, '').replace(/[^\d]/g, '');
        const expenses = parseInt(rawValue, 10);
        const exposure = expenses * duration;
        
        // WhatsApp redirection logic
        const botNumber = '{{whatsappNumber}}';
        const msg = `Hi CoverScore! I calculated my estimated financial exposure as ₦${formatNumber(exposure)} (₦${formatNumber(expenses)}/mo for ${duration} months). I want to see my full Family Protection Score.`;
        const encodedMsg = encodeURIComponent(msg);
        
        // Track event asynchronously
        try {
          fetch('/api/public/landing-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event_name: 'exposure_calculated',
              landing_page: 'personal_calculator',
              cta_position: 'calculator_cta',
              session_key: localStorage.getItem('coverscore_session') || Date.now().toString(),
              metadata: { expenses, duration, exposure }
            })
          });
        } catch(e) {}
        
        // Redirect to WhatsApp
        window.location.href = `https://wa.me/${botNumber}?text=${encodedMsg}`;
      });
    });
  </script>
</body>
</html>
