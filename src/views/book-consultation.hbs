<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book a Consultation - CoverScore AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .consultation-container {
      max-width: 600px;
      margin: 0 auto;
      padding: 40px 16px;
    }
    .consultation-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .consultation-icon {
      width: 64px;
      height: 64px;
      background: rgba(59, 130, 246, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: var(--color-primary);
    }
    .consultation-header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }
    .consultation-header p {
      color: var(--text-secondary);
    }
    .form-section {
      margin-bottom: 24px;
    }
    .form-section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-color);
    }
    .consultation-types {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .consultation-type-card {
      position: relative;
      padding: 16px;
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid var(--border-color);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .consultation-type-card:hover {
      border-color: var(--color-primary);
      background: rgba(59, 130, 246, 0.05);
    }
    .consultation-type-card.selected {
      border-color: var(--color-primary);
      background: rgba(59, 130, 246, 0.1);
    }
    .consultation-type-card input {
      position: absolute;
      opacity: 0;
    }
    .consultation-type-card .check-icon {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 20px;
      height: 20px;
      background: var(--color-primary);
      border-radius: 50%;
      display: none;
      align-items: center;
      justify-content: center;
      color: white;
    }
    .consultation-type-card.selected .check-icon {
      display: flex;
    }
    .consultation-type-card .type-icon {
      font-size: 28px;
      margin-bottom: 8px;
    }
    .consultation-type-card .type-name {
      font-weight: 600;
      font-size: 13px;
    }
    .time-slots {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .time-slot {
      padding: 10px;
      text-align: center;
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid var(--border-color);
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
    }
    .time-slot:hover {
      border-color: var(--color-primary);
    }
    .time-slot.selected {
      border-color: var(--color-primary);
      background: rgba(59, 130, 246, 0.1);
      color: var(--color-primary);
    }
    .time-slot input {
      display: none;
    }
    .time-slot.unavailable {
      opacity: 0.4;
      cursor: not-allowed;
      text-decoration: line-through;
    }
    @media (max-width: 480px) {
      .consultation-types, .time-slots {
        grid-template-columns: 1fr;
      }
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-content">
      <a href="/" class="navbar-brand">Cover<span>Score</span> AI</a>
      <div class="navbar-menu">
        <a href="/" class="navbar-item">Home</a>
        <a href="/assessment/start" class="navbar-item">Assessment</a>
        <a href="/auth/login" class="navbar-item">Sign In</a>
      </div>
    </div>
  </nav>

  <div class="consultation-container">
    <div class="consultation-header">
      <div class="consultation-icon">
        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <h1>Book a Consultation</h1>
      <p>Schedule a free consultation with our insurance experts. Get personalized advice tailored to your risk profile.</p>
    </div>

    <form id="consultationForm" class="card">
      <div class="card-body">
        <!-- Contact Information -->
        <div class="form-section">
          <div class="form-section-title">Your Information</div>
          <div class="input-group">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" required placeholder="Sarah Akanbi">
          </div>
          <div class="input-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required placeholder="sarah@company.com">
          </div>
          <div class="input-group">
            <label for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" required placeholder="+234 801 234 5678">
          </div>
        </div>

        <!-- Consultation Type -->
        <div class="form-section">
          <div class="form-section-title">Consultation Type</div>
          <div class="consultation-types">
            <label class="consultation-type-card" onclick="toggleConsultationType(this)">
              <input type="radio" name="consultationType" value="business_risk" required>
              <span class="check-icon">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div class="type-icon">🏢</div>
              <div class="type-name">Business Risk Assessment</div>
            </label>
            <label class="consultation-type-card" onclick="toggleConsultationType(this)">
              <input type="radio" name="consultationType" value="personal_cover">
              <span class="check-icon">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div class="type-icon">👤</div>
              <div class="type-name">Personal Cover Review</div>
            </label>
            <label class="consultation-type-card" onclick="toggleConsultationType(this)">
              <input type="radio" name="consultationType" value="claims">
              <span class="check-icon">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div class="type-icon">📋</div>
              <div class="type-name">Claims Assistance</div>
            </label>
            <label class="consultation-type-card" onclick="toggleConsultationType(this)">
              <input type="radio" name="consultationType" value="compliance">
              <span class="check-icon">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div class="type-icon">✓</div>
              <div class="type-name">NAICOM Compliance</div>
            </label>
          </div>
        </div>

        <!-- Preferred Date -->
        <div class="form-section">
          <div class="form-section-title">Preferred Date</div>
          <div class="input-group">
            <label for="consultationDate">Select Date *</label>
            <input type="date" id="consultationDate" name="consultationDate" required>
          </div>
        </div>

        <!-- Preferred Time -->
        <div class="form-section">
          <div class="form-section-title">Preferred Time (WAT)</div>
          <div class="time-slots">
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="09:00" required>
              9:00 AM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="10:00">
              10:00 AM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="11:00">
              11:00 AM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="12:00">
              12:00 PM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="14:00">
              2:00 PM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="15:00">
              3:00 PM
            </label>
            <label class="time-slot" onclick="selectTimeSlot(this)">
              <input type="radio" name="consultationTime" value="16:00">
              4:00 PM
            </label>
            <label class="time-slot unavailable" onclick="return false;">
              <input type="radio" name="consultationTime" value="17:00" disabled>
              5:00 PM
            </label>
            <label class="time-slot unavailable" onclick="return false;">
              <input type="radio" name="consultationTime" value="17:00" disabled>
              5:30 PM
            </label>
          </div>
        </div>

        <!-- Additional Notes -->
        <div class="form-section">
          <div class="form-section-title">Additional Notes</div>
          <div class="input-group">
            <label for="message">Anything specific you'd like to discuss?</label>
            <textarea id="message" name="message" rows="3" placeholder="E.g., I completed a risk assessment with score 65 and would like to discuss cyber liability options..."></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;" id="submitBtn">
          <span id="btnText">Book Consultation</span>
          <span id="btnSpinner" style="display: none; margin-left: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
              <path d="M21 12a9 9 0 11-6.219-8.56"/>
            </svg>
          </span>
        </button>
      </div>
    </form>

    <!-- Success Message -->
    <div id="successMessage" style="display: none; text-align: center; padding: 40px 20px;">
      <div style="width: 80px; height: 80px; background: rgba(59, 130, 246, 0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; color: var(--color-primary);">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2 style="font-size: 24px; margin-bottom: 12px;">Consultation Booked!</h2>
      <p style="color: var(--text-secondary); margin-bottom: 16px; max-width: 400px; margin-left: auto; margin-right: auto;">
        We've received your consultation request. An agent will confirm your appointment via email within 2 hours.
      </p>
      <div class="card" style="text-align: left; margin-bottom: 24px;">
        <div class="card-body">
          <p style="font-size: 14px; color: var(--text-secondary); margin-bottom: 12px;">
            <strong>What's next?</strong>
          </p>
          <ul style="font-size: 13px; color: var(--text-secondary); padding-left: 20px; line-height: 1.8;">
            <li>Check your email for confirmation</li>
            <li>Our agent will call to confirm your slot</li>
            <li>Prepare any questions about your risk profile</li>
          </ul>
        </div>
      </div>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>

    <!-- Error Message -->
    <div id="errorMessage" class="card" style="display: none; margin-top: 16px;">
      <div class="card-body" style="color: var(--color-danger); text-align: center;">
        <p id="errorText"></p>
      </div>
    </div>
  </div>

  <script>
    // Set minimum date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    document.getElementById('consultationDate').min = tomorrow.toISOString().split('T')[0];

    function toggleConsultationType(card) {
      // Unselect all in group
      document.querySelectorAll('.consultation-type-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      card.querySelector('input').checked = true;
    }

    function selectTimeSlot(slot) {
      if (slot.classList.contains('unavailable')) return;
      document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
      slot.classList.add('selected');
      slot.querySelector('input').checked = true;
    }

    const form = document.getElementById('consultationForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorDiv = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    const successDiv = document.getElementById('successMessage');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv.style.display = 'none';
      submitBtn.disabled = true;
      document.getElementById('btnText').textContent = 'Booking...';
      document.getElementById('btnSpinner').style.display = 'inline';

      const consultationType = document.querySelector('input[name="consultationType"]:checked');
      const consultationTime = document.querySelector('input[name="consultationTime"]:checked');

      if (!consultationType) {
        errorText.textContent = 'Please select a consultation type.';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Book Consultation';
        return;
      }

      if (!consultationTime) {
        errorText.textContent = 'Please select a preferred time.';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Book Consultation';
        return;
      }

      const data = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        consultationType: consultationType.value,
        consultationDate: document.getElementById('consultationDate').value,
        consultationTime: consultationTime.value,
        message: document.getElementById('message').value,
        type: 'consultation'
      };

      try {
        const token = localStorage.getItem('accessToken');
        const res = await fetch('/api/public/consultation-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: `Bearer ${token}` } : {})
          },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (!res.ok) {
          throw new Error(result.message || 'Failed to book consultation');
        }

        form.style.display = 'none';
        successDiv.style.display = 'block';

      } catch (err) {
        errorText.textContent = err.message;
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        document.getElementById('btnText').textContent = 'Book Consultation';
        document.getElementById('btnSpinner').style.display = 'none';
      }
    });

    // Pre-fill if logged in
    const user = localStorage.getItem('user');
    if (user) {
      try {
        const userData = JSON.parse(user);
        document.getElementById('name').value = userData.name || '';
        document.getElementById('email').value = userData.email || '';
      } catch (e) {}
    }
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
