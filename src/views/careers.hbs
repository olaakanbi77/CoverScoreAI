          </div>
          <div class="job-card">
            <div class="job-info">
              <h3>Product Manager</h3>
              <div class="job-meta">
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> San Francisco / Remote</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg> Product</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Full-time</span>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
              <div class="job-tags">
                <span class="job-tag">SaaS</span>
                <span class="job-tag">B2B</span>
                <span class="job-tag">AI</span>
              </div>
              <a href="/careers/apply" class="btn btn-primary btn-sm">Apply</a>
            </div>
          </div>
          <div class="job-card">
            <div class="job-info">
              <h3>Insurance Data Analyst</h3>
              <div class="job-meta">
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> New York / Remote</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg> Analytics</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Full-time</span>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
              <div class="job-tags">
                <span class="job-tag">SQL</span>
                <span class="job-tag">Python</span>
                <span class="job-tag">Insurance</span>
              </div>
              <a href="/careers/apply" class="btn btn-primary btn-sm">Apply</a>
            </div>
          </div>
          <div class="job-card">
            <div class="job-info">
              <h3>Customer Success Manager</h3>
              <div class="job-meta">
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> San Francisco / Remote</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg> Customer Success</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Full-time</span>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
              <div class="job-tags">
                <span class="job-tag">SaaS</span>
                <span class="job-tag">Enterprise</span>
                <span class="job-tag">B2B</span>
              </div>
              <a href="/careers/apply" class="btn btn-primary btn-sm">Apply</a>
            </div>
          </div>
          <div class="job-card">
            <div class="job-info">
              <h3>Senior Frontend Engineer</h3>
              <div class="job-meta">
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Remote</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg> Engineering</span>
                <span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Full-time</span>
