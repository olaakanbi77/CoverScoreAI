    <section class="careers-section culture-section">
      <div class="container">
        <div class="section-label" style="color: rgba(255,255,255,0.6);">Our Culture</div>
        <h2 class="section-title">Work That Matters</h2>
        <p class="section-text">At CoverScore AI, you'll tackle meaningful challenges that help businesses protect what they've built. We move fast, ship often, and always keep the customer at the center of everything we do.</p>
        <div class="perks-grid">
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Fast-Paced Environment</h4>
              <p>We ship weekly. Your ideas go from concept to production fast.</p>
            </div>
          </div>
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Smart teammates</h4>
              <p>Work alongside talented engineers, insurers, and product experts.</p>
            </div>
          </div>
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Real Impact</h4>
              <p>Your work directly helps 10,000+ businesses manage their risk.</p>
            </div>
          </div>
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Growth Opportunities</h4>
              <p>Clear career paths with mentorship and training programs.</p>
            </div>
          </div>
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Diverse & Inclusive</h4>
              <p>We celebrate differences and create space for everyone to thrive.</p>
            </div>
          </div>
          <div class="perk-item">
            <div class="perk-icon">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h4>Quarterly Retreats</h4>
              <p>Meet your teammates in person at our all-company gatherings.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="careers-section" style="background: #f8fafc; text-align: center;">
      <div class="container">
        <h2 class="section-title">Don't See a Perfect Fit?</h2>
        <p class="section-text" style="max-width: 500px; margin: 0 auto;">We're always interested in meeting talented people. Send us your resume and tell us how you could contribute to our mission.</p>
        <a href="mailto:careers@coverscore.ai" class="btn btn-primary btn-lg" style="margin-top: 24px;">Send Us Your Resume</a>
      </div>
    </section>

