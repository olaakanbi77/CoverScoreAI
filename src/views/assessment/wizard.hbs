    async function init() {
      showLoading(true);

      const token = localStorage.getItem('accessToken');
      const storedId = localStorage.getItem('guestAssessmentId');
      
      try {
        const url = new URL('/api/assessment/start', window.location.origin);
        if (storedId && !token) url.searchParams.append('assessmentId', storedId);

        const headers = {};
        if (token) headers.Authorization = `Bearer ${token}`;

        const res = await fetch(url, { headers });

        if (!res.ok) {
          throw new Error('Failed to load assessment');
        }

        const data = await res.json();
        assessmentId = data.assessmentId;
        
        if (assessmentId && !token) {
          localStorage.setItem('guestAssessmentId', assessmentId);
        }

        if (data.progress && data.progress.completedSections) {
          const completedCount = data.progress.completedSections.length;
          currentStep = Math.min(completedCount, sections.length - 1);
        }

        buildStepper();
        renderStep(currentStep);
      } catch (err) {
        console.error(err);
        buildStepper();
        renderStep(0);
      }

      showLoading(false);
    }

    // ── Render ─────────────────────────────────────────────────────
    function renderStep(step) {
      const section = sections[step];
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');

      // Update stepper
      const stepperItems = document.querySelectorAll('.stepper-item');
      stepperItems.forEach((item, idx) => {
        item.classList.remove('active', 'completed');
        if (idx < step) item.classList.add('completed');
        if (idx === step) item.classList.add('active');
      });

      progressBar.style.width = `${((step + 1) / sections.length) * 100}%`;
      progressText.textContent = `Step ${step + 1} of ${sections.length}`;
      prevBtn.style.display = step > 0 ? '' : 'none';
      nextBtn.textContent = step === sections.length - 1 ? 'Submit Assessment' : 'Next';

      // Hide next button on type step until a persona is selected
      if (section.id === 'type' && !entityType) {
        nextBtn.style.display = 'none';
      } else {
        nextBtn.style.display = '';
      }

      let html = `<h2 style="font-size: 20px; margin-bottom: 4px;">${section.title}</h2>
        <p class="text-muted text-sm" style="margin-bottom: 24px;">${section.subtitle}</p>`;

      section.fields.forEach(field => {
        const savedValue = answers[section.id]?.[field.name];

        html += `<div class="input-group" style="margin-bottom: 24px;">`;

        if (field.type === 'persona') {
          html += `<div class="persona-cards">`;
          field.options.forEach(opt => {
            const isSelected = savedValue === opt.value || entityType === opt.value;
            html += `<div class="persona-card ${isSelected ? 'selected' : ''}" onclick="selectPersona('${opt.value}')">
              <div class="persona-icon">${opt.icon}</div>
              <div class="persona-title">${opt.title}</div>
              <div class="persona-desc">${opt.desc}</div>
            </div>`;
          });
          html += `</div>`;
        } else if (field.type === 'select') {
          html += `<label for="${field.name}" style="display: block; margin-bottom: 8px; font-weight: 500;">${field.label}</label>`;
          html += `<select id="${field.name}" name="${field.name}" onchange="saveField('${section.id}', '${field.name}', this.value)" style="width: 100%; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white;">`;
          html += `<option value="">Select...</option>`;
          field.options.forEach(opt => {
            html += `<option value="${opt.value}" ${savedValue === opt.value ? 'selected' : ''}>${opt.label}</option>`;
          });
          html += `</select>`;
        } else if (field.type === 'radio') {
          html += `<label style="display: block; margin-bottom: 12px; font-weight: 500;">${field.label}</label>`;
          html += `<div class="radio-group">`;
          field.options.forEach(opt => {
            const isSelected = savedValue === opt.value;
            html += `<label class="radio-option ${isSelected ? 'selected' : ''}" onclick="selectRadio(this, '${section.id}', '${field.name}', '${opt.value}')">
              <input type="radio" name="${field.name}" value="${opt.value}" ${isSelected ? 'checked' : ''}>
              <div class="radio-option-content">
                <div class="radio-option-title" style="font-weight: 600; font-size: 15px;">${opt.title}</div>
                <div class="radio-option-desc" style="font-size: 13px; color: rgba(255,255,255,0.5);">${opt.desc}</div>
              </div>
            </label>`;
          });
          html += `</div>`;
        } else if (field.type === 'text') {
          html += `<label for="${field.name}" style="display: block; margin-bottom: 8px; font-weight: 500;">${field.label}</label>`;
          html += `<input type="text" id="${field.name}" name="${field.name}" value="${savedValue || ''}" onchange="saveField('${section.id}', '${field.name}', this.value)" style="width: 100%; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white;" placeholder="Type your answer here..." />`;
        }
        html += `</div>`;
      });

      document.getElementById('stepContent').innerHTML = html;
    }

    // ── Interactions ───────────────────────────────────────────────
    function selectPersona(type) {
      setEntityType(type);
      document.getElementById('nextBtn').style.display = '';
      // Re-render to show selection
      renderStep(currentStep);
    }

    function selectRadio(el, sectionId, fieldName, value) {
      const parent = el.closest('.radio-group');
      parent.querySelectorAll('.radio-option').forEach(opt => opt.classList.remove('selected'));
      el.classList.add('selected');
      el.querySelector('input').checked = true;
      saveField(sectionId, fieldName, value);
    }

    async function saveField(sectionId, fieldName, value) {
      if (!answers[sectionId]) answers[sectionId] = {};
      answers[sectionId][fieldName] = value;

      const token = localStorage.getItem('accessToken');
      
      try {
        const res = await fetch('/api/assessment/section', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: `Bearer ${token}` } : {})
          },
          body: JSON.stringify({
            section: sectionId,
            data: answers[sectionId],
            assessmentId: assessmentId
          })
        });
        
        if (res.ok) {
           const data = await res.json();
           assessmentId = data.assessmentId;
           if (!token) localStorage.setItem('guestAssessmentId', assessmentId);
        }
      } catch (err) {
        console.error('Failed to save:', err);
      }
    }

    async function nextStep() {
      if (currentStep === 0 && !entityType) return; // guard
      if (currentStep < sections.length - 1) {
        currentStep++;
        renderStep(currentStep);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        await submitAssessment();
      }
    }

    function prevStep() {
      if (currentStep > 0) {
        currentStep--;
        renderStep(currentStep);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    async function submitAssessment() {
      showLoading(true);

      const token = localStorage.getItem('accessToken');

      try {
        const res = await fetch('/api/assessment/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: `Bearer ${token}` } : {})
          },
          body: JSON.stringify({
            assessmentId: assessmentId
          })
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.message || 'Submission failed');
        }

        // Always store the assessment ID for the email capture flow
        localStorage.setItem('lastAssessmentId', data.assessmentId);

        window.location.href = data.redirectTo || '/assessment/email-capture';
      } catch (err) {
        alert(err.message);
        showLoading(false);
      }
    }

    async function saveAndExit() {
      showLoading(true);
      window.location.href = localStorage.getItem('accessToken') ? '/dashboard' : '/';
    }

    function showLoading(show) {
      document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
    }

    init();
  </script>
  <script src="/js/main.js"></script>
