    let sections = [typeSection]; // Start with only the type selector
    let currentStep = 0;
    let answers = {};
    let assessmentId = null;
    let entityType = null;

    function setEntityType(type) {
      entityType = type;
      answers.type = { entity_type: type };

      if (type === 'business') {
        sections = [typeSection, ...businessSections];
        document.getElementById('wizardTitle').textContent = 'Business Risk Assessment';
      } else {
        sections = [typeSection, ...individualSections];
        document.getElementById('wizardTitle').textContent = 'Personal Risk Assessment';
      }

      // Rebuild stepper
      buildStepper();

      // Save the type section immediately
      saveField('type', 'entity_type', type);
    }

    function buildStepper() {
      const stepperEl = document.getElementById('stepper');
      let html = '';
      for (let i = 0; i < sections.length; i++) {
        if (i > 0) html += '<div class="stepper-line"></div>';
        const cls = i < currentStep ? 'completed' : (i === currentStep ? 'active' : '');
        html += `<div class="stepper-item ${cls}" data-step="${i}"><div class="stepper-circle">${i + 1}</div></div>`;
      }
      stepperEl.innerHTML = html;
    }

