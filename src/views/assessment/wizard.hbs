            { value: 'one', title: 'One Vehicle', desc: 'One car or motorcycle' },
            { value: 'multiple', title: 'Multiple Vehicles', desc: 'Two or more vehicles' }
          ]},
          { name: 'highValueItems', label: 'Do you own high-value personal items? (Jewellery, electronics, art)', type: 'radio', options: [
            { value: 'no', title: 'No', desc: 'Standard personal belongings' },
