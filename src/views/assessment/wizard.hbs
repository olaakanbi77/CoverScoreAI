        ]
      },
      {
        id: 'insurance',
        title: 'Current Insurance',
        subtitle: 'Your existing insurance coverage',
        fields: [
          { name: 'existing', label: 'Do you currently have business insurance?', type: 'radio', options: [
            { value: 'full', title: 'Full Coverage', desc: 'Comprehensive business insurance' },
            { value: 'partial', title: 'Partial Coverage', desc: 'Some policies in place' },
            { value: 'none', title: 'No Coverage', desc: 'Currently uninsured' }
          ]},
          { name: 'lastReview', label: 'When was your last insurance policy review?', type: 'radio', options: [
