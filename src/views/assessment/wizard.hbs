<style>
  .assessment-section {
    display: none;
  }
  .assessment-section.active {
    display: block;
  }
  .radio-option {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: 0.75rem;
  }
  .radio-option:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .radio-option.selected {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }
  .radio-option input {
    display: none;
  }
  .loading-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .persona-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .persona-card {
    position: relative;
    padding: 2rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }
  .persona-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-4px);
  }
  .persona-card.selected {
    background: rgba(59, 130, 246, 0.12);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary), 0 8px 24px rgba(59, 130, 246, 0.15);
  }
  .persona-card .persona-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .persona-card .persona-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .persona-card .persona-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
  }
  @media (max-width: 600px) {
    .persona-cards {
      grid-template-columns: 1fr;
    }
  }
  .py-12 {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .max-w-3xl {
    max-width: 48rem;
  }
  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
  .mb-8 {
    margin-bottom: 2rem;
  }
  .mt-8 {
    margin-top: 2rem;
  }
  .text-2xl {
    font-size: 1.5rem;
    line-height: 2rem;
  }
  .btn-group {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
  }
  /* Give the wizard a premium dark navy background matching the landing page hero */
  body {
    background: radial-gradient(circle at top right, #1e293b, #0f172a) !important;
    color: #f8fafc;
  }
</style>
  <div class="container py-12">
    <div class="glass-card max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold" id="wizardTitle">Risk Assessment</h1>
          <p class="text-muted text-sm" id="progressText">Step 1 of 6</p>
        </div>
        <button class="btn btn-ghost btn-sm" onclick="saveAndExit()">Save &amp; Exit</button>
      </div>

      <div class="progress-bar mb-8">
        <div class="progress-bar-fill" id="progressBar" style="width: 16.6%;"></div>
      </div>

      <div class="stepper mb-8" id="stepper"></div>

      <form id="assessmentForm">
        <div id="stepContent"></div>

        <div class="btn-group mt-8" id="btnGroup">
          <button type="button" class="btn btn-secondary" id="prevBtn" onclick="prevStep()" style="display: none;">Previous</button>
          <button type="button" class="btn btn-primary" id="nextBtn" onclick="nextStep()">Next</button>
        </div>
      </form>
    </div>
  </div>

  <div id="loadingOverlay" class="loading-overlay" style="display: none; flex-direction: column; gap: 1rem;">
    <div class="loading-spinner"></div>
    <div style="color: white; font-weight: 600; font-size: 1.1rem; text-align: center; max-width: 80%;">
      Analyzing your responses...<br>
      <span style="font-size: 0.9rem; font-weight: 400; opacity: 0.8; margin-top: 0.5rem; display: inline-block;">CoverScore AI is generating your personalized risk report. This usually takes 15-30 seconds.</span>
    </div>
  </div>

  <script>
    // ── Section Definitions ──────────────────────────────────────────

    const typeSection = {
      id: 'type',
      title: 'Who is this assessment for?',
      subtitle: 'Select whether you are assessing risk for a business or for yourself as an individual.',
      fields: [
        {
          name: 'entity_type',
          label: '',
          type: 'persona',
          options: [
            { value: 'business', icon: '🏢', title: 'Business', desc: 'Assess risks for your company, SME, or organisation.' },
            { value: 'individual', icon: '👤', title: 'Individual', desc: 'Assess personal risks — health, assets, motor, life cover.' }
          ]
        }
      ]
    };

    let allTemplates = [];

    // ── State ──────────────────────────────────────────────────────
    let sections = [typeSection]; // Start with only the type selector
    let currentStep = 0;
    let answers = {};
    let assessmentId = null;
    let entityType = null;
    let selectedTemplateId = null;

    async function setEntityType(type) {
      entityType = type;
      answers.type = { entity_type: type };
      saveField('type', 'entity_type', type);

      const trackName = type === 'business' ? 'Business' : 'Personal';
      const available = allTemplates.filter(t => t.track === trackName);
      
      const templateSection = {
        id: 'template_selection',
        title: 'Select Assessment Template',
        subtitle: `Choose the specific risk profile for your ${type} assessment.`,
        fields: [
          {
            name: 'template_id',
            label: '',
            type: 'template_picker',
            options: available.map(t => ({ value: t.id, title: t.title, desc: t.description }))
          }
        ]
      };

      sections = [typeSection, templateSection];
      document.getElementById('wizardTitle').textContent = trackName + ' Risk Assessment';
      buildStepper();
      currentStep = 1;
      renderStep(currentStep);
    }

    function buildStepper() {
      const stepperEl = document.getElementById('stepper');
      let html = '';
      for (let i = 0; i < sections.length; i++) {
        if (i > 0) html += '<div class="stepper-line"></div>';
        const cls = i < currentStep ? 'completed' : (i === currentStep ? 'active' : '');
        html += `<div class="stepper-item ${cls}" data-step="${i}"><div class="stepper-circle">${i + 1}</div></div>`;
      }
      stepperEl.innerHTML = html;
    }

    // ── Init ──────────────────────────────────────────────────────
    async function init() {
      showLoading(true);

      const token = localStorage.getItem('accessToken');
      const storedId = localStorage.getItem('guestAssessmentId');
      
      try {
        const url = new URL('/api/assessment/start', window.location.origin);
        if (storedId && !token) url.searchParams.append('assessmentId', storedId);

        const headers = {};
        if (token) headers.Authorization = `Bearer ${token}`;

        const [startRes, templatesRes] = await Promise.all([
          fetch(url, { headers }),
          fetch('/api/assessment/templates', { headers })
        ]);

        if (!startRes.ok || !templatesRes.ok) {
          throw new Error('Failed to load assessment data');
        }

        const data = await startRes.json();
        allTemplates = await templatesRes.json();
        
        assessmentId = data.assessmentId;
        if (assessmentId && !token) {
          localStorage.setItem('guestAssessmentId', assessmentId);
        }

        if (data.progress && data.progress.completedSections) {
          const completedCount = data.progress.completedSections.length;
          currentStep = Math.min(completedCount, sections.length - 1);
        }

        buildStepper();
        renderStep(currentStep);
      } catch (err) {
        console.error(err);
        buildStepper();
        renderStep(0);
      }

      showLoading(false);
    }

    // ── Render ─────────────────────────────────────────────────────
    function renderStep(step) {
      const section = sections[step];
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');

      // Update stepper
      const stepperItems = document.querySelectorAll('.stepper-item');
      stepperItems.forEach((item, idx) => {
        item.classList.remove('active', 'completed');
        if (idx < step) item.classList.add('completed');
        if (idx === step) item.classList.add('active');
      });

      progressBar.style.width = `${((step + 1) / sections.length) * 100}%`;
      progressText.textContent = `Step ${step + 1} of ${sections.length}`;
      prevBtn.style.display = step > 0 ? '' : 'none';
      nextBtn.textContent = step === sections.length - 1 ? 'Submit Assessment' : 'Next';

      // Hide next button on type step until a persona is selected
      if (section.id === 'type' && !entityType) {
        nextBtn.style.display = 'none';
      } else {
        nextBtn.style.display = '';
      }

      let html = `<h2 style="font-size: 20px; margin-bottom: 4px;">${section.title}</h2>
        <p class="text-muted text-sm" style="margin-bottom: 24px;">${section.subtitle}</p>`;

      section.fields.forEach(field => {
        const savedValue = answers[section.id]?.[field.name];

        html += `<div class="input-group" style="margin-bottom: 24px;">`;

        if (field.type === 'persona') {
          html += `<div class="persona-cards">`;
          field.options.forEach(opt => {
            const isSelected = savedValue === opt.value || entityType === opt.value;
            html += `<div class="persona-card ${isSelected ? 'selected' : ''}" onclick="selectPersona('${opt.value}')">
              <div class="persona-icon">${opt.icon}</div>
              <div class="persona-title">${opt.title}</div>
              <div class="persona-desc">${opt.desc}</div>
            </div>`;
          });
          html += `</div>`;
        } else if (field.type === 'template_picker') {
          html += `<div class="persona-cards">`;
          field.options.forEach(opt => {
            const isSelected = savedValue === opt.value || selectedTemplateId === opt.value;
            html += `<div class="persona-card ${isSelected ? 'selected' : ''}" onclick="selectTemplate('${opt.value}')">
              <div class="persona-title">${opt.title}</div>
              <div class="persona-desc">${opt.desc}</div>
            </div>`;
          });
          html += `</div>`;
        } else if (field.type === 'select') {
          html += `<label for="${field.name}" style="display: block; margin-bottom: 8px; font-weight: 500;">${field.label}</label>`;
          html += `<select id="${field.name}" name="${field.name}" onchange="saveField('${section.id}', '${field.name}', this.value)" style="width: 100%; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white;">`;
          html += `<option value="">Select...</option>`;
          field.options.forEach(opt => {
            html += `<option value="${opt.value}" ${savedValue === opt.value ? 'selected' : ''}>${opt.label}</option>`;
          });
          html += `</select>`;
        } else if (field.type === 'radio') {
          html += `<label style="display: block; margin-bottom: 12px; font-weight: 500;">${field.label}</label>`;
          html += `<div class="radio-group">`;
          field.options.forEach(opt => {
            const isSelected = savedValue === opt.value;
            html += `<label class="radio-option ${isSelected ? 'selected' : ''}" onclick="selectRadio(this, '${section.id}', '${field.name}', '${opt.value}')">
              <input type="radio" name="${field.name}" value="${opt.value}" ${isSelected ? 'checked' : ''}>
              <div class="radio-option-content">
                <div class="radio-option-title" style="font-weight: 600; font-size: 15px;">${opt.title}</div>
                <div class="radio-option-desc" style="font-size: 13px; color: rgba(255,255,255,0.5);">${opt.desc}</div>
              </div>
            </label>`;
          });
          html += `</div>`;
        } else if (field.type === 'text') {
          html += `<label for="${field.name}" style="display: block; margin-bottom: 8px; font-weight: 500;">${field.label}</label>`;
          html += `<input type="text" id="${field.name}" name="${field.name}" value="${savedValue || ''}" onchange="saveField('${section.id}', '${field.name}', this.value)" style="width: 100%; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white;" placeholder="Type your answer here..." />`;
        }
        html += `</div>`;
      });

      document.getElementById('stepContent').innerHTML = html;
    }

    // ── Interactions ───────────────────────────────────────────────
    function selectPersona(type) {
      setEntityType(type);
    }

    async function selectTemplate(templateId) {
      selectedTemplateId = templateId;
      saveField('template_selection', 'template_id', templateId);
      
      showLoading(true);
      try {
        const token = localStorage.getItem('accessToken');
        const headers = token ? { Authorization: `Bearer ${token}` } : {};
        const res = await fetch(`/api/assessment/template/${templateId}/questions`, { headers });
        const questions = await res.json();
        
        const grouped = {};
        questions.forEach(q => {
          if (!grouped[q.category]) {
            grouped[q.category] = {
              id: q.category.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase(),
              title: q.category,
              subtitle: '',
              fields: []
            };
          }
          
          let fieldType = 'text';
          let options = [];
          if (q.answer_type === 'yes_no') {
            fieldType = 'radio';
            options = [
              { value: 'yes', title: 'Yes', desc: '' },
              { value: 'no', title: 'No', desc: '' }
            ];
          } else if (q.answer_type === 'yes_no_notsure') {
            fieldType = 'radio';
            options = [
              { value: 'yes', title: 'Yes', desc: '' },
              { value: 'no', title: 'No', desc: '' },
              { value: 'notsure', title: 'Not sure', desc: '' }
            ];
          } else if (q.answer_type === 'yes_no_na') {
            fieldType = 'radio';
            options = [
              { value: 'yes', title: 'Yes', desc: '' },
              { value: 'no', title: 'No', desc: '' },
              { value: 'na', title: 'N/A', desc: '' }
            ];
          } else if (q.answer_type === 'months_survival') {
            fieldType = 'radio';
            options = [
              { value: 'less_3', title: 'Less than 3 months', desc: '' },
              { value: '3_6', title: '3-6 months', desc: '' },
              { value: '6_12', title: '6-12 months', desc: '' },
              { value: '12_24', title: '12-24 months', desc: '' },
              { value: 'over_24', title: 'Over 24 months', desc: '' }
            ];
          }
          
          grouped[q.category].fields.push({
            name: q.id, // Store answers by question ID
            label: q.question_text,
            type: fieldType,
            options: options
          });
        });
        
        const dynamicSections = Object.values(grouped);
        sections = [typeSection, sections[1], ...dynamicSections];
        buildStepper();
        document.getElementById('nextBtn').style.display = '';
        renderStep(currentStep);
      } catch (err) {
        console.error(err);
      }
      showLoading(false);
    }

    function selectRadio(el, sectionId, fieldName, value) {
      const parent = el.closest('.radio-group');
      parent.querySelectorAll('.radio-option').forEach(opt => opt.classList.remove('selected'));
      el.classList.add('selected');
      el.querySelector('input').checked = true;
      saveField(sectionId, fieldName, value);
    }

    async function saveField(sectionId, fieldName, value) {
      if (!answers[sectionId]) answers[sectionId] = {};
      answers[sectionId][fieldName] = value;

      const token = localStorage.getItem('accessToken');
      
      try {
        const res = await fetch('/api/assessment/section', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: `Bearer ${token}` } : {})
          },
          body: JSON.stringify({
            section: sectionId,
            data: answers[sectionId],
            assessmentId: assessmentId
          })
        });
        
        if (res.ok) {
           const data = await res.json();
           assessmentId = data.assessmentId;
           if (!token) localStorage.setItem('guestAssessmentId', assessmentId);
        }
      } catch (err) {
        console.error('Failed to save:', err);
      }
    }

    async function nextStep() {
      if (currentStep === 0 && !entityType) return; // guard
      if (currentStep < sections.length - 1) {
        currentStep++;
        renderStep(currentStep);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        await submitAssessment();
      }
    }

    function prevStep() {
      if (currentStep > 0) {
        currentStep--;
        renderStep(currentStep);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    async function submitAssessment() {
      showLoading(true);

      const token = localStorage.getItem('accessToken');

      try {
        const res = await fetch('/api/assessment/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { Authorization: `Bearer ${token}` } : {})
          },
          body: JSON.stringify({
            assessmentId: assessmentId
          })
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.message || 'Submission failed');
        }

        // Always store the assessment ID for the email capture flow
        localStorage.setItem('lastAssessmentId', data.assessmentId);

        window.location.href = data.redirectTo || '/assessment/email-capture';
      } catch (err) {
        alert(err.message);
        showLoading(false);
      }
    }

    async function saveAndExit() {
      showLoading(true);
      window.location.href = localStorage.getItem('accessToken') ? '/dashboard' : '/';
    }

    function showLoading(show) {
      document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
    }

    init();
  </script>
  <script src="/js/main.js"></script>
