          ]}
        ]
      }
    ];

    const individualSections = [
      {
        id: 'personal',
        title: 'Personal Information',
        subtitle: 'Tell us a bit about yourself',
        fields: [
          { name: 'ageRange', label: 'What is your age range?', type: 'radio', options: [
            { value: '18_24', title: '18 – 24', desc: 'Young adult' },
            { value: '25_39', title: '25 – 39', desc: 'Early to mid career' },
            { value: '40_54', title: '40 – 54', desc: 'Established professional' },
            { value: '55plus', title: '55+', desc: 'Pre-retirement or retired' }
          ]},
          { name: 'employment', label: 'What is your employment status?', type: 'radio', options: [
            { value: 'employed', title: 'Employed', desc: 'Full-time or part-time employee' },
            { value: 'self_employed', title: 'Self-Employed', desc: 'Freelancer, business owner, contractor' },
            { value: 'unemployed', title: 'Unemployed / Student', desc: 'Not currently earning regular income' }
          ]},
          { name: 'dependents', label: 'How many dependents do you support?', type: 'radio', options: [
            { value: 'none', title: 'None', desc: 'No financial dependents' },
            { value: 'few', title: '1 – 3', desc: 'Small family or relatives' },
            { value: 'many', title: '4+', desc: 'Extended family support' }
          ]},
          { name: 'locationType', label: 'Where do you live?', type: 'radio', options: [
            { value: 'urban', title: 'Urban Area', desc: 'Lagos, Abuja, Port Harcourt, etc.' },
            { value: 'suburban', title: 'Suburban', desc: 'Outskirts of a major city' },
            { value: 'rural', title: 'Rural Area', desc: 'Village or rural community' }
          ]}
        ]
      },
      {
        id: 'personal_assets',
        title: 'Your Assets',
        subtitle: 'What do you own or need to protect?',
        fields: [
          { name: 'housing', label: 'What is your housing situation?', type: 'radio', options: [
            { value: 'owned', title: 'Own My Home', desc: 'Homeowner or property owner' },
            { value: 'rented', title: 'Renting', desc: 'Tenant in a rented apartment/house' },
