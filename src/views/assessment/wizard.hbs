          ]}
        ]
      },
      {
        id: 'personal_insurance',
        title: 'Current Insurance',
        subtitle: 'What coverage do you already have?',
        fields: [
          { name: 'health', label: 'Do you have health insurance (HMO)?', type: 'radio', options: [
            { value: 'comprehensive', title: 'Comprehensive', desc: 'Full HMO covering most needs' },
            { value: 'basic', title: 'Basic', desc: 'Limited or employer plan only' },
            { value: 'none', title: 'None', desc: 'No health insurance' }
          ]},
          { name: 'life', label: 'Do you have life insurance?', type: 'radio', options: [
            { value: 'comprehensive', title: 'Yes – Comprehensive', desc: 'Term life or whole life policy' },
