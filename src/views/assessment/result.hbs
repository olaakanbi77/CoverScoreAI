<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Risk Report - CoverScore AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css?v=2">
  <style>
    .report-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 16px;
    }

    /* Hero Score Section */
    .score-hero {
      background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(30, 41, 59, 0.8) 100%);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 48px 32px;
      text-align: center;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .score-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-success));
    }
    .score-hero-label {
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--text-muted);
      margin-bottom: 24px;
    }
    .score-gauge-wrap {
      position: relative;
      width: 200px;
      height: 200px;
      margin: 0 auto 24px;
    }
    .score-gauge-bg {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(
        from 180deg,
        rgba(255,255,255,0.05) 0deg,
        rgba(255,255,255,0.02) 180deg
      );
    }
    .score-gauge-fill {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(
        from 180deg,
        var(--gauge-color, var(--color-success)) 0deg,
        var(--gauge-color-end, var(--color-success)) var(--gauge-angle, 180deg),
        transparent var(--gauge-angle, 180deg)
      );
      mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #fff calc(100% - 12px));
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #fff calc(100% - 12px));
    }
    .score-gauge-inner {
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      background: var(--bg-surface);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .score-number {
      font-family: var(--font-mono);
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      color: var(--score-color, var(--color-success));
    }
    .score-max {
      font-size: 14px;
      color: var(--text-muted);
      font-weight: 500;
    }
    .risk-badge-large {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 24px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .risk-badge-large.low { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .risk-badge-large.moderate { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .risk-badge-large.high { background: rgba(249, 115, 22, 0.15); color: #f97316; }
    .risk-badge-large.critical { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

    /* Bento Grid Hero */
    .bento-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 20px;
      margin-bottom: 32px;
    }
    .bento-box {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 32px;
      position: relative;
      overflow: hidden;
    }
    .score-box {
      grid-column: 1;
      grid-row: 1;
      text-align: center;
      background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(30, 41, 59, 0.8) 100%);
    }
    .score-box::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-success));
    }
    .risk-box {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .exposure-box {
      grid-column: 1 / span 2;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%);
    }
    
    .cta-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .cta-row a {
      flex: 1;
      min-width: 180px;
      text-align: center;
      justify-content: center;
    }

    @media (max-width: 768px) {
      .bento-hero {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
        gap: 16px;
      }
      .score-box { grid-column: 1; grid-row: 1; }
      .risk-box { grid-column: 1; grid-row: 2; }
      .exposure-box { grid-column: 1; grid-row: 3; }
    }

    /* Section Cards */
    .section-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 24px;
      overflow: hidden;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--glass-border);
    }
    .section-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .section-icon.primary { background: rgba(59, 130, 246, 0.15); color: var(--color-primary); }
    .section-icon.success { background: rgba(16, 185, 129, 0.15); color: var(--color-success); }
    .section-icon.warning { background: rgba(245, 158, 11, 0.15); color: var(--color-warning); }
    .section-icon.danger { background: rgba(239, 68, 68, 0.15); color: var(--color-danger); }
    .section-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .section-body {
      padding: 24px;
      color: var(--text-secondary);
      line-height: 1.75;
      font-size: 15px;
    }

    /* Risk Items */
    .risk-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .risk-item {
      display: flex;
      gap: 16px;
      padding: 16px;
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      transition: border-color 200ms;
    }
    .risk-item:hover {
      border-color: rgba(255,255,255,0.12);
    }
    .risk-item-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .risk-item-icon.high { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .risk-item-icon.medium { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .risk-item-icon.low { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .risk-item-content h4 {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 6px;
    }
    .risk-item-content p {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.6;
    }
    .risk-impact-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 3px 8px;
      border-radius: 4px;
      margin-top: 8px;
      display: inline-block;
    }
    .risk-impact-tag.high { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .risk-impact-tag.medium { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .risk-impact-tag.low { background: rgba(16, 185, 129, 0.15); color: #10b981; }

    /* Recommendations */
    .rec-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .rec-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 100px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-primary-hover);
    }
    .rec-tag svg {
      flex-shrink: 0;
    }

    /* Compliance Note */
    .compliance-note {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 22px;
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-md);
      margin-bottom: 32px;
    }
    .compliance-note svg {
      flex-shrink: 0;
      color: var(--color-primary);
      margin-top: 1px;
    }
    .compliance-note p {
      font-size: 13px;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.6;
    }
    .compliance-note strong {
      color: var(--text-primary);
    }

    /* AI Explanation Layer Styles */
    .ai-narrative {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.05) 100%);
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .ai-narrative::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--color-primary) 0%, rgba(139, 92, 246, 0.5) 100%);
    }
    .ai-narrative-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--color-primary);
      margin-bottom: 16px;
    }
    .ai-narrative-text {
      font-size: 17px;
      line-height: 1.8;
      color: var(--text-primary);
      margin: 0;
    }

    .risk-context-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 20px;
      overflow: hidden;
    }
    .risk-context-header {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--glass-border);
    }
    .risk-context-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .risk-context-icon.high { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .risk-context-icon.medium { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .risk-context-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 4px;
    }
    .risk-context-impact {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .risk-context-impact.high { color: #ef4444; }
    .risk-context-impact.medium { color: #f59e0b; }
    .risk-context-impact.low { color: #10b981; }
    .risk-context-body {
      padding: 20px 24px;
    }
    .risk-context-explanation {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-primary);
      margin: 0 0 16px;
    }
    .risk-context-why {
      font-size: 14px;
      line-height: 1.7;
      color: var(--text-secondary);
      padding: 14px 18px;
      background: rgba(255,255,255,0.02);
      border-left: 3px solid var(--color-primary);
      border-radius: 0 8px 8px 0;
      margin: 0;
    }
    .risk-context-why strong {
      color: var(--color-primary);
    }

    .urgency-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(249, 115, 22, 0.05) 100%);
      border: 1px solid rgba(245, 158, 11, 0.15);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    .urgency-card.critical {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(249, 115, 22, 0.05) 100%);
      border-color: rgba(239, 68, 68, 0.15);
    }
    .urgency-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .urgency-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .urgency-card.critical .urgency-icon { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .urgency-card:not(.critical) .urgency-icon { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .urgency-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .urgency-message {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-primary);
      margin: 0 0 16px;
    }
    .urgency-reasons {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .urgency-reasons li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
      padding: 6px 0;
    }
    .urgency-reasons li::before {
      content: '→';
      color: var(--color-primary);
      font-weight: 600;
    }

    .education-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 20px;
      overflow: hidden;
    }
    .education-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .education-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .education-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .education-body {
      padding: 20px 24px;
    }
    .education-item {
      margin-bottom: 18px;
    }
    .education-item:last-child {
      margin-bottom: 0;
    }
    .education-item-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-primary);
      margin-bottom: 6px;
    }
    .education-item-text {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-secondary);
      margin: 0 0 6px;
    }
    .education-item-benefit {
      font-size: 13px;
      color: var(--text-primary);
      padding: 8px 12px;
      background: rgba(16, 185, 129, 0.08);
      border-radius: 6px;
    }

    .conversion-card {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.08) 100%);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: var(--radius-xl);
      padding: 32px;
      text-align: center;
      margin: 32px 0;
    }
    .conversion-headline {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 8px;
    }
    .conversion-subtext {
      font-size: 15px;
      color: var(--text-secondary);
      margin: 0 0 24px;
      line-height: 1.6;
    }
    .conversion-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--color-primary);
      color: white;
      border-radius: 100px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: all 200ms;
    }
    .conversion-cta:hover {
      background: var(--color-primary-hover);
      transform: translateY(-2px);
    }

    /* Page Actions */
    .page-actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      padding: 24px 0 16px;
    }

    /* Loading */
    .loading-overlay {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      gap: 16px;
    }
    .loading-spinner-lg {
      width: 48px;
      height: 48px;
      border: 3px solid var(--glass-border);
      border-top-color: var(--color-primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    .loading-text {
      color: var(--text-muted);
      font-size: 14px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Animations */
    .fade-in {
      animation: fadeIn 400ms ease forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .stagger-1 { animation-delay: 0.05s; }
    .stagger-2 { animation-delay: 0.1s; }
    .stagger-3 { animation-delay: 0.15s; }
    .stagger-4 { animation-delay: 0.2s; }
    .stagger-5 { animation-delay: 0.25s; }

    @media (max-width: 600px) {
      .score-hero { padding: 36px 20px; }
      .score-gauge-wrap { width: 160px; height: 160px; }
      .score-number { font-size: 44px; }
      .section-header { padding: 16px 20px; }
      .section-body { padding: 20px; }
      .cta-row { flex-direction: column; }
      .cta-row a { min-width: unset; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-content">
      <a href="/" class="navbar-brand">Cover<span>Score</span> AI</a>
    </div>
  </nav>

  <main class="report-page">
    <!-- Loading State -->
    <div id="loadingOverlay" class="loading-overlay">
      <div class="loading-spinner-lg"></div>
      <p class="loading-text">Generating your personalized risk report...</p>
    </div>

    <!-- Report Content -->
    <div id="resultContent" style="display: none;">
      <!-- BENTO GRID HERO -->
      <div class="bento-hero">
        <!-- Box 1: CoverScore -->
        <div class="bento-box score-box fade-in stagger-1">
          <div class="score-hero-label">Your CoverScore</div>
          <div class="score-gauge-wrap">
            <div class="score-gauge-bg"></div>
            <div class="score-gauge-fill" id="scoreGauge"></div>
            <div class="score-gauge-inner">
              <span class="score-number" id="scoreValue">--</span>
              <span class="score-max">/ 100</span>
            </div>
          </div>
        </div>

        <!-- Box 2: Risk Level -->
        <div class="bento-box risk-box fade-in stagger-2">
          <div class="score-hero-label" style="margin-bottom: 12px;">Risk Level</div>
          <div class="risk-badge-large" id="riskBadge" style="margin-bottom: 16px;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="riskBadgeText">Calculating...</span>
          </div>
          <p id="riskProfileText" style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
            Based on your profile, you have a <strong id="riskText">--</strong> risk exposure compared to similar profiles.
          </p>
        </div>

        <!-- Box 3: Financial Exposure & CTAs -->
        <div class="bento-box exposure-box fade-in stagger-3">
          <div class="exposure-content">
            <div class="score-hero-label" style="margin-bottom: 8px;">Potential Financial Exposure</div>
            <div style="font-size: 28px; font-weight: 800; color: var(--text-primary); margin-bottom: 4px;">
              ₦<span id="maxLossVal">--</span>
            </div>
            <div id="financialExposureText" style="font-size: 13px; color: var(--text-muted); margin-bottom: 24px;">
              Estimated range: ₦<span id="minLossVal">--</span> – ₦<span id="maxLossVal2">--</span>
            </div>
            
            <div class="cta-row">
              <a href="/quote" class="btn btn-success">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Request Quote
              </a>
              <a href="/consultation" class="btn btn-outline">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Book Consultation
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- AI Explanation Layer -->
      <div id="aiExplanationLayer"></div>

      <!-- Report Sections -->
      <div id="reportContent"></div>

      <!-- Recommendations -->
      <div class="section-card fade-in stagger-3" id="recommendationsCard">
        <div class="section-header">
          <div class="section-icon success">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="section-title">Recommended Coverage</span>
        </div>
        <div class="section-body" id="recommendationsContent"></div>
      </div>

      <!-- Compliance Note -->
      <div class="compliance-note fade-in stagger-4">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p>
          <strong>NAICOM Compliant:</strong> These recommendations align with Nigerian insurance regulations and standards set by the National Insurance Commission (NAICOM). They are designed to ensure your business meets compulsory insurance requirements.
        </p>
      </div>

      <!-- Actions -->
      <div class="page-actions fade-in stagger-5">
        <a href="/assessment/start" class="btn btn-ghost">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Retake Assessment
        </a>
        <a href="/" class="btn btn-primary" id="homeBtn">Back to Home</a>
      </div>
    </div>
  </main>

  <script>
    const riskConfig = {
      low: {
        color: '#10b981',
        colorEnd: 'rgba(16, 185, 129, 0.3)',
        badgeClass: 'low',
        label: 'Low Risk',
        angle: 180
      },
      moderate: {
        color: '#f59e0b',
        colorEnd: 'rgba(245, 158, 11, 0.3)',
        badgeClass: 'moderate',
        label: 'Moderate Risk',
        angle: 135
      },
      high: {
        color: '#f97316',
        colorEnd: 'rgba(249, 115, 22, 0.3)',
        badgeClass: 'high',
        label: 'High Risk',
        angle: 90
      },
      critical: {
        color: '#ef4444',
        colorEnd: 'rgba(239, 68, 68, 0.3)',
        badgeClass: 'critical',
        label: 'Critical Risk',
        angle: 45
      }
    };

    function getRiskConfig(level) {
      return riskConfig[level] || riskConfig.moderate;
    }

    async function loadResult() {
      const pathParts = window.location.pathname.split('/');
      const assessmentId = pathParts[pathParts.length - 1];
      const token = localStorage.getItem('accessToken');

      try {
        const headers = {};
        if (token) headers.Authorization = `Bearer ${token}`;

        const res = await fetch(`/api/assessment/${assessmentId}`, { headers });
        if (!res.ok) throw new Error('Failed to load results');

        const data = await res.json();
        const score = data.score || 0;
        const riskLevel = data.riskLevel || data.risk_level || 'moderate';
        const cfg = getRiskConfig(riskLevel);

        // Set score and gauge
        document.getElementById('scoreValue').textContent = score;
        document.getElementById('scoreValue').style.color = cfg.color;
        const gauge = document.getElementById('scoreGauge');
        gauge.style.setProperty('--gauge-color', cfg.color);
        gauge.style.setProperty('--gauge-color-end', cfg.colorEnd);
        gauge.style.setProperty('--gauge-angle', `${(score / 100) * 360}deg`);

        // Set risk badge
        const badge = document.getElementById('riskBadge');
        badge.className = `risk-badge-large ${cfg.badgeClass}`;
        document.getElementById('riskBadgeText').textContent = cfg.label;

        // Set risk text
        document.getElementById('riskText').textContent = `${riskLevel.charAt(0).toUpperCase() + riskLevel.slice(1)}`;

        // Set financial exposure
        const formatMoney = (amount) => new Intl.NumberFormat('en-NG').format(amount);
        if (data.min_loss && data.max_loss) {
          document.getElementById('minLossVal').textContent = formatMoney(data.min_loss);
          document.getElementById('maxLossVal').textContent = formatMoney(data.max_loss);
          document.getElementById('maxLossVal2').textContent = formatMoney(data.max_loss);
          document.getElementById('financialExposureText').style.display = 'block';
        } else {
          document.getElementById('financialExposureText').style.display = 'none';
        }

        // Build AI Explanation Layer
        let aiExplanationHtml = '';
        const report = data.aiReport;

        if (report) {
          // Executive Summary
          if (report.executiveSummary) {
            aiExplanationHtml += `
              <div class="ai-narrative fade-in stagger-2">
                <div class="ai-narrative-label">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                  Executive Summary
                </div>
                <p class="ai-narrative-text" style="margin-bottom:15px;">${report.executiveSummary}</p>
                ${data.resilience_score ? `<p class="ai-narrative-text" style="margin-top:15px; color:var(--success);"><strong>Resilience Score:</strong> ${data.resilience_score}/100</p>` : ''}
              </div>`;
          }

          // Top Exposures & Financial Threats
          if ((report.topExposures && report.topExposures.length) || (report.topFinancialThreats && report.topFinancialThreats.length)) {
            aiExplanationHtml += `
              <div class="section-card fade-in">
                <div class="section-header">
                  <div class="section-icon danger">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                  </div>
                  <span class="section-title">Top Risk Exposures & Threats</span>
                </div>
                <div class="section-body" style="padding: 16px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                  <div>
                    <h4 style="margin-bottom: 10px; font-size: 14px; color: var(--text);">Top 5 Exposures</h4>
                    <ul style="margin: 0; padding-left: 20px; color: var(--text-secondary); font-size: 13px;">
                      ${(report.topExposures || []).map(exp => `<li style="margin-bottom: 6px;">${exp}</li>`).join('')}
                    </ul>
                  </div>
                  <div>
                    <h4 style="margin-bottom: 10px; font-size: 14px; color: var(--danger);">Top 5 Financial Threats</h4>
                    <ul style="margin: 0; padding-left: 20px; color: var(--danger); font-size: 13px;">
                      ${(report.topFinancialThreats || []).map(threat => `<li style="margin-bottom: 6px;">${threat}</li>`).join('')}
                    </ul>
                  </div>
                </div>
              </div>`;
          }

          // Key Protection Gaps
          if (report.topProtectionGaps && report.topProtectionGaps.length) {
             aiExplanationHtml += `
              <div class="section-card fade-in">
                <div class="section-header">
                  <div class="section-icon warning">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <span class="section-title">Top 5 Protection Gaps</span>
                </div>
                <div class="section-body" style="padding: 16px 24px;">
                  <ul style="margin: 0; padding-left: 20px; color: #d97706; font-size: 14px;">
                    ${report.topProtectionGaps.map(gap => `<li style="margin-bottom: 8px;">${gap}</li>`).join('')}
                  </ul>
                </div>
              </div>`;
          }
        }

        document.getElementById('aiExplanationLayer').innerHTML = aiExplanationHtml;

        // Build report sections
        let reportHtml = '';

        if (report) {
          // Recommended Actions
          if (report.topRecommendations && report.topRecommendations.length) {
            reportHtml += `
              <div class="section-card fade-in stagger-3">
                <div class="section-header">
                  <div class="section-icon success">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <span class="section-title">Recommended Actions</span>
                </div>
                <div class="section-body" style="padding: 16px 24px;">
                  <div class="risk-list">`;

            report.topRecommendations.forEach(rec => {
              const tfClass = (rec.timeframe || '').toLowerCase().includes('immediate') ? 'high' : 'medium';
              reportHtml += `
                <div class="risk-item">
                  <div class="risk-item-icon ${tfClass}">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div class="risk-item-content">
                    <div style="display: flex; justify-content: space-between; align-items: start;">
                      <h4 style="margin:0 0 4px 0; color:var(--text);">${rec.action}</h4>
                      <span class="risk-impact-tag ${tfClass}">${rec.timeframe}</span>
                    </div>
                    <p style="margin: 4px 0; font-size: 13px; color:var(--text-secondary);"><strong>Exposure:</strong> ${rec.exposure}</p>
                    <p style="margin: 4px 0; font-size: 13px; color:var(--danger);"><strong>Consequence:</strong> ${rec.consequence}</p>
                    <p style="margin: 4px 0; font-size: 13px; color:#d97706;"><strong>Gap:</strong> ${rec.protectionGap}</p>
                  </div>
                </div>`;
            });

            reportHtml += `
                  </div>
                </div>
              </div>`;
          }

          // Professional Recommendation & Conversion
          if (report.professionalRecommendation) {
            reportHtml += `
              <div class="conversion-card fade-in stagger-5">
                <h3 class="conversion-headline">Next Steps</h3>
                <p class="conversion-subtext">${report.professionalRecommendation}</p>
                <a href="/consultation" class="conversion-cta">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Request Complimentary Review
                </a>
              </div>`;
          }
        }

        document.getElementById('reportContent').innerHTML = reportHtml;

        // Build recommendations (Prioritize rules engine, fallback to AI or Industry)
        let recsHtml = '';
        const recs = data.recommendations?.length
          ? data.recommendations
          : data.aiReport?.recommendations?.length
            ? data.aiReport.recommendations
            : data.industryRisks?.recommendations?.length
              ? data.industryRisks.recommendations
              : [];

        if (recs.length) {
          recsHtml = `<div class="rec-grid">`;
          recs.forEach(rec => {
            // Mistral AI sometimes returns objects instead of strings
            const recText = typeof rec === 'object' ? (rec.product || rec.name || rec.title || rec.recommendation || Object.values(rec)[0] || JSON.stringify(rec)) : rec;
            recsHtml += `
              <span class="rec-tag">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                ${recText}
              </span>`;
          });
          recsHtml += `</div>`;
        } else {
          recsHtml = '<p style="color: var(--text-muted); font-size: 14px;">No specific recommendations available.</p>';
        }
        document.getElementById('recommendationsContent').innerHTML = recsHtml;

        // Home button text
        const homeBtn = document.getElementById('homeBtn');
        if (token) {
          homeBtn.textContent = 'Go to Dashboard';
          homeBtn.href = '/dashboard';
        }

        document.getElementById('loadingOverlay').style.display = 'none';
        document.getElementById('resultContent').style.display = 'block';

      } catch (err) {
        console.error(err);
        alert('Failed to load results. Please try again.');
        window.location.href = '/';
      }
    }

    loadResult();
  </script>
</body>
</html>
