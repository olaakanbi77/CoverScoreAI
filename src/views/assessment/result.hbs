<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Risk Report - CoverScore AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .report-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 16px;
    }

    /* Hero Score Section */
    .score-hero {
      background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(30, 41, 59, 0.8) 100%);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 48px 32px;
      text-align: center;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .score-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-success));
    }
    .score-hero-label {
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--text-muted);
      margin-bottom: 24px;
    }
    .score-gauge-wrap {
      position: relative;
      width: 200px;
      height: 200px;
      margin: 0 auto 24px;
    }
    .score-gauge-bg {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(
        from 180deg,
        rgba(255,255,255,0.05) 0deg,
        rgba(255,255,255,0.02) 180deg
      );
    }
    .score-gauge-fill {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(
        from 180deg,
        var(--gauge-color, var(--color-success)) 0deg,
        var(--gauge-color-end, var(--color-success)) var(--gauge-angle, 180deg),
        transparent var(--gauge-angle, 180deg)
      );
      mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #fff calc(100% - 12px));
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 12px), #fff calc(100% - 12px));
    }
    .score-gauge-inner {
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      background: var(--bg-surface);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .score-number {
      font-family: var(--font-mono);
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      color: var(--score-color, var(--color-success));
    }
    .score-max {
      font-size: 14px;
      color: var(--text-muted);
      font-weight: 500;
    }
    .risk-badge-large {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 24px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .risk-badge-large.low { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .risk-badge-large.moderate { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .risk-badge-large.high { background: rgba(249, 115, 22, 0.15); color: #f97316; }
    .risk-badge-large.critical { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

    /* Profile Summary */
    .profile-summary {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      margin-bottom: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .profile-summary p {
      color: var(--text-secondary);
      line-height: 1.7;
      font-size: 15px;
      margin: 0;
    }
    .profile-summary strong {
      color: var(--text-primary);
    }
    .cta-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 8px;
    }
    .cta-row a {
      flex: 1;
      min-width: 140px;
    }

    /* Section Cards */
    .section-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 24px;
      overflow: hidden;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--glass-border);
    }
    .section-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .section-icon.primary { background: rgba(59, 130, 246, 0.15); color: var(--color-primary); }
    .section-icon.success { background: rgba(16, 185, 129, 0.15); color: var(--color-success); }
    .section-icon.warning { background: rgba(245, 158, 11, 0.15); color: var(--color-warning); }
    .section-icon.danger { background: rgba(239, 68, 68, 0.15); color: var(--color-danger); }
    .section-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .section-body {
      padding: 24px;
      color: var(--text-secondary);
      line-height: 1.75;
      font-size: 15px;
    }

    /* Risk Items */
    .risk-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .risk-item {
      display: flex;
      gap: 16px;
      padding: 16px;
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      transition: border-color 200ms;
    }
    .risk-item:hover {
      border-color: rgba(255,255,255,0.12);
    }
    .risk-item-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .risk-item-icon.high { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .risk-item-icon.medium { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .risk-item-icon.low { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .risk-item-content h4 {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 6px;
    }
    .risk-item-content p {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.6;
    }
    .risk-impact-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 3px 8px;
      border-radius: 4px;
      margin-top: 8px;
      display: inline-block;
    }
    .risk-impact-tag.high { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .risk-impact-tag.medium { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .risk-impact-tag.low { background: rgba(16, 185, 129, 0.15); color: #10b981; }

    /* Recommendations */
    .rec-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .rec-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 100px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-primary-hover);
    }
    .rec-tag svg {
      flex-shrink: 0;
    }

    /* Compliance Note */
    .compliance-note {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 22px;
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-md);
      margin-bottom: 32px;
    }
    .compliance-note svg {
      flex-shrink: 0;
      color: var(--color-primary);
      margin-top: 1px;
    }
    .compliance-note p {
      font-size: 13px;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.6;
    }
    .compliance-note strong {
      color: var(--text-primary);
    }

    /* AI Explanation Layer Styles */
    .ai-narrative {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.05) 100%);
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
    }
    .ai-narrative::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--color-primary) 0%, rgba(139, 92, 246, 0.5) 100%);
    }
    .ai-narrative-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--color-primary);
      margin-bottom: 16px;
    }
    .ai-narrative-text {
      font-size: 17px;
      line-height: 1.8;
      color: var(--text-primary);
      margin: 0;
    }

    .risk-context-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 20px;
      overflow: hidden;
    }
    .risk-context-header {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--glass-border);
    }
    .risk-context-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .risk-context-icon.high { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .risk-context-icon.medium { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .risk-context-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 4px;
    }
    .risk-context-impact {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .risk-context-impact.high { color: #ef4444; }
    .risk-context-impact.medium { color: #f59e0b; }
    .risk-context-impact.low { color: #10b981; }
    .risk-context-body {
      padding: 20px 24px;
    }
    .risk-context-explanation {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-primary);
      margin: 0 0 16px;
    }
    .risk-context-why {
      font-size: 14px;
      line-height: 1.7;
      color: var(--text-secondary);
      padding: 14px 18px;
      background: rgba(255,255,255,0.02);
      border-left: 3px solid var(--color-primary);
      border-radius: 0 8px 8px 0;
      margin: 0;
    }
    .risk-context-why strong {
      color: var(--color-primary);
    }

    .urgency-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(249, 115, 22, 0.05) 100%);
      border: 1px solid rgba(245, 158, 11, 0.15);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    .urgency-card.critical {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(249, 115, 22, 0.05) 100%);
      border-color: rgba(239, 68, 68, 0.15);
    }
    .urgency-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .urgency-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .urgency-card.critical .urgency-icon { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .urgency-card:not(.critical) .urgency-icon { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .urgency-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .urgency-message {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-primary);
      margin: 0 0 16px;
    }
    .urgency-reasons {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .urgency-reasons li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
      padding: 6px 0;
    }
    .urgency-reasons li::before {
      content: '→';
      color: var(--color-primary);
      font-weight: 600;
    }

    .education-card {
      background: var(--bg-surface);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      margin-bottom: 20px;
      overflow: hidden;
    }
    .education-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .education-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .education-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .education-body {
      padding: 20px 24px;
    }
    .education-item {
      margin-bottom: 18px;
    }
    .education-item:last-child {
      margin-bottom: 0;
    }
    .education-item-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-primary);
      margin-bottom: 6px;
    }
    .education-item-text {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-secondary);
      margin: 0 0 6px;
    }
    .education-item-benefit {
      font-size: 13px;
      color: var(--text-primary);
      padding: 8px 12px;
      background: rgba(16, 185, 129, 0.08);
      border-radius: 6px;
    }

    .conversion-card {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.08) 100%);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: var(--radius-xl);
      padding: 32px;
      text-align: center;
      margin: 32px 0;
    }
    .conversion-headline {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 8px;
    }
    .conversion-subtext {
      font-size: 15px;
      color: var(--text-secondary);
      margin: 0 0 24px;
      line-height: 1.6;
    }
    .conversion-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--color-primary);
      color: white;
      border-radius: 100px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: all 200ms;
    }
    .conversion-cta:hover {
      background: var(--color-primary-hover);
      transform: translateY(-2px);
    }

    /* Page Actions */
    .page-actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      padding: 24px 0 16px;
    }

    /* Loading */
    .loading-overlay {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      gap: 16px;
    }
    .loading-spinner-lg {
      width: 48px;
      height: 48px;
      border: 3px solid var(--glass-border);
      border-top-color: var(--color-primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    .loading-text {
      color: var(--text-muted);
      font-size: 14px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Animations */
    .fade-in {
      animation: fadeIn 400ms ease forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .stagger-1 { animation-delay: 0.05s; }
    .stagger-2 { animation-delay: 0.1s; }
    .stagger-3 { animation-delay: 0.15s; }
    .stagger-4 { animation-delay: 0.2s; }
    .stagger-5 { animation-delay: 0.25s; }

    @media (max-width: 600px) {
      .score-hero { padding: 36px 20px; }
      .score-gauge-wrap { width: 160px; height: 160px; }
      .score-number { font-size: 44px; }
      .section-header { padding: 16px 20px; }
      .section-body { padding: 20px; }
      .cta-row { flex-direction: column; }
      .cta-row a { min-width: unset; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-content">
      <a href="/" class="navbar-brand">Cover<span>Score</span> AI</a>
    </div>
  </nav>

  <main class="report-page">
    <!-- Loading State -->
    <div id="loadingOverlay" class="loading-overlay">
      <div class="loading-spinner-lg"></div>
      <p class="loading-text">Generating your personalized risk report...</p>
    </div>

    <!-- Report Content -->
    <div id="resultContent" style="display: none;">
      <!-- Score Hero -->
      <div class="score-hero fade-in stagger-1">
        <div class="score-hero-label">Your Risk Score</div>
        <div class="score-gauge-wrap">
          <div class="score-gauge-bg"></div>
          <div class="score-gauge-fill" id="scoreGauge"></div>
          <div class="score-gauge-inner">
            <span class="score-number" id="scoreValue">--</span>
            <span class="score-max">/ 100</span>
          </div>
        </div>
        <div class="risk-badge-large" id="riskBadge">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span id="riskBadgeText">Calculating...</span>
        </div>
      </div>

      <!-- Profile Summary -->
      <div class="profile-summary fade-in stagger-2">
        <p id="riskProfileText">
          Based on your profile, you have a <strong id="riskText">--</strong> risk exposure compared to similar businesses in your industry.
        </p>
        <p id="financialExposureText">
          <strong>Potential Financial Exposure:</strong> ₦<span id="minLossVal">--</span> – ₦<span id="maxLossVal">--</span>
        </p>
        <div class="cta-row">
          <a href="/quote" class="btn btn-success btn-lg">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Request Quote
          </a>
          <a href="/consultation" class="btn btn-outline btn-lg">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Book Consultation
          </a>
        </div>
      </div>

      <!-- AI Explanation Layer -->
      <div id="aiExplanationLayer"></div>

      <!-- Report Sections -->
      <div id="reportContent"></div>

      <!-- Recommendations -->
      <div class="section-card fade-in stagger-3" id="recommendationsCard">
        <div class="section-header">
          <div class="section-icon success">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="section-title">Recommended Coverage</span>
        </div>
        <div class="section-body" id="recommendationsContent"></div>
      </div>

      <!-- Compliance Note -->
      <div class="compliance-note fade-in stagger-4">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p>
          <strong>NAICOM Compliant:</strong> These recommendations align with Nigerian insurance regulations and standards set by the National Insurance Commission (NAICOM). They are designed to ensure your business meets compulsory insurance requirements.
        </p>
      </div>

      <!-- Actions -->
      <div class="page-actions fade-in stagger-5">
        <a href="/assessment/start" class="btn btn-ghost">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Retake Assessment
        </a>
        <a href="/" class="btn btn-primary" id="homeBtn">Back to Home</a>
      </div>
    </div>
  </main>

  <script>
    const riskConfig = {
      low: {
        color: '#10b981',
        colorEnd: 'rgba(16, 185, 129, 0.3)',
        badgeClass: 'low',
        label: 'Low Risk',
        angle: 180
      },
      moderate: {
        color: '#f59e0b',
        colorEnd: 'rgba(245, 158, 11, 0.3)',
        badgeClass: 'moderate',
        label: 'Moderate Risk',
        angle: 135
      },
      high: {
        color: '#f97316',
        colorEnd: 'rgba(249, 115, 22, 0.3)',
        badgeClass: 'high',
        label: 'High Risk',
        angle: 90
      },
      critical: {
        color: '#ef4444',
        colorEnd: 'rgba(239, 68, 68, 0.3)',
        badgeClass: 'critical',
        label: 'Critical Risk',
        angle: 45
      }
    };

    function getRiskConfig(level) {
      return riskConfig[level] || riskConfig.moderate;
    }

    async function loadResult() {
      const pathParts = window.location.pathname.split('/');
      const assessmentId = pathParts[pathParts.length - 1];
      const token = localStorage.getItem('accessToken');

      try {
        const headers = {};
        if (token) headers.Authorization = `Bearer ${token}`;

        const res = await fetch(`/api/assessment/${assessmentId}`, { headers });
        if (!res.ok) throw new Error('Failed to load results');

        const data = await res.json();
        const score = data.score || 0;
        const riskLevel = data.riskLevel || data.risk_level || 'moderate';
        const cfg = getRiskConfig(riskLevel);

        // Set score and gauge
        document.getElementById('scoreValue').textContent = score;
        document.getElementById('scoreValue').style.color = cfg.color;
        const gauge = document.getElementById('scoreGauge');
        gauge.style.setProperty('--gauge-color', cfg.color);
        gauge.style.setProperty('--gauge-color-end', cfg.colorEnd);
        gauge.style.setProperty('--gauge-angle', `${(score / 100) * 360}deg`);

        // Set risk badge
        const badge = document.getElementById('riskBadge');
        badge.className = `risk-badge-large ${cfg.badgeClass}`;
        document.getElementById('riskBadgeText').textContent = cfg.label;

        // Set risk text
        document.getElementById('riskText').textContent = `${riskLevel.charAt(0).toUpperCase() + riskLevel.slice(1)}`;

        // Set financial exposure
        const formatMoney = (amount) => new Intl.NumberFormat('en-NG').format(amount);
        if (data.min_loss && data.max_loss) {
          document.getElementById('minLossVal').textContent = formatMoney(data.min_loss);
          document.getElementById('maxLossVal').textContent = formatMoney(data.max_loss);
          document.getElementById('financialExposureText').style.display = 'block';
        } else {
          document.getElementById('financialExposureText').style.display = 'none';
        }

        // Build AI Explanation Layer
        let aiExplanationHtml = '';
        const explanations = data.aiReport?.explanations;

        if (explanations) {
          // Personalized Narrative
          if (explanations.narrative) {
            aiExplanationHtml += `
              <div class="ai-narrative fade-in stagger-2">
                <div class="ai-narrative-label">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                  Your Personalized Risk Analysis
                </div>
                <p class="ai-narrative-text">${explanations.narrative}</p>
              </div>`;
          }

          // Risk Contexts with "Why This Matters"
          if (explanations.riskContexts?.length) {
            explanations.riskContexts.forEach((ctx, idx) => {
              const impactClass = (ctx.impact || 'Medium').toLowerCase();
              aiExplanationHtml += `
                <div class="risk-context-card fade-in" style="animation-delay: ${0.1 + idx * 0.05}s;">
                  <div class="risk-context-header">
                    <div class="risk-context-icon ${impactClass}">
                      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="risk-context-title">${ctx.factor}</h3>
                      <span class="risk-context-impact ${impactClass}">${ctx.impact} Priority</span>
                    </div>
                  </div>
                  <div class="risk-context-body">
                    <p class="risk-context-explanation">${ctx.explanation}</p>
                    <p class="risk-context-why"><strong>Why this matters:</strong> ${ctx.why}</p>
                  </div>
                </div>`;
            });
          }

          // Urgency Section
          if (explanations.urgency) {
            const urgencyClass = riskLevel === 'critical' ? 'critical' : '';
            aiExplanationHtml += `
              <div class="urgency-card ${urgencyClass} fade-in">
                <div class="urgency-header">
                  <div class="urgency-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <span class="urgency-title">Time Sensitivity</span>
                </div>
                <p class="urgency-message">${explanations.urgency.message}</p>
                <ul class="urgency-reasons">
                  ${explanations.urgency.reasons?.map(reason => `<li>${reason}</li>`).join('') || ''}
                </ul>
              </div>`;
          }

          // Education Section
          if (explanations.education?.length) {
            aiExplanationHtml += `
              <div class="section-card fade-in">
                <div class="section-header">
                  <div class="section-icon success">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                  </div>
                  <span class="section-title">Understanding Your Options</span>
                </div>
                <div class="section-body" style="padding: 16px 24px;">
                  <p style="color: var(--text-secondary); font-size: 14px; margin: 0 0 20px;">Knowledge helps you make confident decisions. Here's what these coverages mean for your situation:</p>`;

            explanations.education.forEach(edu => {
              aiExplanationHtml += `
                    <div class="education-item">
                      <div class="education-item-title">${edu.recommendation}</div>
                      <p class="education-item-text">${edu.explanation}</p>
                      <div class="education-item-benefit">✓ ${edu.benefit}</div>
                    </div>`;
            });

            aiExplanationHtml += `
                </div>
              </div>`;
          }

          // Conversion Guidance
          if (explanations.conversion) {
            aiExplanationHtml += `
              <div class="conversion-card fade-in">
                <h3 class="conversion-headline">${explanations.conversion.headline}</h3>
                <p class="conversion-subtext">${explanations.conversion.subtext}</p>
                <a href="/consultation" class="conversion-cta">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  ${explanations.conversion.cta}
                </a>
              </div>`;
          }
        }

        document.getElementById('aiExplanationLayer').innerHTML = aiExplanationHtml;

        // Build report sections
        let reportHtml = '';

        if (data.aiReport) {
          if (data.aiReport.executiveSummary) {
            reportHtml += `
              <div class="section-card fade-in stagger-2">
                <div class="section-header">
                  <div class="section-icon primary">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                  <span class="section-title">Executive Summary</span>
                </div>
                <div class="section-body">${data.aiReport.executiveSummary}</div>
              </div>`;
          }

          if (data.aiReport.topRisks?.length) {
            const riskItemsHtml = data.aiReport.topRisks.map(risk => {
              const impact = (risk.impact || 'Medium').toLowerCase();
              const iconClass = impact === 'high' ? 'high' : impact === 'low' ? 'low' : 'medium';
              return `
                <div class="risk-item">
                  <div class="risk-item-icon ${iconClass}">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                  </div>
                  <div class="risk-item-content">
                    <h4>${risk.risk || risk.title || 'Identified Risk'}</h4>
                    <p>${risk.description || risk.details || ''}</p>
                    <span class="risk-impact-tag ${impact}">${impact} impact</span>
                  </div>
                </div>`;
            }).join('');

            reportHtml += `
              <div class="section-card fade-in stagger-3">
                <div class="section-header">
                  <div class="section-icon danger">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                  </div>
                  <span class="section-title">Top Risks</span>
                </div>
                <div class="section-body" style="padding: 16px 24px;">
                  <div class="risk-list">${riskItemsHtml}</div>
                </div>
              </div>`;
          }

          if (data.aiReport.financialImpact) {
            reportHtml += `
              <div class="section-card fade-in stagger-4">
                <div class="section-header">
                  <div class="section-icon warning">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <span class="section-title">Financial Impact</span>
                </div>
                <div class="section-body">${data.aiReport.financialImpact}</div>
              </div>`;
          }
        }

        document.getElementById('reportContent').innerHTML = reportHtml;

        // Build recommendations (Prioritize rules engine, fallback to AI or Industry)
        let recsHtml = '';
        const recs = data.recommendations?.length
          ? data.recommendations
          : data.aiReport?.recommendations?.length
            ? data.aiReport.recommendations
            : data.industryRisks?.recommendations?.length
              ? data.industryRisks.recommendations
              : [];

        if (recs.length) {
          recsHtml = `<div class="rec-grid">`;
          recs.forEach(rec => {
            recsHtml += `
              <span class="rec-tag">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                ${rec}
              </span>`;
          });
          recsHtml += `</div>`;
        } else {
          recsHtml = '<p style="color: var(--text-muted); font-size: 14px;">No specific recommendations available.</p>';
        }
        document.getElementById('recommendationsContent').innerHTML = recsHtml;

        // Home button text
        const homeBtn = document.getElementById('homeBtn');
        if (token) {
          homeBtn.textContent = 'Go to Dashboard';
          homeBtn.href = '/dashboard';
        }

        document.getElementById('loadingOverlay').style.display = 'none';
        document.getElementById('resultContent').style.display = 'block';

      } catch (err) {
        console.error(err);
        alert('Failed to load results. Please try again.');
        window.location.href = '/';
      }
    }

    loadResult();
  </script>
</body>
</html>
