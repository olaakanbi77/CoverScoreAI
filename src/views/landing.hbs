  <script>
    // Risk gauge animation
    function animateRiskGauge() {
      const needle = document.getElementById('riskNeedle');
      const score = parseInt(document.getElementById('riskScore').textContent);

      // Map score (0-100) to rotation (-60 to 60 degrees)
      const rotation = -60 + (score / 100) * 120;

      setTimeout(() => {
        needle.style.transform = `translateX(-50%) rotate(${rotation}deg)`;
      }, 500);
    }

    // Initialize on scroll when element is visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateRiskGauge();
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });

    const gaugeContainer = document.querySelector('.risk-gauge-container');
    if (gaugeContainer) {
      observer.observe(gaugeContainer);
    }
  </script>
