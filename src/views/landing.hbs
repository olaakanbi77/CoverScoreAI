<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css?v=52">
</head>
<body style="padding-bottom: 72px;">

  <!-- 1. NAVIGATION BAR -->
  <nav class="navbar">
    <div class="funnel-container navbar-inner">
      <a href="/" class="logo">
        <img src="/images/logo.png" alt="CoverScore AI" style="height: 80px; width: auto; object-fit: contain;">
      </a>
      <div class="desktop-nav">
        <a href="#calculator">Exposure Calculator</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#sample">Sample Report</a>
        <a href="/auth/login">Login</a>
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="color: white; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
      </div>
      <button class="mobile-menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </nav>

  <!-- 2. HERO SECTION -->
  <section class="funnel-section-light hero funnel-container">
    <div class="hero-content">
      <h1 class="hero-title">{{{data.hero.headline}}}</h1>
      <p class="hero-subtitle">{{data.hero.subheadline}}</p>
      
      <div class="hero-benefits">
        {{#each data.hero.benefits}}
        <div class="hero-benefit">
          <div class="hero-benefit-icon">✓</div>
          {{this}}
        </div>
        {{/each}}
      </div>
      
      <div style="margin-top: 16px;">
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="font-size: 1.1rem; height: 56px; width: 65%;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
        <div class="hero-security">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Secure. Private. Takes 5–7 minutes.
        </div>
      </div>
    </div>
    
    <div class="hero-image-wrapper">
      <img src="{{#if data.hero.image}}{{data.hero.image}}{{else}}https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1453&q=80{{/if}}" alt="CoverScore AI Dashboard" class="hero-image">
      
      <div class="hero-overlay">
        <div class="overlay-statement">
          <svg width="40" height="40" fill="none" stroke="var(--color-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M12 8l1.5 2.5 3 .5-2 2 .5 3-3-1.5-3 1.5.5-3-2-2 3-.5z"/>
          </svg>
          <div>{{{data.hero.overlayStatement}}}</div>
        </div>
        <div class="overlay-metrics">
          {{#each data.hero.metrics}}
          <div class="overlay-metric">
            <div class="overlay-metric-icon">{{{this.icon}}}</div>
            <div>
              <div class="overlay-metric-val">{{this.value}}</div>
              <div class="overlay-metric-lbl">{{{this.label}}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RISK EXPOSURE CALCULATOR -->
  <section id="calculator" class="funnel-section funnel-section-gray" style="margin-top: 64px;">
    <div class="funnel-container">
      <div class="calc-card">
        <div class="calc-header">
          <div>
            <h2 class="calc-title">{{data.calculator.title}}</h2>
            <p class="calc-subtitle">{{data.calculator.subtitle}}</p>
          </div>
        </div>
        <div class="calc-inputs" id="calcInputs">
            <!-- Injected via JS based on industry -->
          </div>
          <div class="calc-output">
            <div class="calc-output-title">Your Potential Financial Exposure</div>
            <div class="calc-output-val" id="exposureTotal">₦0</div>
            <div class="calc-output-desc" id="exposureDesc">Based on your inputs, a major incident could expose you to significant losses.</div>
            <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Get My Full Risk Score
            </a>
          </div>
      </div>
    </div>
  </section>

  <!-- 4. TRUST BAR -->
  <section class="funnel-section-light">
    <div class="funnel-container trust-bar">
      <div class="trust-item"><img src="/images/trust-lock.jpg" alt="" width="42" height="42" style="object-fit: contain;"> Confidential & Secure</div>
      <div class="trust-item"><img src="/images/trust-ai.jpg" alt="" width="42" height="42" style="object-fit: contain;"> AI-Powered Insights</div>
      <div class="trust-item"><img src="/images/trust-shield.jpg" alt="" width="42" height="42" style="object-fit: contain;"> {{data.trustBarExpertise}}</div>
      <div class="trust-item"><img src="/images/trust-check.jpg" alt="" width="42" height="42" style="object-fit: contain;"> Actionable Recommendations</div>
    </div>
  </section>

  <!-- 5. WHY CHOOSE COVERSCORE -->
  <section class="funnel-section funnel-section-light">
    <div class="funnel-container">
      <div class="section-header">
        <h2 class="section-title">{{data.whyChooseTitle}}</h2>
      </div>
      <div class="features-grid">
        {{#each data.whyChoose}}
        <div class="feature-card">
          <div class="feature-icon">{{this.icon}}</div>
          <h3 class="feature-title">{{this.title}}</h3>
          <p class="feature-desc">{{this.desc}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- 6. REAL RISK STORIES -->
  <section class="funnel-section funnel-section-gray">
    <div class="funnel-container">
      <div class="stories-layout" style="background: #FFF4E6; padding: 48px; border-radius: var(--radius-lg); align-items: stretch;">
        <div style="display: flex; flex-direction: column;">
          <div class="stories-header">
            <h2 class="calc-title">REAL RISK STORIES</h2>
          </div>
          <p style="padding: 0 32px; color: var(--color-surface-dark); margin-top: 8px;">Incidents happen. Preparation makes the difference.</p>
          
          <div class="stories-grid-three" style="display: grid; gap: 24px; margin-top: 32px;">
            {{#each data.stories}}
            <div class="story-card" style="background: white; padding: 24px; border-radius: var(--radius-md); display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start;">
              <div class="story-icon" style="margin-bottom: 0; font-size: 2.25rem; line-height: 1;">{{{this.icon}}}</div>
              <div class="story-content" style="display: flex; flex-direction: column; height: 100%;">
                <h4 class="story-title" style="margin-bottom: 8px;">{{this.title}}</h4>
                <p class="story-desc" style="margin-bottom: 12px; flex-grow: 1;">{{this.desc}}</p>
                <div>
                  <div class="story-loss-label">Estimated Loss</div>
                  <div class="story-loss-val">{{this.loss}}</div>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>

        <div class="insight-panel" style="background: transparent; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 32px; display: flex; flex-direction: column; justify-content: center; margin-top: 16px;">
          <div class="insight-quote" style="text-align: center; color: var(--color-surface-dark); font-size: 1.5rem; font-weight: 800; line-height: 1.4;">
            Most incidents begin as "unlikely events."<br><br>
            <span style="display: block;">Until they happen.</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 7/8. HOW IT WORKS & TRUSTED LEADERS -->
  <section id="how-it-works" class="funnel-section funnel-section-light" style="background: white;">
    <div class="funnel-container" style="display: grid; grid-template-columns: 1fr; gap: 24px;">
      
      <style>
        @media(min-width: 1024px) {
          .combined-section-grid {
            grid-template-columns: 1fr 1fr;
          }
        }
      </style>
      
      <div class="combined-section-grid" style="display: grid; gap: 24px;">
        <!-- LEFT COLUMN: HOW IT WORKS -->
        <div style="background: white; border-radius: var(--radius-lg); padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid var(--border-light);">
          <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 40px;">
            <h2 class="section-title" style="margin: 0; text-align: left; font-size: 1.5rem;">How It Works</h2>
          </div>
          
          <div class="steps-flow" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 32px; align-items: flex-start; position: relative; padding: 20px 0;">
            <!-- Horizontal Connector Line Removed -->
            
            <div class="step-item" style="text-align: center; z-index: 2; position: relative; min-width: 0;">
              <div style="width: 32px; height: 32px; background: #10B981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-weight: bold; font-size: 0.9rem;">1</div>
              <div style="margin-bottom: 12px;">
                <svg width="32" height="32" fill="#10B981" xmlns="http://www.w3.org/2000/svg" style="margin: 0 auto;" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-surface-dark); margin-bottom: 12px; line-height: 1.3;">Start on WhatsApp</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">Answer a few simple questions about your hospital</div>
              <div style="position: absolute; right: -20px; top: 10px; color: var(--color-surface-dark); font-size: 1.6rem; font-weight: 800;">→</div>
            </div>

            <div class="step-item" style="text-align: center; z-index: 2; position: relative; min-width: 0;">
              <div style="width: 32px; height: 32px; background: #10B981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-weight: bold; font-size: 0.9rem;">2</div>
              <div style="color: #1B2B4C; margin-bottom: 12px;">
                <svg width="32" height="32" fill="none" stroke="#1B2B4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto;" viewBox="0 0 24 24">
                  <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
                  <path d="M8 16V8l4 8V8" stroke-width="1.5"/>
                  <line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>
                </svg>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-surface-dark); margin-bottom: 12px; line-height: 1.3;">AI Analyzes Risks</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">Our AI evaluate your responses across key risk areas</div>
              <div style="position: absolute; right: -20px; top: 10px; color: var(--color-surface-dark); font-size: 1.6rem; font-weight: 800;">→</div>
            </div>

            <div class="step-item" style="text-align: center; z-index: 2; position: relative; min-width: 0;">
              <div style="width: 32px; height: 32px; background: #10B981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-weight: bold; font-size: 0.9rem;">3</div>
              <div style="color: #1B2B4C; margin-bottom: 12px;">
                <svg width="32" height="32" fill="none" stroke="#1B2B4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto;" viewBox="0 0 24 24">
                  <path d="M3.34 19a10 10 0 1 1 17.32 0"/>
                  <circle cx="12" cy="14" r="2" fill="#1B2B4C"/>
                  <path d="m12 14 4-4"/>
                </svg>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-surface-dark); margin-bottom: 12px; line-height: 1.3;">Get your risk score</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">Receive your score on financial exposure instantly</div>
              <div style="position: absolute; right: -20px; top: 10px; color: var(--color-surface-dark); font-size: 1.6rem; font-weight: 800;">→</div>
            </div>

            <div class="step-item" style="text-align: center; z-index: 2; position: relative; min-width: 0;">
              <div style="width: 32px; height: 32px; background: #10B981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-weight: bold; font-size: 0.9rem;">4</div>
              <div style="color: #1B2B4C; margin-bottom: 12px;">
                <svg width="32" height="32" fill="none" stroke="#1B2B4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto;" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h5"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <path d="M20 10v2"/>
                  <path d="M16 22c3-1.5 4-4.5 4-7v-3l-4-1.5-4 1.5v3c0 2.5 1 5.5 4 7z" fill="white"/>
                  <path d="M8 13h4"/>
                  <path d="M8 17h3"/>
                </svg>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-surface-dark); margin-bottom: 12px; line-height: 1.3;">Receive your report</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">Get a personalized risk reports with actionable recommendations</div>
              <div style="position: absolute; right: -20px; top: 10px; color: var(--color-surface-dark); font-size: 1.6rem; font-weight: 800;">→</div>
            </div>

            <div class="step-item" style="text-align: center; z-index: 2; position: relative; min-width: 0;">
              <div style="width: 32px; height: 32px; background: #10B981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-weight: bold; font-size: 0.9rem;">5</div>
              <div style="color: #1B2B4C; margin-bottom: 12px;">
                <svg width="32" height="32" fill="none" stroke="#1B2B4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto;" viewBox="0 0 24 24">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-surface-dark); margin-bottom: 12px; line-height: 1.3;">Speak to a Healthcare advisor</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">Optional: Connect with a risk expert for tailored solution</div>
            </div>
            
          </div>
        </div>

