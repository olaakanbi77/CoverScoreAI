        <a href="#assessments">Assessments</a>
        <a href="#sample">Sample Report</a>
        <a href="#how-it-works">How It Works</a>
        <a href="/auth/login">Login</a>
        <a href="/start-whatsapp?text={{trigger}}" class="mo-btn mo-btn-navy mo-mobile-only-btn">Start Free Assessment</a>
      </div>
      <a href="/start-whatsapp?text={{trigger}}" class="mo-btn mo-btn-navy mo-desktop-only-btn">Start Free Assessment</a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="mo-section-navy">
    <div class="mo-container mo-hero">
      
      <!-- Left Hero Content -->
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.1); padding: 4px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 24px;">
          <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"/></svg>
          AI-POWERED RISK INTELLIGENCE
        </div>
        
        <h1 class="mo-hero-title">{{{headline}}}</h1>
        
        <p class="mo-hero-subtitle">{{subheadline}}</p>
        
        <div class="mo-check-list">
          <div class="mo-check-item">
            <span class="mo-check-icon"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
            AI-Powered Risk Intelligence
          </div>
          <div class="mo-check-item">
            <span class="mo-check-icon"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
            Personalized Risk Reports
          </div>
          <div class="mo-check-item">
            <span class="mo-check-icon"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
            Business & Personal Assessments
          </div>
          <div class="mo-check-item">
            <span class="mo-check-icon"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
            Free Consultation Available
          </div>
        </div>

        <div class="mo-hero-actions">
          <a href="/start-whatsapp?text={{trigger}}" class="mo-btn mo-btn-green">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 2.17.68 4.19 1.84 5.86L2.5 21.5l3.75-1.25A9.95 9.95 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
            Start Assessment on WhatsApp
