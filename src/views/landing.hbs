      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </div>
  </a>

  <!-- INTERACTIVE CALCULATOR JS -->
  <script>
    // Industry specific calculator configs
    const calcConfigs = {
      hospital: {
        inputs: [
          { id: 'inp_beds', label: 'Number of Beds', min: 0, max: 1000, val: 0, step: 10, factor: 1500000 },
          { id: 'inp_staff', label: 'Number of Staff', min: 0, max: 2000, val: 0, step: 5, factor: 500000 },
          { id: 'inp_equip', label: 'Equipment Value', min: 0, max: 5000000000, val: 0, step: 10000000, factor: 0.2 },
          { id: 'inp_ccu', label: 'Critical Car Units', min: 0, max: 100, val: 0, step: 1, factor: 5000000 }
        ],
        baseExposure: 0
      },
      school: {
        inputs: [
          { id: 'inp_students', label: 'Number of Students', min: 0, max: 5000, val: 0, step: 50, factor: 300000 },
          { id: 'inp_staff', label: 'Number of Staff', min: 0, max: 500, val: 0, step: 5, factor: 500000 },
          { id: 'inp_building', label: 'Building Value', min: 0, max: 2000000000, val: 0, step: 10000000, factor: 0.25 },
          { id: 'inp_buses', label: 'School Buses', min: 0, max: 50, val: 0, step: 1, factor: 5000000 }
        ],
        baseExposure: 0
      },
      manufacturing: {
        inputs: [
          { id: 'inp_facilities', label: 'Number of Facilities', min: 0, max: 50, val: 0, step: 1, factor: 20000000 },
          { id: 'inp_staff', label: 'Number of Staff', min: 0, max: 5000, val: 0, step: 50, factor: 500000 },
          { id: 'inp_machinery', label: 'Machinery Value', min: 0, max: 10000000000, val: 0, step: 50000000, factor: 0.2 },
          { id: 'inp_daily_prod', label: 'Daily Production Value', min: 0, max: 500000000, val: 0, step: 1000000, factor: 10 }
        ],
        baseExposure: 0
      },
      church: {
        inputs: [
          { id: 'inp_attendance', label: 'Weekly Attendance', min: 0, max: 20000, val: 0, step: 100, factor: 200000 },
          { id: 'inp_staff', label: 'Staff/Volunteers', min: 0, max: 500, val: 0, step: 10, factor: 100000 },
          { id: 'inp_building', label: 'Building Value', min: 0, max: 5000000000, val: 0, step: 25000000, factor: 0.2 },
          { id: 'inp_equipment', label: 'Equipment Value', min: 0, max: 500000000, val: 0, step: 5000000, factor: 0.3 }
        ],
        baseExposure: 0
      },
      sme: {
        inputs: [
          { id: 'inp_revenue', label: 'Monthly Revenue', min: 0, max: 100000000, val: 0, step: 500000, factor: 3 },
          { id: 'inp_staff', label: 'Number of Employees', min: 0, max: 200, val: 0, step: 1, factor: 500000 },
          { id: 'inp_inventory', label: 'Inventory Value', min: 0, max: 500000000, val: 0, step: 1000000, factor: 0.5 },
          { id: 'inp_equipment', label: 'Equipment Value', min: 0, max: 200000000, val: 0, step: 500000, factor: 0.3 }
        ],
        baseExposure: 0
      }
    };

    // Determine current industry from URL or fallback to school
    const path = window.location.pathname.replace('/', '').toLowerCase();
    const industryKey = calcConfigs[path] ? path : 'school';
    const config = calcConfigs[industryKey];

    const formatCurrency = (num) => {
      return '₦' + num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    };

    const updateExposure = () => {
      let total = config.baseExposure;
      config.inputs.forEach(inp => {
        const val = parseInt(document.getElementById(inp.id).value) || inp.val;
        total += (val * inp.factor);
      });
      document.getElementById('exposureTotal').innerText = formatCurrency(total);
      
      const inMillions = total > 0 ? Math.max(1, Math.round(total / 1000000)) : 0;
      document.getElementById('exposureDesc').innerText = total === 0 
        ? "Adjust the sliders to estimate your potential financial exposure."
        : `Based on your inputs, a major incident could expose your organization to losses exceeding ₦${inMillions} million.`;
    };

    const renderInputs = () => {
      const container = document.getElementById('calcInputs');
      let html = '';
      config.inputs.forEach(inp => {
        let displayVal = inp.val;
        if (inp.id === 'inp_equip' || inp.id === 'inp_building') {
          displayVal = formatCurrency(inp.val);
        } else {
          displayVal = inp.val.toLocaleString();
        }
        
        html += `
          <div class="calc-input-group" style="flex-direction: column; align-items: stretch; gap: 12px; padding: 20px;">
            <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
              <div class="calc-input-label">${inp.label}</div>
              <div class="calc-val" id="${inp.id}_disp" style="color: var(--color-primary);">${displayVal}</div>
            </div>
            <input type="range" class="calc-slider" id="${inp.id}" min="${inp.min}" max="${inp.max}" step="${inp.step}" value="${inp.val}" oninput="changeVal('${inp.id}', this.value)">
          </div>
        `;
      });
      container.innerHTML = html;
      updateExposure();
    };

    window.changeVal = (id, newValStr) => {
      const inp = config.inputs.find(i => i.id === id);
      const el = document.getElementById(id);
      const disp = document.getElementById(id + '_disp');
      
      let newVal = parseInt(newValStr);
      if (newVal < inp.min) newVal = inp.min;
      if (newVal > inp.max) newVal = inp.max;
      
      el.value = newVal;
      
      if (id === 'inp_equip' || id === 'inp_building') {
        disp.innerText = formatCurrency(newVal);
      } else {
        disp.innerText = newVal.toLocaleString();
      }
      
      updateExposure();
    };

    document.addEventListener('DOMContentLoaded', renderInputs);
  </script>
</body>
</html>
