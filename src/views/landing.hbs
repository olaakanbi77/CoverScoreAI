        </div>

        <div class="mo-hero-trust">
          <div class="mo-avatars">
            <div class="mo-avatar"></div>
            <div class="mo-avatar"></div>
            <div class="mo-avatar"></div>
            <div class="mo-avatar"></div>
          </div>
          <div>
            <div style="color: #FBBF24;">★★★★★ <span style="color: white; font-weight: 600;">4.9/5</span></div>
            <div style="font-size: 0.85rem; color: var(--mo-text-light-muted);">Trusted by 1,000+ business owners and families</div>
          </div>
        </div>
      </div>

      <!-- Right Dashboard Mockup -->
      <div class="mo-mockup-card">
        <!-- Sidebar -->
        <div class="mo-mockup-sidebar">
          <div class="mo-mockup-sidebar-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mo-logo-ai" style="color:white; border-radius:4px;"><path d="M12 2L2 22h20L12 2z"/></svg>
            COVERSCORE
          </div>
          <ul>
            <li class="active"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg> Overview</li>
            <li><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg> Risk Breakdown</li>
            <li><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg> Exposure</li>
            <li><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> Protection Gaps</li>
          </ul>
        </div>
        
        <!-- Main Content -->
        <div class="mo-mockup-main">
          <!-- TOP ROW: Score & Risk Level -->
          <div class="mo-mockup-row" style="align-items: center;">
            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;">
              <div class="mo-mockup-label">CoverScore</div>
              <div style="position: relative; width: 140px; height: 140px;">
                <svg viewBox="0 0 36 36" style="width: 100%; height: 100%; transform: rotate(-90deg);">
                  <!-- Background Circle -->
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="var(--border-light)" stroke-width="3" />
                  <!-- Score Circle (72%) -->
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-dasharray="72, 100" stroke-linecap="round" />
                </svg>
                <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                  <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); line-height: 1; letter-spacing: -0.05em;">72</div>
                  <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">/ 100</div>
                </div>
              </div>
            </div>
            
            <div style="flex: 1.2; display: flex; flex-direction: column; justify-content: center;">
              <div class="mo-mockup-label">Risk Level</div>
              <div style="font-size: 1.5rem; font-weight: 800; color: #f59e0b; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-block; width: 12px; height: 12px; background: #f59e0b; border-radius: 50%; box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);"></span> Moderate
              </div>
              <div style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">Your business has an average level of risk exposure across assessed areas.</div>
            </div>
          </div>
          
          <!-- MIDDLE ROW: Financial Exposure & Chart -->
          <div class="mo-mockup-row" style="align-items: center; border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light); padding: 24px 0;">
            <div style="flex: 1;">
              <div class="mo-mockup-label">Financial Exposure</div>
              <div class="mo-mockup-value success">₦12.5M</div>
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Estimated range: ₦8M - ₦20M</div>
            </div>
            <div style="flex: 1; height: 60px;">
              <!-- Trend line mock SVG -->
              <svg viewBox="0 0 100 40" preserveAspectRatio="none" style="width: 100%; height: 100%;">
                <defs>
                  <linearGradient id="green-grad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.2"/>
                    <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0 35 Q10 25, 20 30 T40 20 T60 15 T80 20 T100 5 L100 40 L0 40 Z" fill="url(#green-grad)"/>
                <path d="M0 35 Q10 25, 20 30 T40 20 T60 15 T80 20 T100 5" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          
          <!-- BOTTOM ROW: Recommended Priorities & Risk Breakdown -->
          <div class="mo-mockup-row" style="align-items: flex-start; border-top: 1px solid var(--border-light); padding-top: 24px;">
            <div style="flex: 1;">
              <div class="mo-mockup-label">Recommended Priorities</div>
              <div style="font-size: 0.85rem; color: var(--text-main); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; font-weight: 500;">
                <span style="background: var(--color-surface-muted); border: 1px solid var(--border-light); width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">1</span> 
                Fire Insurance
              </div>
              <div style="font-size: 0.85rem; color: var(--text-main); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; font-weight: 500;">
                <span style="background: var(--color-surface-muted); border: 1px solid var(--border-light); width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">2</span> 
                Group Life Assurance
              </div>
              <div style="font-size: 0.85rem; color: var(--text-main); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; font-weight: 500;">
                <span style="background: var(--color-surface-muted); border: 1px solid var(--border-light); width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">3</span> 
                Public Liability Insurance
              </div>
              
              <div style="margin-top: 24px;">
                <a href="#sample" class="mo-btn mo-btn-navy" style="width: 100%;">View Full Report</a>
              </div>
            </div>
            
            <div style="flex: 1.2;">
              <div class="mo-mockup-label">Risk Breakdown</div>
              <div style="font-size: 0.85rem; color: var(--text-main); display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-weight: 500;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M3 21h18"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"></path></svg>
                  Property Risk
                </div>
                <span style="color: #ef4444; font-weight: 700; background: #fee2e2; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 0.75rem;">High</span>
              </div>
              <div style="font-size: 0.85rem; color: var(--text-main); display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-weight: 500;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                  Business Interruption
                </div>
                <span style="color: #ef4444; font-weight: 700; background: #fee2e2; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 0.75rem;">High</span>
              </div>
              <div style="font-size: 0.85rem; color: var(--text-main); display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-weight: 500;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  Employee Welfare
                </div>
                <span style="color: #f59e0b; font-weight: 700; background: #fef3c7; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 0.75rem;">Medium</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works" class="mo-section mo-section-light">
    <div class="mo-container">
      <div style="text-align: center; margin-bottom: 48px;">
        <div class="mo-kicker" style="justify-content: center;">SIMPLE. FAST. INSIGHTFUL.</div>
        <h2 style="font-size: 2.5rem; color: var(--mo-navy-dark);">How CoverScore AI Works</h2>
      </div>

      <div class="mo-steps">
        <div>
          <div class="mo-step-icon">💬</div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--mo-text-muted);">Step 1</div>
          <h3 style="font-size: 1.1rem; color: var(--mo-navy-dark); margin: 8px 0;">Complete a Quick Assessment</h3>
          <p style="font-size: 0.9rem; color: var(--mo-text-muted);">Answer a few questions about yourself or your business.</p>
        </div>
        <div>
          <div class="mo-step-icon">🧠</div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--mo-text-muted);">Step 2</div>
          <h3 style="font-size: 1.1rem; color: var(--mo-navy-dark); margin: 8px 0;">Receive Your CoverScore</h3>
          <p style="font-size: 0.9rem; color: var(--mo-text-muted);">Our intelligent risk engine analyzes your responses and calculates your risk profile.</p>
        </div>
        <div>
          <div class="mo-step-icon">📊</div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--mo-text-muted);">Step 3</div>
          <h3 style="font-size: 1.1rem; color: var(--mo-navy-dark); margin: 8px 0;">Discover Hidden Risks</h3>
          <p style="font-size: 0.9rem; color: var(--mo-text-muted);">Identify areas where unexpected events could create financial pressure.</p>
        </div>
        <div>
          <div class="mo-step-icon">✅</div>
          <div style="font-size: 0.8rem; font-weight: 700; color: var(--mo-text-muted);">Step 4</div>
          <h3 style="font-size: 1.1rem; color: var(--mo-navy-dark); margin: 8px 0;">Get Personalized Recommendations</h3>
          <p style="font-size: 0.9rem; color: var(--mo-text-muted);">Receive practical actions and protection recommendations tailored to your situation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHOOSE YOUR ASSESSMENT -->
