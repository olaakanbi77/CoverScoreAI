  <script>
    // Industry specific calculator configs
    const calcConfigs = {
      hospital: {
        inputs: [
          { id: 'inp_beds', label: 'Number of Beds', min: 10, max: 1000, val: 150, step: 10, factor: 1500000, isMobile: true, icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A651" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>' },
          { id: 'inp_staff', label: 'Number of Staff', min: 5, max: 2000, val: 350, step: 5, factor: 500000, isMobile: false },
          { id: 'inp_equip', label: 'Total Medical Equipment Value', min: 10000000, max: 2000000000, val: 800000000, step: 10000000, factor: 0.2, isMobile: true, icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A651" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><polyline points="6 10 10 10 12 6 14 14 16 10 18 10"/></svg>' },
          { id: 'inp_ccu', label: 'Critical Care Units', min: 0, max: 100, val: 5, step: 1, factor: 5000000, isMobile: false }
        ],
        baseExposure: 25000000
      },
      school: {
        inputs: [
          { id: 'inp_students', label: 'Number of Students', min: 0, max: 5000, val: 0, step: 50, factor: 300000, isMobile: true, icon: '<svg width="24" height="24" fill="none" stroke="#00A651" stroke-width="2"><path d="M12 4L4 8l8 4 8-4-8-4z"/><path d="M4 12v4l8 4 8-4v-4"/></svg>' },
          { id: 'inp_staff', label: 'Number of Staff', min: 0, max: 500, val: 0, step: 5, factor: 500000, isMobile: false }
        ],
        baseExposure: 0
      },
      manufacturing: {
        inputs: [
          { id: 'inp_facilities', label: 'Number of Facilities', min: 0, max: 50, val: 0, step: 1, factor: 20000000, isMobile: true, icon: '<svg width="24" height="24" fill="none" stroke="#00A651" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/></svg>' },
          { id: 'inp_staff', label: 'Number of Staff', min: 0, max: 5000, val: 0, step: 50, factor: 500000, isMobile: false }
        ],
        baseExposure: 0
      },
      church: {
        inputs: [
          { id: 'inp_attendance', label: 'Weekly Attendance', min: 0, max: 20000, val: 0, step: 100, factor: 200000, isMobile: true, icon: '<svg width="24" height="24" fill="none" stroke="#00A651" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' },
          { id: 'inp_staff', label: 'Staff/Volunteers', min: 0, max: 500, val: 0, step: 10, factor: 100000, isMobile: false }
        ],
        baseExposure: 0
      },
      sme: {
        inputs: [
          { id: 'inp_revenue', label: 'Monthly Revenue', min: 0, max: 100000000, val: 0, step: 500000, factor: 3, isMobile: true, icon: '<svg width="24" height="24" fill="none" stroke="#00A651" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>' },
          { id: 'inp_staff', label: 'Number of Employees', min: 0, max: 200, val: 0, step: 1, factor: 500000, isMobile: false }
        ],
        baseExposure: 0
      }
    };

    // Determine current industry from URL or fallback to school
    const path = window.location.pathname.replace('/', '').toLowerCase();
    const industryKey = calcConfigs[path] ? path : 'hospital';
    const config = calcConfigs[industryKey];

    const formatCurrency = (num) => {
      return '₦' + num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    };
    
    const formatCurrencyShort = (num) => {
      if (num >= 1000000000) return '₦' + (num / 1000000000) + 'B+';
      if (num >= 1000000) return '₦' + (num / 1000000) + 'M';
      return '₦' + num.toLocaleString();
    };

    const updateSliderFill = (el) => {
      const min = el.min || 0;
      const max = el.max || 100;
      const val = el.value;
      const percentage = ((val - min) / (max - min)) * 100;
      el.style.setProperty('--slider-fill', `${percentage}%`);
    };

    const updateExposure = () => {
      let total = config.baseExposure;
      config.inputs.forEach(inp => {
        const val = parseInt(document.getElementById(inp.id).value) || inp.val;
        total += (val * inp.factor);
      });
      document.getElementById('exposureTotal').innerText = formatCurrency(total);
      
      const mobileTotalEl = document.getElementById('exposureTotalMobile');
      if(mobileTotalEl) mobileTotalEl.innerText = formatCurrency(total);
      
      const inMillions = total > 0 ? Math.max(1, Math.round(total / 1000000)) : 0;
      document.getElementById('exposureDesc').innerText = total === 0 
        ? "Adjust the sliders to estimate your potential financial exposure."
        : `Based on your inputs, a major incident could expose your organization to losses exceeding ₦${inMillions} million.`;
    };

    const renderInputs = () => {
      const container = document.getElementById('calcInputs');
      const mobileContainer = document.getElementById('calcInputsMobile');
      let html = '';
      let mobileHtml = '';
      
      config.inputs.forEach(inp => {
        let displayVal = inp.val;
        if (inp.id === 'inp_equip' || inp.id === 'inp_building' || inp.id === 'inp_revenue') {
          displayVal = formatCurrency(inp.val);
        } else {
          displayVal = inp.val.toLocaleString();
        }
        
        // Desktop Output
        html += `
          <div class="calc-input-group" style="flex-direction: column; align-items: stretch; gap: 12px; padding: 20px;">
            <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
              <div class="calc-input-label">${inp.label}</div>
              <div class="calc-val" id="${inp.id}_disp" style="color: var(--color-primary);">${displayVal}</div>
            </div>
            <input type="range" class="calc-slider desktop-slider" id="${inp.id}" min="${inp.min}" max="${inp.max}" step="${inp.step}" value="${inp.val}" oninput="changeVal('${inp.id}', this.value)">
          </div>
        `;
        
        // Mobile Output
        if (inp.isMobile) {
          let minLabel = (inp.id === 'inp_equip' || inp.id === 'inp_revenue') ? formatCurrencyShort(inp.min) : inp.min;
          let maxLabel = (inp.id === 'inp_equip' || inp.id === 'inp_revenue') ? formatCurrencyShort(inp.max) : inp.max + '+';
          let midLabel = (inp.id === 'inp_equip' || inp.id === 'inp_revenue') ? formatCurrencyShort(inp.max / 2) : Math.round(inp.max / 2);
          let unit = inp.id === 'inp_beds' ? 'beds' : '';
          
          mobileHtml += `
            <div class="calc-mobile-card">
               <div class="calc-mobile-card-header">
                 <div class="calc-mobile-icon">${inp.icon}</div>
                 <div class="calc-mobile-details">
                   <div class="calc-mobile-label">${inp.label}</div>
                   <div class="calc-mobile-val-row">
                     <span class="calc-mobile-val" id="${inp.id}_mobile_disp">${displayVal}</span>
                     ${unit ? `<span class="calc-mobile-unit">${unit}</span>` : ''}
                   </div>
                 </div>
               </div>
               <div class="calc-mobile-slider-wrap">
                 <input type="range" class="calc-mobile-slider" id="${inp.id}_mobile" min="${inp.min}" max="${inp.max}" step="${inp.step}" value="${inp.val}" oninput="changeVal('${inp.id}', this.value)">
               </div>
               <div class="calc-mobile-slider-labels">
                 <span>${minLabel}</span>
                 <span>${midLabel}</span>
                 <span>${maxLabel}</span>
               </div>
             </div>
          `;
        }
      });
      container.innerHTML = html;
      if(mobileContainer) mobileContainer.innerHTML = mobileHtml;
      
      // Initialize slider fills
      setTimeout(() => {
        document.querySelectorAll('input[type="range"]').forEach(el => updateSliderFill(el));
      }, 50);
      
      updateExposure();
    };

    window.changeVal = (id, newValStr) => {
      const inp = config.inputs.find(i => i.id === id);
      const elDesktop = document.getElementById(id);
      const dispDesktop = document.getElementById(id + '_disp');
      const elMobile = document.getElementById(id + '_mobile');
      const dispMobile = document.getElementById(id + '_mobile_disp');
      
      let newVal = parseInt(newValStr);
      if (newVal < inp.min) newVal = inp.min;
      if (newVal > inp.max) newVal = inp.max;
      
      // Update values
      if(elDesktop) elDesktop.value = newVal;
      if(elMobile) elMobile.value = newVal;
      
      // Update displays
      let displayStr = '';
      if (id === 'inp_equip' || id === 'inp_building' || id === 'inp_revenue') {
        displayStr = formatCurrency(newVal);
      } else {
        displayStr = newVal.toLocaleString();
      }
      
      if(dispDesktop) dispDesktop.innerText = displayStr;
      if(dispMobile) dispMobile.innerText = displayStr;
      
      // Update slider fills
      if(elDesktop) updateSliderFill(elDesktop);
      if(elMobile) updateSliderFill(elMobile);
      
      updateExposure();
    };

    document.addEventListener('DOMContentLoaded', () => {
      renderInputs();
      
      // Sticky CTA Logic
      const stickyCta = document.getElementById('stickyCta');
      const heroSection = document.getElementById('hero');
      
      if (stickyCta && heroSection && window.IntersectionObserver) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            // entry.boundingClientRect.bottom < 0 means the hero has completely scrolled up and out of view
            if (!entry.isIntersecting && entry.boundingClientRect.bottom < 0) {
              stickyCta.classList.add('visible');
            } else {
              stickyCta.classList.remove('visible');
            }
          });
        }, { threshold: 0 });
        
        observer.observe(heroSection);
      }
    });
  </script>
</body>
</html>
