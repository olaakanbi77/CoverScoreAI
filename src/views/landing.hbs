  <!-- INTERACTIVE CALCULATOR JS -->
  <script>
    // Industry specific calculator configs
    const calcConfigs = {
      hospital: {
        inputs: [
          { id: 'inp_beds', label: 'Number of Beds', min: 10, max: 1000, val: 150, step: 10, factor: 1500000 },
          { id: 'inp_staff', label: 'Number of Staff', min: 5, max: 2000, val: 350, step: 5, factor: 500000 },
          { id: 'inp_equip', label: 'Equipment Value (₦M)', min: 10, max: 5000, val: 800, step: 50, factor: 200000 },
          { id: 'inp_ccu', label: 'Critical Car Units', min: 0, max: 100, val: 5, step: 1, factor: 5000000 }
        ],
        baseExposure: 25000000
      },
      school: {
        inputs: [
          { id: 'inp_students', label: 'Number of Students', min: 50, max: 5000, val: 500, step: 50, factor: 300000 },
          { id: 'inp_staff', label: 'Number of Staff', min: 10, max: 500, val: 45, step: 5, factor: 500000 },
          { id: 'inp_building', label: 'Building Value (₦M)', min: 10, max: 2000, val: 300, step: 10, factor: 250000 },
          { id: 'inp_buses', label: 'School Buses', min: 0, max: 50, val: 3, step: 1, factor: 5000000 }
        ],
        baseExposure: 10000000
      }
    };

    // Determine current industry from URL or fallback to school
    const path = window.location.pathname.replace('/', '').toLowerCase();
    const industryKey = calcConfigs[path] ? path : 'school';
    const config = calcConfigs[industryKey];

    const formatCurrency = (num) => {
      return '₦' + num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    };

    const updateExposure = () => {
      let total = config.baseExposure;
      config.inputs.forEach(inp => {
        const val = parseInt(document.getElementById(inp.id).value) || inp.val;
        total += (val * inp.factor);
      });
      document.getElementById('exposureTotal').innerText = formatCurrency(total);
      
      const inMillions = Math.round(total / 1000000);
      document.getElementById('exposureDesc').innerText = `Based on your inputs, a major incident could expose your organization to losses exceeding ₦${inMillions} million.`;
    };

    const renderInputs = () => {
      const container = document.getElementById('calcInputs');
      let html = '';
      config.inputs.forEach(inp => {
        html += `
          <div class="calc-input-group">
            <div class="calc-input-label">
              ${inp.label}
            </div>
            <div class="calc-controls">
              <button class="btn btn-outline" style="border-color: #e2e8f0; color: #0f172a; height: 32px; padding: 0 12px;" onclick="changeVal('${inp.id}', -${inp.step})">-</button>
              <div class="calc-val" id="${inp.id}_disp">${inp.val}</div>
              <button class="btn btn-outline" style="border-color: #e2e8f0; color: #0f172a; height: 32px; padding: 0 12px;" onclick="changeVal('${inp.id}', ${inp.step})">+</button>
            </div>
            <input type="hidden" id="${inp.id}" value="${inp.val}">
          </div>
        `;
      });
      container.innerHTML = html;
      updateExposure();
    };

    window.changeVal = (id, delta) => {
      const inp = config.inputs.find(i => i.id === id);
      const el = document.getElementById(id);
      const disp = document.getElementById(id + '_disp');
      
      let newVal = parseInt(el.value) + delta;
      if (newVal < inp.min) newVal = inp.min;
      if (newVal > inp.max) newVal = inp.max;
      
      el.value = newVal;
      disp.innerText = newVal;
      updateExposure();
    };

    document.addEventListener('DOMContentLoaded', renderInputs);
  </script>
