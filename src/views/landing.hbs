                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: #3B82F6;">✔️</span> Recommended Protection Priorities
                </div>
              </div>
            </div>
          </div>
          <a href="/start-whatsapp" class="mo-btn mo-btn-navy" style="width: 100%;">Start Business Assessment ➔</a>
        </div>

        <!-- Personal Card -->
        <div class="mo-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div class="mo-card-content">
            <div style="width: 96px; height: 96px; flex-shrink: 0; background: var(--mo-green-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; color: var(--mo-green); margin-top: 12px;">👨‍👩‍👧‍👦</div>
            <div style="padding-top: 8px;">
              <h3 style="font-size: 1.5rem; color: var(--mo-green); margin-bottom: 8px;">Personal Risk Assessment</h3>
              <p style="color: var(--mo-text-muted); margin-bottom: 24px;">For individuals and families.</p>
              
              <div style="display: flex; flex-direction: column; align-items: flex-start;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: var(--mo-green);">✔️</span> Personal Risk Score
                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: var(--mo-green);">✔️</span> Income Protection Assessment
                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: var(--mo-green);">✔️</span> Family Financial Security Review
                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: var(--mo-green);">✔️</span> Insurance Gap Analysis
                </div>
              </div>
            </div>
          </div>
          <a href="/start-whatsapp" class="mo-btn mo-btn-green" style="width: 100%;">Start Personal Assessment ➔</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REPORT PREVIEW -->
