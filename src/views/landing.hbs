<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css?v=78">
</head>
<body style="padding-bottom: 72px;">

  <!-- 1. NAVIGATION BAR -->
  <nav class="navbar">
    <div class="funnel-container navbar-inner">
      <a href="/" class="logo">
        <img src="/images/logo.png" alt="CoverScore AI" style="height: 80px; width: auto; object-fit: contain;">
      </a>
      <div class="desktop-nav">
        <a href="#calculator">Exposure Calculator</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#sample">Sample Report</a>
        <a href="/auth/login">Login</a>
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="color: white; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
      </div>
      <button class="mobile-menu-btn" aria-label="Open navigation menu">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- 2. HERO SECTION -->
  <section id="hero" class="funnel-section-light hero funnel-container">
    <!-- === DESKTOP HERO CONTENT (side-by-side, hidden on mobile) === -->
    <div class="hero-content hero-desktop-only">
      <h1 class="hero-title">{{{data.hero.headline}}}</h1>
      <p class="hero-subtitle">{{data.hero.subheadline}}</p>
      <div class="hero-benefits">
        {{#each data.hero.benefits}}
        <div class="hero-benefit">
          <div class="hero-benefit-icon">✓</div>
          {{this}}
        </div>
        {{/each}}
      </div>
      <div style="margin-top: 16px;">
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="font-size: 1.1rem; height: 56px; width: 65%;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
        <div class="hero-security">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Secure. Private. Takes 5–7 minutes.
        </div>
      </div>
    </div>

    <!-- === HERO IMAGE (both mobile + desktop) === -->
    <div class="hero-image-wrapper">
      <img src="{{#if data.hero.image}}{{data.hero.image}}{{else}}https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d{{/if}}" alt="CoverScore AI" class="hero-image">
      <!-- Desktop overlay only -->
      <div class="hero-overlay hero-desktop-only">
        <div class="overlay-statement">
          <svg width="40" height="40" fill="none" stroke="var(--color-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M12 8l1.5 2.5 3 .5-2 2 .5 3-3-1.5-3 1.5.5-3-2-2 3-.5z"/>
          </svg>
          <div>{{{data.hero.overlayStatement}}}</div>
        </div>
        <div class="overlay-metrics">
          {{#each data.hero.metrics}}
          <div class="overlay-metric">
            <div class="overlay-metric-icon">{{{this.icon}}}</div>
            <div>
              <div class="overlay-metric-val">{{this.value}}</div>
              <div class="overlay-metric-lbl">{{{this.label}}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- === MOBILE HERO CONTENT (below image, hidden on desktop) === -->
    <div class="hero-mobile-content">
      <h1 class="hero-mobile-title">
        {{#if data.hero.mobileHeadline}}
          {{{data.hero.mobileHeadline}}}
        {{else}}
          See Your Hospital's<br><span class="hero-highlight">Risk Score</span><br>In Less Than 5 Minutes.
        {{/if}}
      </h1>
      <div class="hero-mobile-divider"></div>
      <p class="hero-mobile-subtitle">
        {{#if data.hero.mobileSubheadline}}
          {{data.hero.mobileSubheadline}}
        {{else}}
          Most hospitals discover critical risks they never knew existed.
        {{/if}}
      </p>

      <!-- Mobile CTA -->
      <a href="/start-whatsapp?text={{trigger}}" class="hero-mobile-cta">
        <div class="hero-mobile-cta-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <div>
          <div class="hero-mobile-cta-title">
            {{#if data.hero.mobileCta}}{{data.hero.mobileCta}}{{else}}Get My Hospital Risk Score{{/if}}
          </div>
          <div class="hero-mobile-cta-sub">
            {{#if data.hero.mobileCtaSub}}{{data.hero.mobileCtaSub}}{{else}}Takes Less Than 5 Minutes{{/if}}
          </div>
        </div>
      </a>

      <!-- Trust Badge -->
      <div class="hero-trust-badge">
        <div class="hero-trust-badge-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00A651" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div>
          <div class="hero-trust-badge-title">
            {{#if data.hero.trustBadgeTitle}}{{data.hero.trustBadgeTitle}}{{else}}500+ Healthcare Facilities Assessed{{/if}}
          </div>
          <div class="hero-trust-badge-desc">
            {{#if data.hero.trustBadgeDesc}}{{data.hero.trustBadgeDesc}}{{else}}Trusted by hospital leaders across the country.{{/if}}
          </div>
        </div>
      </div>

      <!-- Trust Icons Bar -->
      <div class="hero-trust-icons">
        <div class="hero-trust-icon-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Secure
        </div>
        <div class="hero-trust-icon-sep"></div>
        <div class="hero-trust-icon-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          Private
        </div>
        <div class="hero-trust-icon-sep"></div>
        <div class="hero-trust-icon-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          No Obligation
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RISK EXPOSURE CALCULATOR -->
  <section id="calculator" class="funnel-section funnel-section-gray">
    <div class="funnel-container" style="display: flex; flex-direction: column;">
      
      <!-- === DESKTOP CALCULATOR (Hidden on Mobile) === -->
      <div class="calc-card calc-desktop-only">
        <div class="calc-header">
          <div>
            <h2 class="calc-title">{{data.calculator.title}}</h2>
            <p class="calc-subtitle">{{data.calculator.subtitle}}</p>
          </div>
        </div>
        <div class="calc-inputs" id="calcInputs">
            <!-- Injected via JS based on industry -->
          </div>
          <div class="calc-output">
            <div style="margin: auto 0;">
              <div class="calc-output-title">Your Potential Financial Exposure</div>
              <div class="calc-output-val" id="exposureTotal">₦0</div>
              <div class="calc-output-desc" id="exposureDesc">Based on your inputs, a major incident could expose you to significant losses.</div>
            </div>
            <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Get My Full Risk Score
            </a>
          </div>
      </div>

      <!-- === MOBILE CALCULATOR (Hidden on Desktop) === -->
      <div class="calc-mobile-content">
        
        <h2 class="calc-mobile-headline">What Could One Incident Cost Your <span style="color: #00A651;">Hospital</span>?</h2>
        <p class="calc-mobile-subheadline">A quick estimate based on your hospital size and equipment value.</p>
        
        <div id="calcInputsMobile" class="calc-mobile-inputs-container">
          <!-- Injected via JS -->
        </div>

        <!-- Result Card -->
        <div class="calc-mobile-result">
          <svg class="calc-mobile-result-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#FCA5A5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <div class="calc-mobile-result-title">Your Potential Financial Exposure</div>
          <div class="calc-mobile-result-val" id="exposureTotalMobile">₦0</div>
          <div class="calc-mobile-result-desc">This is what one major incident could cost your hospital.</div>
        </div>

        <!-- Action Banner -->
        <a href="/start-whatsapp?text={{trigger}}" class="calc-mobile-action-banner" style="text-decoration: none;">
          <div class="calc-mobile-action-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00A651" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <div class="calc-mobile-action-text">
            <div class="calc-mobile-action-title">See where your biggest risks exist</div>
            <div class="calc-mobile-action-sub">Get your actual risk score and detailed report.</div>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00A651" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <!-- CTA Button -->
        <a href="/start-whatsapp?text={{trigger}}" class="hero-mobile-cta" style="margin-top: 8px;">
          <div class="hero-mobile-cta-icon" style="background: transparent;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div class="hero-mobile-cta-title" style="margin: 0 auto; padding-right: 32px;">
            Get My Actual Hospital Risk Score
          </div>
        </a>

        <!-- Trust Icons -->
        <div class="hero-trust-icons" style="margin-top: 8px;">
          <div class="hero-trust-icon-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            100% Secure
          </div>
          <div class="hero-trust-icon-sep"></div>
          <div class="hero-trust-icon-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            Private & Confidential
          </div>
          <div class="hero-trust-icon-sep"></div>
          <div class="hero-trust-icon-item" style="gap: 4px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Takes Less Than 5 Minutes
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. TRUST BAR -->
  <section class="funnel-section-light hide-on-mobile">
    <div class="funnel-container trust-bar">
      <div class="trust-item"><img src="/images/trust-lock.jpg" alt="" width="42" height="42" style="object-fit: contain;"> Confidential & Secure</div>
      <div class="trust-item"><img src="/images/trust-ai.jpg" alt="" width="42" height="42" style="object-fit: contain;"> AI-Powered Insights</div>
      <div class="trust-item"><img src="/images/trust-shield.jpg" alt="" width="42" height="42" style="object-fit: contain;"> {{data.trustBarExpertise}}</div>
      <div class="trust-item"><img src="/images/trust-check.jpg" alt="" width="42" height="42" style="object-fit: contain;"> Actionable Recommendations</div>
    </div>
  </section>

<div class="desktop-funnel hide-on-mobile">
  <!-- 5. WHY CHOOSE COVERSCORE -->
  <section class="funnel-section funnel-section-light">
    <div class="funnel-container">
      <div class="section-header">
        <h2 class="section-title">{{data.whyChooseTitle}}</h2>
      </div>
      <div class="features-grid">
        {{#each data.whyChoose}}
        <div class="feature-card">
          <div class="feature-icon">{{this.icon}}</div>
          <h3 class="feature-title">{{this.title}}</h3>
          <p class="feature-desc">{{this.desc}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- 6. REAL RISK STORIES -->
  <section class="funnel-section funnel-section-gray">
    <div class="funnel-container">
      <div class="stories-layout" style="background: #FFF4E6; padding: 48px; border-radius: var(--radius-lg); align-items: stretch;">
        <div style="display: flex; flex-direction: column;">
          <div class="stories-header">
            <h2 class="calc-title">REAL RISK STORIES</h2>
          </div>
          <p style="padding: 0 32px; color: var(--color-surface-dark); margin-top: 8px;">Incidents happen. Preparation makes the difference.</p>
          
          <div class="stories-grid-three mobile-swipeable-cards" style="display: grid; gap: 24px; margin-top: 32px;">
            {{#each data.stories}}
            <div class="story-card" style="background: white; padding: 24px; border-radius: var(--radius-md); display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start;">
              <div class="story-icon" style="margin-bottom: 0; font-size: 2.25rem; line-height: 1;">{{{this.icon}}}</div>
