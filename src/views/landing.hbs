        <h2 style="font-size: 2.5rem; color: var(--mo-navy-dark);">Choose Your Assessment</h2>
      </div>

      <div class="mo-assessment-grid">
        <!-- Business Card -->
        <div class="mo-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div class="mo-card-content">
            <div style="width: 96px; height: 96px; flex-shrink: 0; background: #EFF6FF; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; color: #3B82F6; margin-top: 12px;">🏢</div>
            <div style="padding-top: 8px;">
              <h3 style="font-size: 1.5rem; color: var(--mo-navy-dark); margin-bottom: 8px;">Business Risk Assessment</h3>
              <p style="color: var(--mo-text-muted); margin-bottom: 24px;">For businesses of all sizes and industries.</p>
              
              <div style="display: flex; flex-direction: column; align-items: flex-start;">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
                  <span style="color: #3B82F6;">✔️</span> Business Risk Score
                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: var(--mo-text-dark);">
