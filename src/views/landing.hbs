<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing.css?v=31">
</head>
<body style="padding-bottom: 72px;">

  <!-- 1. NAVIGATION BAR -->
  <nav class="navbar">
    <div class="funnel-container navbar-inner">
      <a href="/" class="logo">
        <img src="/images/logo.png" alt="CoverScore AI" style="height: 80px; width: auto; object-fit: contain;">
      </a>
      <div class="desktop-nav">
        <a href="#calculator">Exposure Calculator</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#sample">Sample Report</a>
        <a href="/auth/login">Login</a>
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="color: white; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
      </div>
      <button class="mobile-menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </nav>

  <!-- 2. HERO SECTION -->
  <section class="funnel-section-light hero funnel-container">
    <div class="hero-content">
      <h1 class="hero-title">{{{data.hero.headline}}}</h1>
      <p class="hero-subtitle">{{data.hero.subheadline}}</p>
      
      <div class="hero-benefits">
        {{#each data.hero.benefits}}
        <div class="hero-benefit">
          <div class="hero-benefit-icon">✓</div>
          {{this}}
        </div>
        {{/each}}
      </div>
      
      <div style="margin-top: 16px;">
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="font-size: 1.1rem; height: 56px; width: 65%;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{trigger}}
        </a>
        <div class="hero-security">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Secure. Private. Takes 5–7 minutes.
        </div>
      </div>
    </div>
    
    <div class="hero-image-wrapper">
      <img src="{{#if data.hero.image}}{{data.hero.image}}{{else}}https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1453&q=80{{/if}}" alt="CoverScore AI Dashboard" class="hero-image">
      
      <div class="hero-overlay">
        <div class="overlay-statement">
          <svg width="40" height="40" fill="none" stroke="var(--color-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M12 8l1.5 2.5 3 .5-2 2 .5 3-3-1.5-3 1.5.5-3-2-2 3-.5z"/>
          </svg>
          <div>{{{data.hero.overlayStatement}}}</div>
        </div>
        <div class="overlay-metrics">
          {{#each data.hero.metrics}}
          <div class="overlay-metric">
            <div class="overlay-metric-icon">{{{this.icon}}}</div>
            <div>
              <div class="overlay-metric-val">{{this.value}}</div>
              <div class="overlay-metric-lbl">{{{this.label}}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RISK EXPOSURE CALCULATOR -->
  <section id="calculator" class="funnel-section funnel-section-gray" style="margin-top: 64px;">
    <div class="funnel-container">
      <div class="calc-card">
        <div class="calc-header">
          <div>
            <h2 class="calc-title">INSTANT HOSPITAL RISK EXPOSURE CALCULATOR™</h2>
            <p class="calc-subtitle">Estimate the potential financial impact of major incidents on your organization.</p>
          </div>
        </div>
        <div class="calc-inputs" id="calcInputs">
            <!-- Injected via JS based on industry -->
          </div>
          <div class="calc-output">
            <div class="calc-output-title">Your Potential Financial Exposure</div>
            <div class="calc-output-val" id="exposureTotal">₦0</div>
            <div class="calc-output-desc" id="exposureDesc">Based on your inputs, a major incident could expose you to significant losses.</div>
            <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Get My Full Risk Score
            </a>
          </div>
      </div>
    </div>
  </section>

  <!-- 4. TRUST BAR -->
  <section class="funnel-section-light">
    <div class="funnel-container trust-bar">
      <div class="trust-item"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Confidential & Secure</div>
      <div class="trust-item"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg> AI-Powered Insights</div>
      <div class="trust-item"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg> Industry Leading Accuracy</div>
      <div class="trust-item"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> Actionable Recommendations</div>
    </div>
  </section>

  <!-- 5. WHY CHOOSE COVERSCORE -->
  <section class="funnel-section funnel-section-light">
    <div class="funnel-container">
      <div class="section-header">
        <h2 class="section-title">Why Organizations Choose CoverScore</h2>
      </div>
      <div class="features-grid">
        {{#each data.whyChoose}}
        <div class="feature-card">
          <div class="feature-icon">{{this.icon}}</div>
          <h3 class="feature-title">{{this.title}}</h3>
          <p class="feature-desc">{{this.desc}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- 6. REAL RISK STORIES -->
  <section class="funnel-section funnel-section-gray">
    <div class="funnel-container">
      <div class="stories-layout">
        <div>
          <div class="stories-header">
            <div class="calc-badge">2</div>
            <h2 class="calc-title">REAL RISK STORIES</h2>
          </div>
          <p style="padding: 0 32px; color: var(--text-muted); margin-top: 8px;">Incidents happen. Preparation makes the difference.</p>
          <div class="stories-grid">
            {{#each data.stories}}
            <div class="story-card">
              <div class="story-icon">{{this.icon}}</div>
              <h4 class="story-title">{{this.title}}</h4>
              <p class="story-desc">{{this.desc}}</p>
              <div>
                <div class="story-loss-label">Estimated Loss</div>
                <div class="story-loss-val">{{this.loss}}</div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="insight-panel">
          <div class="insight-quote">Most incidents begin as "unlikely events." Until they happen.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. HOW IT WORKS -->
  <section id="how-it-works" class="funnel-section funnel-section-light">
    <div class="funnel-container">
      <div class="section-header">
        <h2 class="section-title">How It Works</h2>
      </div>
      <div class="steps-container">
        <div class="step-card">
          <div class="step-num">1</div>
          <div>
            <h4 class="step-title">Start on WhatsApp</h4>
            <p class="step-desc">Answer a few simple questions.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <div>
            <h4 class="step-title">AI Analyzes Risks</h4>
            <p class="step-desc">Our AI evaluates your responses.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <div>
            <h4 class="step-title">Get Your Risk Score</h4>
            <p class="step-desc">Receive your score instantly.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <div>
            <h4 class="step-title">Receive Your Report</h4>
            <p class="step-desc">Get a personalized risk report.</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-num">5</div>
          <div>
            <h4 class="step-title">Speak to an Advisor</h4>
            <p class="step-desc">Connect with an expert for tailored solutions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. TRUSTED LEADERS -->
  <section class="funnel-section funnel-section-gray">
    <div class="funnel-container leaders-grid">
      <div>
        <h2 class="section-title" style="text-align: left; margin-bottom: 32px;">Trusted by Leaders</h2>
        <div class="metrics-grid">
          {{#each data.hero.metrics}}
          <div class="metric-card">
            <div style="font-size: 2rem;">{{this.icon}}</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-surface-dark);">{{this.value}}</div>
            <div style="font-size: 0.9rem; color: var(--text-muted);">{{this.label}}</div>
          </div>
          {{/each}}
        </div>
      </div>
      <div class="testimonial-card">
        <div class="t-quote">{{data.testimonial.quote}}</div>
        <div class="t-author">
          <div class="t-avatar"></div>
          <div>
            <div class="t-name">{{data.testimonial.author}}</div>
            <div class="t-role">{{data.testimonial.role}}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. REPORT PREVIEW -->
  <section id="sample" class="funnel-section funnel-section-light">
    <div class="funnel-container">
      <div class="section-header" style="text-align: left; display: flex; align-items: center; gap: 16px;">
        <div class="calc-badge">3</div>
        <h2 class="section-title" style="margin: 0;">Your Personalized Risk Report Preview</h2>
      </div>
      
      <div class="report-preview-grid">
        <div class="rp-card">
          <div class="rp-title">RISK SCORE™</div>
          <div class="rp-score-val">{{data.preview.score}}<span class="rp-score-sub">/100</span></div>
          <div class="rp-risk-level">{{data.preview.riskText}}</div>
        </div>
        
        <div class="rp-card" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; text-align: left;">
          <div>
            <div class="rp-title">Top Risk Areas</div>
            <div class="rp-list">
              {{#each data.preview.topRisks}}
              <div class="rp-item">
                <div>✓ {{this.name}}</div>
                <div style="color: {{this.color}}; font-weight: 600;"><span class="rp-dot" style="background: {{this.color}};"></span> {{this.level}}</div>
              </div>
              {{/each}}
            </div>
          </div>
          <div>
            <div class="rp-title">Protection Gap Score</div>
            <div class="rp-score-val" style="font-size: 3rem;">{{data.preview.gapScore}}<span class="rp-score-sub" style="font-size: 1.2rem;">/100</span></div>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 8px;">You have protection gaps that need attention.</p>
            
            <div class="rp-title" style="margin-top: 32px;">Estimated Exposure</div>
            <div class="rp-score-val" style="font-size: 2rem;">₦{{data.preview.exposure}}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. ADVANTAGE TABLE -->
  <section class="funnel-section funnel-section-light" style="padding-top: 0;">
    <div class="funnel-container">
      <h3 style="text-align: center; margin-bottom: 32px; font-size: 1.5rem; color: var(--color-surface-dark);">THE COVERSCORE ADVANTAGE</h3>
      <div class="compare-table">
        <div class="compare-row compare-header">
          <div>Traditional Approach</div>
          <div style="color: var(--color-primary-dark);">CoverScore Approach</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell text-muted">Unknown Risks</div>
          <div class="compare-cell pro">✓ Risk Intelligence</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell text-muted">Reactive Decisions</div>
          <div class="compare-cell pro">✓ Proactive Planning</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell text-muted">Insurance Purchased Blindly</div>
          <div class="compare-cell pro">✓ Risk-Based Recommendations</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell text-muted">No Visibility Into Exposure</div>
          <div class="compare-cell pro">✓ Financial Exposure Analysis</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell text-muted">Generic Advice</div>
          <div class="compare-cell pro">✓ Personalized Recommendations</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. CTA BANNER -->
  <section class="funnel-section funnel-section-light" style="padding-top: 0;">
    <div class="funnel-container">
      <div class="cta-banner">
        <h2 class="cta-banner-title">{{data.finalBanner.headline}}</h2>
        <div class="cta-icons-grid">
          {{#each data.finalBanner.icons}}
          <div class="cta-icon-item">
            <div class="cta-icon-icon">{{this.icon}}</div>
            <div class="cta-icon-lbl">{{this.label}}</div>
          </div>
          {{/each}}
        </div>
        <div class="cta-loss-box">
          <div class="cta-loss-lbl">Potential Loss:</div>
          <div class="cta-loss-val">{{data.finalBanner.exposure}}</div>
        </div>
        <a href="/start-whatsapp?text={{trigger}}" class="btn btn-green" style="height: 56px; font-size: 1.1rem; width: 100%; max-width: 400px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Get My Risk Score
        </a>
        <div style="margin-top: 16px; font-size: 0.85rem; color: var(--text-inverse-muted);">Secure • Confidential • No Obligation • Takes Less Than 5 Minutes</div>
      </div>
    </div>
  </section>

  <!-- 12. FOOTER -->
  <footer class="footer">
    <div class="funnel-container footer-grid">
      <div>
        <a href="/" class="footer-logo" style="display: inline-block; background: white; padding: 12px 24px; border-radius: 12px;">
          <img src="/images/logo.png" alt="CoverScore AI" style="height: 56px; width: auto; display: block; object-fit: contain;">
        </a>
        <p style="margin-bottom: 24px;">CoverScore helps organizations identify, understand, and manage risks so they can focus on what matters most—building a secure future.</p>
