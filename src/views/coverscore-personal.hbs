  <!-- 01. Sticky Mobile CTA -->
  <div class="sticky-cta" id="sticky-cta">
    <button class="btn-primary" onclick="startAssessment('sticky_mobile')">Start My Free Score</button>
    <div class="meta">Takes about 3 minutes</div>
  </div>

</div>

<script>
  // 1. Session and Attribution Generation
  const generateSessionKey = () => {
    return 'sess_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
  };

  let sessionKey = localStorage.getItem('cs_session_key');
  if (!sessionKey) {
    sessionKey = generateSessionKey();
    localStorage.setItem('cs_session_key', sessionKey);
  }

  const getQueryParams = () => {
    const params = new URLSearchParams(window.location.search);
    return {
      utm_source: params.get('utm_source'),
      utm_medium: params.get('utm_medium'),
      utm_campaign: params.get('utm_campaign'),
      utm_content: params.get('utm_content'),
      utm_term: params.get('utm_term'),
      campaign_code: params.get('campaign_code') || 'WEB_FAMILY_2026',
      referral_code: params.get('ref')
    };
  };

  const getDeviceType = () => {
    const ua = navigator.userAgent;
    if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) return 'tablet';
    if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry|Kindle|Silk-Accelerated|(hpw|web)OS|Opera M(obi|ini)/.test(ua)) return 'mobile';
    return 'desktop';
  };

  // 2. Tracking Engine
  const trackEvent = (eventName, extraMetadata = {}) => {
    const params = getQueryParams();
    const payload = {
      event_name: eventName,
      landing_page: 'coverscore_personal',
      cta_position: extraMetadata.cta_position || null,
      session_key: sessionKey,
      device_type: getDeviceType(),
      ...params,
      metadata: extraMetadata
    };

    // Fire and forget POST request
    fetch('/api/public/landing-event', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).catch(console.error);
  };

  // 3. CTA Action
  const startAssessment = (position) => {
    trackEvent('family_protection_cta_clicked', { cta_position: position });
    
    // Redirect to WhatsApp
    const params = getQueryParams();
    const campaignCode = params.campaign_code;
    const text = encodeURIComponent(`FAMILY ${campaignCode}`);
    const botNumber = '{{whatsappNumber}}';
    
    trackEvent('whatsapp_redirect_started', { destination: botNumber, campaign: campaignCode });
    
    setTimeout(() => {
      window.location.href = `https://wa.me/${botNumber}?text=${text}`;
    }, 200);
  };

  // 4. Viewport Observers
  document.addEventListener('DOMContentLoaded', () => {
    trackEvent('landing_page_viewed');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const eventName = entry.target.getAttribute('data-event');
          if (eventName) {
            trackEvent(eventName);
            observer.unobserve(entry.target); // Only track once per page load
          }
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.observer-target').forEach(el => observer.observe(el));
    
    // Sticky CTA logic - hide when final CTA is in view
    const stickyCta = document.getElementById('sticky-cta');
    const finalCta = document.getElementById('final-cta');
    
    const finalObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          stickyCta.style.display = 'none';
        } else {
          stickyCta.style.display = 'flex';
        }
      });
    }, { threshold: 0.1 });
    
    if (finalCta && stickyCta) {
      finalObserver.observe(finalCta);
    }
  });

  // 5. FAQ Toggle
  window.toggleFaq = function(element) {
    const isActive = element.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));
    if (!isActive) {
      element.classList.add('active');
      trackEvent('faq_opened', { question: element.querySelector('.faq-question').innerText });
    }
  };

  // 6. Calculator Logic
  const input = document.getElementById('monthlyExpenses');
  const durationBtns = document.querySelectorAll('.segment-btn');
  const resultEl = document.getElementById('exposureResult');
  const subheadEl = document.getElementById('exposureSubhead');
  const btnContinue = document.getElementById('btnContinue');
  
  let duration = 6; // Default to 6 months
  
  // Format number with commas
  function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }
  
  // Calculate exposure
  function calculate() {
    // Get raw numeric value
    const rawValue = input.value.replace(/,/g, '').replace(/[^\d]/g, '');
    const expenses = parseInt(rawValue, 10);
    
    if (!isNaN(expenses) && expenses > 0) {
      const exposure = expenses * duration;
      resultEl.textContent = '₦' + formatNumber(exposure);
      subheadEl.innerHTML = `This is the estimated amount your household may need to maintain essential expenses for <strong>${duration} months</strong>.`;
      btnContinue.disabled = false;
      input.closest('.input-wrapper').classList.add('has-value');
    } else {
      resultEl.textContent = '₦0';
      subheadEl.innerHTML = `This is the estimated amount your household may need to maintain essential expenses for <strong>${duration} months</strong>.`;
      btnContinue.disabled = true;
      input.closest('.input-wrapper').classList.remove('has-value');
    }
  }
  
  // Handle input changes
  if (input) {
    input.addEventListener('input', (e) => {
      // Remove non-numeric characters for processing
      let rawValue = e.target.value.replace(/,/g, '').replace(/[^\d]/g, '');
      
      // Re-format with commas and set value
      if (rawValue !== '') {
        e.target.value = formatNumber(rawValue);
      } else {
        e.target.value = '';
      }
      
      calculate();
    });
  }
  
  // Handle segment buttons
  if (durationBtns) {
    durationBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all
        durationBtns.forEach(b => b.classList.remove('active'));
        // Add active class to clicked
        btn.classList.add('active');
        
        duration = parseInt(btn.getAttribute('data-months'), 10);
        calculate();
      });
    });
  }
  
  // CTA Button
  if (btnContinue) {
    btnContinue.addEventListener('click', () => {
      const rawValue = input.value.replace(/,/g, '').replace(/[^\d]/g, '');
      const expenses = parseInt(rawValue, 10);
      const exposure = expenses * duration;
      
      // WhatsApp redirection logic
      const botNumber = '{{whatsappNumber}}';
      const msg = `Hi CoverScore! I calculated my estimated financial exposure as ₦${formatNumber(exposure)} (₦${formatNumber(expenses)}/mo for ${duration} months). I want to see my full Family Protection Score.`;
      const encodedMsg = encodeURIComponent(msg);
      
      // Track event asynchronously
      try {
        fetch('/api/public/landing-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_name: 'exposure_calculated',
            landing_page: 'personal_calculator',
            cta_position: 'calculator_cta',
            session_key: localStorage.getItem('coverscore_session') || Date.now().toString(),
            metadata: { expenses, duration, exposure }
          })
        });
      } catch(e) {}
      
      // Redirect to WhatsApp
      window.location.href = `https://wa.me/${botNumber}?text=${encodedMsg}`;
    });
  }
</script>

