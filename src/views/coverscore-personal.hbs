<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  <meta name="description" content="Take the free 3-minute Family Protection Score™ on WhatsApp and receive a private report showing your household protection priorities.">
  <meta property="og:title" content="How Prepared Is Your Family for Life’s Unexpected Changes?">
  <meta property="og:description" content="Take the free Family Protection Score™ on WhatsApp and receive a private household protection report.">
  <meta property="og:image" content="/images/coverscore-personal-og.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/coverscore-personal.css">
  <link rel="stylesheet" href="/css/coverscore-calculator.css">
</head>
<body>

<div class="container" id="main-container">

  <!-- Header -->
  <header class="header">
    <div class="logo-container">
      <div class="logo-text">Cover<span>Score</span></div>
      <div class="logo-sub">Personal</div>
    </div>
    <div class="hamburger">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="section hero" id="hero">
    <div class="eyebrow">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
      FREE FAMILY PROTECTION CHECK
    </div>
    
    <h1>How prepared is your family for <span class="text-green">life's unexpected changes?</span></h1>
    <p>Get your private <strong>Family Protection Score™</strong> in about 3 minutes on WhatsApp and know the areas that need attention.</p>
    
    <div class="hero-badges">
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="hero-badge-text">Takes about<br><strong>3 minutes</strong></div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div class="hero-badge-text">Private<br><span class="green-strong">WhatsApp</span><br>assessment</div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div class="hero-badge-text">No payment<br><span class="green-strong">required</span></div>
      </div>
    </div>
    
    <button class="btn-whatsapp" onclick="startAssessment('hero')">
      <div class="btn-whatsapp-content">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        Calculate My Family Exposure
      </div>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
    
    <div class="handwriting-section">
      <div class="handwriting-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5l-4 4 4 4"/>
          <path d="M5 9c6 0 10 4 10 10"/>
        </svg>
      </div>
      <div class="handwriting-text">
        See your estimated financial exposure in <span class="underline-green">30 seconds</span>
      </div>
    </div>
    
    <div class="hero-visual">
      <img src="/images/hero-family.png" alt="Family protection" loading="lazy">
    </div>
    
    <div class="hero-footer-trust">
      <div class="hero-footer-trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        For awareness and planning only. Not an insurance quote or offer.
      </div>
      <div class="hero-footer-trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your data is private and secure. No phone number required.
      </div>
    </div>
  </section>

  <!-- 02b. Exposure Calculator Section -->
  <section class="section calculator" style="background-color: var(--bg-color); padding: 1.5rem 1.5rem;" id="calculator">
    <div class="step-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
        <rect x="9" y="9" width="6" height="6"/>
        <line x1="9" y1="1" x2="9" y2="4"/>
        <line x1="15" y1="1" x2="15" y2="4"/>
        <line x1="9" y1="20" x2="9" y2="23"/>
        <line x1="15" y1="20" x2="15" y2="23"/>
        <line x1="20" y1="9" x2="23" y2="9"/>
        <line x1="20" y1="14" x2="23" y2="14"/>
        <line x1="1" y1="9" x2="4" y2="9"/>
        <line x1="1" y1="14" x2="4" y2="14"/>
      </svg>
      EXPOSURE CALCULATOR
    </div>
    
    <h2>Let's estimate your <span class="text-green">family's financial exposure</span></h2>
    <p class="subtitle" style="margin-bottom: 2rem;">If your <strong>income stopped tomorrow</strong>, how much would your family need to stay financially secure?</p>
    
    <!-- Expenses Card -->
    <div class="calc-card">
      <div class="card-header">
        <div class="icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <div class="card-title-wrap">
          <label for="monthlyExpenses">Your estimated monthly<br>household expenses</label>
          <div class="info-icon" title="Include living expenses like food, rent, transport, school fees, utilities, loans, etc.">i</div>
        </div>
      </div>
      
      <div class="input-wrapper">
        <span class="currency-prefix">₦</span>
        <input type="text" id="monthlyExpenses" inputmode="numeric" placeholder="e.g. 500,000" autocomplete="off">
      </div>
      
      <p class="help-text">Include living expenses like food, rent, transport, school fees, utilities, loans, etc.</p>
    </div>
    
    <!-- Duration Card -->
    <div class="calc-card">
      <div class="card-header">
        <div class="icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <rect x="8" y="14" width="3" height="3" fill="currentColor"/>
          </svg>
        </div>
        <div class="card-title-wrap">
          <label>How many months would your<br>family need support?</label>
          <div class="info-icon" title="Choose how long your family would need coverage to transition or replace income.">i</div>
        </div>
      </div>
      
      <div class="segmented-control" id="durationControl">
        <button class="segment-btn" data-months="3">3 months</button>
        <button class="segment-btn active" data-months="6">6 months</button>
        <button class="segment-btn" data-months="12">12 months</button>
      </div>
    </div>
    
    <!-- Result Card -->
    <div class="result-card">
      <div class="result-header">
        <div class="result-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
        </div>
        <div class="result-title">Your Estimated Household Exposure</div>
      </div>
      
      <div class="huge-number" id="exposureResult">₦0</div>
      
      <p class="result-subhead" id="exposureSubhead">
        This is the estimated amount your household may need to maintain essential expenses for 6 months.
      </p>
      
      <div class="disclaimer-wrap">
        <svg class="disclaimer-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <div class="disclaimer-text">
          This is an estimate based on the figures you entered and is for awareness and planning purposes only.
        </div>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="cta-section">
      <button class="btn-whatsapp" id="btnContinue" disabled>
        <div class="btn-whatsapp-content">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span style="text-align: left; line-height: 1.2;">See My Full Family<br>Protection Score™</span>
        </div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
      
      <div class="trust-badges-row">
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Private & secure
        </div>
        <div class="trust-divider"></div>
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Takes under 30 seconds
        </div>
        <div class="trust-divider"></div>
        <div class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          No obligation
        </div>
      </div>
    </div>
  </section>

  <!-- 03. Trust Strip -->
  <section class="trust-strip observer-target" data-event="trust_strip_viewed">
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      Free to take
    </div>
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      Takes about 3 minutes
    </div>
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      Private report delivered on WhatsApp
    </div>
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      Advisor support is optional
    </div>
  </section>

  <!-- 04. What You Get Section (Step 2) -->
  <section class="section wyg-section">
    <div class="step-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"/>
        <rect x="2" y="7" width="20" height="5"/>
        <line x1="12" y1="22" x2="12" y2="7"/>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
      </svg>
      STEP 2 OF 3
    </div>
    
    <h2>Here's what<br><span class="text-green">you'll receive</span></h2>
    <p class="wyg-subtitle">After your quick assessment on WhatsApp, you'll get a clear, personalized view of your family's protection.</p>
    
    <!-- Card 1 -->
    <div class="wyg-card">
      <div class="wyg-icon-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 14l4-4"/><circle cx="12" cy="14" r="2"/><path d="M3.34 16A10 10 0 1 1 20.66 16"/>
        </svg>
      </div>
      <div class="wyg-content">
        <div class="wyg-title-row">
          <div class="wyg-badge-num">1</div>
          <div class="wyg-title">Your Family Protection Score™</div>
        </div>
        <div class="wyg-text">See how prepared your family may be on a simple score from 0–100.</div>
      </div>
    </div>
    
    <!-- Card 2 -->
    <div class="wyg-card">
      <div class="wyg-icon-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14h6"/><path d="M9 18h6"/><path d="M9 10h6"/>
        </svg>
      </div>
      <div class="wyg-content">
        <div class="wyg-title-row">
          <div class="wyg-badge-num">2</div>
          <div class="wyg-title">Your Top Protection Gaps</div>
        </div>
        <div class="wyg-text">Discover the areas that may need attention and why they matter.</div>
      </div>
    </div>
    
    <!-- Card 3 -->
    <div class="wyg-card">
      <div class="wyg-icon-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <div class="wyg-content">
        <div class="wyg-title-row">
          <div class="wyg-badge-num">3</div>
          <div class="wyg-title">Practical Next Steps</div>
        </div>
        <div class="wyg-text">Get clear, expert-guided actions you can consider to strengthen your family's financial security.</div>
      </div>
    </div>
    
    <!-- Notice -->
    <div class="wyg-notice">
      <div class="wyg-notice-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <circle cx="12" cy="11" r="3"/>
          <path d="M8 17a4 4 0 0 1 8 0"/>
        </svg>
      </div>
      <div class="wyg-notice-text">
        You choose whether you want support from an advisor.<br>
        <span class="green-strong">No obligation.</span> <span class="text-green">You're in control.</span>
      </div>
    </div>
    
    <!-- CTA Section -->
    <div class="cta-section">
      <button class="btn-whatsapp" onclick="startAssessment('what_you_get')">
        <div class="btn-whatsapp-content">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
