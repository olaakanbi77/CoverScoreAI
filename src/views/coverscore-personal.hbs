  <!-- 11. Final Conversion Section -->
  <section class="section" id="final-cta">
    <h2>Know Your Family’s Protection Priorities Before Life Tests Them</h2>
    <p>Take your free Family Protection Score™ today and receive a private report on WhatsApp.</p>
    <button class="btn-primary" onclick="startAssessment('final')">Start My Free Family Protection Score™</button>
    <div class="trust-text">
      Free · Private · About 3 minutes · No obligation
    </div>
  </section>

  <!-- 12. Privacy, Consent, and Footer -->
  <footer class="footer">
    <p style="text-align:left; font-size:0.8rem; margin-bottom:1rem;">
      <strong>Privacy Notice:</strong> CoverScore uses your assessment responses to generate your Family Protection Report™ and provide the support you request. You may choose whether or not to speak with a CoverScore Risk Advisor. Do not send passwords, bank details, BVN, NIN, card details, or other highly sensitive information through WhatsApp.
    </p>
    <div class="footer-links">
      <a href="/privacy">Privacy Notice</a>
      <a href="/terms">Terms of Use</a>
      <a href="/contact">Contact Support</a>
    </div>
    <div class="footer-brand">
      CoverScore Personal™<br>
      <span style="font-weight:400;font-size:0.8rem;">Smart Risk. Stronger Decisions.</span>
    </div>
  </footer>

  <!-- 01. Sticky Mobile CTA -->
  <div class="sticky-cta" id="sticky-cta">
    <button class="btn-primary" onclick="startAssessment('sticky_mobile')">Start My Free Score</button>
    <div class="meta">Takes about 3 minutes</div>
  </div>

</div>

<script>
  // 1. Session and Attribution Generation
  const generateSessionKey = () => {
    return 'sess_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
  };

  let sessionKey = localStorage.getItem('cs_session_key');
  if (!sessionKey) {
    sessionKey = generateSessionKey();
    localStorage.setItem('cs_session_key', sessionKey);
  }

  const getQueryParams = () => {
    const params = new URLSearchParams(window.location.search);
    return {
      utm_source: params.get('utm_source'),
      utm_medium: params.get('utm_medium'),
      utm_campaign: params.get('utm_campaign'),
      utm_content: params.get('utm_content'),
      utm_term: params.get('utm_term'),
      campaign_code: params.get('campaign_code') || 'WEB_FAMILY_2026',
      referral_code: params.get('ref')
    };
  };

  const getDeviceType = () => {
    const ua = navigator.userAgent;
    if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) return 'tablet';
    if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry|Kindle|Silk-Accelerated|(hpw|web)OS|Opera M(obi|ini)/.test(ua)) return 'mobile';
    return 'desktop';
  };

  // 2. Tracking Engine
  const trackEvent = (eventName, extraMetadata = {}) => {
    const params = getQueryParams();
    const payload = {
      event_name: eventName,
      landing_page: 'coverscore_personal',
      cta_position: extraMetadata.cta_position || null,
      session_key: sessionKey,
      device_type: getDeviceType(),
      ...params,
      metadata: extraMetadata
    };

    // Fire and forget POST request
    fetch('/api/public/landing-event', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).catch(console.error);
  };

  // 3. CTA Action
  const startAssessment = (position) => {
    trackEvent('family_protection_cta_clicked', { cta_position: position });
    
    // Redirect to the new Exposure Calculator instead of going straight to WhatsApp
    setTimeout(() => {
      window.location.href = '/personal/calculator';
    }, 200);
  };

  // 4. Viewport Observers
  document.addEventListener('DOMContentLoaded', () => {
    trackEvent('landing_page_viewed');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const eventName = entry.target.getAttribute('data-event');
          if (eventName) {
            trackEvent(eventName);
            observer.unobserve(entry.target); // Only track once per page load
          }
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.observer-target').forEach(el => observer.observe(el));
    
    // Sticky CTA logic - hide when final CTA is in view
    const stickyCta = document.getElementById('sticky-cta');
    const finalCta = document.getElementById('final-cta');
    
    const finalObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          stickyCta.style.display = 'none';
        } else {
          stickyCta.style.display = 'flex';
        }
      });
    }, { threshold: 0.1 });
    
    if (finalCta && stickyCta) {
      finalObserver.observe(finalCta);
    }
  });

  // 5. FAQ Toggle
  window.toggleFaq = function(element) {
    const isActive = element.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));
    if (!isActive) {
      element.classList.add('active');
      trackEvent('faq_opened', { question: element.querySelector('.faq-question').innerText });
    }
  };
</script>

</body>
</html>
