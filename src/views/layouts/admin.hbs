<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - CoverScore AI CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin-crm.css">
</head>
<body class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <a href="/">
        <span class="brand-name">COVER<strong>SCORE</strong> <span class="brand-ai">AI</span></span>
        <span class="brand-tagline">Risk Intelligence CRM</span>
      </a>
    </div>

    <nav class="sidebar-nav">
      {{#if (eq user.role 'admin')}}
      <a href="/admin/dashboard" class="nav-item {{#if (eq activePage 'dashboard')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Admin Dashboard
      </a>
      {{/if}}

      <a href="/advisor/dashboard" class="nav-item {{#if (eq activePage 'advisor_dashboard')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>
        Advisor Workspace
      </a>

      <a href="/admin/leads" class="nav-item {{#if (eq activePage 'leads')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Leads
      </a>
      <a href="/admin/clients" class="nav-item {{#if (eq activePage 'clients')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Clients
      </a>
      <a href="/admin/policies" class="nav-item {{#if (eq activePage 'policies')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Policies
      </a>
      <a href="/admin/calendar" class="nav-item {{#if (eq activePage 'calendar')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Calendar
      </a>
      <a href="/admin/claims" class="nav-item {{#if (eq activePage 'claims')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Claims
      </a>
      <a href="/admin/surveys" class="nav-item {{#if (eq activePage 'surveys')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Risk Surveys
      </a>
      <a href="/admin/audit-logs" class="nav-item {{#if (eq activePage 'audit-logs')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Audit Logs
      </a>
      <a href="/admin/templates" class="nav-item {{#if (eq activePage 'templates')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
        Templates
      </a>
      <a href="/advisor/academy" class="nav-item {{#if (eq activePage 'academy')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Academy
      </a>
      {{#if (eq user.role 'admin')}}
      <a href="/admin/academy" class="nav-item {{#if (eq activePage 'academy-admin')}}active{{/if}}" style="padding-left:48px;font-size:11px;opacity:0.7;">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Manage Courses
      </a>
      {{/if}}
      <a href="/admin/settings" class="nav-item {{#if (eq activePage 'settings')}}active{{/if}}">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Settings
      </a>
    </nav>

    <div class="sidebar-overview">
      <div class="overview-header">This Month Overview</div>
      <div class="overview-grid">
        <div class="overview-item">
          <div class="overview-label">New Leads</div>
          <div class="overview-value-row">
            <span class="overview-val" id="sidebarNewLeads">0</span>
            <span class="overview-trend" id="sidebarNewLeadsTrend">→ 0%</span>
          </div>
        </div>
        <div class="overview-item">
          <div class="overview-label">Assessments Completed</div>
          <div class="overview-value-row">
            <span class="overview-val" id="sidebarAssessments">0</span>
            <span class="overview-trend" id="sidebarAssessmentsTrend">→ 0%</span>
          </div>
        </div>
        <div class="overview-item">
          <div class="overview-label">Consultations Booked</div>
          <div class="overview-value-row">
            <span class="overview-val" id="sidebarConsultations">0</span>
            <span class="overview-trend" id="sidebarConsultationsTrend">→ 0%</span>
          </div>
        </div>
        <div class="overview-item">
          <div class="overview-label">Policies Sold</div>
          <div class="overview-value-row">
            <span class="overview-val" id="sidebarPolicies">0</span>
            <span class="overview-trend" id="sidebarPoliciesTrend">→ 0%</span>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="admin-main">
    <!-- Topbar -->
    <header class="admin-topbar">
      <div class="topbar-left">
        <button class="mobile-menu-btn" onclick="toggleSidebar()">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="search-box">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="Search leads, clients, companies..." id="globalSearch">
        </div>
      </div>
      
      <div class="topbar-right">
        <a href="https://wa.me/" class="topbar-icon-btn whatsapp">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
        <a href="/advisor/notifications" class="topbar-icon-btn" id="notificationBell" onclick="event.preventDefault(); toggleNotifications()" style="text-decoration:none;position:relative;">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span class="badge-dot" id="notificationBadge"></span>
        </a>
        <div class="user-profile">
          <img src="https://ui-avatars.com/api/?name={{user.name}}&background=1E293B&color=fff" alt="User" class="avatar">
          <div class="user-info">
            <span class="user-name">{{user.name}}</span>
            <span class="user-role">Administrator</span>
          </div>
        </div>
      </div>
    </header>

    <div class="admin-content-wrapper">
      {{{body}}}
    </div>
  </main>
  
  <!-- Notification Dropdown -->
  <div class="notification-dropdown" id="notificationDropdown">
    <div class="notification-header">
      <span>Notifications</span>
      <a href="/advisor/notifications" class="view-all">View all</a>
    </div>
    <div class="notification-list" id="notificationList">
      <div class="notification-empty">No new notifications</div>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>

  <script src="/js/main.js"></script>

  <script>
    window.currentUser = {{{json user}}};

    function toggleSidebar() {
      document.querySelector('.admin-sidebar').classList.toggle('show');
    }

    // ===== WebSocket Notifications =====
    (function() {
      const userId = window.currentUser?.id;
      if (!userId) return;

      let ws = null;
      let reconnectTimer = null;
      let unreadCount = 0;

      function connectWS() {
        const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const url = `${proto}//${window.location.host}/ws?userId=${userId}&role=${window.currentUser.role || 'sales'}`;
        
        try {
          ws = new WebSocket(url);
        } catch(e) {
          scheduleReconnect();
          return;
        }

        ws.onopen = () => {
          if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
          fetchUnreadCount();
        };

        ws.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);
            if (data.type === 'notification') {
              showToast(data.notification);
              incrementBadge();
              addNotificationToList(data.notification);
            }
          } catch(e) {
            console.error('WS message error:', e);
          }
        };

        ws.onclose = () => scheduleReconnect();
        ws.onerror = () => ws?.close();
      }

      function scheduleReconnect() {
        if (reconnectTimer) return;
        reconnectTimer = setTimeout(() => {
          reconnectTimer = null;
          connectWS();
        }, 5000);
      }

      async function fetchUnreadCount() {
        try {
          const res = await fetch('/api/notifications/unread-count');
          if (res.ok) {
            const data = await res.json();
            unreadCount = data.count || 0;
            updateBadge(unreadCount);
          }
        } catch(e) {
          console.error('Failed to fetch unread count');
        }
      }

      function updateBadge(count) {
        const badge = document.getElementById('notificationBadge');
        if (!badge) return;
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : count;
          badge.style.display = 'inline-flex';
        } else {
          badge.style.display = 'none';
        }
      }

      function incrementBadge() {
        unreadCount++;
        updateBadge(unreadCount);
      }

      function showToast(n1, n2, n3) {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        var title = '', message = '', type = 'info', link = '';
        if (typeof n1 === 'object' && n1 !== null) {
          title = n1.title || '';
          message = n1.message || '';
          type = n1.type || 'info';
          link = n1.link || '';
        } else if (typeof n3 === 'string') {
          title = n1 || '';
          message = n2 || '';
          type = n3;
        } else if (typeof n2 === 'string' && (n2 === 'success' || n2 === 'error' || n2 === 'info')) {
          message = n1 || '';
          type = n2;
        } else if (typeof n2 === 'string') {
          title = n1 || '';
          message = n2;
        } else if (typeof n1 === 'string') {
          message = n1;
        }

        const toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.innerHTML = `
          <div class="toast-icon">${type === 'lead_assigned' ? '👤' : type === 'new_opportunity' ? '💎' : type === 'follow_up_scheduled' ? '📅' : type === 'stage_update' ? '🔄' : type === 'high_priority_opportunity' ? '🚀' : type === 'error' ? '⚠️' : type === 'success' ? '✅' : '🔔'}</div>
          <div class="toast-body">
            ${title ? '<div class="toast-title">' + esc(title) + '</div>' : ''}
            <div class="toast-message">${esc(message)}</div>
          </div>
          <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
        `;
        toast.style.cursor = link ? 'pointer' : 'default';
        toast.onclick = (e) => {
          if (e.target.closest('.toast-close')) return;
          if (link) window.location.href = link;
        };
        container.appendChild(toast);

        setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateX(100%)';
          setTimeout(function() { toast.remove(); }, 300);
        }, 5000);
      }

      function addNotificationToList(notification) {
        const list = document.getElementById('notificationList');
        if (!list) return;
        const empty = list.querySelector('.notification-empty');
        if (empty) empty.remove();

        const item = document.createElement('a');
        item.href = notification.link || '#';
        item.className = 'notification-item';
        item.innerHTML = `
          <div class="notification-item-icon">${notification.type === 'lead_assigned' ? '👤' : notification.type === 'new_opportunity' ? '💎' : notification.type === 'follow_up_scheduled' ? '📅' : notification.type === 'stage_update' ? '🔄' : notification.type === 'high_priority_opportunity' ? '🚀' : '🔔'}</div>
          <div class="notification-item-body">
            <div class="notification-item-title">${esc(notification.title)}</div>
            <div class="notification-item-message">${esc(notification.message)}</div>
            <div class="notification-item-time">Just now</div>
          </div>
        `;
        list.prepend(item);

        while (list.children.length > 20) {
          list.lastChild.remove();
        }
      }

      function esc(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      window.toggleNotifications = function() {
        const dd = document.getElementById('notificationDropdown');
        if (dd) dd.classList.toggle('show');
      };

      document.addEventListener('click', (e) => {
        const dd = document.getElementById('notificationDropdown');
        const bell = document.getElementById('notificationBell');
        if (dd && dd.classList.contains('show') && !dd.contains(e.target) && !bell?.contains(e.target)) {
          dd.classList.remove('show');
        }
      });

      connectWS();
    })();

    async function loadSidebarOverview() {
      try {
        const res = await fetch('/api/analytics/overview');
        if (res.ok) {
          const data = await res.json();
          const sb = data.sidebar || {};
          
          document.getElementById('sidebarNewLeads').innerText = (sb.newLeads || 0).toLocaleString();
          document.getElementById('sidebarAssessments').innerText = (sb.assessments || 0).toLocaleString();
          document.getElementById('sidebarConsultations').innerText = (sb.consultations || 0).toLocaleString();
          document.getElementById('sidebarPolicies').innerText = (sb.policies || 0).toLocaleString();
          
          const badge = document.getElementById('sidebarWhatsAppBadge');
          if (badge) {
            badge.innerText = sb.activeWhatsAppChats || 0;
            if (sb.activeWhatsAppChats > 0) {
              badge.style.display = 'inline-block';
            } else {
              badge.style.display = 'none';
            }
          }

          const formatTrend = (el, val) => {
            if (!el) return;
            if (val > 0) {
              el.innerText = `↑ ${val}%`;
              el.className = 'overview-trend positive';
            } else if (val < 0) {
              el.innerText = `↓ ${Math.abs(val)}%`;
              el.className = 'overview-trend negative';
            } else {
              el.innerText = `→ 0%`;
              el.className = 'overview-trend';
            }
          };

          formatTrend(document.getElementById('sidebarNewLeadsTrend'), sb.newLeadsTrend || 0);
          formatTrend(document.getElementById('sidebarAssessmentsTrend'), sb.assessmentsTrend || 0);
          formatTrend(document.getElementById('sidebarConsultationsTrend'), sb.consultationsTrend || 0);
          formatTrend(document.getElementById('sidebarPoliciesTrend'), sb.policiesTrend || 0);
        }
      } catch (err) {
        console.error('Failed to load sidebar overview:', err);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadSidebarOverview();
    });
  </script>
</body>
</html>
