<div class="container py-12">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-3xl font-bold mb-2">My Dashboard</h1>
      <p class="text-muted">Welcome back, <span class="text-white font-medium">{{user.name}}</span>.</p>
      {{#if passport}}
      <p class="text-sm text-muted" style="margin-top: 4px;">
        Passport: <span class="font-mono" style="color: var(--color-primary);">{{passport.passport_id}}</span>
      </p>
      {{/if}}
    </div>
    <div class="flex gap-3">
      <a href="/portal/passport" class="btn btn-outline">View Passport</a>
      <a href="/assessment/start" class="btn btn-primary">New Assessment</a>
    </div>
  </div>

  {{#unless passport}}
  <div style="background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(139,92,246,0.08)); border: 1px solid rgba(59,130,246,0.2); border-radius: var(--radius-xl); padding: 40px 32px; text-align: center; margin-bottom: 40px;">
    <h2 style="margin: 0 0 8px; font-size: 22px;">Welcome to CoverScore!</h2>
    <p style="color: var(--text-secondary); margin: 0 0 20px; max-width: 480px; margin-left: auto; margin-right: auto;">
      Complete your first risk assessment to unlock your CoverScore Passport — your unified identity across all CoverScore services.
    </p>
    <a href="/assessment/start" class="btn btn-primary btn-lg">Start Your Assessment</a>
  </div>
  {{/unless}}

  {{#if passport}}
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      {{#if scoreTrend.length}}
      <div id="scoreTrendChart" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 24px;">
        <h3 class="text-lg font-semibold mb-4">Score Trend</h3>
        <div style="display: flex; align-items: flex-end; gap: 8px; height: 120px; padding: 0 4px;">
          {{#each scoreTrend}}
          <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
            <div style="width: 100%; height: {{score}}px; border-radius: 4px 4px 0 0;
              {{#if (gte score 70)}}background: var(--color-success);
              {{else if (gte score 40)}}background: var(--color-warning);
              {{else}}background: var(--color-danger);{{/if}}
              min-height: 4px; transition: height 0.3s;"></div>
            <span class="text-xs text-muted">{{formatDateShort date}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="glass-card">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
          <h3 class="text-lg font-semibold">Assessment History</h3>
          {{#if assessments.length}}<span class="text-sm text-muted">{{assessments.length}} total</span>{{/if}}
        </div>
        <div class="p-0">
          {{#if assessments.length}}
          {{#each assessments}}
          <a href="/assessment/result/{{id}}" style="display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); text-decoration: none; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
            <div style="width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
              {{#if (gte score 70)}}background: rgba(16,185,129,0.12); color: var(--color-success);
              {{else if (gte score 40)}}background: rgba(245,158,11,0.12); color: var(--color-warning);
              {{else}}background: rgba(239,68,68,0.12); color: var(--color-danger);{{/if}}">
              <span style="font-weight: 700; font-size: 14px;">{{score}}</span>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-weight: 500; color: var(--text-primary);">{{business_name}}</div>
              <div style="font-size: 12px; color: var(--text-muted);">{{risk_level}} Risk · {{formatDate created_at}}</div>
            </div>
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted); flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          {{/each}}
          {{else}}
          <div class="empty-state">
            <p class="text-muted">No assessments yet. Take your first assessment to get started.</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <div>
      {{#if policies.length}}
      <div class="glass-card mb-6">
        <div class="p-6 border-b border-white/10">
          <h3 class="text-lg font-semibold">My Policies</h3>
        </div>
        <div class="p-6">
          {{#each policies}}
          <div class="policy-card">
            <div class="policy-icon">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #60a5fa;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-weight: 500; color: var(--text-primary); font-size: 14px;">{{business_name}}</div>
              <div style="font-size: 12px; color: var(--text-muted);">{{product}} · {{formatNumber premium}} NGN</div>
            </div>
            <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 4px;
              {{#if (eq status 'Active')}}background: rgba(16,185,129,0.15); color: #34d399;
              {{else}}background: rgba(245,158,11,0.15); color: #fbbf24;{{/if}}">{{status}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if quotes.length}}
      <div class="glass-card mb-6">
        <div class="p-6 border-b border-white/10">
          <h3 class="text-lg font-semibold">Recent Quotes</h3>
        </div>
        <div class="p-6">
          {{#each quotes}}
          <div class="policy-card">
            <div class="policy-icon" style="background: rgba(139,92,246,0.12);">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #a78bfa;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-weight: 500; color: var(--text-primary); font-size: 14px;">{{product_name}}</div>
              <div style="font-size: 12px; color: var(--text-muted);">{{premium}}</div>
            </div>
            <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 4px; background: rgba(59,130,246,0.15); color: #60a5fa; text-transform: capitalize;">{{status}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </div>
  </div>
  {{/if}}
</div>
