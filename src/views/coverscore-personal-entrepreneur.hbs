  <script>
    let rrsInterval;
    let rrsIsPaused = false;
    let rrsCurrentSlide = 0;
    const rrsTotalSlides = 3;
    const rrsScrollDelay = 6000; // 6 seconds

    function initRrsCarousel() {
      startRrsInterval();
      
      // Pause on touch/interaction
      const track = document.getElementById('rrs-track');
      if(track) {
        track.addEventListener('touchstart', pauseRrsFromInteraction);
        track.addEventListener('mousedown', pauseRrsFromInteraction);
      }
    }

    function startRrsInterval() {
      clearInterval(rrsInterval);
      if(!rrsIsPaused) {
        rrsInterval = setInterval(() => {
          scrollRrs(1);
        }, rrsScrollDelay);
      }
    }

    function toggleRrsPause() {
      rrsIsPaused = !rrsIsPaused;
      const btn = document.getElementById('rrs-pause-btn');
      if(rrsIsPaused) {
        // Play icon
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>';
        clearInterval(rrsInterval);
      } else {
        // Pause icon
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>';
        startRrsInterval();
      }
    }

    function pauseRrsFromInteraction() {
      if(!rrsIsPaused) {
        toggleRrsPause();
      }
    }

    function scrollRrs(direction) {
      const track = document.getElementById('rrs-track');
      if(!track) return;
      const width = track.clientWidth;
      let nextSlide = rrsCurrentSlide + direction;
      
      if(nextSlide >= rrsTotalSlides) {
        nextSlide = 0; // loop back to first
      } else if (nextSlide < 0) {
        nextSlide = rrsTotalSlides - 1; // loop back to last
      }
      
      track.scrollTo({
        left: nextSlide * width,
        behavior: 'smooth'
      });
      // Updating UI is handled by the scroll event listener
      
      // restart timer if not explicitly paused
      if(!rrsIsPaused) {
        startRrsInterval();
      }
    }

    function handleRrsScroll() {
      const track = document.getElementById('rrs-track');
      if(!track) return;
      
      // Calculate current slide based on scroll position
      const scrollLeft = track.scrollLeft;
      const width = track.clientWidth;
      const slideIndex = Math.round(scrollLeft / width);
      
      if(slideIndex !== rrsCurrentSlide) {
        rrsCurrentSlide = slideIndex;
        updateRrsUi();
      }
    }

    function updateRrsUi() {
      // Update progress bars
      for(let i=1; i<=rrsTotalSlides; i++) {
        const fill = document.getElementById('rrs-prog-' + i);
        if(fill) {
          if(i <= rrsCurrentSlide + 1) {
            fill.classList.add('active');
          } else {
            fill.classList.remove('active');
          }
        }
      }
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', initRrsCarousel);
  </script>

