<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - CoverScore AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .coming-soon-container {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 32px 16px;
    }
    .coming-soon-icon {
      width: 80px;
      height: 80px;
      background: rgba(59, 130, 246, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      color: var(--color-primary);
    }
    .coming-soon-icon svg {
      width: 40px;
      height: 40px;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-content">
      <a href="/" class="navbar-brand">Cover<span>Score</span> AI</a>
      <div class="navbar-menu">
        <a href="/" class="navbar-item">Home</a>
        <a href="/auth/login" class="navbar-item">Sign In</a>
      </div>
    </div>
  </nav>

  <div class="coming-soon-container">
    <div>
      <div class="coming-soon-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h1 style="font-size: 28px; margin-bottom: 12px;">{{title}}</h1>
      <p style="color: var(--text-secondary); margin-bottom: 32px; max-width: 400px;">
        This feature is coming soon. In the meantime, you can start a risk assessment to get personalized recommendations.
      </p>
      <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
        <a href="/assessment/start" class="btn btn-primary">Start Risk Assessment</a>
        <a href="/dashboard" class="btn btn-secondary">Go to Dashboard</a>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
