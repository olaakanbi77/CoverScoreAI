<style>
  .page-container { padding: 32px; max-width: 1200px; margin: 0 auto; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary); margin: 0; }
  
  .filters { display: flex; gap: 12px; margin-bottom: 24px; }
  .filter-select { background: rgba(0,0,0,0.2); border: 1px solid var(--glass-border); color: white; padding: 8px 16px; border-radius: var(--radius-md); font-size: 14px; outline: none; }
  
  .data-table { width: 100%; border-collapse: collapse; background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); overflow: hidden; }
  .data-table th, .data-table td { padding: 16px 24px; text-align: left; border-bottom: 1px solid var(--glass-border); }
  .data-table th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600; background: rgba(0,0,0,0.2); }
  .data-table td { font-size: 14px; color: var(--text-primary); }
  .data-table tr:last-child td { border-bottom: none; }
  
  .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
  .badge-active { background: rgba(16, 185, 129, 0.15); color: #34d399; }
  .badge-expiring { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  
  .btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }
  .empty-state { text-align: center; padding: 64px 24px; }
</style>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">Active Policies</h1>
    <button class="btn btn-primary" onclick="openModal('policyModal')">+ Record Policy</button>
  </div>

  <div class="filters">
    <select class="filter-select">
      <option value="all">All Policies</option>
      <option value="active">Active</option>
      <option value="expiring">Expiring Soon</option>
    </select>
    <select class="filter-select">
      <option value="all">All Products</option>
      <option value="motor">Motor Comprehensive</option>
      <option value="fire">Fire & Special Perils</option>
      <option value="health">Health Insurance</option>
    </select>
  </div>

  <table class="data-table">
    <thead>
      <tr>
        <th>Policy No.</th>
        <th>Client Name</th>
        <th>Product</th>
        <th>Premium</th>
        <th>Status</th>
        <th>Expiry Date</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      {{#each policies}}
      <tr>
        <td style="font-family: monospace; color: #60a5fa;">{{policy_number}}</td>
        <td style="font-weight: 500; color: white;">{{client_name}}</td>
        <td>{{product}}</td>
        <td>₦{{formatNumber premium}}</td>
        <td><span class="badge badge-{{toLowerCase status}}">{{status}}</span></td>
        <td>{{formatDate expiry_date}}</td>
        <td><button class="btn btn-outline btn-sm">View Details</button></td>
      </tr>
      {{else}}
      <tr>
        <td colspan="7">
          <div class="empty-state">
            <h3 style="margin-bottom: 8px; color: white;">No Active Policies</h3>
            <p style="color: var(--text-secondary);">Policies bound to clients will appear here.</p>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<!-- Policy Modal -->
<div class="modal-overlay" id="policyModal">
  <div class="modal-container">
    <div class="modal-header">
      <h2 class="modal-title">Record New Policy</h2>
      <button class="modal-close" onclick="closeModal('policyModal')">&times;</button>
    </div>
    <form id="policyForm" onsubmit="submitPolicy(event)" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
      <div class="form-group">
        <label>Client</label>
        <select name="lead_id" class="form-control" required>
          <option value="">Select a client...</option>
          {{#each leads}}
          <option value="{{this.id}}">{{this.name}} {{#if this.business_name}}({{this.business_name}}){{/if}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>Policy Number</label>
        <input type="text" name="policy_number" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Product</label>
        <select name="product" class="form-control" required>
          <option value="Motor Comprehensive">Motor Comprehensive</option>
          <option value="Fire & Special Perils">Fire & Special Perils</option>
          <option value="Health Insurance">Health Insurance</option>
          <option value="All Risks Insurance">All Risks Insurance</option>
        </select>
      </div>
      <div class="form-group">
        <label>Premium (₦)</label>
        <input type="number" name="premium" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Expiry Date</label>
        <input type="date" name="expiry_date" class="form-control" required>
      </div>
      <div class="modal-footer" style="margin-top: 8px; padding: 0;">
        <button type="button" class="btn-secondary" onclick="closeModal('policyModal')">Cancel</button>
        <button type="submit" class="btn-primary">Save Policy</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
  }
  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }
  
  async function submitPolicy(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      const headers = { 'Content-Type': 'application/json' };
      const token = localStorage.getItem('accessToken');
      if (token) headers['Authorization'] = 'Bearer ' + token;

      const res = await fetch('/api/crm/policies', {
        method: 'POST',
        headers,
        body: JSON.stringify(data)
      });
      
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || 'Failed to record policy');
        btn.disabled = false;
        btn.textContent = 'Save Policy';
      }
    } catch (error) {
      alert('Error connecting to server');
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = false;
      btn.textContent = 'Save Policy';
    }
  }
</script>
