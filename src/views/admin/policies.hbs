<style>
  .page-container { padding: 32px; max-width: 1200px; margin: 0 auto; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary); margin: 0; }
  
  .filters { display: flex; gap: 12px; margin-bottom: 24px; }
  .filter-select { background: rgba(0,0,0,0.2); border: 1px solid var(--glass-border); color: white; padding: 8px 16px; border-radius: var(--radius-md); font-size: 14px; outline: none; }
  
  .data-table { width: 100%; border-collapse: collapse; background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); overflow: hidden; }
  .data-table th, .data-table td { padding: 16px 24px; text-align: left; border-bottom: 1px solid var(--glass-border); }
  .data-table th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600; background: rgba(0,0,0,0.2); }
  .data-table td { font-size: 14px; color: var(--text-primary); }
  .data-table tr:last-child td { border-bottom: none; }
  
  .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
  .badge-active { background: rgba(16, 185, 129, 0.15); color: #34d399; }
  .badge-expiring { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  
  .btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }
  .empty-state { text-align: center; padding: 64px 24px; }
</style>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">Active Policies</h1>
    <button class="btn btn-primary" onclick="openModal('policyModal')">+ Create New Policy</button>
  </div>

  <div class="filters">
    <select class="filter-select">
      <option value="all">All Policies</option>
      <option value="active">Active</option>
      <option value="expiring">Expiring Soon</option>
    </select>
    <select class="filter-select">
      <option value="all">All Products</option>
      <option value="Motor Comprehensive">Motor Comprehensive</option>
      <option value="Fire & Special Perils">Fire & Special Perils</option>
      <option value="Health Insurance">Health Insurance</option>
      <option value="All Risks Insurance">All Risks Insurance</option>
      <option value="Property All Risk">Property All Risk</option>
      <option value="General Liability">General Liability</option>
      <option value="Product Liability">Product Liability</option>
      <option value="Workers Compensation">Workers Compensation</option>
      <option value="Business Interruption">Business Interruption</option>
      <option value="Cyber Insurance">Cyber Insurance</option>
      <option value="Goods in Transit">Goods in Transit</option>
      <option value="Marine Cargo">Marine Cargo</option>
      <option value="Motor Fleet">Motor Fleet</option>
      <option value="Public Liability">Public Liability</option>
      <option value="Employers Liability">Employers Liability</option>
      <option value="Shop Comprehensive">Shop Comprehensive</option>
      <option value="Fidelity Guarantee">Fidelity Guarantee</option>
      <option value="Cash in Transit">Cash in Transit</option>
      <option value="Professional Indemnity">Professional Indemnity</option>
      <option value="Directors & Officers">Directors & Officers</option>
      <option value="Equipment All Risk">Equipment All Risk</option>
      <option value="Medical Malpractice">Medical Malpractice</option>
    </select>
  </div>

  <div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Policy No.</th>
        <th>Client Name</th>
        <th>Product</th>
        <th>Premium</th>
        <th>Status</th>
        <th>Expiry Date</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      {{#each policies}}
      <tr>
        <td style="font-family: monospace; color: #60a5fa;">{{policy_number}}</td>
        <td style="font-weight: 500;">{{client_name}}</td>
        <td>{{product}}</td>
        <td>₦{{formatNumber premium}}</td>
        <td><span class="badge badge-{{toLowerCase status}}">{{status}}</span></td>
        <td>{{formatDate expiry_date}}</td>
        <td><button class="btn btn-outline btn-sm">View Details</button></td>
      </tr>
      {{else}}
      <tr>
        <td colspan="7">
          <div class="empty-state">
            <h3 style="margin-bottom: 8px; color: var(--text-primary);">No Active Policies</h3>
            <p style="color: var(--text-secondary);">Policies bound to clients will appear here.</p>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</div>

<!-- Policy Modal -->
<div class="modal-overlay" id="policyModal">
  <div class="modal-container">
    <div class="modal-header">
      <h2 class="modal-title">Record New Policy</h2>
      <button class="modal-close" onclick="closeModal('policyModal')">&times;</button>
    </div>
    <form id="policyForm" onsubmit="submitPolicy(event)" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
      <div class="form-group">
        <label>Client</label>
        <select name="lead_id" id="policyLeadSelect" class="form-control" onchange="toggleManualClient(this.value)">
          <option value="">-- Create New Client --</option>
          {{#each leads}}
          <option value="{{this.id}}">{{this.name}} {{#if this.business_name}}({{this.business_name}}){{/if}}</option>
          {{/each}}
        </select>
      </div>
      <div id="manualClientFields" style="background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--border);">
        <h4 style="margin-top: 0; margin-bottom: 12px; font-size: 14px; color: var(--text-primary);">New Client Details</h4>
        <div class="form-group">
          <label>Client Name</label>
          <input type="text" name="client_name" id="manualClientName" class="form-control" placeholder="Enter full name or business name">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="form-group">
            <label>Email (Optional)</label>
            <input type="email" name="client_email" class="form-control" placeholder="email@example.com">
          </div>
          <div class="form-group">
            <label>Phone (Optional)</label>
            <input type="text" name="client_phone" class="form-control" placeholder="+234...">
          </div>
        </div>
      </div>
      <div class="form-group">
        <label>Policy Number</label>
        <input type="text" name="policy_number" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Product</label>
        <select name="product" class="form-control" required>
          <option value="Motor Comprehensive">Motor Comprehensive</option>
          <option value="Fire & Special Perils">Fire & Special Perils</option>
          <option value="Health Insurance">Health Insurance</option>
          <option value="All Risks Insurance">All Risks Insurance</option>
          <option value="Property All Risk">Property All Risk</option>
          <option value="General Liability">General Liability</option>
          <option value="Product Liability">Product Liability</option>
          <option value="Workers Compensation">Workers Compensation</option>
          <option value="Business Interruption">Business Interruption</option>
          <option value="Cyber Insurance">Cyber Insurance</option>
          <option value="Goods in Transit">Goods in Transit</option>
          <option value="Marine Cargo">Marine Cargo</option>
          <option value="Motor Fleet">Motor Fleet</option>
          <option value="Public Liability">Public Liability</option>
          <option value="Employers Liability">Employers Liability</option>
          <option value="Shop Comprehensive">Shop Comprehensive</option>
          <option value="Fidelity Guarantee">Fidelity Guarantee</option>
          <option value="Cash in Transit">Cash in Transit</option>
          <option value="Professional Indemnity">Professional Indemnity</option>
          <option value="Directors & Officers">Directors & Officers</option>
          <option value="Equipment All Risk">Equipment All Risk</option>
          <option value="Medical Malpractice">Medical Malpractice</option>
        </select>
      </div>
      <div class="form-group">
        <label>Premium (₦)</label>
        <input type="number" name="premium" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Expiry Date</label>
        <input type="date" name="expiry_date" class="form-control" required>
      </div>
      <div class="modal-footer" style="margin-top: 8px; padding: 0;">
        <button type="button" class="btn-secondary" onclick="closeModal('policyModal')">Cancel</button>
        <button type="submit" class="btn-primary">Save Policy</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
    if (id === 'policyModal') {
      toggleManualClient(document.getElementById('policyLeadSelect').value);
    }
  }
  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }
  
  function toggleManualClient(val) {
    const manualFields = document.getElementById('manualClientFields');
    const clientName = document.getElementById('manualClientName');
    if (val) {
      manualFields.style.display = 'none';
      clientName.required = false;
    } else {
      manualFields.style.display = 'block';
      clientName.required = true;
    }
  }
  
  async function submitPolicy(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const btn = form.querySelector('button[type="submit"]');
    
    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';
      
      let token = localStorage.getItem('accessToken');
      let headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = 'Bearer ' + token;

      let res = await fetch('/api/crm/policies', {
        method: 'POST',
        headers,
        body: JSON.stringify(data)
      });
      
      // Auto-refresh token if expired
      if (res.status === 401) {
        const refreshRes = await fetch('/api/auth/refresh', { 
          method: 'POST',
          credentials: 'same-origin'
        });
        
        if (refreshRes.ok) {
          const refreshData = await refreshRes.json();
          token = refreshData.accessToken;
          localStorage.setItem('accessToken', token);
          headers['Authorization'] = 'Bearer ' + token;
          
          // Retry the request
          res = await fetch('/api/crm/policies', {
            method: 'POST',
            headers,
            body: JSON.stringify(data)
          });
        } else {
          window.location.href = '/auth/login';
          return;
        }
      }
      
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || err.message || 'Failed to record policy');
        btn.disabled = false;
        btn.textContent = 'Save Policy';
      }
    } catch (error) {
      console.error(error);
      alert('Error connecting to server');
      btn.disabled = false;
      btn.textContent = 'Save Policy';
    }
  }
</script>
