<style>
  :root {
    --c-green: #10b981;
    --c-green-light: #ecfdf5;
    --c-gray: #64748b;
    --text-sec: #64748b;
    --c-gray-light: #f1f5f9;
    --c-dark: #0f172a;
    --bg-page: #ffffff;
  }

  /* Override Admin Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  
  body {
    background-color: var(--bg-page);
    font-family: 'Inter', sans-serif;
  }

  .mobile-app-container {
    max-width: 480px;
    margin: 0 auto;
    background: #ffffff;
    min-height: 100vh;
    box-shadow: 0 0 20px rgba(0,0,0,0.05);
    position: relative;
    padding-bottom: 90px;
  }

  .more-page {
    padding: 24px 16px;
    color: var(--c-dark);
  }

  .header-row {
    margin-bottom: 24px;
  }
  .header-row h1 {
    font-size: 26px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0 0 4px 0;
  }

  .menu-group {
    margin-bottom: 24px;
  }
  .menu-group-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-gray);
    margin-bottom: 12px;
    padding-left: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .menu-list {
    background: white;
    border: 1px solid var(--c-gray-light);
    border-radius: 12px;
    overflow: hidden;
  }
  .menu-item {
    display: flex;
    align-items: center;
    padding: 16px;
    text-decoration: none;
    color: var(--c-dark);
    border-bottom: 1px solid var(--c-gray-light);
    transition: background-color 0.2s;
  }
  .menu-item:last-child {
    border-bottom: none;
  }
  .menu-item:hover {
    background-color: #f8fafc;
  }
  
  .menu-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--c-green-light);
    color: var(--c-green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
  }
  .menu-icon svg {
    width: 20px;
    height: 20px;
  }

  .menu-text {
    flex-grow: 1;
    font-size: 15px;
    font-weight: 600;
  }

  .chevron {
    color: #cbd5e1;
    width: 20px;
    height: 20px;
  }

  /* Bottom Nav */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 0 24px 0;
    border-top: 1px solid #e2e8f0;
    z-index: 100;
  }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active {
    color: var(--c-green);
  }
  .nav-item svg {
    width: 24px;
    height: 24px;
    stroke-width: 2;
  }
</style>

