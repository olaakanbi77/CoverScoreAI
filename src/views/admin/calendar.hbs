<style>
  .page-container { padding: 32px; max-width: 1200px; margin: 0 auto; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary); margin: 0; }
  
  .calendar-wrapper { background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); padding: 24px; }
  
  /* FullCalendar Customization overrides */
  .fc { font-family: inherit; color: var(--text-primary); }
  .fc-theme-standard th { border-color: var(--glass-border); padding: 12px 0; background: rgba(0,0,0,0.2); text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em; color: var(--text-secondary); }
  .fc-theme-standard td, .fc-theme-standard .fc-scrollgrid { border-color: var(--glass-border); }
  .fc-day-today { background: rgba(59, 130, 246, 0.05) !important; }
  .fc-daygrid-day-number { color: var(--text-secondary); font-weight: 500; font-size: 14px; padding: 8px !important; }
  .fc .fc-button-primary { background: transparent; border: 1px solid var(--glass-border); color: white; border-radius: var(--radius-md); text-transform: capitalize; }
  .fc .fc-button-primary:hover { background: rgba(255,255,255,0.05); }
  .fc .fc-button-primary:not(:disabled):active, .fc .fc-button-primary:not(:disabled).fc-button-active { background: var(--color-primary); border-color: var(--color-primary); }
  .fc .fc-toolbar-title { font-size: 18px; font-weight: 600; color: white; }
  
  .event-consult { background: rgba(16, 185, 129, 0.15) !important; border-left: 3px solid #10b981 !important; color: #34d399 !important; border:none; padding: 4px; font-size: 11px; margin-bottom: 4px; }
  .event-call { background: rgba(59, 130, 246, 0.15) !important; border-left: 3px solid #3b82f6 !important; color: #60a5fa !important; border:none; padding: 4px; font-size: 11px; margin-bottom: 4px; }
</style>

<!-- FullCalendar JS & CSS -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">Calendar</h1>
    <button class="btn btn-primary" onclick="openModal('eventModal')">+ Add Event</button>
  </div>

  <div class="calendar-wrapper">
    <div id="calendar"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,timeGridDay'
      },
      events: '/api/admin/tasks', // Fetch events dynamically from backend
      eventTimeFormat: {
        hour: 'numeric',
        minute: '2-digit',
        meridiem: 'short'
      },
      height: 700,
      eventClick: function(info) {
        // Here we could open a modal to view task details
        console.log('Event clicked:', info.event);
      }
    });
    calendar.render();
  });
  
  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
  }
  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }
  
  async function submitEvent(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Add seconds to match datetime format if needed, or backend can handle it
    
    try {
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      
      const res = await fetch('/api/crm/tasks', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + localStorage.getItem('accessToken')
        },
        body: JSON.stringify(data)
      });
      
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || 'Failed to add event');
        btn.disabled = false;
        btn.textContent = 'Save Event';
      }
    } catch (error) {
      alert('Error connecting to server');
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = false;
      btn.textContent = 'Save Event';
    }
  }
</script>

<!-- Event Modal -->
<div class="modal-overlay" id="eventModal">
  <div class="modal-container">
    <div class="modal-header">
      <h2 class="modal-title">Add New Event</h2>
      <button class="modal-close" onclick="closeModal('eventModal')">&times;</button>
    </div>
    <form id="eventForm" onsubmit="submitEvent(event)" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Client (Lead)</label>
        <select name="lead_id" class="form-control" required>
          <option value="">Select a client...</option>
          {{#each leads}}
          <option value="{{this.id}}">{{this.name}} {{#if this.business_name}}({{this.business_name}}){{/if}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>Type</label>
        <select name="type" class="form-control" required>
          <option value="call">Call</option>
          <option value="consultation">Consultation</option>
          <option value="meeting">Meeting</option>
        </select>
      </div>
      <div class="form-group">
        <label>Date & Time</label>
        <input type="datetime-local" name="due_date" class="form-control" required>
      </div>
      <div class="modal-footer" style="margin-top: 8px; padding: 0;">
        <button type="button" class="btn-secondary" onclick="closeModal('eventModal')">Cancel</button>
        <button type="submit" class="btn-primary">Save Event</button>
      </div>
    </form>
  </div>
</div>
