<style>
  .page-container { padding: 32px; max-width: 1200px; margin: 0 auto; }
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary); margin: 0; }
  
  .kanban-board { display: flex; gap: 24px; overflow-x: auto; padding-bottom: 24px; }
  .kanban-column { flex: 1; min-width: 300px; background: rgba(0,0,0,0.1); border-radius: var(--radius-lg); padding: 16px; border: 1px solid var(--glass-border); }
  .kanban-header { font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 16px; display: flex; justify-content: space-between; }
  
  .consult-card { background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: var(--radius-md); padding: 16px; margin-bottom: 12px; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer; }
  .consult-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: rgba(255,255,255,0.1); }
  
  .card-title { font-size: 15px; font-weight: 600; color: white; margin: 0 0 4px 0; }
  .card-subtitle { font-size: 12px; color: var(--text-secondary); margin: 0 0 12px 0; }
  
  .card-meta { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--glass-border); }
  .meta-icon { width: 14px; height: 14px; opacity: 0.7; }
</style>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">Consultations</h1>
  </div>

  <div class="kanban-board">
    <!-- Requested -->
    <div class="kanban-column">
      <div class="kanban-header">
        <span>Requested</span>
        <span class="badge" style="background: rgba(255,255,255,0.1);">{{consultations.length}}</span>
      </div>
      
      {{#each consultations}}
      <div class="consult-card" onclick="window.location.href='/admin/leads/{{id}}'">
        <div style="display: flex; justify-content: space-between;">
          <h3 class="card-title">{{name}}</h3>
          <span class="badge" style="background: rgba(59,130,246,0.15); color: #60a5fa;">New</span>
        </div>
        <p class="card-subtitle">{{business_name}}</p>
        
        <div style="font-size: 13px; color: #e2e8f0; margin-bottom: 8px;">
          <strong>Prefers:</strong> <span style="text-transform: capitalize;">{{consultation_preference}}</span>
        </div>
        
        <div class="card-meta">
          <svg class="meta-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Requested on {{formatDate created_at}}
        </div>
      </div>
      {{else}}
      <p style="color: var(--text-secondary); font-size: 13px; text-align: center; padding: 20px;">No requests pending</p>
      {{/each}}
    </div>

    <!-- Scheduled -->
    <div class="kanban-column">
      <div class="kanban-header">
        <span>Scheduled</span>
        <span class="badge" style="background: rgba(255,255,255,0.1);">0</span>
      </div>
      <p style="color: var(--text-secondary); font-size: 13px; text-align: center; padding: 20px;">Drag requests here to schedule</p>
    </div>

    <!-- Completed -->
    <div class="kanban-column">
      <div class="kanban-header">
        <span>Completed</span>
        <span class="badge" style="background: rgba(255,255,255,0.1);">0</span>
      </div>
      <p style="color: var(--text-secondary); font-size: 13px; text-align: center; padding: 20px;">No completed consultations yet</p>
    </div>
  </div>
</div>
