<style>
  .team-page {
    padding: 32px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }
  .page-title {
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    color: var(--crm-text-primary);
  }
  .page-desc {
    font-size: 14px;
    color: var(--crm-text-secondary);
    margin-top: 4px;
  }

  .table-card {
    background: var(--crm-card-bg);
    border: 1px solid var(--crm-border);
    border-radius: var(--crm-radius, 12px);
    padding: 24px;
  }

  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .crm-table th {
    text-align: left;
    padding: 12px 16px;
    color: var(--crm-text-secondary);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    border-bottom: 1px solid var(--crm-border);
  }
  .crm-table td {
    padding: 16px;
    border-bottom: 1px solid var(--crm-border);
    color: var(--crm-text-primary);
    vertical-align: middle;
  }
  .crm-table tr:last-child td {
    border-bottom: none;
  }

  .user-cell {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--crm-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: var(--crm-primary);
    font-size: 14px;
  }
  .user-info-text {
    display: flex;
    flex-direction: column;
  }
  .user-name {
    font-weight: 500;
  }
  .user-email {
    font-size: 12px;
    color: var(--crm-text-secondary);
  }

  .role-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    text-transform: capitalize;
  }
  .role-admin { background: rgba(239, 68, 68, 0.1); color: #EF4444; }
  .role-sales { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
  .role-analyst { background: rgba(168, 85, 247, 0.1); color: #A855F7; }
  .role-user { background: rgba(156, 163, 175, 0.1); color: #9CA3AF; }

  .role-select {
    background: var(--crm-bg);
    border: 1px solid var(--crm-border);
    color: var(--crm-text-primary);
    padding: 6px 12px;
    border-radius: var(--crm-radius-sm, 6px);
    font-size: 13px;
    cursor: pointer;
  }
  .role-select option {
    background: var(--crm-card-bg);
    color: var(--crm-text-primary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--crm-radius-sm, 8px);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }
  .btn-primary {
    background: var(--crm-primary);
    color: white;
  }
  .btn-primary:hover {
    background: #059669; /* var(--crm-primary) hover darker green */
  }

  /* Modal */
  .form-group {
    margin-bottom: 20px;
  }
  .form-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--crm-text-primary);
    margin-bottom: 8px;
  }
  .form-control {
    width: 100%;
    background: var(--crm-bg);
    border: 1px solid var(--crm-border);
    border-radius: var(--crm-radius-sm, 8px);
    padding: 12px 16px;
    color: var(--crm-text-primary);
    font-family: inherit;
    font-size: 14px;
  }

</style>

<div class="team-page">
  <div class="page-header" style="flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 class="page-title">Team Management</h1>
      <p class="page-desc">Manage your team members, their roles, and system access.</p>
    </div>
    <button class="btn btn-primary" onclick="openCreateUserModal()">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      Add User
    </button>
  </div>

  <div class="table-card">
    <table class="crm-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Joined Date</th>
          <th style="width: 150px;">Role Assignment</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody">
        <tr><td colspan="5" style="text-align: center;">Loading users...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" class="modal-overlay">
  <div class="modal-container" style="max-width: 500px;">
    <div class="modal-header">
      <h3 class="modal-title">Edit User</h3>
      <button class="modal-close" onclick="closeEditUserModal()"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editUserId">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input type="text" id="editUserName" class="form-control" placeholder="e.g. Jane Smith">
      </div>
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" id="editUserEmail" class="form-control" placeholder="jane@coverscore.ai">
      </div>
      <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--crm-border);">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <label class="form-label" style="margin-bottom:0;font-weight:600;">Reset Password</label>
          <button class="btn btn-outline" style="border:1px solid var(--crm-border);background:var(--crm-bg);color:var(--crm-text-primary);padding:6px 14px;border-radius:var(--crm-radius-sm,8px);cursor:pointer;font-size:13px;white-space:nowrap;text-align:center;" onclick="toggleResetPassword()" id="toggleResetBtn">Change Password</button>
        </div>
        <div id="resetPasswordFields" style="display:none;">
          <div class="form-group">
            <label class="form-label">New Password</label>
            <div style="display:flex; gap:12px;">
              <input type="text" id="editUserPassword" class="form-control" placeholder="Minimum 8 characters">
              <button class="btn btn-outline" style="border: 1px solid var(--crm-border); background: var(--crm-bg); color: var(--crm-text-primary); padding: 10px 16px; border-radius: var(--crm-radius-sm, 8px); cursor: pointer; white-space: nowrap; text-align: center;" onclick="generateEditPassword()">Generate</button>
            </div>
          </div>
          <button class="btn-primary" style="margin-top:8px;padding:8px 16px;font-size:13px;white-space:nowrap;text-align:center;" onclick="submitResetPassword()">Reset Password</button>
        </div>
      </div>
    </div>
      <div class="modal-footer">
      <button class="btn-secondary" style="padding: 10px 20px; background: transparent; border: 1px solid var(--crm-border); color: var(--crm-text-primary); border-radius: var(--crm-radius-sm, 8px); cursor: pointer; white-space: nowrap; text-align: center;" onclick="closeEditUserModal()">Cancel</button>
      <button class="btn-primary" onclick="submitEditUser()">Save Changes</button>
    </div>
  </div>
</div>

<!-- Create User Modal -->
<div id="createUserModal" class="modal-overlay">
  <div class="modal-container" style="max-width: 500px;">
    <div class="modal-header">
      <h3 class="modal-title">Create New User</h3>
      <button class="modal-close" onclick="closeCreateUserModal()"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input type="text" id="newUserName" class="form-control" placeholder="e.g. Jane Smith">
      </div>
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" id="newUserEmail" class="form-control" placeholder="jane@coverscore.ai">
      </div>
      <div class="form-group">
        <label class="form-label">Role</label>
        <select id="newUserRole" class="form-control">
          <option value="sales">Advisor (Sales)</option>
          <option value="admin">Administrator</option>
          <option value="analyst">Risk Analyst</option>
          <option value="user">Standard User</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Temporary Password</label>
        <div style="display:flex; gap:12px;">
          <input type="text" id="newUserPassword" class="form-control" placeholder="Minimum 6 characters">
          <button class="btn btn-outline" style="border: 1px solid var(--crm-border); background: var(--crm-bg); color: var(--crm-text-primary); white-space: nowrap; text-align: center;" onclick="generatePassword()">Generate</button>
        </div>
      </div>
      <p style="font-size: 12px; color: var(--crm-text-secondary); margin-top: 8px;">
        Please securely share this temporary password with the new user. They can log in immediately.
      </p>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" style="padding: 10px 20px; background: transparent; border: 1px solid var(--crm-border); color: var(--crm-text-primary); border-radius: var(--crm-radius-sm, 8px); cursor: pointer; white-space: nowrap; text-align: center;" onclick="closeCreateUserModal()">Cancel</button>
      <button class="btn-primary" onclick="submitCreateUser()">Create Account</button>
    </div>
  </div>
</div>

<script>
  function openCreateUserModal() {
    document.getElementById('createUserModal').classList.add('show');
    generatePassword(); // Auto generate a secure password on open
  }

  function closeCreateUserModal() {
    document.getElementById('createUserModal').classList.remove('show');
    document.getElementById('newUserName').value = '';
    document.getElementById('newUserEmail').value = '';
  }

  function generatePassword() {
    const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';
    let pwd = '';
    for(let i=0; i<12; i++) {
      pwd += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    document.getElementById('newUserPassword').value = pwd;
  }

  function getApiHeaders() {
    return {};
  }

  async function loadUsers() {
    try {
      const res = await fetch('/api/admin/users?limit=50', { headers: getApiHeaders() });
      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
      
      if (res.status === 403) {
        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">You need Administrator access to manage users.</td></tr>';
        return;
      }
      
      if (res.ok) {
        const data = await res.json();
        renderUsers(data.users || []);
      } else {
        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">Error loading users. Please refresh.</td></tr>';
      }
    } catch(err) {
      console.error('Failed to load users', err);
      const tbody = document.getElementById('usersTableBody');
      tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">Network error. Please refresh.</td></tr>';
    }
  }

  function openEditUserModal(id, name, email) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editUserName').value = name;
    document.getElementById('editUserEmail').value = email;
    document.getElementById('editUserModal').classList.add('show');
  }

  function closeEditUserModal() {
    document.getElementById('editUserModal').classList.remove('show');
    document.getElementById('editUserId').value = '';
    document.getElementById('editUserName').value = '';
    document.getElementById('editUserEmail').value = '';
    document.getElementById('editUserPassword').value = '';
    const fields = document.getElementById('resetPasswordFields');
    if (fields) fields.style.display = 'none';
    const btn = document.getElementById('toggleResetBtn');
    if (btn) btn.textContent = 'Change Password';
  }

  async function submitEditUser() {
    const id = document.getElementById('editUserId').value;
    const name = document.getElementById('editUserName').value.trim();
    const email = document.getElementById('editUserEmail').value.trim();

    if (!name || !email) {
      if (typeof showToast === 'function') showToast('Error', 'Please fill in all fields', 'error');
      else alert('Please fill in all fields');
      return;
    }

    try {
      const headers = { 'Content-Type': 'application/json', ...getApiHeaders() };

      const res = await fetch(`/api/admin/users/${id}`, {
        method: 'PUT',
        headers,
        body: JSON.stringify({ name, email })
      });

      if (res.ok) {
        if (typeof showToast === 'function') showToast('Success', 'User updated successfully');
        closeEditUserModal();
        loadUsers();
      } else {
        const data = await res.json();
        if (typeof showToast === 'function') showToast('Error', data.message || 'Failed to update user', 'error');
        else alert('Error: ' + (data.message || 'Failed to update user'));
      }
    } catch(err) {
      console.error(err);
      if (typeof showToast === 'function') showToast('Error', 'Network error', 'error');
      else alert('Network error');
    }
  }

  function toggleResetPassword() {
    const fields = document.getElementById('resetPasswordFields');
    const btn = document.getElementById('toggleResetBtn');
    const isHidden = fields.style.display === 'none';
    fields.style.display = isHidden ? 'block' : 'none';
    btn.textContent = isHidden ? 'Cancel' : 'Change Password';
    if (!isHidden) document.getElementById('editUserPassword').value = '';
  }

  function generateEditPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#$%';
    let pwd = '';
    for (let i = 0; i < 14; i++) pwd += chars.charAt(Math.floor(Math.random() * chars.length));
    document.getElementById('editUserPassword').value = pwd;
  }

  async function submitResetPassword() {
    const id = document.getElementById('editUserId').value;
    const password = document.getElementById('editUserPassword').value.trim();

    if (!password || password.length < 8) {
      if (typeof showToast === 'function') showToast('Error', 'Password must be at least 8 characters', 'error');
      else alert('Password must be at least 8 characters');
      return;
    }

    try {
      const headers = { 'Content-Type': 'application/json', ...getApiHeaders() };
      const res = await fetch(`/api/admin/users/${id}/reset-password`, {
        method: 'PUT',
        headers,
        body: JSON.stringify({ password })
      });

      if (res.ok) {
        if (typeof showToast === 'function') showToast('Success', 'Password reset successfully');
        toggleResetPassword();
        document.getElementById('editUserPassword').value = '';
      } else {
        const data = await res.json();
        if (typeof showToast === 'function') showToast('Error', data.message || 'Failed to reset password', 'error');
        else alert('Error: ' + (data.message || 'Failed to reset password'));
      }
    } catch (err) {
      console.error(err);
      if (typeof showToast === 'function') showToast('Error', 'Network error', 'error');
      else alert('Network error');
    }
  }

  async function deleteUser(id) {
    if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
      return;
    }

    try {
      const res = await fetch(`/api/admin/users/${id}`, {
        method: 'DELETE',
        headers: getApiHeaders()
      });

      if (res.ok) {
        if (typeof showToast === 'function') showToast('Success', 'User deleted successfully');
        loadUsers();
      } else {
        const data = await res.json();
        if (typeof showToast === 'function') showToast('Error', data.message || 'Failed to delete user', 'error');
        else alert('Error: ' + (data.message || 'Failed to delete user'));
      }
    } catch(err) {
      console.error(err);
      if (typeof showToast === 'function') showToast('Error', 'Network error', 'error');
      else alert('Network error');
    }
  }

  function escapeHTML(str) {
    if (!str) return '';
    return str.toString()
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderUsers(users) {
    const tbody = document.getElementById('usersTableBody');
    if (!users || users.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align: center;">No users found.</td></tr>';
      return;
    }

    tbody.innerHTML = users.map(user => {
      const name = user.name || 'Unknown User';
      const email = user.email || 'No email';
      const initials = name.split(' ').filter(n => n.length > 0).map(n => n[0]).join('').toUpperCase().substring(0,2) || '??';
      const joinedDate = user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Unknown Date';
      
      const escapedName = escapeHTML(name);
      const escapedEmail = escapeHTML(email);

      return `
        <tr>
          <td>
            <div class="user-cell">
              <div class="user-avatar">${initials}</div>
              <div class="user-info-text">
                <span class="user-name">${escapedName}</span>
                <span class="user-email">${escapedEmail}</span>
              </div>
            </div>
          </td>
          <td><span class="role-badge role-${user.role || 'user'}">${user.role || 'user'}</span></td>
          <td>${joinedDate}</td>
          <td>
            <select class="role-select" onchange="updateUserRole(${user.id}, this.value)">
              <option value="user" ${user.role === 'user' ? 'selected' : ''}>User</option>
              <option value="sales" ${user.role === 'sales' ? 'selected' : ''}>Advisor</option>
              <option value="analyst" ${user.role === 'analyst' ? 'selected' : ''}>Analyst</option>
              <option value="admin" ${user.role === 'admin' ? 'selected' : ''}>Admin</option>
            </select>
          </td>
          <td style="text-align: right;">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
              <button class="btn btn-outline" style="padding: 6px 12px; border: 1px solid var(--crm-border); background: var(--crm-bg); color: var(--crm-text-primary); cursor: pointer; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500;" onclick="openEditUserModal(${user.id}, decodeURIComponent('${encodeURIComponent(name)}'), decodeURIComponent('${encodeURIComponent(email)}'))" title="Edit">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Edit
              </button>
              <button class="btn btn-outline" style="padding: 6px 12px; border: 1px solid rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.1); color: #EF4444; cursor: pointer; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500;" onclick="deleteUser(${user.id})" title="Delete">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Delete
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function updateUserRole(userId, newRole) {
    try {
      const headers = { 'Content-Type': 'application/json', ...getApiHeaders() };

      const res = await fetch(`/api/admin/users/${userId}/role`, {
        method: 'PUT',
        headers,
        body: JSON.stringify({ role: newRole })
      });
      if (res.ok) {
        if (typeof showToast === 'function') showToast('Success', 'User role updated successfully');
        loadUsers();
      } else {
        const data = await res.json();
        if (typeof showToast === 'function') showToast('Error', data.message || 'Failed to update role', 'error');
        else alert('Error: ' + (data.message || 'Failed to update role'));
      }
    } catch(err) {
      console.error(err);
      if (typeof showToast === 'function') showToast('Error', 'Network error', 'error');
      else alert('Network error');
    }
  }

  async function submitCreateUser() {
    const name = document.getElementById('newUserName').value.trim();
    const email = document.getElementById('newUserEmail').value.trim();
    const role = document.getElementById('newUserRole').value;
    const password = document.getElementById('newUserPassword').value;

    if (!name || !email || !password) {
      if (typeof showToast === 'function') showToast('Error', 'Please fill in all fields', 'error');
      else alert('Please fill in all fields');
      return;
    }

    try {
      const headers = { 'Content-Type': 'application/json', ...getApiHeaders() };

      const res = await fetch('/api/admin/users/create', {
        method: 'POST',
        headers,
        body: JSON.stringify({ name, email, role, password })
      });

      const data = await res.json();
      if (res.ok) {
        if (typeof showToast === 'function') showToast('Success', 'User account created successfully');
        else alert('User account created successfully');
        closeCreateUserModal();
        loadUsers();
      } else {
        if (typeof showToast === 'function') showToast('Error', data.message || 'Failed to create user', 'error');
        else alert('Error: ' + (data.message || 'Failed to create user'));
      }
    } catch(err) {
      console.error(err);
      if (typeof showToast === 'function') showToast('Error', 'Network error', 'error');
      else alert('Network error');
    }
  }

  // Load initially
  document.addEventListener('DOMContentLoaded', loadUsers);
</script>
