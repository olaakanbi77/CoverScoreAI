  function switchDetailTab(tab) {
    const tabInfo = document.getElementById('tabInfo');
    const tabChat = document.getElementById('tabChat');
    const infoSec = document.getElementById('infoSection');
    const chatSec = document.getElementById('chatSection');
    
    if (tab === 'info') {
      infoSec.style.display = 'block';
      chatSec.style.display = 'none';
      tabInfo.style.color = 'var(--crm-primary)';
      tabInfo.style.fontWeight = '600';
      tabChat.style.color = 'var(--crm-text-secondary)';
      tabChat.style.fontWeight = '400';
    } else {
      infoSec.style.display = 'none';
      chatSec.style.display = 'block';
      tabInfo.style.color = 'var(--crm-text-secondary)';
      tabInfo.style.fontWeight = '400';
      tabChat.style.color = 'var(--crm-primary)';
      tabChat.style.fontWeight = '600';
    }
  }

  async function openLeadModal(leadId) {
    try {
      switchDetailTab('info');
      const token = localStorage.getItem('accessToken');
      const headers = {};
      if (token) headers['Authorization'] = 'Bearer ' + token;
      
      const res = await fetch('/api/leads/' + leadId, { headers });
      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
      if (!res.ok) throw new Error('Failed to load lead details');
      
      const lead = await res.json();
      
      document.getElementById('detailLeadId').value = lead.id;
      document.getElementById('detailModalTitle').innerText = 'Lead Details: ' + lead.name;
      document.getElementById('detailName').value = lead.name || '';
      document.getElementById('detailEmail').value = lead.email || '';
      document.getElementById('detailPhone').value = lead.phone || '';
      document.getElementById('detailBusiness').value = lead.businessName || '';
      document.getElementById('detailScore').innerText = (lead.score || 0) + '/100';
      document.getElementById('detailNotes').value = lead.notes || '';
      document.getElementById('detailPremium').value = lead.estimatedPremium || 0;
      document.getElementById('detailAgent').value = lead.assignedAgent || '';
      document.getElementById('detailIndustry').value = lead.industry || '';
      document.getElementById('detailStatus').value = lead.status || 'New Lead';
      
      document.getElementById('detailSource').innerText = lead.lead_source || 'CoverScore AI';
      document.getElementById('detailEntityType').innerText = lead.entity_type || 'business';

      const risk = lead.riskLevel || 'low';
      const badge = document.getElementById('detailRiskBadge');
      badge.className = 'crm-badge';
      badge.innerText = risk.toUpperCase();
      if (risk === 'high' || risk === 'critical') badge.className = 'crm-badge badge-high';
      else if (risk === 'low') badge.className = 'crm-badge badge-low-mod';
      else badge.className = 'crm-badge badge-mod';

      const chatLog = document.getElementById('detailChatLog');
      let chatHistory = [];
      if (lead.assessment?.answers?.chat_history) {
        chatHistory = lead.assessment.answers.chat_history;
      } else if (lead.chat_history) {
        try {
          chatHistory = JSON.parse(lead.chat_history);
        } catch(e) {}
      }
      
      if (chatHistory && typeof chatHistory === 'object' && Object.keys(chatHistory).length > 0) {
        let html = '';
        if (Array.isArray(chatHistory)) {
          html = chatHistory.map(m => {
            const isSent = m.sender === 'bot';
            return `<div class="chat-msg ${isSent ? 'sent' : 'received'}"><strong>${isSent ? 'Bot' : 'Lead'}:</strong> ${m.message || m.text || ''}</div>`;
          }).join('');
        } else {
          html = Object.entries(chatHistory).map(([key, val]) => {
            return `<div class="chat-msg received"><strong>${key}:</strong> ${val}</div>`;
          }).join('');
        }
        chatLog.innerHTML = html;
      } else {
        chatLog.innerHTML = '<div style="color: var(--crm-text-muted); font-size: 12px; text-align: center; padding: 12px;">No chat history recorded.</div>';
      }

      document.getElementById('leadDetailModal').classList.add('show');
    } catch(err) {
      console.error(err);
      showToast('Error loading lead: ' + err.message, 'error');
    }
  }

  function closeLeadDetailModal() {
    document.getElementById('leadDetailModal').classList.remove('show');
  }

  async function saveLeadDetails() {
    try {
      const leadId = document.getElementById('detailLeadId').value;
      const token = localStorage.getItem('accessToken');
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = 'Bearer ' + token;

      const body = {
        name: document.getElementById('detailName').value,
        email: document.getElementById('detailEmail').value,
        phone: document.getElementById('detailPhone').value,
        businessName: document.getElementById('detailBusiness').value,
        status: document.getElementById('detailStatus').value,
        estimatedPremium: parseInt(document.getElementById('detailPremium').value) || 0,
        assignedAgent: document.getElementById('detailAgent').value,
        industry: document.getElementById('detailIndustry').value,
        notes: document.getElementById('detailNotes').value
      };

      if (body.status === 'Won') {
        document.getElementById('policyLeadId').value = leadId;
        document.getElementById('policyClientName').value = document.getElementById('detailName').value;
        closeLeadDetailModal();
        document.getElementById('policyModal').classList.add('show');
        return;
      }

      const res = await fetch('/api/leads/' + leadId, {
        method: 'PUT',
        headers,
        body: JSON.stringify(body)
      });

      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
      if (!res.ok) throw new Error('Failed to update lead');

      showToast('Lead updated successfully', 'success');
      closeLeadDetailModal();
      
      const isLeadsPage = '{{activePage}}' === 'leads';
      if (isLeadsPage) {
        loadLeadsData();
      } else {
        loadDashboardData();
      }
    } catch(err) {
      console.error(err);
      showToast('Error updating lead: ' + err.message, 'error');
    }
  }

  function closePolicyModal() {
    document.getElementById('policyModal').classList.remove('show');
  }

  async function submitPolicy(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      const headers = { 'Content-Type': 'application/json' };
      const token = localStorage.getItem('accessToken');
      if (token) headers['Authorization'] = 'Bearer ' + token;

      const res = await fetch('/api/crm/policies', {
        method: 'POST',
        headers,
        body: JSON.stringify(data)
      });
      
      if (res.ok) {
        closePolicyModal();
        showToast('Policy recorded and lead marked as Won', 'success');
        const isLeadsPage = '{{activePage}}' === 'leads';
        if (isLeadsPage) {
          loadLeadsData();
        } else {
          loadDashboardData();
        }
      } else {
        const err = await res.json();
        alert(err.error || 'Failed to record policy');
        btn.disabled = false;
        btn.textContent = 'Save Policy';
      }
    } catch (error) {
      alert('Error connecting to server');
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = false;
      btn.textContent = 'Save Policy';
    }
  }

  async function deleteLead() {
    if (!confirm('Are you sure you want to delete this lead? This cannot be undone.')) return;
    try {
      const leadId = document.getElementById('detailLeadId').value;
      const token = localStorage.getItem('accessToken');
      const headers = {};
      if (token) headers['Authorization'] = 'Bearer ' + token;

      const res = await fetch('/api/leads/' + leadId, {
        method: 'DELETE',
        headers
      });

      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
      if (!res.ok) throw new Error('Failed to delete lead');

      showToast('Lead deleted successfully', 'success');
      closeLeadDetailModal();
      
      const isLeadsPage = '{{activePage}}' === 'leads';
      if (isLeadsPage) {
        loadLeadsData();
      } else {
        loadDashboardData();
      }
    } catch(err) {
      console.error(err);
      showToast('Error deleting lead: ' + err.message, 'error');
    }
  }

  // --- Init ---
  const isLeadsPage = '{{activePage}}' === 'leads';
  if (isLeadsPage) {
    loadLeadsData();
  } else {
    updateDateRange();
    loadDashboardData();
  }
</script>