<style>
  @media (max-width: 768px) {
    .dashboard-header { flex-direction: column; gap: 12px; align-items: stretch; }
    .dashboard-header .greeting-title { font-size: 20px; }
    .dashboard-header .greeting-sub { font-size: 13px; }
    .date-picker { align-self: flex-start; }
    .kpi-card { padding: 14px; }
    .kpi-value { font-size: 22px; }
    .pipeline-section { padding: 16px; }
    .section-title { font-size: 16px; }
    .table-card { padding: 16px; border-radius: var(--crm-radius); overflow: hidden; }
    .table-card .table-filters { flex-direction: column; gap: 8px; }
    .table-card .filter-group { min-width: 100% !important; }
    .table-card .filter-group input,
    .table-card .filter-group select { width: 100%; }
    .crm-table thead { display: none; }
    .crm-table tbody tr { display: block; padding: 12px; margin-bottom: 8px; background: white; border: 1px solid var(--crm-border); border-radius: 8px; }
    .crm-table tbody tr td { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border: none; gap: 8px; }
    .crm-table tbody tr td::before { content: attr(data-label); font-weight: 600; font-size: 11px; color: var(--crm-text-secondary); text-transform: uppercase; flex-shrink: 0; }
    .crm-table tbody tr td .td-main { font-size: 13px; }
    .crm-table tbody tr td .td-sub { font-size: 11px; }
    .crm-table tbody tr td .btn-action-outline { width: auto; padding: 4px 10px; font-size: 11px; }
    .table-pagination { flex-direction: column; gap: 8px; align-items: flex-start; }
    .charts-row { gap: 16px; }
    .chart-card { padding: 16px; }
    .grid-right { display: grid; grid-template-columns: 1fr; gap: 16px; }
    .widget-card { padding: 16px; }
    .quick-actions-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .quick-action-btn { padding: 10px; }
    .quick-action-btn svg { width: 20px; height: 20px; }
    .quick-action-btn span { font-size: 11px; }
    .task-item { padding: 10px 0; }
    .feed-item { padding: 10px 0; }
    .modal-container { max-width: 95%; margin: 20px auto; border-radius: 12px; }
    .modal-header { padding: 16px 20px; }
    .modal-body { padding: 16px 20px; }
    .modal-footer { padding: 12px 20px; flex-direction: column; }
    .modal-footer .btn-secondary,
    .modal-footer .btn-primary { width: 100%; text-align: center; }
  }

  @media (max-width: 480px) {
    .dashboard-header .greeting-title { font-size: 18px; }
    .kpi-card { padding: 10px; }
    .kpi-value { font-size: 20px; }
    .kpi-icon-wrap { width: 32px; height: 32px; }
    .kpi-icon-wrap svg { width: 16px; height: 16px; }
    .pipeline-section { padding: 12px; }
    .pipeline-stage { padding: 8px 12px; font-size: 12px; }
    .table-card { padding: 12px; border-radius: 0; margin: 0 -16px; }
    .date-picker { font-size: 12px; padding: 6px 10px; }
    .quick-actions-grid { grid-template-columns: 1fr; }
    .modal-overlay { align-items: flex-end; }
    .modal-container { width: 100%; margin: 0; border-radius: 16px 16px 0 0; max-height: 90vh; overflow-y: auto; }
  }
</style>
<div class="dashboard-header">
  <div>
    {{#if (eq activePage 'leads')}}
      <h1 class="greeting-title">Lead Management</h1>
      <p class="greeting-sub">Track risk intelligence scores, customize insurance categories, and process quotes.</p>
    {{else}}
      <h1 class="greeting-title">Good morning, Admin 👋<br><span style="font-size: 24px; font-weight: 700; display: block; margin-top: 4px; color: var(--crm-text);">Admin Dashboard</span></h1>
      <p class="greeting-sub">Platform overview at a glance.</p>
    {{/if}}
  </div>
  {{#unless (eq activePage 'leads')}}
  <div class="date-picker-badge" style="background: white; border-radius: 8px; border: 1px solid var(--crm-border); padding: 8px 12px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; margin-top: 12px;">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    <span id="currentDateRange">Today, 30 Jul 2026</span>
    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </div>
  {{/unless}}
</div>

