<link rel="stylesheet" href="/css/admin-dashboard.css">

<div class="md-dashboard">
  <div class="md-shell">

    <div id="mdError" class="md-error">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      <span>Unable to refresh dashboard data.</span>
    </div>

    <!-- 1 · Top Navigation / Greeting -->
    <header class="md-header md-reveal md-d1">
      <div class="md-eyebrow">Admin Dashboard</div>
      <h1 class="md-title" id="mdGreeting">Good Morning, <span id="mdUserName">{{#if user.name}}{{user.name}}{{else}}Admin{{/if}}</span></h1>
      <p class="md-date" id="mdDate"></p>
    </header>

    <!-- 2 · Hero Card · Platform Status -->
    <section class="md-hero md-reveal md-d2" aria-label="Platform status">
      <div class="md-hero-top">
        <span class="md-hero-label">Platform Status</span>
        <span class="md-dot" id="mdStatusDot"></span>
      </div>
      <div class="md-hero-status" id="mdStatusTitle">Checking…</div>
      <p class="md-hero-msg" id="mdStatusMsg">Loading platform health.</p>
    </section>

    <!-- 3 · Needs Attention -->
    <section>
      <div class="md-section-head">
        <h2 class="md-section-title">Needs Your Attention</h2>
      </div>
      <div class="md-card md-attention md-reveal md-d3">
        <div id="mdAttentionList">
          <div class="md-empty">Checking priorities…</div>
        </div>
        <a href="/admin/leads" class="md-btn-primary">
          Review Now
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </section>

    <!-- 4 · Today's Activity · KPIs -->
    <section>
      <div class="md-section-head">
        <h2 class="md-section-title">Today's Activity</h2>
      </div>
      <div class="md-kpis" id="mdKpis">
        <div class="md-kpi md-reveal md-d3"><span class="md-kpi-ic blue" style="background:#EEF2F7;color:#94A3B8"></span><span class="md-skeleton" style="height:28px;width:70px"></span></div>
        <div class="md-kpi md-reveal md-d4"><span class="md-kpi-ic blue" style="background:#EEF2F7;color:#94A3B8"></span><span class="md-skeleton" style="height:28px;width:70px"></span></div>
        <div class="md-kpi md-reveal md-d5"><span class="md-kpi-ic blue" style="background:#EEF2F7;color:#94A3B8"></span><span class="md-skeleton" style="height:28px;width:70px"></span></div>
        <div class="md-kpi md-reveal md-d6"><span class="md-kpi-ic blue" style="background:#EEF2F7;color:#94A3B8"></span><span class="md-skeleton" style="height:28px;width:70px"></span></div>
      </div>
    </section>

    <!-- 5 · Priority Leads -->
    <section>
      <div class="md-section-head">
        <h2 class="md-section-title">Priority Leads</h2>
        <a href="/admin/leads" class="md-section-link">View All →</a>
      </div>
      <div class="md-card md-leads md-reveal md-d4">
        <div id="mdPriorityLeads">
          <div class="md-empty">Loading leads…</div>
        </div>
      </div>
    </section>

    <!-- 6 · Quick Actions -->
    <section>
      <div class="md-section-head">
        <h2 class="md-section-title">Quick Actions</h2>
      </div>
      <div class="md-quick md-reveal md-d5">
        <a href="/admin/team" class="md-quick-btn">
          <span class="md-quick-ic blue">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
          </span>
          <span class="md-quick-label">Add Advisor</span>
        </a>
        <a href="/admin/analytics" class="md-quick-btn">
          <span class="md-quick-ic violet">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </span>
          <span class="md-quick-label">Generate Report</span>
        </a>
        <a href="/admin/settings" class="md-quick-btn">
          <span class="md-quick-ic green">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </span>
          <span class="md-quick-label">Automation</span>
        </a>
        <a href="/admin/consultations" class="md-quick-btn">
          <span class="md-quick-ic amber">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
          </span>
          <span class="md-quick-label">Broadcast</span>
        </a>
      </div>
    </section>

  </div>
</div>

<script>
(function() {
  'use strict';

  // Time-of-day greeting (name is server-rendered, only the period updates)
  var now = new Date();
  var hr = now.getHours();
  var period = hr < 12 ? 'Good Morning' : (hr < 17 ? 'Good Afternoon' : 'Good Evening');
  var g = document.getElementById('mdGreeting');
  var n = document.getElementById('mdUserName');
  if (g && n) {
    var first = String(n.textContent).trim().split(/\s+/)[0];
    g.textContent = period + (first ? ', ' + first : '') + ' 👋';
  }
  var d = document.getElementById('mdDate');
  if (d) {
    d.textContent = now.toLocaleDateString('en-NG', { weekday: 'long', day: 'numeric', month: 'long' }) +
      ' · ' + now.toLocaleTimeString('en-NG', { hour: 'numeric', minute: '2-digit' });
  }

  function api(path, fallback) {
    return fetch(path)
      .then(function(r) { if (!r.ok) throw new Error(path + ' ' + r.status); return r.json(); })
      .catch(function(err) { console.warn('dashboard fetch failed:', path, err); return fallback; });
  }

  function initials(name) {
    return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2)
      .map(function(w) { return w[0].toUpperCase(); }).join('') || '?';
  }

  function riskBadge(level) {
    var l = String(level || '').toLowerCase();
    if (l === 'high' || l === 'critical') return 'high';
    if (l === 'moderate' || l === 'medium') return 'moderate';
    return 'low';
  }

  function riskLabel(level) {
    var l = String(level || '').toLowerCase();
    if (l === 'critical') return 'Critical';
    if (l === 'high') return 'High Risk';
    if (l === 'moderate' || l === 'medium') return 'Medium Risk';
    if (l === 'low') return 'Low Risk';
    return 'Assessed';
  }

  function leadName(l) {
    return l.business_name || l.name || l.contact_person || 'Unknown';
  }

  // ── Load everything in parallel ──
  Promise.all([
    api('/api/admin/dashboard', null),
    api('/api/analytics/overview', null),
    api('/api/analytics/risk-distribution', null)
  ]).then(function(res) {
    var admin = res[0] || {};
    var overview = res[1] || {};
    var risk = res[2] || {};

    var metrics = admin.metrics || {};
    var submissions = admin.recentSubmissions || [];
    var highRiskLeads = metrics.highRiskLeads != null ? metrics.highRiskLeads
      : ((risk.high || 0) + (risk.critical || 0));

    var attention = [];
    if (highRiskLeads > 0) attention.push({ level: 'crit', icon: 'alert', title: 'High-Risk Leads', count: highRiskLeads, sub: 'Need review soon', href: '/admin/leads?risk_level=high' });
    var conversions = overview.conversionRate != null ? overview.conversionRate : (metrics.conversionRate || 0);
    if (conversions < 30 && conversions > 0) attention.push({ level: 'warn', icon: 'trend', title: 'Conversion Below Target', count: conversions + '%', sub: 'Target is 30%', href: '/admin/analytics' });
    var assessments = overview.totalAssessments != null ? overview.totalAssessments : metrics.totalAssessments;
    if ((assessments || 0) > 100 && highRiskLeads === 0) attention.push({ level: 'info', icon: 'doc', title: 'Assessments in Motion', count: assessments, sub: 'Strong intake this cycle', href: '/admin/assessments' });
    if (attention.length === 0) attention.push({ level: 'info', icon: 'check', title: 'All Clear', count: 0, sub: 'No items need your attention', href: '/admin/leads' });

    renderAttention(attention.slice(0, 3));
    renderHero(highRiskLeads, assessments, conversions);
    renderKpis(overview, risk, metrics, highRiskLeads);
    renderLeads(submissions);
  });

  function renderHero(highRisk, assessments, conversion) {
    var dot = document.getElementById('mdStatusDot');
    var title = document.getElementById('mdStatusTitle');
    var msg = document.getElementById('mdStatusMsg');
    var healthy = highRisk === 0;

    dot.classList.add(healthy ? 'healthy' : 'warn');
    dot.classList.remove(healthy ? 'warn' : 'healthy');
    title.textContent = healthy ? 'Healthy' : 'Attention Required';

    if (healthy) {
      msg.innerHTML = 'Everything operating normally. <strong>' + (assessments || 0) + ' assessments</strong> this cycle, conversion at <strong>' + (conversion || 0) + '%</strong>.';
    } else {
      msg.innerHTML = '<strong>' + highRisk + ' critical ' + (highRisk === 1 ? 'issue' : 'issues') + '</strong> need your review.';
    }
  }

  function renderAttention(items) {
    var list = document.getElementById('mdAttentionList');
    var icons = {
      alert: '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>',
      trend: '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>',
      doc: '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
      check: '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>'
    };
    list.innerHTML = items.map(function(it) {
      return '<a class="md-att-item" href="' + it.href + '">' +
        '<span class="md-att-ic ' + it.level + '">' + (icons[it.icon] || icons.alert) + '</span>' +
        '<span class="md-att-body">' +
          '<span class="md-att-text">' + it.title + (it.count > 0 ? ' <span class="md-att-badge">' + it.count + '</span>' : '') + '</span>' +
          '<span class="md-att-sub">' + it.sub + '</span>' +
        '</span>' +
        '<span class="md-att-chev"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>' +
      '</a>';
    }).join('');
  }

  function renderKpis(overview, risk, metrics, highRisk) {
    var kpis = [
      { ic: 'blue',   label: 'Assessments',   val: overview.totalAssessments != null ? overview.totalAssessments : metrics.totalAssessments, trend: overview.trends ? overview.trends.assessments : null },
      { ic: 'green',  label: 'Qualified Leads', val: overview.convertedLeads != null ? overview.convertedLeads : 0, trend: overview.trends ? overview.trends.leads : null },
      { ic: 'amber',  label: 'Risk Reviews',  val: (risk.high || 0) + (risk.critical || 0), trend: null },
      { ic: 'red',    label: 'Conversion',    val: (overview.conversionRate != null ? overview.conversionRate : metrics.conversionRate || 0) + '%', trend: overview.trends ? overview.trends.consultations : null }
    ];
    var icons = {
      blue: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>',
      green: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>',
      amber: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>',
      red: '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>'
    };
    var grid = document.getElementById('mdKpis');
    grid.innerHTML = kpis.map(function(k, i) {
      var t = '';
      if (k.trend != null) {
        if (k.trend > 0) t = '<span class="md-kpi-trend up">↑ ' + k.trend + '%</span>';
        else if (k.trend < 0) t = '<span class="md-kpi-trend down">↓ ' + Math.abs(k.trend) + '%</span>';
        else t = '<span class="md-kpi-trend flat">→ 0%</span>';
      }
      return '<div class="md-kpi md-reveal md-d' + (i + 3) + '">' +
        '<span class="md-kpi-ic ' + k.ic + '">' + icons[k.ic] + '</span>' +
        '<span class="md-kpi-val">' + (k.val != null ? k.val.toLocaleString() : '0') + '</span>' +
        '<span class="md-kpi-meta"><span class="md-kpi-label">' + k.label + '</span>' + t + '</span>' +
      '</div>';
    }).join('');
  }

  function renderLeads(submissions) {
    var box = document.getElementById('mdPriorityLeads');
    if (!submissions || !submissions.length) {
      box.innerHTML = '<div class="md-empty">No leads yet.</div>';
      return;
    }
    var sorted = submissions.slice().sort(function(a, b) { return (a.score || 0) - (b.score || 0); }).slice(0, 3);
    box.innerHTML = sorted.map(function(l) {
      return '<a class="md-lead" href="/admin/leads/' + l.id + '">' +
        '<span class="md-lead-av">' + initials(leadName(l)) + '</span>' +
        '<span class="md-lead-body">' +
          '<span class="md-lead-name">' + leadName(l) + '</span>' +
          '<span class="md-lead-sub"><span class="md-badge ' + riskBadge(l.riskLevel) + '">' + riskLabel(l.riskLevel) + '</span>' + (l.assigned_agent ? l.assigned_agent : '') + '</span>' +
        '</span>' +
        '<span class="md-lead-score"><b>' + (l.score != null ? l.score : '—') + '</b><span>CoverScore</span></span>' +
      '</a>';
    }).join('');
  }
})();
</script>
