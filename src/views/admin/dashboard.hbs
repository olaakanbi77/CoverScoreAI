<div class="dashboard-header">
  <div>
    <h1 class="greeting-title">Welcome back, {{user.name}} 👋</h1>
    <p class="greeting-sub">Here's what's happening with your business today.</p>
  </div>
  <div class="date-picker">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    May 11 - May 17, 2026
    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </div>
</div>

<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-header">
      <div class="kpi-icon-wrap" style="background: rgba(59,130,246,0.1); color: #3B82F6;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      </div>
      <span class="kpi-label">Total Leads</span>
    </div>
    <div class="kpi-value" id="kpiLeads">0</div>
    <div class="kpi-trend positive"><span id="kpiLeadsTrend">↑ 0%</span> <span class="muted">vs last 7 days</span></div>
  </div>
  
  <div class="kpi-card">
    <div class="kpi-header">
      <div class="kpi-icon-wrap" style="background: rgba(168,85,247,0.1); color: #A855F7;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      </div>
      <span class="kpi-label">Assessments</span>
    </div>
    <div class="kpi-value" id="kpiAssessments">0</div>
    <div class="kpi-trend positive"><span id="kpiAssessTrend">↑ 0%</span> <span class="muted">vs last 7 days</span></div>
  </div>

  <div class="kpi-card">
    <div class="kpi-header">
      <div class="kpi-icon-wrap" style="background: rgba(245,158,11,0.1); color: #F59E0B;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <span class="kpi-label">Consultations</span>
    </div>
    <div class="kpi-value" id="kpiConsultations">0</div>
    <div class="kpi-trend positive"><span id="kpiConsTrend">↑ 0%</span> <span class="muted">vs last 7 days</span></div>
  </div>

  <div class="kpi-card">
    <div class="kpi-header">
      <div class="kpi-icon-wrap" style="background: rgba(16,185,129,0.1); color: #10B981;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
      <span class="kpi-label">Policies Sold</span>
    </div>
    <div class="kpi-value" id="kpiPolicies">0</div>
    <div class="kpi-trend positive"><span id="kpiPolTrend">↑ 0%</span> <span class="muted">vs last 7 days</span></div>
  </div>

  <div class="kpi-card">
    <div class="kpi-header">
      <div class="kpi-icon-wrap" style="background: rgba(239,68,68,0.1); color: #EF4444;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <span class="kpi-label">Premium (₦)</span>
    </div>
    <div class="kpi-value" id="kpiPremium">0</div>
    <div class="kpi-trend positive"><span id="kpiPremTrend">↑ 0%</span> <span class="muted">vs last 7 days</span></div>
  </div>
</div>

<div class="pipeline-section">
  <h2 class="section-title">Pipeline Overview</h2>
  <div class="pipeline-funnel" id="pipelineFunnel">
    <div class="pipeline-stage s1">
      <span class="stage-label">New Lead</span>
      <span class="stage-value" id="pl_new">0</span>
    </div>
    <div class="pipeline-stage s2">
      <span class="stage-label">Assessment Done</span>
      <span class="stage-value" id="pl_assess">0</span>
    </div>
    <div class="pipeline-stage s3">
      <span class="stage-label">Report Delivered</span>
      <span class="stage-value" id="pl_report">0</span>
    </div>
    <div class="pipeline-stage s4">
      <span class="stage-label">Consultations Booked</span>
      <span class="stage-value" id="pl_cons">0</span>
    </div>
    <div class="pipeline-stage s5">
      <span class="stage-label">Proposal Sent</span>
      <span class="stage-value" id="pl_prop">0</span>
    </div>
    <div class="pipeline-stage s6">
      <span class="stage-label">Policy Sold</span>
      <span class="stage-value" id="pl_sold">0</span>
    </div>
    <div class="pipeline-rates" id="pipelineRates"></div>
  </div>
</div>

<div class="dashboard-grid">
  <div class="grid-left">
    <div class="charts-row">
      <div class="chart-card">
        <h2 class="section-title">Risk Score Distribution</h2>
        <div class="donut-wrapper">
          <div class="donut-svg-wrap">
            <svg viewBox="0 0 36 36" id="riskDonut">
              <!-- Rendered via JS -->
            </svg>
            <div class="donut-center-text">
              <span class="donut-val" id="riskDonutTotal">0</span>
              <span class="donut-lbl">Total</span>
            </div>
          </div>
          <div class="donut-legend" id="riskLegend"></div>
        </div>
      </div>

      <div class="chart-card">
        <h2 class="section-title">Leads by Source</h2>
        <div class="donut-wrapper">
          <div class="donut-svg-wrap">
            <svg viewBox="0 0 36 36" id="sourceDonut">
              <!-- Rendered via JS -->
            </svg>
            <div class="donut-center-text">
              <span class="donut-val" id="sourceDonutTotal">0</span>
              <span class="donut-lbl">Total</span>
            </div>
          </div>
          <div class="donut-legend" id="sourceLegend"></div>
        </div>
      </div>
    </div>

    <div class="table-card">
      <div class="table-header">
        <h2 class="section-title">Recent Assessments</h2>
        <a href="/admin/leads" class="view-all-link">View All</a>
      </div>
      <table class="crm-table">
        <thead>
          <tr>
            <th>NAME/COMPANY</th>
            <th>TYPE</th>
            <th>SCORE</th>
            <th>RISK LEVEL</th>
            <th>DATE</th>
            <th>STATUS</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="recentAssessmentsTable">
          <tr><td colspan="7" class="text-center">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid-right">
    <div class="widget-card">
      <div class="widget-header">
        <h2 class="section-title">Upcoming Tasks</h2>
        <button class="topbar-icon-btn"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></button>
      </div>
      <div class="task-list" id="taskList">Loading...</div>
    </div>

    <div class="widget-card">
      <h2 class="section-title">Activity Feed</h2>
      <div class="feed-list" id="activityFeed">Loading...</div>
    </div>

    <div class="widget-card">
      <h2 class="section-title">Quick Actions</h2>
      <div class="quick-actions-grid">
        <button class="quick-action-btn">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
          <span>Add New Lead</span>
        </button>
        <button class="quick-action-btn" onclick="window.open('/start-whatsapp', '_blank')">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          <span>Start Assessment</span>
        </button>
        <button class="quick-action-btn">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Schedule Meeting</span>
        </button>
        <button class="quick-action-btn">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Create Proposal</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  async function loadDashboardData() {
    try {
      const token = localStorage.getItem('accessToken');
      if (!token) return window.location.href = '/auth/login';
      const headers = { 'Authorization': 'Bearer ' + token };

      // Load Analytics Overview
      const resOverview = await fetch('/api/analytics/overview', { headers });
      if (resOverview.ok) {
        const data = await resOverview.json();
        document.getElementById('kpiLeads').innerText = data.totalLeads.toLocaleString();
        document.getElementById('kpiAssessments').innerText = data.totalAssessments.toLocaleString();
        document.getElementById('kpiPremium').innerText = (data.totalPremium / 1000000).toFixed(1) + 'M';
        
        // Mocking positive trends for now
        document.getElementById('kpiLeadsTrend').innerText = '↑ 16%';
        document.getElementById('kpiAssessTrend').innerText = '↑ 22%';
        document.getElementById('kpiPremTrend').innerText = '↑ 28%';
      }

      // Load Pipeline
      const resPipeline = await fetch('/api/analytics/pipeline', { headers });
      if (resPipeline.ok) {
        const p = await resPipeline.json();
        document.getElementById('pl_new').innerText = p[1] || 0;
        document.getElementById('pl_assess').innerText = p[2] || 0;
        document.getElementById('pl_report').innerText = p[3] || 0;
        document.getElementById('pl_cons').innerText = p[4] || 0;
        document.getElementById('pl_prop').innerText = p[5] || 0;
        document.getElementById('pl_sold').innerText = p[6] || 0;

        document.getElementById('kpiConsultations').innerText = p[4] || 0;
        document.getElementById('kpiPolicies').innerText = p[6] || 0;
        document.getElementById('kpiConsTrend').innerText = '↑ 18%';
        document.getElementById('kpiPolTrend').innerText = '↑ 35%';
      }

      // Load Risk Distribution
      const resRisk = await fetch('/api/analytics/risk-distribution', { headers });
      if (resRisk.ok) {
        const risk = await resRisk.json();
        renderRiskDonut(risk);
      }

      // Load Sources
      const resSources = await fetch('/api/analytics/sources', { headers });
      if (resSources.ok) {
        const sources = await resSources.json();
        renderSourceDonut(sources);
      }

      // Load Recent Leads
      const resLeads = await fetch('/api/admin/dashboard', { headers });
      if (resLeads.ok) {
        const d = await resLeads.json();
        renderTable(d.recentSubmissions);
      }

      // Load Tasks
      const resTasks = await fetch('/api/crm/tasks', { headers });
      if (resTasks.ok) {
        const tasks = await resTasks.json();
        renderTasks(tasks);
      }

      // Load Activities
      const resActivities = await fetch('/api/crm/activities', { headers });
      if (resActivities.ok) {
        const activities = await resActivities.json();
        renderActivities(activities);
      }

    } catch (err) {
      console.error('Failed to load dashboard', err);
    }
  }

  function renderRiskDonut(data) {
    const colors = { high: '#EF4444', moderate: '#F59E0B', low: '#10B981', critical: '#991B1B' };
    const total = (data.low || 0) + (data.moderate || 0) + (data.high || 0) + (data.critical || 0);
    document.getElementById('riskDonutTotal').innerText = total;

    if (total === 0) return;

    let svg = '';
    let legend = '';
    let cumulative = 0;

    const items = [
      { key: 'high', label: 'High Risk' },
      { key: 'moderate', label: 'Moderate' },
      { key: 'low', label: 'Low Risk' }
    ];

    items.forEach(item => {
      const count = data[item.key] || 0;
      if (count > 0) {
        const percent = count / total;
        const dashArray = `${percent * 100} 100`;
        const offset = -cumulative * 100;
        svg += `<circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="${colors[item.key]}" stroke-width="4" stroke-dasharray="${dashArray}" stroke-dashoffset="${offset}"></circle>`;
        cumulative += percent;

        legend += `
          <div class="legend-row">
            <div class="legend-left"><div class="legend-dot" style="background: ${colors[item.key]}"></div>${item.label}</div>
            <div class="legend-right">${count} <span>(${Math.round(percent * 100)}%)</span></div>
          </div>
        `;
      }
    });
    
    if (cumulative === 0) {
        svg = `<circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#E2E8F0" stroke-width="4"></circle>`;
    }
    
    document.getElementById('riskDonut').innerHTML = svg;
    document.getElementById('riskLegend').innerHTML = legend;
  }

  function renderSourceDonut(sources) {
    const palette = ['#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EC4899'];
    let total = sources.reduce((a, b) => a + b.count, 0);
    document.getElementById('sourceDonutTotal').innerText = total;

    let svg = '';
    let legend = '';
    let cumulative = 0;

    if (total === 0) {
       document.getElementById('sourceDonut').innerHTML = `<circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#E2E8F0" stroke-width="4"></circle>`;
       return;
    }

    sources.slice(0, 5).forEach((s, idx) => {
      const count = s.count;
      const color = palette[idx % palette.length];
      const percent = count / total;
      const dashArray = `${percent * 100} 100`;
      const offset = -cumulative * 100;
      
      svg += `<circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="${color}" stroke-width="4" stroke-dasharray="${dashArray}" stroke-dashoffset="${offset}"></circle>`;
      cumulative += percent;

      legend += `
        <div class="legend-row">
          <div class="legend-left"><div class="legend-dot" style="background: ${color}"></div>${s.source}</div>
          <div class="legend-right">${count} <span>(${Math.round(percent * 100)}%)</span></div>
        </div>
      `;
    });

    document.getElementById('sourceDonut').innerHTML = svg;
    document.getElementById('sourceLegend').innerHTML = legend;
  }

  function renderTable(leads) {
    const tbody = document.getElementById('recentAssessmentsTable');
    if (!leads || !leads.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 24px; color: #64748B;">No recent assessments</td></tr>';
      return;
    }

    tbody.innerHTML = leads.map(lead => {
      const date = new Date(lead.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      
      let badgeClass = 'badge-mod';
      if (lead.riskLevel === 'high' || lead.riskLevel === 'critical') badgeClass = 'badge-high';
      if (lead.riskLevel === 'low') badgeClass = 'badge-low-mod';

      let statusBadge = 'badge-mod';
      if (lead.status === 'New Lead') statusBadge = 'badge-low-mod';
      if (lead.status === 'Report Delivered') statusBadge = 'badge-report';

      let action = 'Book Consultation';
      if (lead.status === 'New Lead') action = 'Start Assessment';
      if (lead.status === 'Consultation Booked') action = 'Send Proposal';

      return `
        <tr>
          <td>
            <div class="td-main">${lead.name}</div>
            <div class="td-sub">${lead.email}</div>
          </td>
          <td><div class="td-main">${lead.industry || 'Business'}</div></td>
          <td><div class="td-main">${lead.score || 0}/100</div></td>
          <td><span class="crm-badge ${badgeClass}">${lead.riskLevel || 'Unknown'}</span></td>
          <td><div class="td-main">${date}</div></td>
          <td><span class="crm-badge ${statusBadge}">${lead.status || 'New Lead'}</span></td>
          <td><button class="btn-action-outline">${action}</button></td>
        </tr>
      `;
    }).join('');
  }

  function renderTasks(tasks) {
    const container = document.getElementById('taskList');
    if (!tasks || !tasks.length) {
      container.innerHTML = '<div style="color: #64748B; font-size: 13px;">No upcoming tasks</div>';
      return;
    }
    container.innerHTML = tasks.slice(0, 4).map(t => {
      const date = new Date(t.due_date).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
      return `
        <div class="task-item">
          <div class="task-radio"></div>
          <div class="task-content">
            <div class="task-title">${t.title}</div>
            <div class="task-meta">
              <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              ${t.lead_name}
            </div>
          </div>
          <div class="task-time">${date}</div>
        </div>
      `;
    }).join('');
  }

  function renderActivities(activities) {
    const container = document.getElementById('activityFeed');
    if (!activities || !activities.length) {
      container.innerHTML = '<div style="color: #64748B; font-size: 13px;">No recent activities</div>';
      return;
    }
    
    const icons = {
      assessment: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>',
      message: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>',
      system: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
    };

    container.innerHTML = activities.slice(0, 5).map(a => {
      // Calculate time ago
      const diff = Math.floor((new Date() - new Date(a.created_at)) / 60000); // mins
      const timeAgo = diff < 60 ? `${diff}m ago` : diff < 1440 ? `${Math.floor(diff/60)}h ago` : `${Math.floor(diff/1440)}d ago`;

      return `
        <div class="feed-item">
          <div class="feed-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor">${icons[a.type] || icons.system}</svg></div>
          <div class="feed-content">
            <div class="feed-title">${a.title}</div>
            <div class="feed-desc">${a.description || ''}</div>
          </div>
          <div class="feed-time">${timeAgo}</div>
        </div>
      `;
    }).join('');
  }

  loadDashboardData();
</script>