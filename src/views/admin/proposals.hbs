<style>
  :root {
    --c-green: #10b981;
    --c-green-light: #ecfdf5;
    --c-green-dark: #047857;
    --c-orange: #f59e0b;
    --c-orange-light: #fffbeb;
    --c-blue: #3b82f6;
    --c-blue-light: #eff6ff;
    --c-purple: #8b5cf6;
    --c-purple-light: #f5f3ff;
    --c-red: #ef4444;
    --c-red-light: #fef2f2;
    --c-gray: #64748b;
    --text-sec: #64748b;
    --c-gray-light: #f1f5f9;
    --c-dark: #0f172a;
    --bg-page: #ffffff;
  }

  /* Override Admin Layout */
  .admin-sidebar, .admin-topbar { display: none !important; }
  .admin-main, .admin-content-wrapper { padding: 0 !important; margin: 0 !important; background: var(--bg-page) !important; height: 100vh; overflow-y: auto; }
  body.admin-layout { background: var(--bg-page) !important; }
  
  body {
    background-color: var(--bg-page);
    font-family: 'Inter', sans-serif;
  }

  .mobile-app-container {
    max-width: 480px;
    margin: 0 auto;
    background: #ffffff;
    min-height: 100vh;
    box-shadow: 0 0 20px rgba(0,0,0,0.05);
    position: relative;
    padding-bottom: 90px;
  }

  .quotes-page {
    padding: 16px;
    color: var(--c-dark);
  }

  /* Top Bar */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0 24px;
  }
  .screen-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0;
  }
  .icon-btn {
    background: none;
    border: none;
    color: var(--c-dark);
    padding: 4px;
    cursor: pointer;
    display: flex;
  }
  .icon-btn svg { width: 24px; height: 24px; }

  /* Tabs Row */
  .tabs-row {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin-bottom: 24px;
    border-bottom: 1px solid #f1f5f9;
  }
  .tabs-row::-webkit-scrollbar { display: none; }
  .tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 12px;
    position: relative;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-gray);
    cursor: pointer;
  }
  .tab.active { color: var(--c-green-dark); }
  .tab.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--c-green-dark);
    border-radius: 2px 2px 0 0;
  }
  .tab-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 12px;
  }
  .tab-badge.bg-green { background: var(--c-green-dark); color: white; }
  .tab-badge.bg-gray { background: #f1f5f9; color: var(--c-gray); }

  /* Summary Card */
  .summary-card {
    background: #f4fdf8;
    border: 1px solid #e6f9ed;
    border-radius: 16px;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .sum-left { display: flex; align-items: flex-start; gap: 12px; }
  .sum-icon {
    width: 44px;
    height: 44px;
    background: #e6f9ed;
    color: var(--c-green-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sum-icon svg { width: 22px; height: 22px; }
  .sum-lbl {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    margin: 0 0 4px 0;
  }
  .sum-val {
    font-size: 24px;
    font-weight: 800;
    color: var(--c-dark);
    margin: 0 0 4px 0;
  }
  .sum-sub {
    font-size: 11px;
    color: var(--c-gray);
    margin: 0;
  }
  .growth-box {
    background: #e6f9ed;
    padding: 10px;
    border-radius: 8px;
    text-align: center;
    min-width: 70px;
  }
  .growth-val {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-green-dark);
    margin-bottom: 2px;
  }
  .growth-val svg { width: 14px; height: 14px; }
  .growth-lbl {
    font-size: 9px;
    color: var(--c-gray);
    font-weight: 600;
  }

  /* List Area */
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .list-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-dark);
    margin: 0;
  }
  .view-all {
    font-size: 12px;
    font-weight: 700;
    color: var(--c-green-dark);
    text-decoration: none;
  }

  /* List Cards */
  .list-card {
    background: white;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    margin-bottom: 8px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
  }
  .c-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
    margin-right: 12px;
  }
  .c-avatar.green { background: #ecfdf5; color: #059669; }
  .c-avatar.purple { background: #f5f3ff; color: #7c3aed; }
  .c-avatar.blue { background: #eff6ff; color: #2563eb; }
  .c-avatar.orange { background: #fffbeb; color: #d97706; }
  .c-avatar.red { background: #fef2f2; color: #dc2626; }

  .c-body { flex-grow: 1; }
  .c-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--c-dark);
    margin: 0 0 4px 0;
  }
  .c-sub {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--c-gray);
    margin: 0 0 6px 0;
  }
  .c-sub svg { width: 12px; height: 12px; }
  
  .c-meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
  }
  .status-badge svg { width: 10px; height: 10px; }
  .status-badge.green { background: #ecfdf5; color: #059669; }
  .status-badge.orange { background: #fffbeb; color: #d97706; }
  .status-badge.red { background: #fef2f2; color: #dc2626; }
  .meta-dot { color: #cbd5e1; font-size: 10px; }
  .meta-time { font-size: 10px; color: var(--c-gray); font-weight: 500; }

  .c-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    margin-right: 8px;
    flex-shrink: 0;
  }
  .c-amount {
    font-size: 13px;
    font-weight: 800;
    color: var(--c-dark);
    margin-bottom: 4px;
  }
  .c-freq {
    font-size: 10px;
    color: var(--c-gray);
  }

  .chevron {
    color: #cbd5e1;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Create CTA Card */
  .create-cta {
    background: #f4fdf8;
    border: 1px solid #d1fae5;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  .cta-icon {
    width: 36px;
    height: 36px;
    background: #e6f9ed;
    color: var(--c-green-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cta-icon svg { width: 18px; height: 18px; }
  .cta-text { flex-grow: 1; }
  .cta-text h4 {
    font-size: 13px;
    font-weight: 700;
    color: #064e3b;
    margin: 0 0 2px 0;
  }
  .cta-text p {
    font-size: 10px;
    color: #065f46;
    margin: 0;
    line-height: 1.3;
  }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #047857;
    color: white;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
  }
  .btn-cta svg { width: 12px; height: 12px; }

  /* Bottom Nav */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 0 24px 0;
    border-top: 1px solid #e2e8f0;
    z-index: 100;
  }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-sec); text-decoration: none; font-size: 10px; font-weight: 600; }
  .nav-item.active {
    color: var(--c-green);
  }
  .nav-item svg {
    width: 24px;
    height: 24px;
    stroke-width: 2;
  }
</style>

