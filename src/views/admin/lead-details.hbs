<style>
  .lead-page {
    padding: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .header-main {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    transition: all 0.2s;
  }
  .back-btn:hover {
    color: var(--text-primary);
    border-color: rgba(255,255,255,0.2);
  }
  .lead-name {
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }
  .lead-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
  .status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .status-badge.new { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
  .status-badge.contacted { background: rgba(168, 85, 247, 0.2); color: #c084fc; }
  .status-badge.converted { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  .status-badge.lost { background: rgba(239, 68, 68, 0.2); color: #f87171; }
  
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 24px;
    align-items: start;
  }

  .card {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 24px;
  }
  .card-header {
    padding: 16px 24px;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-body {
    padding: 24px;
  }

  /* Info Grid */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .info-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .info-value {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Score Widget */
  .score-widget {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px;
    background: rgba(255,255,255,0.02);
    border-radius: var(--radius-md);
    margin-bottom: 24px;
  }
  .score-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-family: var(--font-mono);
    font-weight: 700;
    border: 4px solid;
  }
  .score-details {
    flex: 1;
  }
  .risk-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .risk-badge.low { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  .risk-badge.moderate { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
  .risk-badge.high { background: rgba(249, 115, 22, 0.2); color: #fb923c; }
  .risk-badge.critical { background: rgba(239, 68, 68, 0.2); color: #f87171; }

  /* Assessment Answers */
  .qa-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .qa-item {
    background: rgba(255,255,255,0.02);
    border-radius: 8px;
    padding: 16px;
  }
  .qa-q {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }
  .qa-a {
    font-size: 15px;
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .timeline-item {
    display: flex;
    gap: 16px;
  }
  .tl-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .tl-content {
    flex: 1;
    padding-top: 6px;
  }
  .tl-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .tl-desc {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 4px;
  }
  .tl-time {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* Chat Box */
  .chat-box {
    height: 400px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 8px;
  }
  .chat-msg {
    max-width: 85%;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
  }
  .chat-msg.bot {
    background: rgba(255,255,255,0.05);
    color: var(--text-primary);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .chat-msg.user {
    background: var(--color-primary);
    color: white;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }
  .chat-time {
    font-size: 10px;
    opacity: 0.6;
    margin-top: 4px;
    text-align: right;
  }

  /* Form Control Override */
  .form-select {
    background-color: var(--bg-surface);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    padding: 8px 16px;
    border-radius: var(--radius-md);
    outline: none;
    font-size: 14px;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .grid-layout { grid-template-columns: 1fr; }
  }
</style>

<div class="lead-page">
  <div id="loadingOverlay" style="text-align:center; padding: 100px;">
    <div class="loading-spinner-lg" style="margin:0 auto 16px; width:40px; height:40px; border:3px solid var(--glass-border); border-top-color:var(--color-primary); border-radius:50%; animation:spin 0.8s linear infinite;"></div>
    Loading lead details...
  </div>

  <div id="leadContent" style="display:none;">
    <div class="page-header">
      <div class="header-main">
        <a href="/admin/leads" class="back-btn">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <div>
          <h1 class="lead-name" id="leadName">--</h1>
          <div class="lead-meta">
            <span id="leadStatus" class="status-badge new">New</span>
            <span style="color: var(--text-muted); font-size: 13px;" id="leadDate">--</span>
          </div>
        </div>
      </div>
      <div class="header-actions">
        <select class="form-select" id="statusSelect" onchange="updateStatus(this.value)">
          <option value="New Lead">New Lead</option>
          <option value="WhatsApp Engaged">WhatsApp Engaged</option>
          <option value="Qualified">Qualified</option>
          <option value="Consultation Scheduled">Consultation Scheduled</option>
          <option value="Proposal Sent">Proposal Sent</option>
          <option value="Won">Won</option>
          <option value="Lost">Lost</option>
        </select>
      </div>
    </div>

    <div class="grid-layout">
      <!-- Left Column -->
      <div class="main-column">
        
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Contact Information
            </div>
          </div>
          <div class="card-body info-grid">
            <div class="info-item">
              <span class="info-label">Email</span>
              <span class="info-value" id="infoEmail">--</span>
            </div>
            <div class="info-item">
              <span class="info-label">Phone</span>
              <span class="info-value" id="infoPhone">--</span>
            </div>
            <div class="info-item">
              <span class="info-label">Business</span>
              <span class="info-value" id="infoBusiness">--</span>
            </div>
            <div class="info-item">
              <span class="info-label">Industry</span>
              <span class="info-value" style="text-transform: capitalize;" id="infoIndustry">--</span>
            </div>
            <div class="info-item">
              <span class="info-label">Lead Source</span>
              <span class="info-value">CoverScore AI</span>
            </div>
            <div class="info-item">
              <span class="info-label">Est. Premium</span>
              <span class="info-value" id="infoPremium">--</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Assessment Breakdown
            </div>
          </div>
          <div class="card-body">
            <div class="score-widget" id="scoreWidget" style="display:none;">
              <div class="score-circle" id="scoreCircle">0</div>
              <div class="score-details">
                <div class="risk-badge" id="riskBadge">Unknown</div>
                <p style="font-size: 13px; color: var(--text-secondary); margin:0;" id="aiSummary">Loading AI analysis...</p>
              </div>
            </div>

            <div class="qa-list" id="qaList">
              <p style="color: var(--text-muted); font-size: 14px;">No assessment answers available.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column -->
      <div class="side-column">

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              WhatsApp Chat
            </div>
          </div>
          <div class="card-body">
            <div class="chat-box" id="chatBox">
              <p style="color: var(--text-muted); font-size: 13px; text-align:center;">No chat history.</p>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Activity Timeline
            </div>
          </div>
          <div class="card-body">
            <div class="timeline" id="timeline">
              <p style="color: var(--text-muted); font-size: 13px;">No activities recorded.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  const leadId = "{{leadId}}";

  async function loadLead() {
    const token = localStorage.getItem('accessToken');
    try {
      const res = await fetch(`/api/leads/${leadId}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Failed to fetch lead');
      const data = await res.json();
      renderLead(data);
    } catch (err) {
      console.error("DEBUG ERR:", err);
      document.getElementById('loadingOverlay').style.display = 'flex';
      document.getElementById('loadingOverlay').innerHTML = `
        <div style="color: #ef4444; text-align: center; padding: 20px;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin: 0 auto 16px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <h3 style="margin-top:0;">Error Loading Lead</h3>
          <p style="font-size: 14px; opacity: 0.8; font-family: monospace; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 4px;">${err.message}</p>
          <button onclick="loadLead()" class="btn btn-outline" style="margin-top: 16px;">Try Again</button>
        </div>
      `;
    }
  }

  function renderLead(lead) {
    document.getElementById('loadingOverlay').style.display = 'none';
    document.getElementById('leadContent').style.display = 'block';

    document.getElementById('leadName').textContent = lead.name;
    document.getElementById('leadStatus').textContent = lead.status;
    document.getElementById('leadStatus').className = `status-badge ${getBadgeClass(lead.status)}`;
    document.getElementById('leadDate').textContent = `Added on ${new Date(lead.createdAt).toLocaleDateString()}`;
    document.getElementById('statusSelect').value = lead.status;

    document.getElementById('infoEmail').textContent = lead.email;
    document.getElementById('infoPhone').textContent = lead.phone || 'N/A';
    document.getElementById('infoBusiness').textContent = lead.businessName || 'N/A';
    document.getElementById('infoIndustry').textContent = lead.industry || 'Unknown';
    document.getElementById('infoPremium').textContent = lead.estimatedPremium ? `$${lead.estimatedPremium}` : 'Pending';

    // Assessment
    if (lead.assessment) {
      document.getElementById('scoreWidget').style.display = 'flex';
      const score = lead.assessment.score;
      const risk = lead.assessment.riskLevel;
      const circle = document.getElementById('scoreCircle');
      circle.textContent = score;
      
      const colors = { low: '#10b981', moderate: '#f59e0b', high: '#f97316', critical: '#ef4444' };
      circle.style.borderColor = colors[risk] || '#666';
      circle.style.color = colors[risk] || '#fff';

      const badge = document.getElementById('riskBadge');
      badge.textContent = risk + ' Risk';
      badge.className = `risk-badge ${risk}`;

      if (lead.assessment.aiReport && lead.assessment.aiReport.executive_summary) {
        document.getElementById('aiSummary').textContent = lead.assessment.aiReport.executive_summary;
      }

      if (lead.assessment.answers) {
        const answersHtml = Object.entries(lead.assessment.answers).map(([cat, fields]) => {
          if(!fields || typeof fields !== 'object') return '';
          return Object.entries(fields).map(([k, v]) => `
            <div class="qa-item">
              <div class="qa-q">${k.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</div>
              <div class="qa-a">${v || 'N/A'}</div>
            </div>
          `).join('');
        }).join('');
        document.getElementById('qaList').innerHTML = answersHtml;
      }
    }

    // Chat History
    if (lead.chatHistory && typeof lead.chatHistory === 'object') {
      const isArray = Array.isArray(lead.chatHistory);
      const keys = isArray ? lead.chatHistory : Object.keys(lead.chatHistory);
      if (keys.length > 0) {
        let html = '';
        if (isArray) {
          html = lead.chatHistory.map(msg => {
            const text = msg.message || msg.text || '';
            const senderClass = msg.sender === 'bot' ? 'bot' : 'user';
            const senderLabel = msg.sender === 'bot' ? 'Bot' : 'Lead';
            const time = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';
            return `
              <div class="chat-msg ${senderClass}">
                <div style="font-size: 11px; opacity: 0.7; margin-bottom: 4px;">${senderLabel}</div>
                <div>${text}</div>
                <div class="chat-time">${time}</div>
              </div>
            `;
          }).join('');
        } else {
          html = Object.entries(lead.chatHistory).map(([key, val]) => `
            <div class="chat-msg user">
              <div style="font-size: 11px; opacity: 0.7; margin-bottom: 4px;">${key}</div>
              <div>${val}</div>
            </div>
          `).join('');
        }
        document.getElementById('chatBox').innerHTML = html;
        const cb = document.getElementById('chatBox');
        cb.scrollTop = cb.scrollHeight;
      }
    }

    // Timeline (merge tasks and activities)
    const timeline = [];
    if (lead.tasks) {
      lead.tasks.forEach(t => timeline.push({
        icon: '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>',
        title: `Task: ${t.title}`,
        desc: `Status: ${t.status}`,
        time: t.created_at
      }));
    }
    if (lead.activities) {
      lead.activities.forEach(a => timeline.push({
        icon: '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
        title: a.title,
        desc: a.description,
        time: a.created_at
      }));
    }

    timeline.sort((a,b) => new Date(b.time) - new Date(a.time));

    if (timeline.length > 0) {
      document.getElementById('timeline').innerHTML = timeline.map(item => `
        <div class="timeline-item">
          <div class="tl-icon">${item.icon}</div>
          <div class="tl-content">
            <div class="tl-title">${item.title}</div>
            ${item.desc ? `<div class="tl-desc">${item.desc}</div>` : ''}
            <div class="tl-time">${new Date(item.time).toLocaleString()}</div>
          </div>
        </div>
      `).join('');
    }
  }

  function getBadgeClass(status) {
    if (!status) return 'new';
    const s = status.toLowerCase();
    if (s.includes('new')) return 'new';
    if (s.includes('engaged') || s.includes('scheduled')) return 'contacted';
    if (s.includes('won') || s.includes('converted')) return 'converted';
    if (s.includes('lost')) return 'lost';
    return 'new';
  }

  async function updateStatus(newStatus) {
    const token = localStorage.getItem('accessToken');
    try {
      const res = await fetch(`/api/leads/${leadId}/status`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ status: newStatus })
      });
      if (res.ok) {
        document.getElementById('leadStatus').textContent = newStatus;
        document.getElementById('leadStatus').className = `status-badge ${getBadgeClass(newStatus)}`;
      } else {
        throw new Error('Failed to update status');
      }
    } catch (err) {
      alert(err.message);
      // Revert select
      loadLead(); 
    }
  }

  document.addEventListener('DOMContentLoaded', loadLead);
</script>
